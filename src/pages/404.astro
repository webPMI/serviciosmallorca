---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { detectUserLocale, loadTranslations, getLangPrefix, type Locale } from "../i18n";

export const prerender = false;

const locale = (detectUserLocale(Astro.request) || "es") as Locale;
const translations = await loadTranslations(locale);
const prefix = getLangPrefix(locale);

const searchPlaceholder =
  locale === "de"
    ? "Suche nach Restaurants, Spas, Booten oder Sport..."
    : locale === "en"
      ? "Search for restaurants, spas, boat charters, sports..."
      : locale === "ca"
        ? "Cerca restaurants, spas, embarcacions, esports..."
        : "Buscar restaurantes, spas, barcos, deportes...";

const searchBtnText = locale === "de" ? "Suchen" : locale === "en" ? "Search" : locale === "ca" ? "Cercar" : "Buscar";

const categoriesTitle =
  locale === "de"
    ? "Oder entdecke beliebte Kategorien:"
    : locale === "en"
      ? "Or explore popular categories:"
      : locale === "ca"
        ? "O explora categories populars:"
        : "O explora categorías populares:";

const categoryLinks = [
  {
    icon: "🍽️",
    label:
      locale === "de"
        ? "Gastronomie"
        : locale === "en"
          ? "Gastronomy"
          : locale === "ca"
            ? "Gastronomia"
            : "Gastronomía",
    url: `${prefix}servicios?category=gastronomia-catering`,
  },
  {
    icon: "✨",
    label:
      locale === "de"
        ? "Spas & Wellness"
        : locale === "en"
          ? "Spas & Wellness"
          : locale === "ca"
            ? "Spas & Benestar"
            : "Spas & Bienestar",
    url: `${prefix}servicios?category=salud-bienestar`,
  },
  {
    icon: "⛵",
    label:
      locale === "de"
        ? "Yachtcharter"
        : locale === "en"
          ? "Boat Charter"
          : locale === "ca"
            ? "Nàutica & Xàrter"
            : "Náutica & Chárter",
    url: `${prefix}servicios?category=nautica-charter`,
  },
  {
    icon: "🎾",
    label:
      locale === "de"
        ? "Sport & Padel"
        : locale === "en"
          ? "Sports & Padel"
          : locale === "ca"
            ? "Esport & Pàdel"
            : "Deporte & Pádel",
    url: `${prefix}deporte`,
  },
  {
    icon: "🎨",
    label:
      locale === "de"
        ? "Tattoo & Kunst"
        : locale === "en"
          ? "Tattoo & Art"
          : locale === "ca"
            ? "Art & Tatuatges"
            : "Arte & Tatuajes",
    url: `${prefix}servicios?category=arte-tatuajes`,
  },
  {
    icon: "🏡",
    label:
      locale === "de"
        ? "Villen & Bau"
        : locale === "en"
          ? "Villas & Reform"
          : locale === "ca"
            ? "Reformes & Llar"
            : "Reformas & Hogar",
    url: `${prefix}servicios?category=reformas-construccion`,
  },
];
---

<BaseLayout
  title={`${translations["404.title"] || "404 - Página no encontrada"} | Servicios Mallorca`}
  lang={locale}
  description={translations["404.description"] || "La página que buscas no existe o ha cambiado de dirección."}
>
  <Navbar currentLocale={locale} translations={translations} getLangPrefix={getLangPrefix} />

  <main class="container section error-404-container">
    <div class="error-404-card card card-glass">
      <div class="error-404-visual">
        <span class="error-code">404</span>
        <div class="island-icon-wrap">
          <span class="island-emoji">🏝️</span>
          <span class="compass-emoji">🧭</span>
        </div>
      </div>

      <div class="badge badge-accent">
        <span
          >📍 {
            locale === "de"
              ? "Route verloren"
              : locale === "en"
                ? "Off the Route"
                : locale === "ca"
                  ? "Fora de Ruta"
                  : "Fuera de Ruta"
          }</span
        >
      </div>

      <h1 class="error-title">{translations["404.title"] || "Página no encontrada"}</h1>
      <p class="error-lead">{translations["404.subtitle"] || "Parece que te has desviado de la ruta en la isla."}</p>
      <p class="error-desc text-muted">
        {
          translations["404.description"] ||
            "La cala, el servicio o la página que buscas no existe o ha cambiado de dirección."
        }
      </p>

      <!-- Search Box in 404 Page -->
      <form action={`${prefix}servicios`} method="GET" class="error-search-box">
        <div class="search-input-group">
          <span class="search-icon">🔍</span>
          <input
            type="text"
            name="q"
            placeholder={searchPlaceholder}
            class="search-input"
            aria-label={searchPlaceholder}
            required
          />
          <button type="submit" class="btn btn-primary btn-sm search-submit-btn">
            {searchBtnText}
          </button>
        </div>
      </form>

      <!-- Category Shortcut Pills -->
      <div class="category-shortcuts-section">
        <p class="shortcuts-title">{categoriesTitle}</p>
        <div class="category-pills-grid">
          {
            categoryLinks.map((cat) => (
              <a href={cat.url} class="category-pill-link hover-lift">
                <span class="pill-icon">{cat.icon}</span>
                <span class="pill-label">{cat.label}</span>
              </a>
            ))
          }
        </div>
      </div>

      <!-- Quick Island Recovery Actions -->
      <div class="error-action-grid">
        <a href={prefix} class="btn btn-primary btn-lg hover-lift">
          <span>🏠 {translations["404.backHome"] || "Volver al Inicio"}</span>
        </a>
        <a href={`${prefix}servicios`} class="btn btn-secondary hover-lift">
          <span>🔍 {translations["404.exploreServices"] || "Explorar Servicios"}</span>
        </a>
        <a href={`${prefix}favoritos`} class="btn btn-outline hover-lift">
          <span
            >❤️ {
              locale === "de"
                ? "Meine Favoriten"
                : locale === "en"
                  ? "My Favorites"
                  : locale === "ca"
                    ? "Els Meus Preferits"
                    : "Mis Favoritos"
            }</span
          >
        </a>
      </div>
    </div>
  </main>

  <Footer currentLocale={locale} translations={translations} getLangPrefix={getLangPrefix} />
</BaseLayout>

<style>
  .error-404-container {
    min-height: 75vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: var(--space-8);
    padding-bottom: var(--space-12);
  }

  .error-404-card {
    max-width: 680px;
    width: 100%;
    margin: 0 auto;
    text-align: center;
    padding: var(--space-8);
    border-radius: var(--border-radius-2xl);
    border: 1px solid var(--color-surface-border);
    box-shadow: var(--shadow-xl);
    backdrop-filter: blur(16px);
  }

  .error-404-visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-2);
  }

  .error-code {
    font-size: clamp(4.5rem, 12vw, 7.5rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.05em;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-accent, #c9933e) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    opacity: 0.9;
  }

  .island-icon-wrap {
    position: absolute;
    display: flex;
    gap: var(--space-1);
    font-size: 2.2rem;
    bottom: -8px;
    filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.15));
  }

  .error-title {
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    font-weight: 800;
    margin-top: var(--space-3);
    margin-bottom: var(--space-1);
    color: var(--color-text);
  }

  .error-lead {
    font-size: var(--font-size-lg);
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--space-2);
  }

  .error-desc {
    font-size: var(--font-size-sm);
    max-width: 480px;
    margin: 0 auto var(--space-6);
  }

  /* Search Box */
  .error-search-box {
    margin-bottom: var(--space-6);
  }

  .search-input-group {
    display: flex;
    align-items: center;
    background: var(--color-surface);
    border: 1px solid var(--color-surface-border);
    border-radius: var(--border-radius-full);
    padding: 0.35rem 0.5rem 0.35rem 1rem;
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-fast);
  }

  .search-input-group:focus-within {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px var(--color-primary-light, rgba(201, 147, 62, 0.2));
  }

  .search-icon {
    font-size: 1.1rem;
    margin-right: 0.5rem;
    color: var(--color-text-muted);
  }

  .search-input {
    flex: 1;
    border: none;
    background: transparent;
    font-size: var(--font-size-sm);
    color: var(--color-text);
    outline: none;
    min-width: 0;
  }

  .search-submit-btn {
    border-radius: var(--border-radius-full);
    padding: 0.4rem 1.1rem;
    flex-shrink: 0;
  }

  /* Category Shortcuts */
  .category-shortcuts-section {
    margin-bottom: var(--space-6);
  }

  .shortcuts-title {
    font-size: var(--font-size-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .category-pills-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
  }

  .category-pill-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.85rem;
    background: var(--color-surface);
    border: 1px solid var(--color-surface-border);
    border-radius: var(--border-radius-full);
    text-decoration: none;
    color: var(--color-text);
    font-size: var(--font-size-xs);
    font-weight: 600;
    transition: all var(--transition-fast);
  }

  .category-pill-link:hover {
    border-color: var(--color-primary);
    background: var(--color-surface-hover);
    color: var(--color-primary);
  }

  .error-action-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
  }

  @media (max-width: 640px) {
    .error-404-card {
      padding: var(--space-5) var(--space-4);
    }

    .error-action-grid {
      flex-direction: column;
    }

    .error-action-grid .btn {
      width: 100%;
    }
  }
</style>
