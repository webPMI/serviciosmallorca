---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Navbar from "../../../components/Navbar.astro";
import Footer from "../../../components/Footer.astro";
import { getLocaleFromUrl, loadTranslations, getLangPrefix, type Locale } from "../../../i18n";
import {
  CHANGELOG_RELEASES,
  CURRENT_PLATFORM_VERSION,
  PLATFORM_LAST_BUILD_TIMESTAMP,
  getFormattedBuildTimestamp,
} from "../../../data/changelog";

export const prerender = false;

const locale = getLocaleFromUrl(Astro.url) as Locale;
const translations = await loadTranslations(locale);
const prefix = getLangPrefix(locale);
const formattedLastUpdate = getFormattedBuildTimestamp(locale);

const i18nTexts = {
  es: {
    pageTitle: `Registro de Actualizaciones & Versión Beta (${CURRENT_PLATFORM_VERSION}) - Servicios Mallorca`,
    pageDescription: `Conoce las últimas novedades, mejoras técnicas, correcciones y el registro de versiones de Servicios Mallorca (${CURRENT_PLATFORM_VERSION}).`,
    heroBadgeVersion: `🚀 Versión ${CURRENT_PLATFORM_VERSION}`,
    heroBadgeTransparency: "🌴 Transparencia & Desarrollo Activo",
    heroBadgeLastUpdate: `⏱️ Última actualización: ${formattedLastUpdate} (UTC+2)`,
    heroTitle: "Centro de Actualizaciones, Mejoras y Registro de Versiones",
    heroSubtitle:
      "Servicios Mallorca nace con un compromiso inquebrantable de transparencia, datos reales y meritocracia. En este registro documentamos cada mejora, corrección y nueva herramienta.",
    statBusinesses: "Comercios en Catálogo",
    statSuites: "Suites de Calidad",
    statData: "Fuentes Públicas Reales",
    principle1Title: "Búsqueda y Contraste Continuo",
    principle1Desc:
      "Recopilamos y contrastamos información constantemente desde fuentes públicas oficiales (Google Maps, registros y webs oficiales) para mantener las fichas al día, invitando a titulares y vecinos a colaborar.",
    principle2Title: "Despliegue Continuo y Resiliente",
    principle2Desc:
      "Toda actualización pasa por 612 tests automatizados y validación de taxonomía antes de publicarse en la red global de alta velocidad.",
    principle3Title: "Meritocracia y Claridad",
    principle3Desc:
      "Subastas de reconocimiento transparentes desde 1,00€, visualización continua a simple vista y comunicación clara y directa sin tecnicismos.",
    timelineTitle: "📦 Historial de Versiones & Lanzamientos",
    timelineDesc: "Evolución detallada de cada despliegue con sus características y optimizaciones.",
    highlightsTitle: "✨ Hitos & Novedades Destacadas:",
    feedbackTitle: "¿Tienes una sugerencia, has detectado un fallo o quieres compartir una buena noticia?",
    feedbackDesc:
      "Tu opinión nos ayuda a construir la mejor guía de servicios para Mallorca. Nuestro equipo y agentes revisan cada propuesta con dedicación.",
    btnExplore: "Explorar Comercios del Catálogo →",
    btnHonor: "Ver Cuadro de Honor (desde 1€) →",
    roadmapTitle: "🗺️ Próximos Pasos (Roadmap v0.02 - 2026)",
    roadmapF1Step: "Fase 1",
    roadmapF1Title: "Escalado a 1.000 Comercios",
    roadmapF1Desc: "Cobertura integral en los 53 municipios de Mallorca.",
    roadmapF2Step: "Fase 2",
    roadmapF2Title: "Instalaciones Deportivas & Parques",
    roadmapF2Desc: "Mapeo de calistenia, pistas de pádel y centros de entrenamiento.",
    roadmapF3Step: "Fase 3",
    roadmapF3Title: "Buzón Ciudadano & Buenas Noticias",
    roadmapF3Desc: "Muro de agradecimientos y canal directo para sugerencias.",
  },
  en: {
    pageTitle: `Platform Updates & Beta Changelog (${CURRENT_PLATFORM_VERSION}) - Servicios Mallorca`,
    pageDescription: `Explore the latest features, technical improvements, fixes, and release history of Servicios Mallorca (${CURRENT_PLATFORM_VERSION}).`,
    heroBadgeVersion: `🚀 Version ${CURRENT_PLATFORM_VERSION}`,
    heroBadgeTransparency: "🌴 Transparency & Active Development",
    heroBadgeLastUpdate: `⏱️ Last update: ${formattedLastUpdate} (UTC+2)`,
    heroTitle: "Platform Changelog, Updates & Release Log",
    heroSubtitle:
      "Servicios Mallorca is built on strict transparency, genuine verified public data, and local meritocracy. Here we document every single release, fix, and new platform tool.",
    statBusinesses: "Local Businesses",
    statSuites: "Quality Suites",
    statData: "Genuine Public Data",
    principle1Title: "Continuous Research & Contrast",
    principle1Desc:
      "We constantly gather and contrast data from official public sources (Google Maps, official websites) to keep listings fresh, inviting business owners and locals to corroborate.",
    principle2Title: "Continuous Resilient Delivery",
    principle2Desc:
      "Every release runs through 612 automated test suites and taxonomy validation before publishing to our high-speed global network.",
    principle3Title: "Meritocracy & Clarity",
    principle3Desc:
      "Transparent community recognition bids starting at €1.00, continuous layout view, and clear natural communication without technical jargon.",
    timelineTitle: "📦 Release History & Changelog",
    timelineDesc: "Detailed log of every deployment with its features and performance optimizations.",
    highlightsTitle: "✨ Key Milestones & Highlights:",
    feedbackTitle: "Have a suggestion, spotted an error, or want to share good local news?",
    feedbackDesc:
      "Your feedback helps us build the best local directory for Mallorca. Our team and research agents review every submission carefully.",
    btnExplore: "Explore Directory Listings →",
    btnHonor: "View Honor Board (from €1) →",
    roadmapTitle: "🗺️ Upcoming Milestones (Roadmap v0.02 - 2026)",
    roadmapF1Step: "Phase 1",
    roadmapF1Title: "Scaling to 1,000 Businesses",
    roadmapF1Desc: "Comprehensive coverage across all 53 Mallorca municipalities.",
    roadmapF2Step: "Phase 2",
    roadmapF2Title: "Sports Facilities & Parks",
    roadmapF2Desc: "Mapping outdoor calisthenics, padel courts, and fitness centers.",
    roadmapF3Step: "Phase 3",
    roadmapF3Title: "Community Voice & Good News Feed",
    roadmapF3Desc: "Public gratitude wall and direct suggestion pipeline.",
  },
  ca: {
    pageTitle: `Registre d'Actualitzacions i Versió Beta (${CURRENT_PLATFORM_VERSION}) - Serveis Mallorca`,
    pageDescription: `Descobreix les darreres novetats, millores tècniques, correccions i l'historial de versions de Serveis Mallorca (${CURRENT_PLATFORM_VERSION}).`,
    heroBadgeVersion: `🚀 Versió ${CURRENT_PLATFORM_VERSION}`,
    heroBadgeTransparency: "🌴 Transparència & Desenvolupament Actiu",
    heroBadgeLastUpdate: `⏱️ Darrera actualització: ${formattedLastUpdate} (UTC+2)`,
    heroTitle: "Centre d'Actualitzacions, Millores i Registre de Versions",
    heroSubtitle:
      "Servicios Mallorca neix amb un compromís infranquejable de transparència, dades reals i meritocràcia. En aquest registre documentem cada millora, correcció i nova eina.",
    statBusinesses: "Comerços en Catàleg",
    statSuites: "Suites de Qualitat",
    statData: "Fonts Públiques Reals",
    principle1Title: "Cerca i Contrast Continu",
    principle1Desc:
      "Recopilem informació constantment des de fonts públiques oficials (Google Maps, registres i webs oficials) per mantenir les dades al dia, convidant a titulars i veïns a col·laborar.",
    principle2Title: "Desplegament Continu i Resilient",
    principle2Desc:
      "Cada actualització passa per 612 proves automatitzades i validació de taxonomia abans de publicar-se a la xarxa global d'alta velocitat.",
    principle3Title: "Meritocràcia i Transparència",
    principle3Desc:
      "Subhastes de reconeixement transparents des d'1,00€, visualització contínua a simple vista i llenguatge natural sense tecnicismes.",
    timelineTitle: "📦 Historial de Versions & Llançaments",
    timelineDesc: "Evolució detallada de cada desplegament amb les seves característiques i optimitzacions.",
    highlightsTitle: "✨ Fites i Novetats Destacades:",
    feedbackTitle: "Tens un suggeriment, has detectat una errada o vols compartir una bona notícia?",
    feedbackDesc:
      "La teva opinió ens ajuda a construir la millor guia de serveis per a Mallorca. El nostre equip i agents revisen cada proposta amb dedicació.",
    btnExplore: "Explorar Comerços del Catàleg →",
    btnHonor: "Veure Quadre d'Honor (des d'1€) →",
    roadmapTitle: "🗺️ Propers Passos (Full de Ruta v0.02 - 2026)",
    roadmapF1Step: "Fase 1",
    roadmapF1Title: "Escalat a 1.000 Comerços",
    roadmapF1Desc: "Cobertura integral als 53 municipis de Mallorca.",
    roadmapF2Step: "Fase 2",
    roadmapF2Title: "Instal·lacions Esportives & Parcs",
    roadmapF2Desc: "Mapeig de cal·listènia, pistes de pàdel i centres d'entrenament.",
    roadmapF3Step: "Fase 3",
    roadmapF3Title: "Bústia Ciutadana & Bones Notícies",
    roadmapF3Desc: "Mur públic d'agraïments i canal directe per a suggeriments.",
  },
  de: {
    pageTitle: `Plattform-Updates & Beta-Changelog (${CURRENT_PLATFORM_VERSION}) - Servicios Mallorca`,
    pageDescription: `Entdecken Sie die neuesten Funktionen, technischen Verbesserungen, Fixes und die Versionshistorie von Servicios Mallorca (${CURRENT_PLATFORM_VERSION}).`,
    heroBadgeVersion: `🚀 Version ${CURRENT_PLATFORM_VERSION}`,
    heroBadgeTransparency: "🌴 Transparenz & Aktive Entwicklung",
    heroBadgeLastUpdate: `⏱️ Letzte Aktualisierung: ${formattedLastUpdate} (UTC+2)`,
    heroTitle: "Plattform-Updates, Versionsprotokoll & Changelog",
    heroSubtitle:
      "Servicios Mallorca basiert auf absoluter Transparenz, verifizierten Echtzeitdaten und lokaler Exzellenz. Hier dokumentieren wir alle Verbesserungen und Updates.",
    statBusinesses: "Gelistete Betriebe",
    statSuites: "Qualitäts-Suites",
    statData: "Geprüfte Echtdaten",
    principle1Title: "Kontinuierliche Recherche",
    principle1Desc:
      "Wir recherchieren und vergleichen fortlaufend Informationen aus offiziellen Quellen (Google Maps, Websites), um Einträge aktuell zu halten, und laden Inhaber zur Prüfung ein.",
    principle2Title: "Resiliente Bereitstellung",
    principle2Desc:
      "Jedes Update durchläuft 612 automatisierte Tests und Taxonomieprüfungen vor dem Rollout im globalen Highspeed-Netzwerk.",
    principle3Title: "Meritokratie & Klarheit",
    principle3Desc:
      "Transparente Ehrentafel-Gebote ab 1,00€, direkte Gesamtansicht und klare Sprache ohne Fachchinesisch.",
    timelineTitle: "📦 Versionshistorie & Release-Log",
    timelineDesc: "Detailliertes Protokoll jedes Deployments mit neuen Funktionen und Optimierungen.",
    highlightsTitle: "✨ Wichtigste Meilensteine & Highlights:",
    feedbackTitle: "Haben Sie einen Vorschlag, einen Fehler entdeckt oder möchten gute Nachrichten teilen?",
    feedbackDesc:
      "Ihr Feedback hilft uns, das beste Verzeichnis für Mallorca aufzubauen. Unser Team und unsere Recherche-Agenten prüfen jeden Hinweis sorgfältig.",
    btnExplore: "Gelistete Betriebe ansehen →",
    btnHonor: "Ehrentafel ansehen (ab 1€) →",
    roadmapTitle: "🗺️ Nächste Schritte (Roadmap v0.02 - 2026)",
    roadmapF1Step: "Phase 1",
    roadmapF1Title: "Erweiterung auf 1.000 Betriebe",
    roadmapF1Desc: "Vollständige Abdeckung aller 53 Gemeinden Mallorcas.",
    roadmapF2Step: "Phase 2",
    roadmapF2Title: "Sportanlagen & Parks",
    roadmapF2Desc: "Erfassung von Calisthenics-Parks, Padel-Plätzen und Fitnessstudios.",
    roadmapF3Step: "Phase 3",
    roadmapF3Title: "Bürger-Feedback & Gute Nachrichten",
    roadmapF3Desc: "Öffentliche Ehrentafel für Danksagungen und direktes Feedback.",
  },
};

const t = i18nTexts[locale] || i18nTexts.es;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: translations["nav.home"] || "Inicio",
      item: `https://serviciosmallorca.com${prefix}`,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: t.heroTitle,
      item: `https://serviciosmallorca.com${prefix}actualizaciones`,
    },
  ],
};
---

<BaseLayout title={t.pageTitle} description={t.pageDescription} lang={locale} jsonLd={breadcrumbSchema}>
  <Navbar currentLocale={locale} translations={translations} getLangPrefix={getLangPrefix} />

  <main class="changelog-main-container">
    <!-- Hero Header -->
    <header class="changelog-hero card card-glass">
      <div class="hero-top-badge">
        <span class="badge badge-accent">{t.heroBadgeVersion}</span>
        <span class="badge badge-primary">{t.heroBadgeTransparency}</span>
        <span class="badge badge-secondary" title={`Timestamp ISO: ${PLATFORM_LAST_BUILD_TIMESTAMP}`}>
          {t.heroBadgeLastUpdate}
        </span>
      </div>
      <h1 class="hero-title">{t.heroTitle}</h1>
      <p class="hero-subtitle">{t.heroSubtitle}</p>

      <div class="hero-stats-row">
        <div class="stat-pill">
          <span class="stat-num">313+</span>
          <span class="stat-lbl">{t.statBusinesses}</span>
        </div>
        <div class="stat-pill">
          <span class="stat-num">75</span>
          <span class="stat-lbl">{t.statSuites}</span>
        </div>
        <div class="stat-pill">
          <span class="stat-num">Audit</span>
          <span class="stat-lbl">{t.statData}</span>
        </div>
        <div class="stat-pill">
          <span class="stat-num">&lt;300ms</span>
          <span class="stat-lbl">Edge Speed</span>
        </div>
      </div>
    </header>

    <!-- Beta Transparency Principles -->
    <section class="principles-grid">
      <div class="principle-card card">
        <div class="principle-icon">🔎</div>
        <h3>{t.principle1Title}</h3>
        <p>{t.principle1Desc}</p>
      </div>
      <div class="principle-card card">
        <div class="principle-icon">⚡</div>
        <h3>{t.principle2Title}</h3>
        <p>{t.principle2Desc}</p>
      </div>
      <div class="principle-card card">
        <div class="principle-icon">👑</div>
        <h3>{t.principle3Title}</h3>
        <p>{t.principle3Desc}</p>
      </div>
    </section>

    <!-- Timeline of Releases -->
    <section class="releases-section">
      <div class="section-title-wrap">
        <h2 class="section-title">{t.timelineTitle}</h2>
        <p class="section-desc">{t.timelineDesc}</p>
      </div>

      <div class="timeline-container">
        {
          CHANGELOG_RELEASES.map((rel) => {
            const relLabel = rel.versionLabel[locale] || rel.versionLabel.es;
            const relSummary = rel.summary[locale] || rel.summary.es;
            const relHighlights = rel.highlights[locale] || rel.highlights.es;

            return (
              <article class="release-timeline-card card">
                <div class="release-card-header">
                  <div class="version-meta">
                    <span class="version-tag">{relLabel}</span>
                    <time datetime={rel.date} class="version-date">
                      📅 {rel.date}
                    </time>
                  </div>
                  <span class="badge badge-accent">{rel.type} RELEASE</span>
                </div>

                <p class="release-summary-text">{relSummary}</p>

                <div class="release-highlights-box">
                  <h4>{t.highlightsTitle}</h4>
                  <ul class="highlights-list">
                    {relHighlights.map((hl) => (
                      <li>{hl}</li>
                    ))}
                  </ul>
                </div>

                <div class="release-entries-grid">
                  {rel.entries.map((entry) => {
                    const entryTitle = entry.title[locale] || entry.title.es;
                    const entryDesc = entry.description[locale] || entry.description.es;
                    const badge = entry.badgeText ? entry.badgeText[locale] || entry.badgeText.es : entry.category;

                    const catColorClass =
                      entry.category === "FEATURE"
                        ? "cat-feature"
                        : entry.category === "FIX"
                          ? "cat-fix"
                          : entry.category === "PERFORMANCE"
                            ? "cat-perf"
                            : "cat-sec";

                    return (
                      <div class={`entry-item card ${catColorClass}`}>
                        <div class="entry-header">
                          <span class="entry-badge">{badge}</span>
                          <span class="entry-cat">{entry.category}</span>
                        </div>
                        <h5 class="entry-title">{entryTitle}</h5>
                        <p class="entry-desc">{entryDesc}</p>
                      </div>
                    );
                  })}
                </div>
              </article>
            );
          })
        }
      </div>
    </section>

    <!-- Community Feedback & Voice Hub -->
    <section class="feedback-cta-card card card-glass">
      <div class="feedback-icon">💬</div>
      <div class="feedback-info">
        <h3>{t.feedbackTitle}</h3>
        <p>{t.feedbackDesc}</p>
        <div class="feedback-actions">
          <a href={`${prefix}servicios`} class="btn btn-primary">
            <span>{t.btnExplore}</span>
          </a>
          <a href={`${prefix}cuadro-de-honor`} class="btn btn-secondary">
            <span>{t.btnHonor}</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Upcoming Roadmap -->
    <section class="roadmap-preview card">
      <h3>{t.roadmapTitle}</h3>
      <div class="roadmap-grid">
        <div class="roadmap-item">
          <span class="roadmap-step">{t.roadmapF1Step}</span>
          <strong>{t.roadmapF1Title}</strong>
          <p>{t.roadmapF1Desc}</p>
        </div>
        <div class="roadmap-item">
          <span class="roadmap-step">{t.roadmapF2Step}</span>
          <strong>{t.roadmapF2Title}</strong>
          <p>{t.roadmapF2Desc}</p>
        </div>
        <div class="roadmap-item">
          <span class="roadmap-step">{t.roadmapF3Step}</span>
          <strong>{t.roadmapF3Title}</strong>
          <p>{t.roadmapF3Desc}</p>
        </div>
      </div>
    </section>
  </main>

  <Footer translations={translations} currentLocale={locale} getLangPrefix={getLangPrefix} />
</BaseLayout>

<style>
  .changelog-main-container {
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    padding: var(--space-xl) var(--space-md) var(--space-3xl);
    box-sizing: border-box;
    min-width: 0;
  }

  /* Hero Section */
  .changelog-hero {
    text-align: center;
    padding: clamp(var(--space-lg), 4vw, var(--space-2xl)) clamp(var(--space-md), 3vw, var(--space-xl));
    margin-bottom: var(--space-2xl);
    border-radius: var(--border-radius-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-surface-border);
    box-shadow: var(--shadow-md);
    width: 100%;
    box-sizing: border-box;
  }

  .hero-top-badge {
    display: flex;
    justify-content: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
    flex-wrap: wrap;
  }

  .hero-title {
    font-size: clamp(1.4rem, 3.5vw, var(--font-size-3xl));
    font-weight: 900;
    color: var(--color-text);
    margin-bottom: var(--space-sm);
    line-height: 1.25;
    word-break: break-word;
  }

  .hero-subtitle {
    font-size: var(--font-size-base);
    color: var(--color-text-light);
    max-width: 800px;
    margin: 0 auto var(--space-lg);
    line-height: 1.6;
    word-break: break-word;
  }

  .hero-stats-row {
    display: flex;
    justify-content: center;
    gap: var(--space-md);
    flex-wrap: wrap;
    margin-top: var(--space-md);
  }

  .stat-pill {
    background: rgba(0, 0, 0, 0.2);
    padding: 8px 18px;
    border-radius: var(--border-radius-full);
    border: 1px solid var(--color-surface-border);
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 120px;
  }

  .stat-num {
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--color-accent);
  }

  .stat-lbl {
    font-size: 0.72rem;
    color: var(--color-text-light);
    font-weight: 600;
  }

  /* Principles Grid */
  .principles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: var(--space-lg);
    margin-bottom: var(--space-3xl);
  }

  .principle-card {
    padding: var(--space-lg);
    border-radius: var(--border-radius-md);
    background: var(--color-surface);
    border: 1px solid var(--color-surface-border);
  }

  .principle-icon {
    font-size: 2.2rem;
    margin-bottom: var(--space-xs);
  }

  .principle-card h3 {
    font-size: var(--font-size-lg);
    font-weight: 700;
    margin-bottom: var(--space-2xs);
  }

  .principle-card p {
    font-size: var(--font-size-sm);
    color: var(--color-text-light);
    line-height: 1.5;
  }

  /* Releases Timeline */
  .releases-section {
    margin-bottom: var(--space-3xl);
  }

  .section-title-wrap {
    text-align: center;
    margin-bottom: var(--space-xl);
  }

  .section-title {
    font-size: var(--font-size-2xl);
    font-weight: 800;
    margin-bottom: var(--space-2xs);
  }

  .section-desc {
    font-size: var(--font-size-sm);
    color: var(--color-text-light);
  }

  .timeline-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
  }

  .release-timeline-card {
    padding: var(--space-xl);
    border-radius: var(--border-radius-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-surface-border);
    box-shadow: var(--shadow-sm);
  }

  .release-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--color-surface-border);
  }

  .version-meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .version-tag {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--color-primary);
  }

  .version-date {
    font-size: 0.8rem;
    color: var(--color-text-light);
  }

  .release-summary-text {
    font-size: var(--font-size-base);
    line-height: 1.6;
    margin-bottom: var(--space-lg);
    color: var(--color-text);
  }

  .release-highlights-box {
    background: rgba(46, 204, 113, 0.06);
    border: 1px solid rgba(46, 204, 113, 0.2);
    border-radius: var(--border-radius-md);
    padding: var(--space-md) var(--space-lg);
    margin-bottom: var(--space-xl);
  }

  .release-highlights-box h4 {
    font-size: var(--font-size-sm);
    font-weight: 700;
    color: #2ecc71;
    margin-bottom: var(--space-xs);
  }

  .highlights-list {
    margin: 0;
    padding-left: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 0.88rem;
    line-height: 1.45;
  }

  .release-entries-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: var(--space-md);
  }

  .entry-item {
