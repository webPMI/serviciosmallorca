---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import ProfileForm from "../../components/ProfileForm.astro";
import {
  getLocaleFromUrl,
  loadTranslations,
  getLangPrefix,
} from "../../i18n";

export const prerender = false;

const locale = getLocaleFromUrl(Astro.url);
const translations = await loadTranslations(locale);
---

<BaseLayout title={`${translations["profile.title"]} - ${translations["site.title"]}`} lang={locale}>
  <Navbar 
    currentLocale={locale}
    translations={translations}
    getLangPrefix={getLangPrefix}
  />

  <main class="container section">
    <ProfileForm translations={translations} locale={locale} />
  </main>

  <Footer 
    translations={translations}
    currentLocale={locale}
    getLangPrefix={getLangPrefix}
  />
</BaseLayout>

<style>
  /* Container layout wrapper */
  .section {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-3xl);
  }
</style>
