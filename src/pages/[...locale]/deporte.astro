---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import SportsExplorer from "../../components/SportsExplorer.astro";
import { getLocaleFromUrl, loadTranslations, getLangPrefix, type Locale } from "../../i18n";
import { SPORTS_FACILITIES } from "../../data/sports/facilities";

export const prerender = false;

const locale = getLocaleFromUrl(Astro.url) as Locale;
const translations = await loadTranslations(locale);
const prefix = getLangPrefix(locale);

const pageTitles: Record<Locale, string> = {
  es: "Deporte & Bienestar en Mallorca - Pistas de Pádel, Running, Calistenia y Clubs",
  en: "Sports & Wellbeing in Mallorca - Padel Courts, Running Routes, Gyms & Studios",
  ca: "Esport & Benestar a Mallorca - Pistes de Pàdel, Running, Cal·listènia i Clubs",
  de: "Sport & Wellness auf Mallorca - Padel-Plätze, Laufstrecken, Calisthenics & Yoga",
};

const pageDescriptions: Record<Locale, string> = {
  es: "Guía interactiva de pistas de pádel, parques de calistenia, circuitos de running y centros deportivos de Mallorca con filtro de sombra, agua y mapas oficiales.",
  en: "Interactive guide to padel courts, calisthenics parks, running tracks, and sports centers across Mallorca with shade, water, and official maps.",
  ca: "Guia interactiva de pistes de pàdel, parcs de cal·listènia, circuits de running i centres esportius a Mallorca amb filtres d'ombra i aigua.",
  de: "Interaktiver Guide für Padel-Plätze, Calisthenics-Parks, Laufstrecken und Sportzentren auf Mallorca mit Schatten-, Wasserfiltern und Karten.",
};

const sportsJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ItemList",
      name: pageTitles[locale],
      description: pageDescriptions[locale],
      numberOfItems: SPORTS_FACILITIES.length,
      itemListElement: SPORTS_FACILITIES.map((f, idx) => ({
        "@type": "ListItem",
        position: idx + 1,
        name: f.name,
        description: f.description[locale] || f.description.es,
        item: {
          "@type": "SportsActivityLocation",
          name: f.name,
          address: f.address,
          geo: {
            "@type": "GeoCoordinates",
            latitude: f.coordinates.lat,
            longitude: f.coordinates.lng,
          },
        },
      })),
    },
  ],
};
---

<BaseLayout title={`${pageTitles[locale]} | Servicios Mallorca`} lang={locale} description={pageDescriptions[locale]}>
  <!-- Injected SEO Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(sportsJsonLd)} />

  <Navbar currentLocale={locale} translations={translations} getLangPrefix={getLangPrefix} />

  <main class="container section">
    <!-- Breadcrumbs Navigation -->
    <nav class="breadcrumb-nav" aria-label="Breadcrumb">
      <a href={prefix}>{translations["nav.home"] || "Inicio"}</a>
      <span>/</span>
      <span class="active-crumb"
        >{
          locale === "de"
            ? "Sport & Wellness"
            : locale === "en"
              ? "Sports & Wellbeing"
              : locale === "ca"
                ? "Esport & Benestar"
                : "Deporte & Bienestar"
        }</span
      >
    </nav>

    <!-- Sports Explorer Interactive Component -->
    <SportsExplorer currentLocale={locale} translations={translations} />
  </main>

  <Footer translations={translations} currentLocale={locale} getLangPrefix={getLangPrefix} />
</BaseLayout>

<style>
  .breadcrumb-nav {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-lg);
  }

  .breadcrumb-nav a {
    color: var(--color-primary);
    text-decoration: none;
  }

  .active-crumb {
    color: var(--color-text);
    font-weight: 600;
  }
</style>
