---

<BaseLayout title={c.pageTitle} description={c.pageDesc} lang={locale}>
  <Navbar currentLocale={locale} translations={translations} getLangPrefix={getLangPrefix} />

  <main class="join-page-container container" id="main-content">
    <!-- Hero Section -->
    <header class="join-hero text-center">
      <div class="hero-chip">
        <span class="pulse-dot"></span>
        <span>{c.chip}</span>
      </div>
      <h1 class="join-hero-title">
        {c.heroTitle1}<span class="gradient-text">{c.heroTitle2}</span>
      </h1>
      <p class="join-hero-subtitle">
        {c.heroSubtitle}
      </p>

      <div class="hero-cta-group">
        <a href={`${prefix}servicios`} class="btn btn-accent btn-lg">
          <span>{c.btnSearch}</span>
        </a>
        <a href={`${prefix}cuadro-de-honor`} class="btn btn-secondary btn-lg">
          <span>{c.btnHonor}</span>
        </a>
      </div>
    </header>

    <!-- 3 Steps Section -->
    <section class="steps-section" aria-labelledby="steps-heading">
      <div class="section-header text-center">
        <h2 id="steps-heading" class="section-title">{c.stepsTitle}</h2>
        <p class="section-subtitle">
          {c.stepsSubtitle}
        </p>
      </div>

