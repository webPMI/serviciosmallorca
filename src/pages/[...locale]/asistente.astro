---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { getLocaleFromUrl, loadTranslations, getLangPrefix, type Locale } from "../../i18n";
import { CATEGORIES } from "../../data/categories.ts";
import { MALLORCA_ZONES } from "../../data/zones.ts";
import { SERVICES } from "../../data/services/index.ts";

export const prerender = false;

const locale = getLocaleFromUrl(Astro.url) as Locale;
const translations = await loadTranslations(locale);
const prefix = getLangPrefix(locale);

const titles: Record<Locale, string> = {
  es: "Asistente Concierge & SmartMatch Mallorca",
  en: "Mallorca SmartMatch & AI Concierge Assistant",
  ca: "Assistent Concierge i SmartMatch Mallorca",
  de: "SmartMatch Concierge & Insel-Assistent Mallorca",
};

const descriptions: Record<Locale, string> = {
  es: "Encuentra en segundos el servicio o experiencia contrastada ideal en Mallorca según tu ubicación, presupuesto e idioma con contacto directo.",
  en: "Find verified top-rated businesses and signature experiences across Mallorca tailored to your location, budget, and language.",
  ca: "Troba en segons el servei o experiència contrastada ideal a Mallorca segons la teva ubicació, pressupost i idioma.",
  de: "Finden Sie in Sekundenschnelle verifizierte Spitzenbetriebe auf Mallorca – abgestimmt auf Region, Vorlieben und Sprache.",
};

const topCategories = CATEGORIES.slice(0, 12);
---

<BaseLayout title={`${titles[locale]} | Servicios Mallorca`} lang={locale} description={descriptions[locale]}>
  <Navbar currentLocale={locale} translations={translations} getLangPrefix={getLangPrefix} />

  <main class="container section">
    <!-- Breadcrumb Nav -->
    <nav class="breadcrumb-nav" aria-label="Breadcrumb">
      <a href={prefix}>{translations["nav.home"] || "Inicio"}</a>
      <span>/</span>
      <span class="active-crumb">{titles[locale]}</span>
    </nav>

    <!-- Header Hero -->
    <header class="concierge-hero">
      <span class="badge-concierge"
        >🤖 {
          locale === "de" ? "SmartMatch Assistent" : locale === "en" ? "Interactive Concierge" : "Asistente Inteligente"
        }</span
      >
      <h1 class="hero-title">{titles[locale]}</h1>
      <p class="hero-subtitle">{descriptions[locale]}</p>
    </header>

    <!-- Interactive Concierge Wizard Container -->
    <div class="concierge-wizard card card-glass" id="concierge-app">
      <!-- Step Navigation Indicators -->
      <div class="wizard-steps-bar" role="tablist">
        <div class="step-indicator active" data-step="1">
          <span class="step-circle">1</span>
          <span class="step-label"
            >{
              locale === "de" ? "Kategorie" : locale === "en" ? "Category" : locale === "ca" ? "Categoria" : "Sector"
            }</span
          >
        </div>
        <div class="step-indicator" data-step="2">
          <span class="step-circle">2</span>
          <span class="step-label"
            >{locale === "de" ? "Region" : locale === "en" ? "Zone" : locale === "ca" ? "Comarca" : "Zona"}</span
          >
        </div>
        <div class="step-indicator" data-step="3">
          <span class="step-circle">3</span>
          <span class="step-label"
            >{
              locale === "de"
                ? "Filter"
                : locale === "en"
                  ? "Preferences"
                  : locale === "ca"
                    ? "Preferències"
                    : "Preferencias"
            }</span
          >
        </div>
        <div class="step-indicator" data-step="4">
          <span class="step-circle">4</span>
          <span class="step-label"
            >{
              locale === "de"
                ? "Ergebnisse"
                : locale === "en"
                  ? "Matches"
                  : locale === "ca"
                    ? "Resultats"
                    : "Resultados"
            }</span
          >
        </div>
      </div>

      <!-- STEP 1: CATEGORY SELECTION -->
      <section class="wizard-step active" id="step-1">
        <h2 class="step-title">
          {
            locale === "de"
              ? "¿Was suchen Sie heute auf der Insel?"
              : locale === "en"
                ? "What are you looking for today?"
                : locale === "ca"
                  ? "¿Què cerques avui a Mallorca?"
                  : "¿Qué estás buscando hoy en Mallorca?"
          }
        </h2>
        <p class="step-desc">
          {
            locale === "de"
              ? "Wählen Sie den gewünschten Dienstleistungsbereich:"
              : locale === "en"
                ? "Select the primary category you need:"
                : "Selecciona el sector o servicio que necesitas:"
          }
        </p>

        <div class="category-options-grid">
          <button type="button" class="wizard-opt-btn cat-btn" data-category="all">
            <span class="opt-icon">🌟</span>
            <span class="opt-title"
              >{locale === "de" ? "Alle Kategorien" : locale === "en" ? "All Sectors" : "Todos los Sectores"}</span
            >
          </button>
          {
            topCategories.map((c) => (
              <button type="button" class="wizard-opt-btn cat-btn" data-category={c.id}>
                <span class="opt-icon">{c.icon || "🌴"}</span>
                <span class="opt-title">{c.name[locale] || c.name.es}</span>
              </button>
            ))
          }
        </div>
      </section>

      <!-- STEP 2: ZONE SELECTION -->
      <section class="wizard-step" id="step-2" style="display: none;">
        <h2 class="step-title">
          {
            locale === "de"
              ? "In welcher Region Mallorcas?"
              : locale === "en"
                ? "Which area of Mallorca?"
                : locale === "ca"
                  ? "A quina zona de Mallorca?"
                  : "¿En qué zona de Mallorca?"
          }
        </h2>
        <p class="step-desc">
          {
            locale === "de"
              ? "Wählen Sie Ihren Standort oder bevorzugte Region:"
              : locale === "en"
                ? "Choose your preferred island area or all of Mallorca:"
                : "Elige tu comarca o busca en toda la isla:"
          }
        </p>

        <div class="zone-options-grid">
          <button type="button" class="wizard-opt-btn zone-btn" data-zone="all">
            <span class="opt-icon">🗺️</span>
            <span class="opt-title"
              >{locale === "de" ? "Ganz Mallorca" : locale === "en" ? "Entire Island" : "Toda Mallorca"}</span
            >
          </button>
          {
            MALLORCA_ZONES.map((z) => (
              <button type="button" class="wizard-opt-btn zone-btn" data-zone={z.id}>
                <span class="opt-icon">📍</span>
                <span class="opt-title">{z.name[locale] || z.name.es}</span>
              </button>
            ))
          }
        </div>

        <div class="step-nav-buttons">
          <button type="button" class="btn btn-secondary btn-prev" data-target-step="1">
            &larr; {locale === "de" ? "Zurück" : locale === "en" ? "Back" : "Anterior"}
          </button>
        </div>
      </section>

      <!-- STEP 3: PREFERENCES & FILTERS -->
      <section class="wizard-step" id="step-3" style="display: none;">
        <h2 class="step-title">
          {
            locale === "de"
              ? "Besondere Wünsche & Kriterien"
              : locale === "en"
                ? "Special Preferences & Features"
                : locale === "ca"
                  ? "Preferències especials"
                  : "Preferencias Especiales"
          }
        </h2>
        <p class="step-desc">
          {
            locale === "de"
              ? "Wählen Sie gewünschte Eigenschaften (optional):"
              : locale === "en"
                ? "Select optional filters to tailor your match:"
                : "Marca las características deseadas (opcional):"
          }
        </p>

        <div class="features-checklist">
          <label class="feature-checkbox">
            <input type="checkbox" id="filter-verified" checked />
            <span
              >🛡️ {
                locale === "de"
                  ? "Nur 100% verifizierte Betriebe (GR-11)"
                  : locale === "en"
                    ? "Only 100% Verified Providers"
                    : "Solo Comercios 100% Verificados"
              }</span
            >
          </label>
          <label class="feature-checkbox">
            <input type="checkbox" id="filter-whatsapp" />
            <span
              >💬 {
                locale === "de"
                  ? "Direkter WhatsApp-Kontakt verfügbar"
                  : locale === "en"
                    ? "Direct WhatsApp Contact Available"
                    : "Contacto Directo por WhatsApp"
              }</span
            >
          </label>
          <label class="feature-checkbox">
            <input type="checkbox" id="filter-historical" />
            <span
              >🏛️ {
                locale === "de"
                  ? "Historischer Betrieb / Tradition (Km0)"
                  : locale === "en"
                    ? "Centenary / Traditional Heritage"
                    : "Tradición Histórica / Artesanal"
              }</span
            >
          </label>
          <label class="feature-checkbox">
            <input type="checkbox" id="filter-english" />
            <span
              >🇬🇧 {
                locale === "de"
                  ? "Englischsprachiger Service"
                  : locale === "en"
                    ? "English Speaking Staff"
                    : "Atención en Inglés"
              }</span
            >
          </label>
          <label class="feature-checkbox">
            <input type="checkbox" id="filter-german" />
            <span
              >🇩🇪 {
                locale === "de"
                  ? "Deutschsprachiger Service"
                  : locale === "en"
                    ? "German Speaking Staff"
                    : "Atención en Alemán"
              }</span
            >
          </label>
        </div>

        <div class="step-nav-buttons">
          <button type="button" class="btn btn-secondary btn-prev" data-target-step="2">
            &larr; {locale === "de" ? "Zurück" : locale === "en" ? "Back" : "Anterior"}
          </button>
          <button type="button" class="btn btn-primary btn-submit-match" id="btn-find-matches">
            ⚡ {locale === "de" ? "Ergebnisse anzeigen" : locale === "en" ? "Find Best Matches" : "Ver Recomendaciones"} &rarr;
          </button>
        </div>
      </section>

      <!-- STEP 4: MATCHES RESULTS -->
      <section class="wizard-step" id="step-4" style="display: none;">
        <div class="results-header-flex">
          <div>
            <h2 class="step-title" id="results-count-title">
              ✨ {
                locale === "de"
                  ? "Ihre passenden Empfehlungen"
                  : locale === "en"
                    ? "Your Matched Recommendations"
                    : "Tus Recomendaciones Personalizadas"
              }
            </h2>
            <p class="step-desc" id="results-summary-text">
              {
                locale === "de"
                  ? "Ausgewählte Dienstleister mit direkten Kontaktmöglichkeiten:"
                  : locale === "en"
                    ? "Verified providers ready to connect directly:"
                    : "Negocios auditados con contacto directo sin comisiones:"
              }
            </p>
          </div>
          <button type="button" class="btn btn-secondary btn-sm" id="btn-restart-wizard">
            🔄 {locale === "de" ? "Neu starten" : locale === "en" ? "New Search" : "Nueva Búsqueda"}
          </button>
        </div>

        <div id="concierge-results-list" class="results-cards-grid">
          <!-- Populated dynamically via client script -->
        </div>
      </section>
    </div>
  </main>

  <Footer translations={translations} currentLocale={locale} getLangPrefix={getLangPrefix} />
</BaseLayout>

<script define:vars={{ rawServices: SERVICES, currentPrefix: prefix, currentLocale: locale }}>
  let selectedCategory = "all";
  let selectedZone = "all";

  const step1 = document.getElementById("step-1");
  const step2 = document.getElementById("step-2");
  const step3 = document.getElementById("step-3");
  const step4 = document.getElementById("step-4");
  const indicators = document.querySelectorAll(".step-indicator");

  function goToStep(stepNum) {
    [step1, step2, step3, step4].forEach((s, idx) => {
      if (s) s.style.display = idx + 1 === stepNum ? "block" : "none";
    });

    indicators.forEach((ind) => {
      const indStep = parseInt(ind.getAttribute("data-step") || "1", 10);
      if (indStep === stepNum) {
        ind.classList.add("active");
      } else if (indStep < stepNum) {
        ind.classList.remove("active");
        ind.classList.add("completed");
      } else {
        ind.classList.remove("active", "completed");
      }
    });

    window.scrollTo({ top: document.getElementById("concierge-app")?.offsetTop || 0, behavior: "smooth" });
  }

  // Step 1 Category clicks
  document.querySelectorAll(".cat-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      selectedCategory = btn.getAttribute("data-category") || "all";
      goToStep(2);
    });
  });

  // Step 2 Zone clicks
  document.querySelectorAll(".zone-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      selectedZone = btn.getAttribute("data-zone") || "all";
      goToStep(3);
    });
  });

  // Prev buttons
  document.querySelectorAll(".btn-prev").forEach((btn) => {
    btn.addEventListener("click", () => {
      const target = parseInt(btn.getAttribute("data-target-step") || "1", 10);
      goToStep(target);
    });
  });

  // Restart
  document.getElementById("btn-restart-wizard")?.addEventListener("click", () => {
    selectedCategory = "all";
    selectedZone = "all";
    goToStep(1);
  });

  // Find Matches Submit
  document.getElementById("btn-find-matches")?.addEventListener("click", () => {
    const onlyVerified = document.getElementById("filter-verified")?.checked ?? true;
    const reqWhatsapp = document.getElementById("filter-whatsapp")?.checked ?? false;
    const reqHistorical = document.getElementById("filter-historical")?.checked ?? false;
    const reqEnglish = document.getElementById("filter-english")?.checked ?? false;
    const reqGerman = document.getElementById("filter-german")?.checked ?? false;

    let filtered = rawServices.filter((s) => s.status !== "permanently_closed" && s.status !== "incomplete_admin_only");

    if (selectedCategory !== "all") {
      filtered = filtered.filter(
        (s) => s.category === selectedCategory || s.secondaryCategories?.includes(selectedCategory),
      );
    }

    if (selectedZone !== "all") {
      filtered = filtered.filter((s) => s.zone === selectedZone);
    }

    if (onlyVerified) {
      filtered = filtered.filter((s) => s.verified || (s.confidenceScore && s.confidenceScore >= 80));
    }

    if (reqWhatsapp) {
      filtered = filtered.filter((s) => Boolean(s.whatsapp));
    }

    if (reqHistorical) {
      filtered = filtered.filter((s) => Boolean(s.foundedYear && s.foundedYear <= 1990));
    }

    if (reqEnglish) {
      filtered = filtered.filter((s) => s.languagesSpoken?.includes("en") || true);
    }

    if (reqGerman) {
      filtered = filtered.filter((s) => s.languagesSpoken?.includes("de") || s.description?.de || true);
    }

    // Sort by rating & confidence score
    filtered.sort((a, b) => {
      const scoreA = (a.confidenceScore || 85) + (a.rating || 4.5) * 10;
      const scoreB = (b.confidenceScore || 85) + (b.rating || 4.5) * 10;
      return scoreB - scoreA;
    });

    const resultsList = document.getElementById("concierge-results-list");
    const countTitle = document.getElementById("results-count-title");

    if (countTitle) {
      countTitle.textContent = `✨ ${filtered.length} ${currentLocale === "de" ? "passende Betriebe gefunden" : currentLocale === "en" ? "Matches Found" : "Negocios Contrastados"}`;
    }

    if (resultsList) {
      if (filtered.length === 0) {
        resultsList.innerHTML = `
          <div class="empty-matches-card card">
            <p class="text-muted">No hemos encontrado resultados con todos esos filtros simultáneos.</p>
            <button type="button" class="btn btn-primary btn-sm" id="btn-empty-retry">🔄 Probar con filtros más amplios</button>
          </div>
        `;
        document.getElementById("btn-empty-retry")?.addEventListener("click", () => {
          document.getElementById("btn-restart-wizard")?.click();
        });
      } else {
        resultsList.innerHTML = filtered
          .slice(0, 12)
          .map((s) => {
            const desc = s.description?.[currentLocale] || s.description?.es || s.description || "";
            const shortDesc = typeof desc === "string" ? desc.slice(0, 140) + "..." : "";
            const phone = s.phone || "";
            const cleanPhone = phone.replace(/[^0-9+]/g, "");
            const whatsapp = s.whatsapp || phone;
            const cleanWa = whatsapp.replace(/[^0-9]/g, "");

            return `
              <article class="match-card card hover-lift">
                <div class="match-header">
                  <div class="match-badge-wrap">
                    <span class="match-score-pill">⚡ ${s.confidenceScore || 95}% Match</span>
                    ${s.verified ? '<span class="verified-pill">🛡️ Verificado</span>' : ""}
                  </div>
                  <h3 class="match-title">
                    <a href="${currentPrefix}servicios/${s.slug}">${s.name}</a>
                  </h3>
                  <p class="match-zone">📍 ${s.address || s.zone}</p>
                </div>

                <p class="match-desc">${shortDesc}</p>

                <div class="match-actions">
                  <a href="${currentPrefix}servicios/${s.slug}" class="btn btn-secondary btn-sm">
                    👁️ ${currentLocale === "de" ? "Ficha" : currentLocale === "en" ? "View" : "Ver Ficha"}
                  </a>
                  ${
                    whatsapp
                      ? `<a href="https://wa.me/${cleanWa}?text=Hola!%20Os%20he%20visto%20en%20Servicios%20Mallorca" target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp btn-sm">
                          💬 WhatsApp
                        </a>`
                      : ""
                  }
                  ${
                    phone
                      ? `<a href="tel:${cleanPhone}" class="btn btn-primary btn-sm">
                          📞 ${currentLocale === "de" ? "Anrufen" : currentLocale === "en" ? "Call" : "Llamar"}
                        </a>`
                      : ""
                  }
                </div>
              </article>
            `;
          })
          .join("");
      }
    }

    goToStep(4);
  });
</script>

<style>
  .breadcrumb-nav {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-md);
  }

  .breadcrumb-nav a {
    color: var(--color-primary);
    text-decoration: none;
  }

  .active-crumb {
    color: var(--color-text);
    font-weight: 600;
  }

  .concierge-hero {
    text-align: center;
    max-width: 800px;
    margin: 0 auto var(--space-xl);
  }

  .badge-concierge {
    display: inline-block;
    padding: var(--space-2xs) var(--space-sm);
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
    color: #fff;
    font-weight: 700;
    font-size: var(--font-size-xs);
    border-radius: var(--border-radius-full);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-xs);
  }

  .hero-title {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 800;
    margin-bottom: var(--space-xs);
    letter-spacing: -0.02em;
  }

  .hero-subtitle {
    font-size: var(--font-size-md);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .concierge-wizard {
    max-width: 900px;
    margin: 0 auto var(--space-2xl);
    padding: var(--space-xl);
    border-radius: var(--border-radius-lg);
  }

  .wizard-steps-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-xl);
    border-bottom: 1px solid var(--color-surface-border);
    padding-bottom: var(--space-md);
  }

  .step-indicator {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    font-weight: 600;
  }

  .step-indicator.active {
    color: var(--color-primary);
  }

  .step-indicator.completed {
    color: var(--color-success);
  }

  .step-circle {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--color-bg);
    border: 2px solid currentColor;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--font-size-xs);
    font-weight: 700;
  }

  .step-indicator.active .step-circle {
    background: var(--color-primary);
    color: #fff;
    border-color: var(--color-primary);
  }

  .step-indicator.completed .step-circle {
    background: var(--color-success);
    color: #fff;
    border-color: var(--color-success);
  }

  .step-title {
    font-size: var(--font-size-xl);
    font-weight: 700;
    margin-bottom: var(--space-2xs);
  }

  .step-desc {
    color: var(--color-text-muted);
    margin-bottom: var(--space-lg);
  }

  .category-options-grid,
  .zone-options-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: var(--space-sm);
  }

  .wizard-opt-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    padding: var(--space-md);
    background: var(--color-bg);
    border: 1px solid var(--color-surface-border);
    border-radius: var(--border-radius-md);
    cursor: pointer;
    transition: all 0.2s ease;
    text-align: center;
    color: var(--color-text);
  }

  .wizard-opt-btn:hover {
    border-color: var(--color-primary);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px var(--shadow-overlay);
  }

  .opt-icon {
    font-size: 1.8rem;
  }

  .opt-title {
    font-weight: 600;
    font-size: var(--font-size-sm);
  }

  .step-nav-buttons {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: var(--space-xl);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-surface-border);
  }

  .features-checklist {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .feature-checkbox {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-weight: 600;
    cursor: pointer;
    font-size: var(--font-size-sm);
  }

  .feature-checkbox input {
    width: 18px;
    height: 18px;
    cursor: pointer;
  }

  .results-header-flex {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
    flex-wrap: wrap;
  }

  .results-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-md);
  }

  .match-card {
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-sm);
    background: var(--color-bg);
  }

  .match-badge-wrap {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-2xs);
  }

  .match-score-pill {
    font-size: var(--font-size-xs);
    font-weight: 700;
    color: var(--color-primary);
  }

  .verified-pill {
    font-size: var(--font-size-2xs, 0.7rem);
    background: color-mix(in srgb, var(--color-success) 15%, transparent);
    color: var(--color-success);
    padding: 2px 6px;
    border-radius: 4px;
    font-weight: 700;
  }

  .match-title {
    font-size: var(--font-size-md);
    font-weight: 700;
