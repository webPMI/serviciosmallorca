---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { getLocaleFromUrl, loadTranslations, getLangPrefix, type Locale } from "../../i18n";

export const prerender = false;

const locale = getLocaleFromUrl(Astro.url) as Locale;
const translations = await loadTranslations(locale);
const prefix = getLangPrefix(locale);

const i18nPrivacy = {
  es: {
    pageTitle: "Política de Privacidad y Protección de Datos",
    pageSubtitle:
      "En Servicios Mallorca nos tomamos muy en serio la seguridad y privacidad de tus datos personales conforme al RGPD y la LOPD-GDD.",
    badgeRegulation: "Cumplimiento RGPD & LOPD-GDD",
    badgeUpdated: "Actualizado: Agosto 2026",
    actionTitle: "Gestión de Fichas y Derechos para Titulares",
    actionDesc:
      "Si eres titular o representante legal de un negocio en Mallorca, puedes reclamar la propiedad para personalizarlo, actualizar canales de contacto directo o solicitar la baja sin ningún coste ni fricción.",
    btnClaim: "🏢 Reclamar Negocio",
    btnDelete: "🗑️ Solicitar Baja RGPD",
    ethicalTitle: "Nuestro Compromiso de Privacidad Ética",
    ethicalDesc:
