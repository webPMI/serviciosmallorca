    dataCollectionTitle: "Recogida y Tipología de Datos",
    itemAccount: "Datos de cuenta: Nombre, correo electrónico, fotografía o avatar seleccionado.",
    itemInteraction: "Datos de interacción: Reseñas voluntarias, votos, temas y respuestas publicados en el foro.",
    itemBusiness:
      "Datos de verificación empresarial: CIF, acreditación de titularidad y teléfono de contacto para reclamaciones.",
    adDisclosureTitle: "Publicidad contextual de Google:",
    adDisclosureDesc:
      " Puedes gestionar o deshabilitar la personalización de anuncios en cualquier momento accediendo a la ",
    adLinkText: "Configuración de Anuncios de Google ↗",
    rightsAccess: "✓ Acceso",
    rightsRectification: "✓ Rectificación",
    rightsErasure: "✓ Supresión (Olvido)",
    rightsRestriction: "✓ Limitación",
    rightsPortability: "✓ Portabilidad",
    rightsObjection: "✓ Oposición",
    backHome: "Volver al Inicio",
  },
  en: {
    pageTitle: "Privacy Policy & Data Protection",
    pageSubtitle:
      "At Servicios Mallorca, we take the security and privacy of your personal data very seriously in compliance with GDPR and Spanish data protection laws.",
    badgeRegulation: "GDPR & LOPD-GDD Compliant",
    badgeUpdated: "Updated: August 2026",
    actionTitle: "Listing Management & Rights for Business Owners",
    actionDesc:
      "If you are the owner or legal representative of a local business in Mallorca, you can claim your profile, update direct contact channels, or request complete removal with zero cost or friction.",
    btnClaim: "🏢 Claim Business Profile",
    btnDelete: "🗑️ Request GDPR Erasure",
    ethicalTitle: "Our Ethical Privacy Commitment",
    ethicalDesc:
      "We never sell your personal data or transfer it to aggressive marketing brokers. Our sole purpose is to securely and directly connect the community with local commerce.",
    dataCollectionTitle: "Data Collection & Categories",
    itemAccount: "Account details: Name, email address, profile picture or chosen avatar.",
    itemInteraction: "Community data: Voluntary reviews, ratings, questions, and replies posted in local forums.",
    itemBusiness: "Business verification data: Tax ID (CIF), ownership proof, and contact phone for verified claims.",
    adDisclosureTitle: "Google Contextual Advertising:",
    adDisclosureDesc: " You can customize or disable personalized ad preferences at any time by visiting ",
    adLinkText: "Google Ads Settings ↗",
    rightsAccess: "✓ Access",
    rightsRectification: "✓ Rectification",
    rightsErasure: "✓ Erasure (Right to be Forgotten)",
    rightsRestriction: "✓ Restriction",
    rightsPortability: "✓ Portability",
    rightsObjection: "✓ Objection",
    backHome: "Back to Home",
  },
  ca: {
    pageTitle: "Política de Privadesa i Protecció de Dades",
    pageSubtitle:
      "A Servicios Mallorca ens prenem molt seriosament la seguretat i privadesa de les teves dades personals segons el RGPD i la LOPD-GDD.",
    badgeRegulation: "Compliment RGPD & LOPD-GDD",
    badgeUpdated: "Actualitzat: Agost 2026",
    actionTitle: "Gestió de Fitxes i Drets per a Titulars",
    actionDesc:
      "Si ets titular o representant legal d'un negoci a Mallorca, pots reclamar la propietat per personalitzar-lo, actualitzar canals de contacte directe o sol·licitar la baixa sense cost ni friccions.",
    btnClaim: "🏢 Reclamar Negoci",
    btnDelete: "🗑️ Sol·licitar Baixa RGPD",
    ethicalTitle: "El Nostre Compromís de Privadesa Ètica",
    ethicalDesc:
      "Mai comercialitzam les teves dades personals ni les transferim a xarxes publicitàries invasives. El nostre objectiu és facilitar una connexió segura i directa amb el comerç de Mallorca.",
    dataCollectionTitle: "Recollida i Tipologia de Dades",
    itemAccount: "Dades de compte: Nom, adreça de correu electrònic, fotografia o avatar seleccionat.",
    itemInteraction: "Dades d'interacció: Ressenyes voluntàries, vots, temes i respostes publicades a la comunitat.",
    itemBusiness:
      "Dades de verificació empresarial: CIF, acreditació de titularitat i telèfon de contacte per reclamacions.",
    adDisclosureTitle: "Publicitat contextual de Google:",
    adDisclosureDesc: " Pots gestionar o deshabilitar la personalització d'anuncis en qualsevol moment visitant la ",
    adLinkText: "Configuració d'Anuncis de Google ↗",
    rightsAccess: "✓ Accés",
    rightsRectification: "✓ Rectificació",
    rightsErasure: "✓ Supressió (Dret a l'Oblit)",
    rightsRestriction: "✓ Limitació",
    rightsPortability: "✓ Portabilitat",
    rightsObjection: "✓ Oposició",
    backHome: "Tornar a l'Inici",
  },
  de: {
    pageTitle: "Datenschutzerklärung & Datenschutz",
    pageSubtitle:
      "Bei Servicios Mallorca nehmen wir die Sicherheit und den Schutz Ihrer personenbezogenen Daten gemäß der DSGVO und dem spanischen Datenschutzrecht sehr ernst.",
    badgeRegulation: "DSGVO & LOPD-GDD Konform",
    badgeUpdated: "Aktualisiert: August 2026",
    actionTitle: "Eintragsverwaltung & Rechte für Betriebsinhaber",
    actionDesc:
      "Wenn Sie Inhaber oder gesetzlicher Vertreter eines Unternehmens auf Mallorca sind, können Sie Ihren Eintrag beanspruchen, Direktkontakte aktualisieren oder eine vollständige Löschung beantragen.",
    btnClaim: "🏢 Eintrag beanspruchen",
    btnDelete: "🗑️ DSGVO-Löschung anfordern",
    ethicalTitle: "Unser Versprechen für ethischen Datenschutz",
    ethicalDesc:
      "Wir verkaufen Ihre Daten niemals an Dritte oder aggressive Werbenetzwerke. Unsere Plattform dient ausschließlich dazu, Sie sicher und direkt mit ehrlichen Betrieben auf Mallorca zu verbinden.",
    dataCollectionTitle: "Datenerfassung & Kategorien",
    itemAccount: "Kontodaten: Name, E-Mail-Adresse, Profilfoto oder ausgewählter Avatar.",
    itemInteraction: "Community-Daten: Freiwillige Bewertungen, Abstimmungen und Beiträge im Forum.",
    itemBusiness:
      "Unternehmensprüfung: Steuernummer (CIF), Inhabernachweis und Telefonnummer für beanspruchte Profile.",
    adDisclosureTitle: "Google Kontextwerbung:",
    adDisclosureDesc: " Sie können personalisierte Werbung jederzeit verwalten oder deaktivieren unter ",
    adLinkText: "Google Anzeigeneinstellungen ↗",
    rightsAccess: "✓ Auskunft",
    rightsRectification: "✓ Berichtigung",
    rightsErasure: "✓ Löschung (Recht auf Vergessenwerden)",
    rightsRestriction: "✓ Einschränkung",
    rightsPortability: "✓ Datenübertragbarkeit",
    rightsObjection: "✓ Widerspruch",
    backHome: "Zur Startseite",
  },
};

const t = i18nPrivacy[locale] || i18nPrivacy.es;
---

<BaseLayout
  title={`${t.pageTitle} - ${translations["site.title"] || "Servicios Mallorca"}`}
  lang={locale}
  description={t.pageSubtitle}
>
  <Navbar currentLocale={locale} translations={translations} getLangPrefix={getLangPrefix} />

  <main class="container section">
    <div class="legal-wrapper">
      <!-- Legal Header Hero -->
      <header class="legal-hero card-glass fade-in">
        <div class="legal-badge-row">
          <span class="badge badge-primary">🛡️ {t.badgeRegulation}</span>
          <span class="badge badge-secondary">📅 {t.badgeUpdated}</span>
        </div>
        <h1 class="legal-title">{t.pageTitle}</h1>
        <p class="legal-subtitle">{t.pageSubtitle}</p>
      </header>

      <!-- Quick Action Box: Business Management & ARCO Rights -->
      <section class="card card-glass legal-action-box fade-in">
        <div class="action-box-text">
          <span class="action-box-icon">🤝</span>
          <div>
            <h3>{t.actionTitle}</h3>
            <p>{t.actionDesc}</p>
          </div>
        </div>
        <div class="action-box-buttons">
          <a href={`${prefix}servicios`} class="btn btn-primary btn-sm">
            {t.btnClaim}
          </a>
          <a href={`${prefix}servicios`} class="btn btn-secondary btn-sm">
            {t.btnDelete}
          </a>
        </div>
      </section>

      <!-- Ethical Privacy & Transparency Callout -->
      <section class="card card-glass legal-card positive-privacy-card">
        <div class="section-icon-header">
          <span class="sec-icon">🌿</span>
          <h2>{t.ethicalTitle}</h2>
        </div>
        <p>{t.ethicalDesc}</p>
      </section>

      <!-- Legal Content Sections -->
      <div class="legal-sections-grid">
        <section class="card card-glass legal-card">
          <div class="section-icon-header">
            <span class="sec-icon">📥</span>
            <h2>{t.dataCollectionTitle}</h2>
          </div>
          <p>{translations["legal.privacy.dataCollectionContent"]}</p>
          <ul class="legal-bullet-list">
            <li>
              <strong>{t.itemAccount.split(":")[0]}:</strong>{t.itemAccount.split(":")[1]}
            </li>
            <li>
              <strong>{t.itemInteraction.split(":")[0]}:</strong>{t.itemInteraction.split(":")[1]}
            </li>
            <li>
              <strong>{t.itemBusiness.split(":")[0]}:</strong>{t.itemBusiness.split(":")[1]}
            </li>
          </ul>
        </section>

        <section class="card card-glass legal-card">
          <div class="section-icon-header">
            <span class="sec-icon">🎯</span>
            <h2>{translations["legal.privacy.dataUse"] || "Finalidad del Tratamiento"}</h2>
          </div>
          <p>{translations["legal.privacy.dataUseContent"]}</p>
        </section>

        <section class="card card-glass legal-card">
          <div class="section-icon-header">
            <span class="sec-icon">🤝</span>
            <h2>{translations["legal.privacy.dataSharing"] || "Cesión de Datos a Terceros"}</h2>
          </div>
          <p>{translations["legal.privacy.dataSharingContent"]}</p>
          <div class="adsense-disclosure-note">
            <strong>🌐 {t.adDisclosureTitle}</strong>{t.adDisclosureDesc}
            <a
              href="https://adssettings.google.com/authenticated"
              target="_blank"
              rel="noopener noreferrer"
              class="link-highlight">{t.adLinkText}</a
            >.
          </div>
        </section>

        <section class="card card-glass legal-card">
          <div class="section-icon-header">
            <span class="sec-icon">⚖️</span>
            <h2>{translations["legal.privacy.userRights"] || "Tus Derechos ARCO"}</h2>
          </div>
          <p>{translations["legal.privacy.userRightsContent"]}</p>
          <div class="rights-tags-cloud">
            <span class="right-pill">{t.rightsAccess}</span>
            <span class="right-pill">{t.rightsRectification}</span>
            <span class="right-pill">{t.rightsErasure}</span>
            <span class="right-pill">{t.rightsRestriction}</span>
            <span class="right-pill">{t.rightsPortability}</span>
            <span class="right-pill">{t.rightsObjection}</span>
          </div>
        </section>

        <section class="card card-glass legal-card">
          <div class="section-icon-header">
            <span class="sec-icon">🔐</span>
            <h2>{translations["legal.privacy.security"] || "Seguridad de la Información"}</h2>
          </div>
          <p>{translations["legal.privacy.securityContent"]}</p>
        </section>

        <section class="card card-glass legal-card">
          <div class="section-icon-header">
            <span class="sec-icon">🍪</span>
            <h2>{translations["legal.privacy.cookies"] || "Política de Cookies"}</h2>
          </div>
          <p>{translations["legal.privacy.cookiesContent"]}</p>
        </section>
      </div>

      <!-- Legal Footer Back Link -->
      <footer class="legal-footer-nav">
        <a href={prefix} class="btn btn-secondary">
          ← {t.backHome}
        </a>
      </footer>
    </div>
  </main>

  <Footer currentLocale={locale} translations={translations} getLangPrefix={getLangPrefix} />
</BaseLayout>

<style>
  .legal-wrapper {
    max-width: 920px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .legal-hero {
    padding: var(--space-2xl) var(--space-xl);
    border-radius: var(--border-radius-xl, 1.5rem);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    background: var(--color-surface);
    border: 1px solid var(--color-surface-border);
  }

  .legal-badge-row {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    justify-content: center;
  }

  .legal-title {
    font-size: clamp(2rem, 4vw, var(--font-size-4xl));
    font-weight: 800;
    color: var(--color-text);
    margin: 0;
  }

  .legal-subtitle {
    font-size: var(--font-size-base);
    color: var(--color-text-light);
    max-width: 720px;
    margin: 0;
    line-height: 1.6;
  }

  .legal-action-box {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-lg) var(--space-xl);
    border-radius: var(--border-radius-lg);
    background: linear-gradient(135deg, rgba(234, 88, 12, 0.08) 0%, rgba(255, 215, 0, 0.05) 100%);
    border: 1px solid var(--color-surface-border);
    gap: var(--space-lg);
  }

  .action-box-text {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .action-box-icon {
    font-size: 2.5rem;
    flex-shrink: 0;
  }

  .action-box-text h3 {
    font-size: var(--font-size-base);
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 4px;
  }

  .action-box-text p {
    font-size: var(--font-size-sm);
    color: var(--color-text-light);
    margin: 0;
    line-height: 1.4;
  }

  .action-box-buttons {
    display: flex;
    gap: var(--space-sm);
    flex-shrink: 0;
  }

  .positive-privacy-card {
    border-left: 4px solid #10b981;
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.06) 0%, rgba(16, 185, 129, 0.01) 100%);
  }

  .legal-sections-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .legal-card {
    padding: var(--space-xl);
    border-radius: var(--border-radius-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-surface-border);
  }

  .section-icon-header {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .sec-icon {
    font-size: 1.5rem;
  }

  .section-icon-header h2 {
    font-size: var(--font-size-lg);
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
  }

  .legal-card p {
    font-size: var(--font-size-base);
    color: var(--color-text);
    line-height: 1.65;
    margin: 0 0 var(--space-md);
  }

  .legal-card p:last-child {
    margin-bottom: 0;
  }

  .legal-bullet-list {
    margin: var(--space-md) 0 0;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .legal-bullet-list li {
    font-size: var(--font-size-sm);
    color: var(--color-text);
    line-height: 1.55;
  }

  .adsense-disclosure-note {
    background: rgba(52, 152, 219, 0.06);
    border: 1px solid rgba(52, 152, 219, 0.2);
    border-radius: var(--border-radius-sm);
    padding: var(--space-md);
    margin-top: var(--space-md);
    font-size: var(--font-size-sm);
    line-height: 1.5;
  }

  .link-highlight {
    color: var(--color-primary);
    font-weight: 600;
    text-decoration: underline;
  }

  .rights-tags-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-md);
  }

  .right-pill {
    padding: 6px 12px;
    border-radius: var(--border-radius-full);
    background: var(--color-surface-border);
    font-size: var(--font-size-xs);
    font-weight: 600;
    color: var(--color-text);
  }

  .legal-footer-nav {
    text-align: center;
    margin-top: var(--space-lg);
  }

  @media (max-width: 768px) {
    .legal-action-box {
      flex-direction: column;
      align-items: flex-start;
      padding: var(--space-md);
    }
    .action-box-buttons {
      width: 100%;
      flex-direction: column;
    }
  }
</style>
