---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import EcosystemGuideSection from "../../components/EcosystemGuideSection.astro";
import HonorCategorySection from "../../components/HonorCategorySection.astro";
import HonorCheckoutModal from "../../components/HonorCheckoutModal.astro";
import { getLocaleFromUrl, loadTranslations, getLangPrefix, type Locale } from "../../i18n";
import { HONOR_LISTS, getDefaultHonorSpots } from "../../lib/honorBoardEngine";

export const prerender = false;

const locale = getLocaleFromUrl(Astro.url) as Locale;
const translations = await loadTranslations(locale);
const prefix = getLangPrefix(locale);

const defaultSpots = getDefaultHonorSpots();

// JSON-LD Structured Data for SEO (ItemList + HowTo)
const honorJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ItemList",
      name: "Cuadro de Honor Balear & Comercios de Élite en Mallorca",
      description: "Listado verificado y meritocrático de los negocios más reconocidos de Mallorca.",
      numberOfItems: HONOR_LISTS.length,
      itemListElement: HONOR_LISTS.map((cat, idx) => ({
        "@type": "ListItem",
        position: idx + 1,
        name: cat.title[locale] || cat.title.es,
        description: cat.subtitle[locale] || cat.subtitle.es,
      })),
    },
    {
      "@type": "HowTo",
      name: "¿Cómo posicionar o impulsar un negocio en el Cuadro de Honor?",
      description: "Guía paso a paso para respaldar a un comercio de Mallorca con auditoría oficial.",
      step: [
        {
          "@type": "HowToStep",
          name: "Selecciona el comercio verificado",
          text: "Elige un negocio de Mallorca con índice de confianza garantizado (≥ 80%) y auditoría oficial.",
        },
        {
          "@type": "HowToStep",
          name: "Elige la modalidad de apoyo",
          text: "Participa con Impulso Popular (desde 1€) o Puja Oficial de Titular (+1€).",
        },
        {
          "@type": "HowToStep",
          name: "Facturación y Visibilidad Inmediata",
          text: "Recibe tu factura oficial con 21% de IVA y visibilidad en tiempo real en el cuadro de honor.",
        },
      ],
    },
  ],
};
---

<BaseLayout
  title={`${translations["honor.title"] || "Cuadro de Honor & Reconocimiento Comunitario"} - ${translations["site.title"] || "Servicios Mallorca"}`}
  lang={locale}
  description={translations["honor.subtitle"] ||
    "Mercado de Autoridad y Cuadro de Honor: descubre y patrocina a los mejores profesionales y comercios de Mallorca a simple vista."}
>
  <!-- Injected SEO Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(honorJsonLd)} />

  <Navbar currentLocale={locale} translations={translations} getLangPrefix={getLangPrefix} />

  <main class="honor-container">
    <!-- Payment Return Status Banner (Cancel / Success Feedback) -->
    <div id="payment-status-banner" class="payment-alert-banner" style="display: none;" role="status">
      <div class="alert-banner-content">
        <span id="payment-status-icon" class="alert-icon">ℹ️</span>
        <div class="alert-text-block">
          <strong id="payment-status-title" class="alert-title">Estado de la Transacción</strong>
          <p id="payment-status-desc" class="alert-desc"></p>
        </div>
      </div>
      <button type="button" id="close-payment-banner-btn" class="alert-close-btn" aria-label="Cerrar notificación"
        >×</button
      >
    </div>

    <!-- Hero Section -->
    <header class="honor-hero card card-glass">
      <div class="hero-badge">
        <span class="badge badge-accent">{translations["honor.badge"] || "👑 Cuadro de Honor Balear"}</span>
        <span class="badge badge-primary"
          >{translations["honor.auctions"] || "💎 Subastas de Reconocimiento (+1€)"}</span
        >
      </div>
      <h1 class="hero-title">{translations["honor.title"] || "Puestos de Honor & Prestigio de Mallorca"}</h1>
      <p class="hero-subtitle">
        {
          translations["honor.subtitle"] ||
            "Un espacio transparente y meritocrático donde vecinos, clientes y gremios impulsan a sus referentes favoritos a simple vista."
        }
      </p>

      <div class="hero-actions">
        <a href="#listas" class="btn btn-primary">
          <span>{translations["honor.exploreLists"] || "🏆 Explorar Todos los Gremios"}</span>
        </a>
        <a href="#guia-ecosistema" class="btn btn-secondary">
          <span>{translations["honor.howItWorks"] || "🌐 ¿Cómo Funciona la Plataforma?"}</span>
        </a>
      </div>
    </header>

    <!-- Ethical Guarantee Notice -->
    <section class="trust-guarantee-banner card">
      <div class="guarantee-icon">🛡️</div>
      <div class="guarantee-content">
        <h3>{translations["honor.guaranteeTitle"] || "Garantía Ética de Calidad"}</h3>
        <p>
          {
            translations["honor.guaranteeDesc"] ||
              "A diferencia de la publicidad tradicional, en Servicios Mallorca no se puede comprar visibilidad para negocios mediocres o falsos. Todos los puestos exigen verificación real y contrastada en la isla."
          }
        </p>
      </div>
    </section>

    <!-- Categories Full Grid & Quick Jump -->
    <section id="listas" class="honor-section">
      <div class="section-header">
        <h2 class="section-title">
          {translations["honor.activeListsTitle"] || "Gremios y Líderes de Mallorca a Simple Vista"}
        </h2>
        <p class="section-desc">
          {
            translations["honor.activeListsDesc"] ||
              "Descubre todos los líderes de cada categoría o pulsa un acceso rápido para desplazarte inmediatamente a su sección."
          }
        </p>
      </div>

      <!-- Quick Jump Navigation Bar -->
      <nav
        class="quick-jump-wrapper"
        aria-label={locale === "de"
          ? "Schnellnavigation nach Gilde"
          : locale === "ca"
            ? "Accés ràpid per gremi"
            : locale === "en"
              ? "Quick jump by guild"
              : "Acceso rápido por gremio"}
      >
        <div class="quick-jump-bar" id="honor-quick-jump">
          {
            HONOR_LISTS.map((cat) => (
              <a href={`#gremio-${cat.id}`} class="quick-jump-pill">
                <span class="pill-icon">{cat.icon}</span>
                <span class="pill-label">{cat.title[locale] || cat.title.es}</span>
              </a>
            ))
          }
        </div>
      </nav>

      <!-- Modular Guild Sections -->
      <div class="honor-lists-content">
        {
          HONOR_LISTS.map((cat) => (
            <HonorCategorySection
              category={cat}
              spots={defaultSpots[cat.id] || []}
              locale={locale}
              prefix={prefix}
              translations={translations}
            />
          ))
        }
      </div>
    </section>

    <!-- Ecosystem Guide & Platform Explanation (SEO Anchor) -->
    <div id="guia-ecosistema">
      <EcosystemGuideSection currentLocale={locale} translations={translations} />
    </div>
  </main>

  <HonorCheckoutModal locale={locale} translations={translations} />
  <Footer translations={translations} currentLocale={locale} getLangPrefix={getLangPrefix} />
</BaseLayout>

<script>
  // Open Honor Checkout Modal on Click with full metadata
  const openButtons = document.querySelectorAll(".open-nominate-modal");
  openButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const catId = btn.getAttribute("data-cat-id") || "elite-general";
      const serviceId = btn.getAttribute("data-service-id") || "";
      const serviceSlug = btn.getAttribute("data-service-slug") || "";
      const serviceName = btn.getAttribute("data-service-name") || "";
      const nextPrice = Number(btn.getAttribute("data-next-price") || "1.00");
      const mode = btn.getAttribute("data-mode") || "community_boost";

      window.dispatchEvent(
        new CustomEvent("open-honor-checkout", {
          detail: {
            catId,
            category: catId,
            serviceId,
            serviceSlug,
            serviceName: serviceName || "",
            minBid: nextPrice,
            mode,
          },
        }),
      );
    });
  });

  // Auto-reopen modal if returning from login / auth redirect with intent
  const params = new URLSearchParams(window.location.search);

  // Payment Status Banner Handler (Cancel / Success)
  const paymentStatus = params.get("payment");
  const banner = document.getElementById("payment-status-banner");
  const bannerIcon = document.getElementById("payment-status-icon");
  const bannerTitle = document.getElementById("payment-status-title");
  const bannerDesc = document.getElementById("payment-status-desc");
  const bannerClose = document.getElementById("close-payment-banner-btn");

  if (paymentStatus && banner) {
    if (paymentStatus === "cancelled") {
      banner.className = "payment-alert-banner banner-warning";
      if (bannerIcon) bannerIcon.textContent = "ℹ️";
      if (bannerTitle) bannerTitle.textContent = "Proceso de Pago Cancelado";
      if (bannerDesc) {
        bannerDesc.textContent =
          "No se ha realizado ningún cobro en tu tarjeta ni cuenta bancaria. Si deseas impulsar o posicionar tu comercio más adelante, puedes seleccionar el negocio en cualquier momento.";
      }
      banner.style.display = "flex";

      // Sincronizar en el perfil del usuario como transacción cancelada sin coste (0,00€)
      try {
        const draftStr =
          localStorage.getItem("sm_pending_checkout_draft") || sessionStorage.getItem("sm_pending_checkout_draft");
        let slug = "";
        if (draftStr) {
          try {
            const d = JSON.parse(draftStr);
            slug = d.serviceSlug || d.serviceName || "";
          } catch {}
        }
        const cancelledRecord = {
          serviceSlug: slug || "Aportación en Pasarela",
          at: new Date().toISOString(),
          reason: "Cancelado por el usuario en pasarela bancaria Stripe (0,00 €)",
        };

        const authData = localStorage.getItem("sm_auth_state");
        let uid: string | null = null;
        if (authData) {
          try {
            const parsedAuth = JSON.parse(authData);
            uid = parsedAuth?.user?.uid || null;
          } catch {}
        }
        const cancelledKey = uid ? `sm_user_${uid}_cancelled_transactions` : "sm_cancelled_transactions_guest";
        const existing = JSON.parse(localStorage.getItem(cancelledKey) || "[]");
        existing.unshift(cancelledRecord);
        localStorage.setItem(cancelledKey, JSON.stringify(existing.slice(0, 25)));
      } catch (err) {
        console.warn("Could not save cancelled transaction:", err);
      }
    } else if (paymentStatus === "success") {
      banner.className = "payment-alert-banner banner-success";
      if (bannerIcon) bannerIcon.textContent = "🎉";
      if (bannerTitle) bannerTitle.textContent = "¡Aportación Confirmada con Éxito!";
      if (bannerDesc) {
        bannerDesc.textContent =
          "Tu transacción ha sido validada por la pasarela bancaria. El comercio cuenta ahora con visibilidad prioritaria en el Cuadro de Honor e indexación oficial para motores de IA.";
      }
      banner.style.display = "flex";
    }

    bannerClose?.addEventListener("click", () => {
      banner.style.display = "none";
    });

    // Limpiar query params de la barra de direcciones para evitar repeticiones al recargar
    try {
      const cleanUrl = window.location.pathname;
      window.history.replaceState({}, document.title, cleanUrl);
    } catch {}
  }

  if (params.get("intent") === "boost" || params.get("openCheckout") === "1" || params.get("resumeDraft") === "1") {
    let serviceName = params.get("serviceName") || "";
    let minBid = Number(params.get("amount") || params.get("minBid") || "1.00");
    let serviceId = params.get("serviceId") || "";
    let serviceSlug = params.get("serviceSlug") || "";
    let mode = params.get("mode") || "community_boost";
    let catId = params.get("catId") || params.get("category") || "elite-general";
    let backerName = "";
    let backerEmail = "";
    let backerMessage = "";
    let isB2B = false;
    let b2bTaxId = "";
    let b2bLegalName = "";
    let b2bAddress = "";
    let resumed = false;

    // Recuperar datos completos del borrador si volvemos de login/registro o desde el perfil
    if (params.get("resumeDraft") === "1" || (!serviceId && !serviceName)) {
      try {
        const draftStr =
          localStorage.getItem("sm_pending_checkout_draft") || sessionStorage.getItem("sm_pending_checkout_draft");
        if (draftStr) {
          const draft = JSON.parse(draftStr);
          if (draft) {
            resumed = true;
            if (draft.serviceName) serviceName = draft.serviceName;
            if (draft.serviceId) serviceId = draft.serviceId;
            if (draft.serviceSlug) serviceSlug = draft.serviceSlug;
            if (draft.amount) minBid = Number(draft.amount);
            if (draft.mode) mode = draft.mode;
            if (draft.catId) catId = draft.catId;
            if (draft.backerName) backerName = draft.backerName;
            if (draft.backerEmail) backerEmail = draft.backerEmail;
            if (draft.backerMessage) backerMessage = draft.backerMessage;
            if (draft.isB2B) isB2B = Boolean(draft.isB2B);
            if (draft.b2bTaxId) b2bTaxId = draft.b2bTaxId;
            if (draft.b2bLegalName) b2bLegalName = draft.b2bLegalName;
            if (draft.b2bAddress) b2bAddress = draft.b2bAddress;
          }
        }
      } catch (err) {
        console.warn("Could not parse draft:", err);
      }
    }

    setTimeout(() => {
      window.dispatchEvent(
        new CustomEvent("open-honor-checkout", {
          detail: {
            catId,
            category: catId,
            serviceId,
            serviceSlug,
            serviceName,
            minBid,
            mode,
            backerName,
            backerEmail,
            backerMessage,
            isB2B,
            b2bTaxId,
            b2bLegalName,
            b2bAddress,
            resumed,
          },
        }),
      );
    }, 200);
  }
</script>

<style>
  /* Payment Alert Banner (GR-01, GR-02) */
  .payment-alert-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding: var(--space-md) var(--space-lg);
    border-radius: var(--border-radius-md, 12px);
    margin-bottom: var(--space-lg);
    box-shadow: var(--shadow-sm);
    animation: fadeIn 0.3s ease-out;
  }

  .banner-warning {
    background: var(--color-warning-bg, rgba(234, 179, 8, 0.12));
    border: 1px solid var(--color-warning, #eab308);
    color: var(--color-text);
  }

  .banner-success {
    background: var(--color-success-bg, rgba(34, 197, 94, 0.12));
    border: 1px solid var(--color-success, #22c55e);
    color: var(--color-text);
  }

  .alert-banner-content {
    display: flex;
    align-items: flex-start;
    gap: var(--space-md);
    flex: 1;
  }

  .alert-icon {
    font-size: 1.5rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .alert-text-block {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .alert-title {
    font-size: 0.95rem;
    font-weight: 800;
  }

  .alert-desc {
    font-size: 0.82rem;
    margin: 0;
    line-height: 1.4;
    color: var(--color-text-muted);
  }

  .alert-close-btn {
    background: transparent;
    border: none;
    font-size: 1.3rem;
    line-height: 1;
    cursor: pointer;
    color: var(--color-text-muted);
    padding: 4px 8px;
    border-radius: var(--border-radius-sm);
    transition: color var(--transition-fast);
  }

  .alert-close-btn:hover {
    color: var(--color-text);
  }

  .honor-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-xl) var(--space-md) var(--space-3xl);
    box-sizing: border-box;
    min-width: 0;
  }

  /* Hero Section */
  .honor-hero {
    text-align: center;
    padding: clamp(var(--space-lg), 4vw, var(--space-2xl)) clamp(var(--space-md), 3vw, var(--space-xl));
    margin-bottom: var(--space-xl);
    border-radius: var(--border-radius-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-surface-border);
    box-shadow: var(--shadow-md);
    width: 100%;
    box-sizing: border-box;
    min-width: 0;
  }

  .hero-badge {
    display: flex;
    justify-content: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
    flex-wrap: wrap;
  }

  .hero-title {
    font-size: clamp(1.4rem, 4vw, var(--font-size-4xl));
    font-weight: 900;
    color: var(--color-text);
    margin-bottom: var(--space-sm);
    letter-spacing: -0.02em;
    line-height: 1.2;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  .hero-subtitle {
    font-size: var(--font-size-base);
    color: var(--color-text-light);
    max-width: 800px;
    margin: 0 auto var(--space-lg);
    line-height: 1.6;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    gap: var(--space-md);
    flex-wrap: wrap;
    width: 100%;
  }

  .hero-actions .btn {
    white-space: normal;
    word-break: break-word;
    text-align: center;
    line-height: 1.3;
  }

  /* Ethical Guarantee Banner */
  .trust-guarantee-banner {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    padding: var(--space-lg);
    margin-bottom: var(--space-2xl);
    border-left: 4px solid var(--color-accent);
    background: var(--color-surface);
    border-radius: var(--border-radius-md);
    width: 100%;
    box-sizing: border-box;
    min-width: 0;
  }

  .guarantee-icon {
    font-size: 2.5rem;
    flex-shrink: 0;
  }

  .guarantee-content {
    flex: 1;
    min-width: 0;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  .guarantee-content h3 {
    font-size: var(--font-size-lg);
    font-weight: 700;
    margin-bottom: var(--space-2xs);
    word-break: break-word;
    overflow-wrap: break-word;
  }

  .guarantee-content p {
    font-size: var(--font-size-sm);
    color: var(--color-text-light);
    line-height: 1.5;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  /* Section Headers */
  .section-header {
    text-align: center;
    margin-bottom: var(--space-xl);
    width: 100%;
    min-width: 0;
  }

  .section-title {
    font-size: clamp(1.3rem, 3vw, var(--font-size-2xl));
    font-weight: 800;
    margin-bottom: var(--space-2xs);
    word-break: break-word;
    overflow-wrap: break-word;
  }

  .section-desc {
    font-size: var(--font-size-sm);
    color: var(--color-text-light);
    max-width: 700px;
    margin: 0 auto;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  /* Quick Jump Navigation Bar (Pills) */
  .quick-jump-wrapper {
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    padding: 4px 2px var(--space-md);
    margin-bottom: var(--space-2xl);
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    box-sizing: border-box;
  }

  .quick-jump-wrapper::-webkit-scrollbar {
    height: 6px;
  }

  .quick-jump-wrapper::-webkit-scrollbar-thumb {
    background: rgba(255, 215, 0, 0.3);
    border-radius: 4px;
  }

  .quick-jump-bar {
    display: flex;
    gap: var(--space-xs);
    justify-content: flex-start;
    min-width: max-content;
    padding: 2px;
  }

  .quick-jump-pill {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0.5rem 0.9rem;
    background: var(--color-surface);
    border: 1px solid var(--color-surface-border);
    border-radius: var(--border-radius-full);
    font-weight: 600;
    font-size: 0.84rem;
    color: var(--color-text);
    text-decoration: none;
    transition: all 0.2s ease;
    white-space: nowrap;
    user-select: none;
    flex-shrink: 0;
  }

  .quick-jump-pill:hover {
    border-color: var(--color-primary);
    transform: translateY(-2px);
    background: var(--color-surface-hover);
    color: var(--color-primary);
  }

  .pill-icon {
    font-size: 1.05rem;
  }

  .honor-lists-content {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-width: 0;
  }

  /* Responsive Media Queries */
  @media (max-width: 1024px) {
    .honor-container {
      padding: var(--space-lg) var(--space-sm) var(--space-2xl);
    }
  }

  @media (max-width: 640px) {
    .honor-container {
      overflow-x: hidden;
      padding: var(--space-md) var(--space-xs) var(--space-xl);
    }
    .trust-guarantee-banner {
      flex-direction: column;
      text-align: center;
      gap: var(--space-sm);
      padding: var(--space-md);
    }
    .hero-actions {
      flex-direction: column;
      width: 100%;
    }
    .hero-actions .btn {
      width: 100%;
      justify-content: center;
    }
  }

  @media (max-width: 480px) {
    .honor-hero {
      padding: var(--space-lg) var(--space-sm);
    }
    .hero-title {
      font-size: 1.5rem;
    }
  }
</style>
