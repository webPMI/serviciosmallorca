---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { getLocaleFromUrl, loadTranslations, getLangPrefix, type Locale } from "../../i18n";
import { HONOR_LISTS, getDefaultHonorSpots, calculateNextBidPrice } from "../../lib/honorBoardEngine";
import HonorCheckoutModal from "../../components/HonorCheckoutModal.astro";

export const prerender = false;

const locale = getLocaleFromUrl(Astro.url) as Locale;
const translations = await loadTranslations(locale);
const prefix = getLangPrefix(locale);

const defaultSpots = getDefaultHonorSpots();
---

<BaseLayout
  title={`${translations["honor.title"] || "Cuadro de Honor & Reconocimiento Comunitario"} - ${translations["site.title"] || "Servicios Mallorca"}`}
  lang={locale}
  description={translations["honor.subtitle"] ||
    "Mercado de Autoridad y Cuadro de Honor: reconoce y patrocina a los mejores profesionales de Mallorca."}
>
  <Navbar currentLocale={locale} translations={translations} getLangPrefix={getLangPrefix} />

  <main class="honor-container">
    <!-- Hero Section -->
    <header class="honor-hero card card-glass">
      <div class="hero-badge">
        <span class="badge badge-accent">{translations["honor.badge"] || "👑 Cuadro de Honor Balear"}</span>
        <span class="badge badge-primary"
          >{translations["honor.auctions"] || "💎 Subastas de Reconocimiento (+1€)"}</span
        >
      </div>
      <h1 class="hero-title">{translations["honor.title"] || "Puestos de Honor & Prestigio de Mallorca"}</h1>
      <p class="hero-subtitle">
        {
          translations["honor.subtitle"] ||
            "Un espacio transparente y meritocrático donde vecinos, clientes y gremios impulsan a sus referentes favoritos."
        }
      </p>

      <div class="hero-actions">
        <a href="#listas" class="btn btn-primary">
          <span>{translations["honor.exploreLists"] || "🏆 Explorar Listas de Honor"}</span>
        </a>
        <a href={`${prefix}comunidad`} class="btn btn-secondary">
          <span>{translations["honor.communityWall"] || "💬 Muro Comunitario & Rutas"}</span>
        </a>
      </div>
    </header>

    <!-- Ethical Guarantee Notice -->
    <section class="trust-guarantee-banner card">
      <div class="guarantee-icon">🛡️</div>
      <div class="guarantee-content">
        <h3>{translations["honor.guaranteeTitle"] || "Garantía Ética de Calidad"}</h3>
        <p>
          {
            translations["honor.guaranteeDesc"] ||
              "A diferencia de la publicidad tradicional, en Servicios Mallorca no se puede comprar visibilidad para negocios mediocres o falsos."
          }
        </p>
      </div>
    </section>

    <!-- Categories Tabs & Grid -->
    <section id="listas" class="honor-section">
      <div class="section-header">
        <h2 class="section-title">{translations["honor.activeListsTitle"] || "Listas de Reconocimiento Activas"}</h2>
        <p class="section-desc">
          {
            translations["honor.activeListsDesc"] ||
              "Selecciona una categoría gremial para ver los líderes actuales o nominar a tu negocio preferido."
          }
        </p>
      </div>

      <!-- Categories Navigation -->
      <div class="category-tabs-wrapper">
        <div class="category-tabs" id="honor-category-tabs">
          {
            HONOR_LISTS.map((cat, idx) => (
              <button class={`tab-btn ${idx === 0 ? "active" : ""}`} data-cat-id={cat.id}>
                <span class="tab-icon">{cat.icon}</span>
                <span class="tab-label">{cat.title[locale] || cat.title.es}</span>
              </button>
            ))
          }
        </div>
      </div>

      <!-- Lists Content Display -->
      <div class="honor-lists-content">
        {
          HONOR_LISTS.map((cat, idx) => {
            const spots = defaultSpots[cat.id] || [];
            const topBid = spots.length > 0 ? spots[0].currentBidEuros : 0;
            const nextPrice = calculateNextBidPrice(topBid, cat.bidIncrementEuros);

            return (
              <div id={`panel-${cat.id}`} class={`honor-panel ${idx === 0 ? "active" : ""}`} data-cat-id={cat.id}>
                <div class="panel-header card card-glass">
                  <div class="panel-info">
                    <span class="panel-icon">{cat.icon}</span>
                    <div>
                      <h3 class="panel-title">{cat.title[locale] || cat.title.es}</h3>
                      <p class="panel-subtitle">{cat.subtitle[locale] || cat.subtitle.es}</p>
                    </div>
                  </div>
                  <div class="panel-bid-info">
                    <div class="price-chip">
                      <span class="price-label">{translations["honor.topCurrent"] || "Puesto #1 Actual:"}</span>
                      <span class="price-val">
                        {topBid > 0 ? `${topBid.toFixed(2)}€` : translations["honor.free"] || "Libre"}
                      </span>
                    </div>
                    <div class="panel-actions-group">
                      <button
                        class="btn btn-accent btn-sm open-nominate-modal"
                        data-cat-id={cat.id}
                        data-cat-title={cat.title[locale] || cat.title.es}
                        data-next-price={nextPrice}
                        data-mode="owner_bid"
                      >
                        {(translations["honor.positionMyBiz"] || "👑 Posicionar mi Negocio ({price}€)").replace(
                          "{price}",
                          nextPrice.toFixed(2),
                        )}
                      </button>
                      <button
                        class="btn btn-secondary btn-sm open-nominate-modal"
                        data-cat-id={cat.id}
                        data-cat-title={cat.title[locale] || cat.title.es}
                        data-next-price="1.00"
                        data-mode="community_boost"
                      >
                        {translations["honor.popularBoost"] || "❤️ Impulso Popular (desde 1€)"}
                      </button>
                    </div>
                  </div>
                </div>

                {spots.length > 0 ? (
                  <div class="spots-grid">
                    {spots.map((spot) => (
                      <article
                        class={`spot-card card ${spot.position === 1 ? "spot-diamond" : spot.position === 2 ? "spot-gold" : "spot-silver"}`}
                      >
                        <div class="spot-rank-badge">
                          {spot.position === 1
                            ? translations["honor.diamond"] || "💎 #1 Diamante"
                            : spot.position === 2
                              ? translations["honor.gold"] || "🥇 #2 Oro"
                              : translations["honor.silver"] || "🥈 #3 Plata"}
                        </div>

                        <div class="spot-card-body">
                          {spot.avatarImage && (
                            <div class="spot-avatar">
                              <img src={spot.avatarImage} alt={spot.serviceName} loading="lazy" />
                            </div>
                          )}

                          <div class="spot-details">
                            <h4 class="spot-business-name">
                              <a href={`${prefix}servicios/${spot.serviceSlug}`}>{spot.serviceName}</a>
                            </h4>
                            <p class="spot-honor-title">"{spot.honorTitle[locale] || spot.honorTitle.es}"</p>

                            <div class="spot-meta">
                              <span class="meta-tag">📍 {spot.zone}</span>
                              <span class="meta-tag trust-tag">
                                🛡️ {spot.confidenceScore}% {translations["honor.confidence"] || "Confianza"}
                              </span>
                              <span class="meta-tag bid-tag">💰 {spot.currentBidEuros.toFixed(2)}€</span>
                            </div>

                            {spot.sponsorMessage && (
                              <blockquote class="spot-quote">
                                "{spot.sponsorMessage}"
                                <cite>
                                  — {translations["honor.sponsoredBy"] || "Patrocinado por"} {spot.sponsorName}
                                </cite>
                              </blockquote>
                            )}
                          </div>
                        </div>

                        <div class="spot-card-footer">
                          <a href={`${prefix}servicios/${spot.serviceSlug}`} class="btn btn-secondary btn-sm">
                            {translations["honor.viewDetails"] || "Ver Ficha Completa"}
                          </a>
                          <button
                            class="btn btn-primary btn-sm open-nominate-modal"
                            data-cat-id={cat.id}
                            data-cat-title={cat.title[locale] || cat.title.es}
                            data-service-id={spot.serviceId}
                            data-service-slug={spot.serviceSlug}
                            data-service-name={spot.serviceName}
                            data-next-price={calculateNextBidPrice(spot.currentBidEuros)}
                            data-mode="owner_bid"
                          >
                            {(translations["honor.outbid"] || "Superar con {price}€").replace(
                              "{price}",
                              (spot.currentBidEuros + 1).toFixed(2),
                            )}
                          </button>
                        </div>
                      </article>
                    ))}
                  </div>
                ) : (
                  <div class="empty-spots card">
                    <div class="empty-icon">🌟</div>
                    <h4>{translations["honor.emptyTitle"] || "¡Sé el primero en liderar este podio!"}</h4>
                    <p>
                      {translations["honor.emptyDesc"] ||
                        "Aún no hay candidaturas en esta lista. Con solo 1.00€ puedes colocar a tu negocio o profesional favorito en el puesto #1."}
                    </p>
                    <div class="empty-actions">
                      <button
                        class="btn btn-primary open-nominate-modal"
                        data-cat-id={cat.id}
                        data-cat-title={cat.title[locale] || cat.title.es}
                        data-next-price="1.00"
                        data-mode="owner_bid"
                      >
                        {translations["honor.inaugurate"] || "🏆 Inaugurar Puesto #1 por 1.00€"}
                      </button>
                    </div>
                  </div>
                )}
              </div>
            );
          })
        }
      </div>
    </section>
  </main>

  <HonorCheckoutModal locale={locale} translations={translations} />
  <Footer translations={translations} currentLocale={locale} getLangPrefix={getLangPrefix} />
</BaseLayout>

<script>
  // Interactive Tabs Logic
  const tabButtons = document.querySelectorAll(".tab-btn");
  const panels = document.querySelectorAll(".honor-panel");

  tabButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const catId = btn.getAttribute("data-cat-id");

      tabButtons.forEach((b) => b.classList.remove("active"));
      panels.forEach((p) => p.classList.remove("active"));

      btn.classList.add("active");
      const targetPanel = document.getElementById(`panel-${catId}`);
      if (targetPanel) {
        targetPanel.classList.add("active");
      }
    });
  });

  // Open Honor Checkout Modal on Click with full metadata
  const openButtons = document.querySelectorAll(".open-nominate-modal");
  openButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const catId = btn.getAttribute("data-cat-id") || "elite-general";
      const catTitle = btn.getAttribute("data-cat-title") || "Cuadro de Honor";
      const serviceId = btn.getAttribute("data-service-id") || "";
      const serviceSlug = btn.getAttribute("data-service-slug") || "";
      const serviceName = btn.getAttribute("data-service-name") || "";
      const nextPrice = Number(btn.getAttribute("data-next-price") || "1.00");
      const mode = btn.getAttribute("data-mode") || "community_boost";

      window.dispatchEvent(
        new CustomEvent("open-honor-checkout", {
          detail: {
            category: catId,
            serviceId,
            serviceSlug,
            serviceName: serviceName || `Comercio en ${catTitle}`,
            minBid: nextPrice,
            mode,
          },
        }),
      );
    });
  });

  // Auto-reopen modal if returning from login / auth redirect with intent
  const params = new URLSearchParams(window.location.search);
  if (params.get("intent") === "boost" || params.get("openCheckout") === "1") {
    const serviceName = params.get("serviceName") || "Referente de Cuadro de Honor";
    const minBid = Number(params.get("amount") || params.get("minBid") || "1.00");
    const serviceId = params.get("serviceId") || "";
    const serviceSlug = params.get("serviceSlug") || "";
    const mode = params.get("mode") || "community_boost";

    setTimeout(() => {
      window.dispatchEvent(
        new CustomEvent("open-honor-checkout", {
          detail: {
            serviceId,
            serviceSlug,
            serviceName,
            minBid,
            mode,
          },
        }),
      );
    }, 150);
  }
</script>

<style>
  .honor-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-xl) var(--space-md) var(--space-3xl);
    box-sizing: border-box;
    min-width: 0;
  }

  /* Hero Section */
  .honor-hero {
    text-align: center;
    padding: clamp(var(--space-lg), 4vw, var(--space-2xl)) clamp(var(--space-md), 3vw, var(--space-xl));
    margin-bottom: var(--space-xl);
    border-radius: var(--border-radius-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-surface-border);
    box-shadow: var(--shadow-md);
    width: 100%;
    box-sizing: border-box;
    min-width: 0;
  }

  .hero-badge {
    display: flex;
    justify-content: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
    flex-wrap: wrap;
  }

  .hero-title {
    font-size: clamp(1.4rem, 4vw, var(--font-size-4xl));
    font-weight: 900;
    color: var(--color-text);
    margin-bottom: var(--space-sm);
    letter-spacing: -0.02em;
    line-height: 1.2;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  .hero-subtitle {
    font-size: var(--font-size-base);
    color: var(--color-text-light);
    max-width: 800px;
    margin: 0 auto var(--space-lg);
    line-height: 1.6;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    gap: var(--space-md);
    flex-wrap: wrap;
    width: 100%;
  }

  .hero-actions .btn {
    white-space: normal;
    word-break: break-word;
    text-align: center;
    line-height: 1.3;
  }

  /* Ethical Guarantee Banner */
  .trust-guarantee-banner {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    padding: var(--space-lg);
    margin-bottom: var(--space-2xl);
    border-left: 4px solid var(--color-accent);
    background: var(--color-surface);
    border-radius: var(--border-radius-md);
    width: 100%;
    box-sizing: border-box;
    min-width: 0;
  }

  .guarantee-icon {
    font-size: 2.5rem;
    flex-shrink: 0;
  }

  .guarantee-content {
    flex: 1;
    min-width: 0;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  .guarantee-content h3 {
    font-size: var(--font-size-lg);
    font-weight: 700;
    margin-bottom: var(--space-2xs);
    word-break: break-word;
    overflow-wrap: break-word;
  }

  .guarantee-content p {
    font-size: var(--font-size-sm);
    color: var(--color-text-light);
    line-height: 1.5;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  /* Section Headers */
  .section-header {
    text-align: center;
    margin-bottom: var(--space-xl);
    width: 100%;
    min-width: 0;
  }

  .section-title {
    font-size: clamp(1.3rem, 3vw, var(--font-size-2xl));
    font-weight: 800;
    margin-bottom: var(--space-2xs);
    word-break: break-word;
    overflow-wrap: break-word;
  }

  .section-desc {
    font-size: var(--font-size-sm);
    color: var(--color-text-light);
    max-width: 700px;
    margin: 0 auto;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  /* Categories Navigation Tabs */
  .category-tabs-wrapper {
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    padding: 4px 2px var(--space-sm);
    margin-bottom: var(--space-xl);
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    box-sizing: border-box;
  }

  .category-tabs-wrapper::-webkit-scrollbar {
    height: 6px;
  }

  .category-tabs-wrapper::-webkit-scrollbar-thumb {
    background: rgba(255, 215, 0, 0.3);
    border-radius: 4px;
  }

  .category-tabs {
    display: flex;
    gap: var(--space-xs);
    justify-content: flex-start;
    min-width: max-content;
    padding: 2px;
  }

  .tab-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0.55rem 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-surface-border);
    border-radius: var(--border-radius-full);
    font-weight: 600;
    font-size: 0.84rem;
    color: var(--color-text);
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
    user-select: none;
    flex-shrink: 0;
  }

  .tab-btn:hover {
    border-color: var(--color-primary);
    transform: translateY(-2px);
    background: var(--color-surface-hover);
  }

  .tab-btn.active {
    background: var(--color-primary);
    color: var(--color-btn-primary-text, #ffffff);
    font-weight: 800;
    border-color: var(--color-primary);
    box-shadow: 0 4px 12px var(--color-primary-ring);
  }

  .tab-icon {
    font-size: 1.1rem;
  }

  /* Panels */
  .honor-panel {
    display: none;
    width: 100%;
    min-width: 0;
  }

  .honor-panel.active {
    display: block;
    animation: fadeIn 0.3s ease;
  }

  .panel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-lg);
    margin-bottom: var(--space-lg);
    border-radius: var(--border-radius-md);
    flex-wrap: wrap;
    gap: var(--space-md);
    border: 1px solid var(--color-surface-border);
    width: 100%;
    box-sizing: border-box;
    min-width: 0;
  }

  .panel-info {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    flex: 1 1 240px;
    min-width: 0;
  }

  .panel-icon {
    font-size: 2.2rem;
    flex-shrink: 0;
  }

  .panel-title {
    font-size: var(--font-size-xl);
    font-weight: 700;
    margin-bottom: var(--space-3xs);
    word-break: break-word;
    overflow-wrap: break-word;
  }

  .panel-subtitle {
    font-size: var(--font-size-sm);
    color: var(--color-text-light);
    word-break: break-word;
    overflow-wrap: break-word;
  }

  .panel-bid-info {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    flex-wrap: wrap;
    min-width: 0;
    flex: 1 1 auto;
    justify-content: flex-end;
  }

  .panel-actions-group {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    flex-wrap: wrap;
    min-width: 0;
  }

  .panel-actions-group .btn {
    white-space: normal;
    word-break: break-word;
    text-align: center;
    line-height: 1.25;
    padding: 0.5rem 0.75rem;
  }

  .price-chip {
    background: rgba(0, 0, 0, 0.25);
    padding: 6px 12px;
    border-radius: var(--border-radius-sm);
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    border: 1px solid rgba(255, 255, 255, 0.08);
    min-width: 0;
  }

  .price-label {
    font-size: 0.72rem;
    color: var(--color-text-light);
  }

  .price-val {
    font-weight: 800;
    color: var(--color-accent, #ffd700);
    font-size: 1.1rem;
  }

  /* Grid & Spot Cards */
  .spots-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: var(--space-lg);
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
  }

  .spot-card {
    padding: var(--space-lg);
    border-radius: var(--border-radius-md);
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
    border: 1px solid var(--color-surface-border);
    width: 100%;
    box-sizing: border-box;
    min-width: 0;
    overflow: hidden;
  }

  .spot-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .spot-diamond {
    border: 2px solid #00d2ff;
    background: linear-gradient(180deg, rgba(0, 210, 255, 0.08) 0%, var(--color-surface) 100%);
  }

  .spot-gold {
    border: 2px solid #ffd700;
    background: linear-gradient(180deg, rgba(255, 215, 0, 0.08) 0%, var(--color-surface) 100%);
  }

  .spot-silver {
    border: 2px solid #c0c0c0;
    background: linear-gradient(180deg, rgba(192, 192, 192, 0.08) 0%, var(--color-surface) 100%);
  }

  .spot-rank-badge {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-sm);
    font-weight: 800;
    font-size: 0.72rem;
    padding: 3px 8px;
    border-radius: var(--border-radius-full);
    background: rgba(0, 0, 0, 0.75);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.2);
    z-index: 1;
  }

  .spot-avatar img {
    width: 100%;
    height: 140px;
    object-fit: cover;
    border-radius: var(--border-radius-sm);
    margin-bottom: var(--space-md);
  }

  .spot-business-name {
    font-size: 1.15rem;
    font-weight: 800;
    margin-bottom: var(--space-3xs);
    line-height: 1.3;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  .spot-business-name a {
    color: inherit;
    text-decoration: none;
  }

  .spot-business-name a:hover {
    color: var(--color-primary);
  }

  .spot-honor-title {
    font-style: italic;
    color: var(--color-text-light);
    font-size: 0.85rem;
    margin-bottom: var(--space-sm);
    word-break: break-word;
    overflow-wrap: break-word;
  }

  .spot-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: var(--space-md);
  }

  .meta-tag {
    font-size: 0.72rem;
    padding: 2px 8px;
    border-radius: var(--border-radius-sm);
    background: var(--color-surface-border);
    font-weight: 600;
    word-break: break-word;
  }

  .trust-tag {
    background: rgba(46, 204, 113, 0.15);
    color: #2ecc71;
  }

  .bid-tag {
    background: rgba(255, 215, 0, 0.15);
    color: var(--color-accent, #ffd700);
    font-weight: 700;
  }

  .spot-quote {
    font-size: 0.8rem;
    border-left: 2px solid var(--color-primary);
    padding-left: var(--space-sm);
    margin-bottom: var(--space-md);
    color: var(--color-text-light);
    line-height: 1.4;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  .spot-quote cite {
    display: block;
    font-size: 0.72rem;
    margin-top: 4px;
    font-weight: 700;
    color: var(--color-text);
  }

  .spot-card-footer {
    display: flex;
