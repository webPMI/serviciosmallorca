---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import ServiceCard from "../../components/ServiceCard.astro";
import BlogCard from "../../components/BlogCard.astro";
import TopRankedSection from "../../components/TopRankedSection.astro";
import DiscoveryTours from "../../components/DiscoveryTours.astro";
import MallorcaNewsFeed from "../../components/MallorcaNewsFeed.astro";
import AdSenseSlot from "../../components/AdSenseSlot.astro";
import BusinessJoinBanner from "../../components/BusinessJoinBanner.astro";
import EcosystemGuideSection from "../../components/EcosystemGuideSection.astro";
import { getActiveCategories } from "../../data/categories";
import { getFeaturedServices, SERVICES } from "../../data/services";
import { getFeaturedPosts } from "../../data/posts";
import { getLocaleFromUrl, loadTranslations, getLangPrefix, type Locale } from "../../i18n";
import { generateHomepageJsonLd } from "../../lib/jsonLdGenerator";

export const prerender = false;

const locale = getLocaleFromUrl(Astro.url) as Locale;
const translations = await loadTranslations(locale);
const prefix = getLangPrefix(locale);

const activeCategories = getActiveCategories(SERVICES);
const featuredServices = getFeaturedServices();
const featuredPosts = getFeaturedPosts();

// Stats for hero bar
const totalServices = SERVICES.filter((s) => s.status !== "permanently_closed").length;
const totalCategories = activeCategories.length;
const totalReviews = SERVICES.reduce((acc, s) => acc + (s.reviewCount || 0), 0);
const LANGUAGES = 4;

const canonicalUrl = `https://serviciosmallorca.com${prefix}`;
const homepageJsonLd = generateHomepageJsonLd(locale, canonicalUrl);
---

<BaseLayout
  title={`${translations["site.title"]} - ${translations["site.tagline"]}`}
  lang={locale}
  description={translations["home.subtitle"]}
  jsonLd={homepageJsonLd}
>
  <Navbar currentLocale={locale} translations={translations} getLangPrefix={getLangPrefix} />

  <main>
    <!-- HERO SECTION -->
    <section class="hero-wrapper">
      <div class="container hero-content">
        <div class="hero-badge badge badge-primary fade-in">
          {translations["home.badge"]}
        </div>

        <h1 class="hero-title fade-in">
          {translations["home.heading"]}
        </h1>

        <p class="hero-subtitle fade-in">
          {translations["home.subtitle"]}
        </p>

        <!-- Search Bar -->
        <form action={`${prefix}servicios`} method="GET" class="hero-search-box fade-in">
          <div class="search-input-wrap">
            <span class="search-icon">🔍</span>
            <input
              type="text"
              name="q"
              placeholder={translations["home.search.placeholder"]}
              class="hero-search-input"
              aria-label="Buscar servicios"
            />
          </div>
          <button type="submit" class="btn btn-primary hero-search-btn">
            {translations["home.search.button"]}
          </button>
        </form>

        <!-- Quick Category Pills (Only active categories with content) -->
        {
          activeCategories.length > 0 && (
            <div class="quick-categories">
              {activeCategories.slice(0, 4).map((cat) => (
                <a href={`${prefix}servicios?categoria=${cat.id}`} class="quick-pill">
                  <span>{cat.icon}</span>
                  <span>{cat.name[locale]}</span>
                </a>
              ))}
            </div>
          )
        }

        <!-- Animated Stats Bar -->
        <div class="hero-stats-bar">
          <div class="hero-stat" id="stat-businesses">
            <span class="hero-stat-num" data-target={totalServices}>0</span>
            <span class="hero-stat-label">{translations["home.stats.businesses"] || "negocios curados"}</span>
          </div>
          <div class="hero-stat-divider" aria-hidden="true"></div>
          <div class="hero-stat" id="stat-categories">
            <span class="hero-stat-num" data-target={totalCategories}>0</span>
            <span class="hero-stat-label">{translations["home.stats.categories"] || "categorías activas"}</span>
          </div>
          <div class="hero-stat-divider" aria-hidden="true"></div>
          <div class="hero-stat" id="stat-reviews">
            <span class="hero-stat-num" data-target={totalReviews > 0 ? totalReviews : 1200}>0</span>
            <span class="hero-stat-label">{translations["home.stats.reviews"] || "reseñas verificadas"}</span>
          </div>
          <div class="hero-stat-divider" aria-hidden="true"></div>
          <div class="hero-stat">
            <span class="hero-stat-num">{LANGUAGES}</span>
            <span class="hero-stat-label">{translations["home.stats.languages"] || "idiomas"}</span>
          </div>
        </div>
      </div>
    </section>

    <!-- CATEGORIES SECTION -->
    {
      activeCategories.length > 0 && (
        <section class="container section">
          <div class="section-header">
            <h2 class="section-title">{translations["home.categories.title"]}</h2>
            <p class="section-subtitle">{translations["home.categories.subtitle"]}</p>
          </div>

          <div class="categories-grid">
            {activeCategories.map((cat) => (
              <a href={`${prefix}servicios?categoria=${cat.id}`} class="category-card card-glass hover-lift">
                <div class="category-icon">{cat.icon}</div>
                <h3 class="category-name">{cat.name[locale]}</h3>
                <p class="category-desc">{cat.description[locale]}</p>
              </a>
            ))}
          </div>
          <AdSenseSlot format="horizontal" slotId="home-mid-banner" />
        </section>
      )
    }

    <!-- SPECIALIZED EXPLORATION HUBS & VERTICALS -->
    <section class="container section">
      <div class="section-header">
        <span class="badge-hub">{translations["home.hubs.badge"]}</span>
        <h2 class="section-title">{translations["home.hubs.title"]}</h2>
        <p class="section-subtitle">{translations["home.hubs.subtitle"]}</p>
      </div>

      <div class="hubs-grid">
        <a href={`${prefix}deporte`} class="hub-card card-glass hover-lift">
          <div class="hub-icon-wrap sports-accent">🏃‍♂️</div>
          <div class="hub-info">
            <span class="hub-tag">{translations["home.hubs.sports.tag"]}</span>
            <h3 class="hub-title">{translations["home.hubs.sports.title"]}</h3>
            <p class="hub-desc">{translations["home.hubs.sports.desc"]}</p>
          </div>
          <span class="hub-arrow" aria-hidden="true">→</span>
        </a>

        <a href={`${prefix}tours`} class="hub-card card-glass hover-lift">
          <div class="hub-icon-wrap tours-accent">🗺️</div>
          <div class="hub-info">
            <span class="hub-tag">{translations["home.hubs.tours.tag"]}</span>
            <h3 class="hub-title">{translations["home.hubs.tours.title"]}</h3>
            <p class="hub-desc">{translations["home.hubs.tours.desc"]}</p>
          </div>
          <span class="hub-arrow" aria-hidden="true">→</span>
        </a>

        <a href={`${prefix}memoria-historica`} class="hub-card card-glass hover-lift">
          <div class="hub-icon-wrap history-accent">🏛️</div>
          <div class="hub-info">
            <span class="hub-tag">{translations["home.hubs.history.tag"]}</span>
            <h3 class="hub-title">{translations["home.hubs.history.title"]}</h3>
            <p class="hub-desc">{translations["home.hubs.history.desc"]}</p>
          </div>
          <span class="hub-arrow" aria-hidden="true">→</span>
        </a>

        <a href={`${prefix}comunidad`} class="hub-card card-glass hover-lift">
          <div class="hub-icon-wrap community-accent">💬</div>
          <div class="hub-info">
            <span class="hub-tag">{translations["home.hubs.community.tag"]}</span>
            <h3 class="hub-title">{translations["home.hubs.community.title"]}</h3>
            <p class="hub-desc">{translations["home.hubs.community.desc"]}</p>
          </div>
          <span class="hub-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <!-- FEATURED SERVICES SECTION -->
    <section id="features" class="section bg-surface">
      <div class="container">
        <div class="section-header-flex">
          <div>
            <h2 class="section-title">{translations["home.featured.title"]}</h2>
            <p class="section-subtitle">{translations["home.featured.subtitle"]}</p>
          </div>
          <a href={`${prefix}servicios`} class="btn btn-secondary btn-sm">
            {translations["home.explore"]} →
          </a>
        </div>

        <div class="services-grid">
          {
            featuredServices.map((service) => (
              <ServiceCard
                service={service}
                currentLocale={locale}
                getLangPrefix={getLangPrefix}
                translations={translations}
              />
            ))
          }
        </div>

        <!-- Dynamic Weekly Top Curated Section -->
        <TopRankedSection locale={locale} prefix={prefix} translations={translations} mode="weekly" />
      </div>
    </section>

    <!-- THEMATIC DISCOVERY TOURS (Inspiration Itineraries) -->
    <div class="container">
      <DiscoveryTours currentLocale={locale} getLangPrefix={getLangPrefix} />
    </div>

    <!-- LATEST BLOG POSTS SECTION -->
    <section class="container section">
      <div class="section-header-flex">
        <div>
          <h2 class="section-title">{translations["home.blog.title"]}</h2>
          <p class="section-subtitle">{translations["home.blog.subtitle"]}</p>
        </div>
        <a href={`${prefix}blog`} class="btn btn-secondary btn-sm">
          {translations["nav.blog"]} →
        </a>
      </div>

      <div class="blog-grid">
        {
          featuredPosts.map((post) => (
            <BlogCard post={post} currentLocale={locale} getLangPrefix={getLangPrefix} translations={translations} />
          ))
        }
      </div>

      <!-- Mallorca Verified Media & Press Mentions Feed -->
      <MallorcaNewsFeed locale={locale} limit={4} />
    </section>

    <!-- PHILOSOPHY & LOCAL COMMITMENT SECTION -->
    <section class="container section">
      <div class="mission-callout card-glass">
        <div class="mission-callout-header">
          <span class="badge-mission">{translations["home.mission.badge"]}</span>
          <h2 class="section-title">{translations["home.mission.title"]}</h2>
          <p class="section-subtitle">{translations["home.mission.subtitle"]}</p>
        </div>

        <div class="mission-callout-grid">
          <div class="mission-item">
            <span class="mission-icon">🏃‍♂️</span>
            <h4>{translations["home.mission.item1.title"]}</h4>
            <p>{translations["home.mission.item1.desc"]}</p>
          </div>
          <div class="mission-item">
            <span class="mission-icon">⚖️</span>
            <h4>{translations["home.mission.item2.title"]}</h4>
            <p>{translations["home.mission.item2.desc"]}</p>
          </div>
          <div class="mission-item">
            <span class="mission-icon">🛡️</span>
            <h4>{translations["home.mission.item3.title"]}</h4>
            <p>{translations["home.mission.item3.desc"]}</p>
          </div>
        </div>

        <div class="mission-callout-footer">
          <a href={`${prefix}sobre-nosotros`} class="btn btn-outline">
            {translations["home.mission.cta"]} →
          </a>
        </div>
      </div>
    </section>

    <!-- TRUST & FEATURES SECTION -->
    <section class="section bg-surface">
      <div class="container">
        <div class="section-header text-center">
          <h2 class="section-title">{translations["home.features.title"]}</h2>
        </div>

        <div class="features-grid">
          <article class="card hover-lift">
            <div class="card-icon">🛡️</div>
            <h3>{translations["home.features.training"]}</h3>
            <p>{translations["home.features.training.description"]}</p>
          </article>

          <article class="card hover-lift">
            <div class="card-icon">📍</div>
            <h3>{translations["home.features.nutrition"]}</h3>
            <p>{translations["home.features.nutrition.description"]}</p>
          </article>

          <article class="card hover-lift">
            <div class="card-icon">🌍</div>
            <h3>{translations["home.features.tracking"]}</h3>
            <p>{translations["home.features.tracking.description"]}</p>
          </article>
        </div>
      </div>
    </section>

    <!-- PLATFORM ECOSYSTEM GUIDE & SEO AUTHORITY HUB -->
    <div class="container">
      <EcosystemGuideSection currentLocale={locale} translations={translations} />
    </div>

    <!-- BUSINESS ONBOARDING & PRICING BANNER -->
    <div class="container">
      <BusinessJoinBanner locale={locale} translations={translations} />
    </div>
  </main>

  <Footer translations={translations} currentLocale={locale} getLangPrefix={getLangPrefix} />
</BaseLayout>

<script>
  // Animated counter for stats bar
  function animateCounter(el: HTMLElement, target: number, duration = 1200) {
    const start = performance.now();
    const startVal = 0;
    const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);

    function tick(now: number) {
      const elapsed = now - start;
      const progress = Math.min(elapsed / duration, 1);
      const value = Math.round(startVal + (target - startVal) * easeOut(progress));
      el.textContent = value.toLocaleString();
      if (progress < 1) requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }

  const statsBar = document.querySelector(".hero-stats-bar");
  if (statsBar) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            document.querySelectorAll<HTMLElement>(".hero-stat-num[data-target]").forEach((el) => {
              const target = parseInt(el.dataset.target || "0", 10);
              animateCounter(el, target);
            });
            observer.disconnect();
          }
        });
      },
      { threshold: 0.3 },
    );
    observer.observe(statsBar);
  }
</script>

<style>
  /* HERO STYLES */
  .hero-wrapper {
    padding: var(--space-2xl) 0 var(--space-xl);
    background: radial-gradient(ellipse at top, var(--color-primary-bg) 0%, transparent 70%);
    border-bottom: 1px solid var(--color-surface-border);
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 860px;
    gap: var(--space-sm);
  }

  .hero-title {
    font-size: clamp(2.2rem, 5.5vw, var(--font-size-4xl));
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .hero-subtitle {
    font-size: var(--font-size-lg);
    color: var(--color-text-light);
    max-width: 680px;
    line-height: 1.6;
    margin-bottom: var(--space-sm);
  }

  .hero-search-box {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    width: 100%;
    max-width: 650px;
    background: var(--color-surface);
    border: 2px solid var(--color-primary-border);
    border-radius: var(--border-radius-full);
    padding: 0.35rem 0.5rem;
    box-shadow: var(--shadow-md);
    transition:
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .hero-search-box:focus-within {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 4px var(--color-primary-ring);
  }

  .search-input-wrap {
    display: flex;
    align-items: center;
    flex-grow: 1;
    padding-left: 0.75rem;
    gap: 0.5rem;
  }

  .search-icon {
    font-size: 1.1rem;
    user-select: none;
  }

  .hero-search-input {
    width: 100%;
    border: none;
    background: transparent;
    font-size: var(--font-size-base);
    color: var(--color-text);
    padding: 0.5rem 0;
    outline: none;
    font-family: inherit;
  }

  .hero-search-btn {
    border-radius: var(--border-radius-full);
    padding: 0.6rem 1.5rem;
    white-space: nowrap;
  }

  .quick-categories {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-xs);
    margin-top: var(--space-sm);
  }

  .quick-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.85rem;
    border-radius: var(--border-radius-full);
    background: var(--color-surface);
    border: 1px solid var(--color-surface-border);
    font-size: var(--font-size-xs);
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .quick-pill:hover {
    background: var(--color-primary-bg);
    color: var(--color-primary);
    border-color: var(--color-primary-border);
  }

  /* STATS BAR */
  .hero-stats-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-lg);
    flex-wrap: wrap;
    margin-top: var(--space-lg);
    padding: var(--space-md) var(--space-xl);
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: var(--border-radius-lg);
    backdrop-filter: var(--glass-backdrop);
    box-shadow: var(--glass-shadow);
    animation: fadeSlideUp 0.6s ease 0.3s both;
  }

  .hero-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
  }

  .hero-stat-num {
    font-size: var(--font-size-2xl);
    font-weight: 900;
    color: var(--color-primary);
    line-height: 1;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }

  .hero-stat-label {
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-align: center;
  }

  .hero-stat-divider {
    width: 1px;
    height: 36px;
    background: var(--color-surface-border);
    border-radius: 1px;
  }

  @keyframes fadeSlideUp {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* SECTION HEADERS */
  .section-header {
    margin-bottom: var(--space-xl);
  }

  .section-header.text-center {
    text-align: center;
  }

  .section-header-flex {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: var(--space-xl);
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .section-title {
    font-size: var(--font-size-2xl);
    font-weight: 800;
    color: var(--color-text);
    letter-spacing: -0.01em;
  }

  .section-subtitle {
    font-size: var(--font-size-base);
    color: var(--color-text-muted);
    margin-top: 0.25rem;
  }

  .bg-surface {
    background-color: var(--color-surface-hover);
  }

  /* GRIDS */
  .categories-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-md);
  }

  .category-card {
    padding: var(--space-lg);
    border-radius: var(--border-radius);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    border: 1px solid var(--color-surface-border);
  }

  .category-icon {
    font-size: 2.2rem;
    margin-bottom: var(--space-xs);
  }

  .category-name {
    font-size: var(--font-size-lg);
    font-weight: 700;
    color: var(--color-text);
  }

  .category-desc {
    font-size: var(--font-size-sm);
    color: var(--color-text-light);
    line-height: 1.45;
  }

  .services-grid,
  .blog-grid,
  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-lg);
  }

  .card-icon {
    font-size: 2.2rem;
    margin-bottom: var(--space-sm);
  }

  .features-grid .card h3 {
    margin-bottom: var(--space-xs);
    font-size: var(--font-size-lg);
    font-weight: 700;
  }

  .features-grid .card p {
    color: var(--color-text-light);
    font-size: var(--font-size-sm);
    line-height: 1.5;
  }

  /* CTA BANNER */
  .cta-banner {
    padding: var(--space-2xl);
    border-radius: var(--border-radius-lg);
    text-align: center;
    border: 2px solid var(--color-primary-border);
    background: linear-gradient(135deg, var(--color-surface) 0%, var(--color-primary-bg) 100%);
  }

  .cta-content {
    max-width: 600px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
  }

  .cta-badge {
    font-size: var(--font-size-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary);
  }

  .cta-title {
    font-size: var(--font-size-2xl);
    font-weight: 800;
    color: var(--color-text);
  }

  .cta-subtitle {
    font-size: var(--font-size-base);
    color: var(--color-text-light);
    line-height: 1.5;
    margin-bottom: var(--space-xs);
  }

  .btn-lg {
    padding: 0.85rem 2rem;
    font-size: var(--font-size-base);
  }

  /* SPECIALIZED HUBS STYLES */
  .badge-hub {
    display: inline-block;
    padding: 0.3rem 0.8rem;
    background: rgba(30, 144, 255, 0.12);
    border: 1px solid rgba(30, 144, 255, 0.3);
    border-radius: var(--border-radius-full);
    color: var(--color-primary);
    font-size: var(--font-size-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-xs);
  }

  .hubs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-md);
    margin-top: var(--space-md);
  }

  .hub-card {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-surface-border);
    border-radius: var(--border-radius-lg);
    text-decoration: none;
    transition: all var(--transition-base);
  }

  .hub-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-3px);
  }

  .hub-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: var(--border-radius-md);
    font-size: 1.8rem;
    flex-shrink: 0;
  }

  .sports-accent {
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.3);
  }
  .tours-accent {
    background: rgba(212, 175, 55, 0.15);
    border: 1px solid rgba(212, 175, 55, 0.3);
  }
  .history-accent {
    background: rgba(139, 92, 246, 0.15);
    border: 1px solid rgba(139, 92, 246, 0.3);
  }
  .community-accent {
    background: rgba(59, 130, 246, 0.15);
    border: 1px solid rgba(59, 130, 246, 0.3);
  }

  .hub-info {
    flex: 1;
