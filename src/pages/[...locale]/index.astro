---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import ServiceCard from "../../components/ServiceCard.astro";
import BlogCard from "../../components/BlogCard.astro";
import TopRankedSection from "../../components/TopRankedSection.astro";
import DiscoveryTours from "../../components/DiscoveryTours.astro";
import MallorcaNewsFeed from "../../components/MallorcaNewsFeed.astro";
import AdSenseSlot from "../../components/AdSenseSlot.astro";
import BusinessJoinBanner from "../../components/BusinessJoinBanner.astro";
import EcosystemGuideSection from "../../components/EcosystemGuideSection.astro";
import { getActiveCategories } from "../../data/categories";
import { getFeaturedServices, SERVICES } from "../../data/services";
import { getFeaturedPosts } from "../../data/posts";
import { getLocaleFromUrl, loadTranslations, getLangPrefix, type Locale } from "../../i18n";
import { generateHomepageJsonLd } from "../../lib/jsonLdGenerator";

export const prerender = false;

const locale = getLocaleFromUrl(Astro.url) as Locale;
const translations = await loadTranslations(locale);
const prefix = getLangPrefix(locale);

const activeCategories = getActiveCategories(SERVICES);
const featuredServices = getFeaturedServices();
const featuredPosts = getFeaturedPosts();

// Stats for hero bar
const totalServices = SERVICES.filter((s) => s.status !== "permanently_closed").length;
const totalCategories = activeCategories.length;
const totalReviews = SERVICES.reduce((acc, s) => acc + (s.reviewCount || 0), 0);
const LANGUAGES = 4;

// Category count map
const categoryCountMap = activeCategories.reduce<Record<string, number>>((acc, cat) => {
  acc[cat.id] = SERVICES.filter((s) => s.category === cat.id && s.status !== "permanently_closed").length;
  return acc;
}, {});

const canonicalUrl = `https://serviciosmallorca.com${prefix}`;
const homepageJsonLd = generateHomepageJsonLd(locale, canonicalUrl);
---

<BaseLayout
  title={`${translations["site.title"]} - ${translations["site.tagline"]}`}
  lang={locale}
  description={translations["home.subtitle"]}
  jsonLd={homepageJsonLd}
>
  <Navbar currentLocale={locale} translations={translations} getLangPrefix={getLangPrefix} />

  <main class="home-main">
    <!-- HERO SECTION -->
    <section class="hero-wrapper">
      <div class="container hero-content">
        <div class="hero-badge badge badge-primary fade-in">
          🌴 {translations["home.badge"] || "Guía Oficial de Mallorca"}
        </div>

        <h1 class="hero-title fade-in">
          {translations["home.heading"]}
        </h1>

        <p class="hero-subtitle fade-in">
          {translations["home.subtitle"]}
        </p>

        <!-- Search Bar -->
        <form action={`${prefix}servicios`} method="GET" class="hero-search-box fade-in">
          <div class="search-input-wrap">
            <span class="search-icon" aria-hidden="true">🔍</span>
            <input
              type="text"
              name="q"
              placeholder={translations["home.search.placeholder"] || "Buscar fontanero, restaurante, gimnasio, spa..."}
              class="hero-search-input"
              aria-label="Buscar servicios en Mallorca"
            />
          </div>
          <button type="submit" class="btn btn-primary hero-search-btn">
            {translations["home.search.button"] || "Buscar"}
          </button>
        </form>

        <!-- Quick Category Scrollable Chips -->
        {
          activeCategories.length > 0 && (
            <div class="quick-chips-wrapper" aria-label="Categorías rápidas">
              <div class="quick-chips-scroll">
                {activeCategories.slice(0, 8).map((cat) => (
                  <a href={`${prefix}servicios?categoria=${cat.id}`} class="quick-chip">
                    <span class="chip-icon">{cat.icon}</span>
                    <span class="chip-label">{cat.name[locale]}</span>
                  </a>
                ))}
                <a href={`${prefix}servicios`} class="quick-chip chip-all">
                  <span>✨</span>
                  <span>Ver todas</span>
                </a>
              </div>
            </div>
          )
        }

        <!-- Compact Glass Stats Bar -->
        <div class="hero-stats-bar">
          <div class="hero-stat" id="stat-businesses">
            <span class="hero-stat-num" data-target={totalServices}>0</span>
            <span class="hero-stat-label">{translations["home.stats.businesses"] || "negocios"}</span>
          </div>
          <div class="hero-stat-divider" aria-hidden="true"></div>
          <div class="hero-stat" id="stat-categories">
            <span class="hero-stat-num" data-target={totalCategories}>0</span>
            <span class="hero-stat-label">{translations["home.stats.categories"] || "categorías"}</span>
          </div>
          <div class="hero-stat-divider" aria-hidden="true"></div>
          <div class="hero-stat" id="stat-reviews">
            <span class="hero-stat-num" data-target={totalReviews > 0 ? totalReviews : 1200}>0</span>
            <span class="hero-stat-label">{translations["home.stats.reviews"] || "reseñas"}</span>
          </div>
          <div class="hero-stat-divider" aria-hidden="true"></div>
          <div class="hero-stat">
            <span class="hero-stat-num">{LANGUAGES}</span>
            <span class="hero-stat-label">{translations["home.stats.languages"] || "idiomas"}</span>
          </div>
        </div>
      </div>
    </section>

    <!-- EXPLORE BY CATEGORIES (VISUAL DASHBOARD) -->
    {
      activeCategories.length > 0 && (
        <section class="container section categories-section">
          <div class="section-header-compact">
            <div>
              <h2 class="section-title">{translations["home.categories.title"] || "Explora por Categorías"}</h2>
              <p class="section-subtitle">
                {translations["home.categories.subtitle"] ||
                  "Accede directamente a los mejores profesionales y comercios"}
              </p>
            </div>
            <a href={`${prefix}servicios`} class="section-link-more">
              Ver catálogo completo ({totalServices}) →
            </a>
          </div>

          <div class="categories-compact-grid">
            {activeCategories.map((cat) => {
              const count = categoryCountMap[cat.id] || 0;
              return (
                <a href={`${prefix}servicios?categoria=${cat.id}`} class="cat-pill-card hover-lift">
                  <div class="cat-pill-icon">{cat.icon}</div>
                  <div class="cat-pill-text">
                    <span class="cat-pill-name">{cat.name[locale]}</span>
                    <span class="cat-pill-count">
                      {count} {count === 1 ? "sitio" : "sitios"}
                    </span>
                  </div>
                </a>
              );
            })}
          </div>
          <AdSenseSlot format="horizontal" slotId="home-mid-banner" />
        </section>
      )
    }

    <!-- FEATURED & TOP SERVICES (HORIZONTAL SWIPEABLE SHOWCASE) -->
    <section id="features" class="section bg-surface featured-showcase-section">
      <div class="container">
        <div class="section-header-flex">
          <div>
            <div class="section-badge badge badge-secondary">⭐ Selección Exclusiva</div>
            <h2 class="section-title">{translations["home.featured.title"] || "Servicios Destacados"}</h2>
            <p class="section-subtitle">
              {
                translations["home.featured.subtitle"] ||
                  "Empresas y referentes con las mejores valoraciones en Mallorca"
              }
            </p>
          </div>
          <a href={`${prefix}servicios`} class="btn btn-secondary btn-sm">
            {translations["home.explore"] || "Explorar todos"} →
          </a>
        </div>

        <!-- Horizontal Swipeable Track on Mobile / Grid on Desktop -->
        <div class="services-swipe-track">
          {
            featuredServices.slice(0, 8).map((service) => (
              <div class="swipe-card-item">
                <ServiceCard
                  service={service}
                  currentLocale={locale}
                  getLangPrefix={getLangPrefix}
                  translations={translations}
                />
              </div>
            ))
          }
        </div>

        <!-- Dynamic Weekly Top Curated Section -->
        <div class="weekly-top-wrapper">
          <TopRankedSection locale={locale} prefix={prefix} translations={translations} mode="weekly" />
        </div>
      </div>
    </section>

    <!-- SPECIALIZED HUBS & EXPERIENCES (BENTO 2x2) -->
    <section class="container section hubs-bento-section">
      <div class="section-header-compact">
        <div>
          <span class="badge-hub">{translations["home.hubs.badge"] || "⚡ Experiencias & Ecosistema"}</span>
          <h2 class="section-title">{translations["home.hubs.title"] || "Hubs Especializados de Mallorca"}</h2>
          <p class="section-subtitle">
            {translations["home.hubs.subtitle"] || "Descubre guías interactivas, rutas y memoria histórica"}
          </p>
        </div>
      </div>

      <div class="hubs-bento-grid">
        <a href={`${prefix}deporte`} class="hub-bento-card sports-card hover-lift">
          <div class="hub-bento-header">
            <span class="hub-bento-icon">🏃‍♂️</span>
            <span class="hub-bento-badge">{translations["home.hubs.sports.tag"] || "Deporte & Fitness"}</span>
          </div>
          <div class="hub-bento-content">
            <h3 class="hub-bento-title">{translations["home.hubs.sports.title"] || "Guía Deportiva & Fitness"}</h3>
            <p class="hub-bento-desc">
              {
                translations["home.hubs.sports.desc"] ||
                  "Gimnasios, pádel, tenis, boxes y espacios públicos al aire libre."
              }
            </p>
          </div>
          <span class="hub-bento-action">Explorar deporte →</span>
        </a>

        <a href={`${prefix}tours`} class="hub-bento-card tours-card hover-lift">
          <div class="hub-bento-header">
            <span class="hub-bento-icon">🗺️</span>
            <span class="hub-bento-badge">{translations["home.hubs.tours.tag"] || "Rutas Autoguiadas"}</span>
          </div>
          <div class="hub-bento-content">
            <h3 class="hub-bento-title">{translations["home.hubs.tours.title"] || "Rutas de Experiencia"}</h3>
            <p class="hub-bento-desc">
              {
                translations["home.hubs.tours.desc"] ||
                  "Itinerarios temáticos: bodegas, gastronomía, calas y patrimonio."
              }
            </p>
          </div>
          <span class="hub-bento-action">Ver rutas →</span>
        </a>

        <a href={`${prefix}memoria-historica`} class="hub-bento-card history-card hover-lift">
          <div class="hub-bento-header">
            <span class="hub-bento-icon">🏛️</span>
            <span class="hub-bento-badge">{translations["home.hubs.history.tag"] || "Patrimonio"}</span>
          </div>
          <div class="hub-bento-content">
            <h3 class="hub-bento-title">{translations["home.hubs.history.title"] || "Memoria Histórica"}</h3>
            <p class="hub-bento-desc">
              {
                translations["home.hubs.history.desc"] ||
                  "Comercios centenarios, talleres artesanos y memoria viva de la isla."
              }
            </p>
          </div>
          <span class="hub-bento-action">Descubrir historia →</span>
        </a>

        <a href={`${prefix}comunidad`} class="hub-bento-card community-card hover-lift">
          <div class="hub-bento-header">
            <span class="hub-bento-icon">💬</span>
            <span class="hub-bento-badge">{translations["home.hubs.community.tag"] || "Comunidad"}</span>
          </div>
          <div class="hub-bento-content">
            <h3 class="hub-bento-title">{translations["home.hubs.community.title"] || "Comunidad Balear"}</h3>
            <p class="hub-bento-desc">
              {
                translations["home.hubs.community.desc"] ||
                  "Recomendaciones reales de residentes, preguntas y apoyo local."
              }
            </p>
          </div>
          <span class="hub-bento-action">Entrar a la comunidad →</span>
        </a>
      </div>
    </section>

    <!-- THEMATIC DISCOVERY TOURS (Inspiration Itineraries) -->
    <section class="section bg-surface discovery-section">
      <div class="container">
        <DiscoveryTours currentLocale={locale} getLangPrefix={getLangPrefix} />
      </div>
    </section>

    <!-- LATEST BLOG POSTS & LOCAL NEWS -->
    <section class="container section blog-news-section">
      <div class="section-header-flex">
        <div>
          <h2 class="section-title">{translations["home.blog.title"] || "Guías y Consejos de Mallorca"}</h2>
          <p class="section-subtitle">
            {translations["home.blog.subtitle"] || "Artículos exclusivos, precios de referencia y recomendaciones"}
          </p>
        </div>
        <a href={`${prefix}blog`} class="btn btn-secondary btn-sm">
          {translations["nav.blog"] || "Ver blog"} →
        </a>
      </div>

      <div class="blog-swipe-track">
        {
          featuredPosts.slice(0, 3).map((post) => (
            <div class="blog-swipe-item">
              <BlogCard post={post} currentLocale={locale} getLangPrefix={getLangPrefix} translations={translations} />
            </div>
          ))
        }
      </div>

      <!-- Mallorca Verified Media & Press Mentions Feed -->
      <div class="news-feed-wrapper">
        <MallorcaNewsFeed locale={locale} limit={4} />
      </div>
    </section>

    <!-- TRUST SEALS BAR (Clean, non-intrusive guarantee) -->
    <section class="container section trust-seals-section">
      <div class="trust-seals-bar card-glass">
        <div class="trust-seal-item">
          <div class="trust-seal-icon">🛡️</div>
          <div class="trust-seal-info">
            <h4>Auditoría 100% Humana</h4>
            <p>Teléfonos (+34), CIF y presencia física comprobada.</p>
          </div>
        </div>
        <div class="trust-seal-divider" aria-hidden="true"></div>
        <div class="trust-seal-item">
          <div class="trust-seal-icon">📍</div>
          <div class="trust-seal-info">
            <h4>Fidelidad Cartográfica</h4>
            <p>Geolocalización precisa con Google, Apple y Bing Maps.</p>
          </div>
        </div>
        <div class="trust-seal-divider" aria-hidden="true"></div>
        <div class="trust-seal-item">
          <div class="trust-seal-icon">🤝</div>
          <div class="trust-seal-info">
            <h4>Contacto Directo</h4>
            <p>WhatsApp y llamadas sin comisiones ni intermediarios.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- PLATFORM ECOSYSTEM GUIDE (SMART COLLAPSIBLE ACCORDION FOR SEO) -->
    <div class="container">
      <EcosystemGuideSection currentLocale={locale} translations={translations} />
    </div>

    <!-- BUSINESS ONBOARDING & PRICING BANNER -->
    <div class="container">
      <BusinessJoinBanner locale={locale} translations={translations} />
    </div>
  </main>

  <Footer translations={translations} currentLocale={locale} getLangPrefix={getLangPrefix} />
</BaseLayout>

<script>
  // Animated counter for stats bar
  function animateCounter(el: HTMLElement, target: number, duration = 1200) {
    const start = performance.now();
    const startVal = 0;
    const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);

    function tick(now: number) {
      const elapsed = now - start;
      const progress = Math.min(elapsed / duration, 1);
      const value = Math.round(startVal + (target - startVal) * easeOut(progress));
      el.textContent = value.toLocaleString();
      if (progress < 1) requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }

  const statsBar = document.querySelector(".hero-stats-bar");
  if (statsBar) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            document.querySelectorAll<HTMLElement>(".hero-stat-num[data-target]").forEach((el) => {
              const target = parseInt(el.dataset.target || "0", 10);
              animateCounter(el, target);
            });
            observer.disconnect();
          }
        });
      },
      { threshold: 0.3 },
    );
    observer.observe(statsBar);
  }
</script>

<style>
  .home-main {
    overflow-x: hidden;
  }

  /* HERO STYLES */
  .hero-wrapper {
    padding: var(--space-xl) 0 var(--space-lg);
    background:
      radial-gradient(ellipse at 50% -20%, rgba(30, 144, 255, 0.15) 0%, transparent 70%),
      radial-gradient(ellipse at 80% 30%, rgba(16, 185, 129, 0.08) 0%, transparent 60%);
    border-bottom: 1px solid var(--color-surface-border);
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 860px;
    gap: var(--space-xs);
  }

  .hero-badge {
    font-size: var(--font-size-xs);
    font-weight: 700;
    padding: 0.35rem 0.9rem;
    border-radius: var(--border-radius-full);
    margin-bottom: var(--space-xs);
  }

  .hero-title {
    font-size: clamp(2rem, 5vw, var(--font-size-4xl));
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .hero-subtitle {
    font-size: clamp(0.95rem, 2.2vw, var(--font-size-lg));
    color: var(--color-text-light);
    max-width: 660px;
    line-height: 1.55;
    margin-bottom: var(--space-sm);
  }

  .hero-search-box {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    width: 100%;
    max-width: 620px;
    background: var(--color-surface);
    border: 2px solid var(--color-primary-border);
    border-radius: var(--border-radius-full);
    padding: 0.35rem 0.5rem;
    box-shadow: var(--shadow-md);
    transition: all var(--transition-fast);
  }

  .hero-search-box:focus-within {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 4px var(--color-primary-ring);
  }

  .search-input-wrap {
    display: flex;
    align-items: center;
    flex-grow: 1;
    padding-left: 0.75rem;
    gap: 0.5rem;
  }

  .search-icon {
    font-size: 1.1rem;
    user-select: none;
  }

  .hero-search-input {
    width: 100%;
    border: none;
    background: transparent;
    font-size: var(--font-size-base);
    color: var(--color-text);
    padding: 0.5rem 0;
    outline: none;
    font-family: inherit;
  }

  .hero-search-btn {
    border-radius: var(--border-radius-full);
    padding: 0.6rem 1.4rem;
    white-space: nowrap;
    font-weight: 700;
  }

  /* QUICK CHIPS (TOUCH HORIZONTAL SCROLL) */
  .quick-chips-wrapper {
    width: 100%;
    max-width: 700px;
    margin-top: var(--space-sm);
    overflow: hidden;
  }

  .quick-chips-scroll {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    padding: 4px 2px;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .quick-chips-scroll::-webkit-scrollbar {
    display: none;
  }

  .quick-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.8rem;
    border-radius: var(--border-radius-full);
    background: var(--color-surface);
    border: 1px solid var(--color-surface-border);
    font-size: var(--font-size-xs);
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    transition: all var(--transition-fast);
  }

  .quick-chip:hover {
    background: var(--color-primary-bg);
    color: var(--color-primary);
    border-color: var(--color-primary-border);
    transform: translateY(-1px);
  }

  .chip-all {
    background: var(--color-primary-bg);
    border-color: var(--color-primary-border);
    color: var(--color-primary);
  }

  /* STATS BAR */
  .hero-stats-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
    flex-wrap: wrap;
    margin-top: var(--space-md);
    padding: 0.6rem var(--space-lg);
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: var(--border-radius-full);
    backdrop-filter: var(--glass-backdrop);
    box-shadow: var(--shadow-sm);
  }

  .hero-stat {
    display: flex;
    align-items: baseline;
    gap: 0.3rem;
  }

  .hero-stat-num {
    font-size: var(--font-size-lg);
    font-weight: 900;
    color: var(--color-primary);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .hero-stat-label {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .hero-stat-divider {
    width: 1px;
    height: 16px;
    background: var(--color-surface-border);
  }

  /* SECTION HEADERS */
  .section-header-compact {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: var(--space-lg);
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .section-header-flex {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: var(--space-lg);
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .section-title {
    font-size: clamp(1.4rem, 3vw, var(--font-size-2xl));
    font-weight: 800;
    color: var(--color-text);
    letter-spacing: -0.01em;
  }

  .section-subtitle {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    margin-top: 0.2rem;
  }

  .section-link-more {
    font-size: var(--font-size-sm);
    font-weight: 700;
    color: var(--color-primary);
    text-decoration: none;
  }

  .section-link-more:hover {
    text-decoration: underline;
  }

  .bg-surface {
    background-color: var(--color-surface-hover);
  }

  /* COMPACT CATEGORIES DASHBOARD */
  .categories-compact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 0.75rem;
  }

  .cat-pill-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-surface-border);
    border-radius: var(--border-radius-md);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .cat-pill-card:hover {
    border-color: var(--color-primary);
    background: var(--color-primary-bg);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }

  .cat-pill-icon {
    font-size: 1.8rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .cat-pill-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .cat-pill-name {
    font-size: var(--font-size-sm);
    font-weight: 700;
    color: var(--color-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cat-pill-count {
    font-size: 0.72rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  /* SWIPEABLE SERVICES TRACK ON MOBILE */
  .services-swipe-track,
  .blog-swipe-track {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-md);
