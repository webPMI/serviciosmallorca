---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import ServiceCard from "../../components/ServiceCard.astro";
import BlogCard from "../../components/BlogCard.astro";
import TopRankedSection from "../../components/TopRankedSection.astro";
import DiscoveryTours from "../../components/DiscoveryTours.astro";
import MallorcaNewsFeed from "../../components/MallorcaNewsFeed.astro";
import AdSenseSlot from "../../components/AdSenseSlot.astro";
import { getActiveCategories } from "../../data/categories";
import { getFeaturedServices, SERVICES } from "../../data/services";
import { getFeaturedPosts } from "../../data/posts";
import { getLocaleFromUrl, loadTranslations, getLangPrefix, type Locale } from "../../i18n";
import { generateHomepageJsonLd } from "../../lib/jsonLdGenerator";

export const prerender = false;

const locale = getLocaleFromUrl(Astro.url) as Locale;
const translations = await loadTranslations(locale);
const prefix = getLangPrefix(locale);

const activeCategories = getActiveCategories(SERVICES);
const featuredServices = getFeaturedServices();
const featuredPosts = getFeaturedPosts();

const canonicalUrl = `https://serviciosmallorca.com${prefix}`;
const homepageJsonLd = generateHomepageJsonLd(locale, canonicalUrl);
---

<BaseLayout
  title={`${translations["site.title"]} - ${translations["site.tagline"]}`}
  lang={locale}
  description={translations["home.subtitle"]}
  jsonLd={homepageJsonLd}
>
  <Navbar currentLocale={locale} translations={translations} getLangPrefix={getLangPrefix} />

  <main>
    <!-- HERO SECTION -->
    <section class="hero-wrapper">
      <div class="container hero-content">
        <div class="hero-badge badge badge-primary fade-in">
          {translations["home.badge"]}
        </div>

        <h1 class="hero-title fade-in">
          {translations["home.heading"]}
        </h1>

        <p class="hero-subtitle fade-in">
          {translations["home.subtitle"]}
        </p>

        <!-- Search Bar -->
        <form action={`${prefix}servicios`} method="GET" class="hero-search-box fade-in">
          <div class="search-input-wrap">
            <span class="search-icon">🔍</span>
            <input
              type="text"
              name="q"
              placeholder={translations["home.search.placeholder"]}
              class="hero-search-input"
              aria-label="Buscar servicios"
            />
          </div>
          <button type="submit" class="btn btn-primary hero-search-btn">
            {translations["home.search.button"]}
          </button>
        </form>

        <!-- Quick Category Pills (Only active categories with content) -->
        {
          activeCategories.length > 0 && (
            <div class="quick-categories">
              {activeCategories.slice(0, 4).map((cat) => (
                <a href={`${prefix}servicios?categoria=${cat.id}`} class="quick-pill">
                  <span>{cat.icon}</span>
                  <span>{cat.name[locale]}</span>
                </a>
              ))}
            </div>
          )
        }
      </div>
    </section>

    <!-- CATEGORIES SECTION -->
    {
      activeCategories.length > 0 && (
        <section class="container section">
          <div class="section-header">
            <h2 class="section-title">{translations["home.categories.title"]}</h2>
            <p class="section-subtitle">{translations["home.categories.subtitle"]}</p>
          </div>

          <div class="categories-grid">
            {activeCategories.map((cat) => (
              <a href={`${prefix}servicios?categoria=${cat.id}`} class="category-card card-glass hover-lift">
                <div class="category-icon">{cat.icon}</div>
                <h3 class="category-name">{cat.name[locale]}</h3>
                <p class="category-desc">{cat.description[locale]}</p>
              </a>
            ))}
          </div>
          <AdSenseSlot format="horizontal" slotId="home-mid-banner" />
        </section>
      )
    }

    <!-- SPECIALIZED EXPLORATION HUBS & VERTICALS -->
    <section class="container section">
      <div class="section-header">
        <span class="badge-hub"
          >⚡ {
            locale === "de"
              ? "Entdecken & Erleben"
              : locale === "en"
                ? "Explore & Discover"
                : "Ecosistema & Experiencias"
          }</span
        >
        <h2 class="section-title">
          {
            locale === "de"
              ? "Spezialisierte Hubs auf Mallorca"
              : locale === "en"
                ? "Specialized Hubs in Mallorca"
                : "Hubs Especializados de Mallorca"
          }
        </h2>
        <p class="section-subtitle">
          {
            locale === "de"
              ? "Direkter Zugang zu Sportstätten, thematischen Routen und historischem Kulturerbe"
              : locale === "en"
                ? "Direct access to sports facilities, curated itineraries, and living heritage"
                : "Acceso directo a espacios deportivos, rutas temáticas y memoria comercial"
          }
        </p>
      </div>

      <div class="hubs-grid">
        <a href={`${prefix}deporte`} class="hub-card card-glass hover-lift">
          <div class="hub-icon-wrap sports-accent">🏃‍♂️</div>
          <div class="hub-info">
            <span class="hub-tag"
              >{locale === "de" ? "Sport & Fitness" : locale === "en" ? "Sports & Fitness" : "Deporte & Parques"}</span
            >
            <h3 class="hub-title">
              {
                locale === "de"
                  ? "Sport & Wellness Guide"
                  : locale === "en"
                    ? "Sports & Fitness Explorer"
                    : "Guía Deportiva & Zonas Públicas"
              }
            </h3>
            <p class="hub-desc">
              {
                locale === "de"
                  ? "Padel, Calisthenics, Outdoor-Fitness & Laufstrecken mit Schatten- und Wasserfilter."
                  : locale === "en"
                    ? "Padel courts, calisthenics parks, gym studios & running tracks with shade/water filters."
                    : "Pistas de pádel, parques de calistenia, gimnasios y rutas de running con sombra y fuentes."
              }
            </p>
          </div>
          <span class="hub-arrow">→</span>
        </a>

        <a href={`${prefix}tours`} class="hub-card card-glass hover-lift">
          <div class="hub-icon-wrap tours-accent">🗺️</div>
          <div class="hub-info">
            <span class="hub-tag"
              >{
                locale === "de" ? "SmartMatch Touren" : locale === "en" ? "Signature Routes" : "Rutas Inteligentes"
              }</span
            >
            <h3 class="hub-title">
              {
                locale === "de"
                  ? "Erlebnis-Routen & Touren"
                  : locale === "en"
                    ? "Curated Experience Tours"
                    : "Rutas de Experiencia & Tours"
              }
            </h3>
            <p class="hub-desc">
              {
                locale === "de"
                  ? "Thematische Tagesrouten: Kunsthandwerk, Yachting, Kulinarik und Inseltradition."
                  : locale === "en"
                    ? "Step-by-step curated journeys: craft ateliers, superyacht marinas & gastronomy."
                    : "Itinerarios temáticos paso a paso: artesanía balear, náutica, enoturismo y gastronomía."
              }
            </p>
          </div>
          <span class="hub-arrow">→</span>
        </a>

        <a href={`${prefix}memoria-historica`} class="hub-card card-glass hover-lift">
          <div class="hub-icon-wrap history-accent">🏛️</div>
          <div class="hub-info">
            <span class="hub-tag"
              >{locale === "de" ? "Tradition & Erbe" : locale === "en" ? "Living Heritage" : "Memoria & Legado"}</span
            >
            <h3 class="hub-title">
              {
                locale === "de"
                  ? "Historischer Hub der Insel"
                  : locale === "en"
                    ? "Island Historical Hub"
                    : "Hub de Memoria Histórica"
              }
            </h3>
            <p class="hub-desc">
              {
                locale === "de"
                  ? "Emblematische Betriebe mit jahrzehntelanger Tradition und Ursprungsgeschichten."
                  : locale === "en"
                    ? "Centenary shops, traditional craft workshops, and iconic establishments."
                    : "Comercios emblemáticos centenarios, talleres artesanos y memoria viva de Mallorca."
              }
            </p>
          </div>
          <span class="hub-arrow">→</span>
        </a>

        <a href={`${prefix}comunidad`} class="hub-card card-glass hover-lift">
          <div class="hub-icon-wrap community-accent">💬</div>
          <div class="hub-info">
            <span class="hub-tag"
              >{locale === "de" ? "Community & Forum" : locale === "en" ? "Local Community" : "Comunidad & Foro"}</span
            >
            <h3 class="hub-title">
              {
                locale === "de"
                  ? "Forum für Residenten"
                  : locale === "en"
                    ? "Residents & Expats Hub"
                    : "Comunidad de Residentes"
              }
            </h3>
            <p class="hub-desc">
              {
                locale === "de"
                  ? "Tausche dich mit Residenten aus, stelle Fragen und entdecke geprüfte Empfehlungen."
                  : locale === "en"
                    ? "Connect with island residents, ask questions, and share genuine recommendations."
                    : "Conecta con residentes, formula preguntas y consulta recomendaciones reales y verificadas."
              }
            </p>
          </div>
          <span class="hub-arrow">→</span>
        </a>
      </div>
    </section>

    <!-- FEATURED SERVICES SECTION -->
    <section id="features" class="section bg-surface">
      <div class="container">
        <div class="section-header-flex">
          <div>
            <h2 class="section-title">{translations["home.featured.title"]}</h2>
            <p class="section-subtitle">{translations["home.featured.subtitle"]}</p>
          </div>
          <a href={`${prefix}servicios`} class="btn btn-secondary btn-sm">
            {translations["home.explore"]} →
          </a>
        </div>

        <div class="services-grid">
          {
            featuredServices.map((service) => (
              <ServiceCard
                service={service}
                currentLocale={locale}
                getLangPrefix={getLangPrefix}
                translations={translations}
              />
            ))
          }
        </div>

        <!-- Dynamic Weekly Top Curated Section -->
        <TopRankedSection locale={locale} prefix={prefix} translations={translations} mode="weekly" />
      </div>
    </section>

    <!-- THEMATIC DISCOVERY TOURS (Inspiration Itineraries) -->
    <div class="container">
      <DiscoveryTours currentLocale={locale} getLangPrefix={getLangPrefix} />
    </div>

    <!-- LATEST BLOG POSTS SECTION -->
    <section class="container section">
      <div class="section-header-flex">
        <div>
          <h2 class="section-title">{translations["home.blog.title"]}</h2>
          <p class="section-subtitle">{translations["home.blog.subtitle"]}</p>
        </div>
        <a href={`${prefix}blog`} class="btn btn-secondary btn-sm">
          {translations["nav.blog"]} →
        </a>
      </div>

      <div class="blog-grid">
        {
          featuredPosts.map((post) => (
            <BlogCard post={post} currentLocale={locale} getLangPrefix={getLangPrefix} translations={translations} />
          ))
        }
      </div>

      <!-- Mallorca Verified Media & Press Mentions Feed -->
      <MallorcaNewsFeed locale={locale} limit={4} />
    </section>

    <!-- TRUST & FEATURES SECTION -->
    <section class="section bg-surface">
      <div class="container">
        <div class="section-header text-center">
          <h2 class="section-title">{translations["home.features.title"]}</h2>
        </div>

        <div class="features-grid">
          <article class="card hover-lift">
            <div class="card-icon">🛡️</div>
            <h3>{translations["home.features.training"]}</h3>
            <p>{translations["home.features.training.description"]}</p>
          </article>

          <article class="card hover-lift">
            <div class="card-icon">📍</div>
            <h3>{translations["home.features.nutrition"]}</h3>
            <p>{translations["home.features.nutrition.description"]}</p>
          </article>

          <article class="card hover-lift">
            <div class="card-icon">🌍</div>
            <h3>{translations["home.features.tracking"]}</h3>
            <p>{translations["home.features.tracking.description"]}</p>
          </article>
        </div>
      </div>
    </section>

    <!-- CTA SECTION -->
    <section class="container section">
      <div class="cta-banner card-glass">
        <div class="cta-content">
          <span class="cta-badge">🌴 Mallorca Pro Network</span>
          <h2 class="cta-title">{translations["home.cta.title"]}</h2>
          <p class="cta-subtitle">{translations["home.cta.subtitle"]}</p>
          <a href={`${prefix}register`} class="btn btn-primary btn-lg">
            {translations["home.cta.button"]}
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer translations={translations} currentLocale={locale} getLangPrefix={getLangPrefix} />
</BaseLayout>

<style>
  /* HERO STYLES */
  .hero-wrapper {
    padding: var(--space-2xl) 0 var(--space-xl);
    background: radial-gradient(ellipse at top, var(--color-primary-bg) 0%, transparent 70%);
    border-bottom: 1px solid var(--color-surface-border);
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 860px;
    gap: var(--space-sm);
  }

  .hero-title {
    font-size: clamp(2.2rem, 5.5vw, var(--font-size-4xl));
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .hero-subtitle {
    font-size: var(--font-size-lg);
    color: var(--color-text-light);
    max-width: 680px;
    line-height: 1.6;
    margin-bottom: var(--space-sm);
  }

  .hero-search-box {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    width: 100%;
    max-width: 650px;
    background: var(--color-surface);
    border: 2px solid var(--color-primary-border);
    border-radius: var(--border-radius-full);
    padding: 0.35rem 0.5rem;
    box-shadow: var(--shadow-md);
    transition:
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .hero-search-box:focus-within {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 4px var(--color-primary-ring);
  }

  .search-input-wrap {
    display: flex;
    align-items: center;
    flex-grow: 1;
    padding-left: 0.75rem;
    gap: 0.5rem;
  }

  .search-icon {
    font-size: 1.1rem;
    user-select: none;
  }

  .hero-search-input {
    width: 100%;
    border: none;
    background: transparent;
    font-size: var(--font-size-base);
    color: var(--color-text);
    padding: 0.5rem 0;
    outline: none;
    font-family: inherit;
  }

  .hero-search-btn {
    border-radius: var(--border-radius-full);
    padding: 0.6rem 1.5rem;
    white-space: nowrap;
  }

  .quick-categories {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-xs);
    margin-top: var(--space-sm);
  }

  .quick-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.85rem;
    border-radius: var(--border-radius-full);
    background: var(--color-surface);
    border: 1px solid var(--color-surface-border);
    font-size: var(--font-size-xs);
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .quick-pill:hover {
    background: var(--color-primary-bg);
    color: var(--color-primary);
    border-color: var(--color-primary-border);
  }

  /* SECTION HEADERS */
  .section-header {
    margin-bottom: var(--space-xl);
  }

  .section-header.text-center {
    text-align: center;
  }

  .section-header-flex {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: var(--space-xl);
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .section-title {
    font-size: var(--font-size-2xl);
    font-weight: 800;
    color: var(--color-text);
    letter-spacing: -0.01em;
  }

  .section-subtitle {
    font-size: var(--font-size-base);
    color: var(--color-text-muted);
    margin-top: 0.25rem;
  }

  .bg-surface {
    background-color: var(--color-surface-hover);
  }

  /* GRIDS */
  .categories-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-md);
  }

  .category-card {
    padding: var(--space-lg);
    border-radius: var(--border-radius);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    border: 1px solid var(--color-surface-border);
  }

  .category-icon {
    font-size: 2.2rem;
    margin-bottom: var(--space-xs);
  }

  .category-name {
    font-size: var(--font-size-lg);
    font-weight: 700;
    color: var(--color-text);
  }

  .category-desc {
    font-size: var(--font-size-sm);
    color: var(--color-text-light);
    line-height: 1.45;
  }

  .services-grid,
  .blog-grid,
  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-lg);
  }

  .card-icon {
    font-size: 2.2rem;
    margin-bottom: var(--space-sm);
  }

  .features-grid .card h3 {
    margin-bottom: var(--space-xs);
    font-size: var(--font-size-lg);
    font-weight: 700;
  }

  .features-grid .card p {
    color: var(--color-text-light);
    font-size: var(--font-size-sm);
    line-height: 1.5;
  }

  /* CTA BANNER */
  .cta-banner {
    padding: var(--space-2xl);
    border-radius: var(--border-radius-lg);
    text-align: center;
    border: 2px solid var(--color-primary-border);
    background: linear-gradient(135deg, var(--color-surface) 0%, var(--color-primary-bg) 100%);
  }

  .cta-content {
    max-width: 600px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
  }

  .cta-badge {
    font-size: var(--font-size-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary);
  }

  .cta-title {
    font-size: var(--font-size-2xl);
    font-weight: 800;
    color: var(--color-text);
  }

  .cta-subtitle {
    font-size: var(--font-size-base);
    color: var(--color-text-light);
    line-height: 1.5;
    margin-bottom: var(--space-xs);
  }

  .btn-lg {
    padding: 0.85rem 2rem;
    font-size: var(--font-size-base);
  }

  /* SPECIALIZED HUBS STYLES */
  .badge-hub {
    display: inline-block;
    padding: 0.3rem 0.8rem;
    background: rgba(30, 144, 255, 0.12);
    border: 1px solid rgba(30, 144, 255, 0.3);
    border-radius: var(--border-radius-full);
    color: var(--color-primary);
    font-size: var(--font-size-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-xs);
  }

  .hubs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-md);
    margin-top: var(--space-md);
  }

  .hub-card {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-surface-border);
    border-radius: var(--border-radius-lg);
    text-decoration: none;
    transition: all var(--transition-base);
  }

  .hub-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-3px);
  }

  .hub-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: var(--border-radius-md);
    font-size: 1.8rem;
    flex-shrink: 0;
  }

  .sports-accent {
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.3);
  }
  .tours-accent {
    background: rgba(212, 175, 55, 0.15);
    border: 1px solid rgba(212, 175, 55, 0.3);
  }
  .history-accent {
    background: rgba(139, 92, 246, 0.15);
    border: 1px solid rgba(139, 92, 246, 0.3);
  }
  .community-accent {
    background: rgba(59, 130, 246, 0.15);
    border: 1px solid rgba(59, 130, 246, 0.3);
  }

  .hub-info {
    flex: 1;
  }

  .hub-tag {
    display: block;
    font-size: var(--font-size-xs);
    font-weight: 700;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.2rem;
  }

  .hub-title {
    font-size: var(--font-size-lg);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.3rem;
  }

  .hub-desc {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    line-height: 1.45;
  }

  .hub-arrow {
    font-size: 1.4rem;
    color: var(--color-text-muted);
    transition: transform var(--transition-base);
  }

  .hub-card:hover .hub-arrow {
    color: var(--color-primary);
    transform: translateX(4px);
  }

  @media (max-width: 640px) {
    .hero-search-box {
      flex-direction: column;
      border-radius: var(--border-radius);
      padding: var(--space-sm);
    }

    .hero-search-btn {
      width: 100%;
    }

    .search-input-wrap {
      padding-left: 0;
      width: 100%;
    }

    .hubs-grid,
    .services-grid,
    .blog-grid,
    .features-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
