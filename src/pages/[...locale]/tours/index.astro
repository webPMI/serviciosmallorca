---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Navbar from "../../../components/Navbar.astro";
import Footer from "../../../components/Footer.astro";
import { getLocaleFromUrl, loadTranslations, getLangPrefix, type Locale } from "../../../i18n";
import { SIGNATURE_TOURS, getHydratedTourBySlug } from "../../../lib/experienceTours.ts";

export const prerender = false;

const locale = getLocaleFromUrl(Astro.url) as Locale;
const translations = await loadTranslations(locale);
const prefix = getLangPrefix(locale);

const hydratedTours = SIGNATURE_TOURS.map((t) => getHydratedTourBySlug(t.slug) || t);

const titles: Record<Locale, string> = {
  es: "Rutas de Experiencia & Tours Temáticos en Mallorca",
  en: "Experience Tours & Curated Signature Routes in Mallorca",
  ca: "Rutes d'Experiència i Tours Temàtics a Mallorca",
  de: "Erlebnis-Routen & Ausgewählte Signature-Touren auf Mallorca",
};

const descriptions: Record<Locale, string> = {
  es: "Itinerarios temáticos conectados con SmartMatch para descubrir la artesanía, náutica, gastronomía y bienestar de Mallorca paso a paso.",
  en: "SmartMatch connected themed itineraries exploring artisan crafts, yachting, cuisine, and wellness across Mallorca step by step.",
  ca: "Itineraris temàtics connectats amb SmartMatch per descobrir l'artesania, nàutica, gastronomia i benestar de Mallorca pas a pas.",
  de: "Mit SmartMatch vernetzte thematische Reiserouten für Handwerkskunst, Yachting, Kulinarik und Entspannung auf Mallorca.",
};
---

<BaseLayout title={`${titles[locale]} | Servicios Mallorca`} lang={locale} description={descriptions[locale]}>
  <Navbar currentLocale={locale} translations={translations} getLangPrefix={getLangPrefix} />

  <main class="container section">
    <!-- Breadcrumbs Navigation -->
    <nav class="breadcrumb-nav" aria-label="Breadcrumb">
      <a href={prefix}>{translations["nav.home"] || "Inicio"}</a>
      <span>/</span>
      <span class="active-crumb">{titles[locale]}</span>
    </nav>

    <!-- Header Hero -->
    <header class="tours-hero">
      <span class="badge-tour"
        >🗺️ {
          locale === "de" ? "SmartMatch Routen" : locale === "en" ? "Curated Itineraries" : "Rutas de Experiencia"
        }</span
      >
      <h1 class="hero-title">{titles[locale]}</h1>
      <p class="hero-subtitle">{descriptions[locale]}</p>
    </header>

    <!-- Tours Grid -->
    <div class="tours-grid">
      {
        hydratedTours.map((tour) => (
          <article class="tour-card">
            <div class="tour-card-header">
              <span class="badge-theme">{tour.theme.replace("_", " & ").toUpperCase()}</span>
              <span class="tour-meta">
                ⏱️ {tour.estimatedTotalHours}h | 🚗 {tour.totalDistanceKm} km
              </span>
            </div>
            <h2 class="tour-title">{tour.title[locale] || tour.title.es}</h2>
            {/* Stops Timeline Preview */}
            <div class="stops-preview">
              <span class="stops-count">
                📍 {tour.stops.length} {locale === "de" ? "Stationen" : locale === "en" ? "Stops" : "Paradas"}:
              </span>
              <ul class="stops-list">
                {tour.stops.map((stop) => (
                  <li>
                    <span class="stop-num">{stop.stopNumber}</span>
                    <span class="stop-name">{stop.service.name}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="tour-card-footer">
              <a href={`${prefix}tours/${tour.slug}`} class="btn-tour">
                {locale === "de"
                  ? "Komplette Route ansehen"
                  : locale === "en"
                    ? "Explore Full Itinerary"
                    : "Ver Itinerario Completo"}{" "}
                &rarr;
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </main>

  <Footer translations={translations} currentLocale={locale} getLangPrefix={getLangPrefix} />
</BaseLayout>

<style>
  .breadcrumb-nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }
  .breadcrumb-nav a {
    color: var(--color-accent);
    text-decoration: none;
  }
  .active-crumb {
    color: var(--color-text-main);
    font-weight: 500;
  }
  .tours-hero {
    text-align: center;
    max-width: 860px;
    margin: 0 auto 3rem;
    padding: var(--space-xl) var(--space-md);
    background: radial-gradient(ellipse at top, rgba(212, 175, 55, 0.12) 0%, transparent 70%);
    border-radius: var(--border-radius-xl);
    border: 1px solid rgba(212, 175, 55, 0.2);
  }
  .badge-tour {
    display: inline-block;
    padding: 0.35rem 0.85rem;
    background: rgba(212, 175, 55, 0.15);
    border: 1px solid rgba(212, 175, 55, 0.4);
    border-radius: 9999px;
    color: var(--color-accent);
    font-size: 0.875rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }
  .hero-title {
    font-size: clamp(2rem, 4vw, 2.5rem);
    font-weight: 800;
    color: var(--color-text);
    line-height: 1.2;
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
  }
  .hero-subtitle {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }
  .tours-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 2rem;
    margin-bottom: 4rem;
  }
  .tour-card {
    background: var(--color-surface);
    border: 1px solid var(--color-surface-border);
    border-radius: var(--border-radius-lg);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm);
    transition:
      transform var(--transition-smooth),
      box-shadow var(--transition-smooth),
      border-color var(--transition-smooth);
  }
  .tour-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 32px rgba(0, 0, 0, 0.12);
    border-color: var(--color-accent);
  }
  .tour-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }
  .badge-theme {
    background: rgba(212, 175, 55, 0.15);
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.3rem 0.7rem;
    border-radius: var(--border-radius-full);
    border: 1px solid rgba(212, 175, 55, 0.3);
  }
  .tour-meta {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }
  .tour-title {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--color-text);
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }
  .stops-preview {
    background: var(--color-surface-hover);
    border: 1px solid var(--color-surface-border);
    border-radius: var(--border-radius-md);
    padding: 1.25rem;
    margin-bottom: 1.5rem;
  }
  .stops-count {
    display: block;
    font-size: 0.825rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .stops-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .stops-list li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.875rem;
  }
  .stop-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.4rem;
    height: 1.4rem;
    background: linear-gradient(135deg, #ffd700, #f59e0b);
    color: #1a1a1a;
    font-size: 0.75rem;
    font-weight: 800;
    border-radius: 9999px;
    flex-shrink: 0;
    box-shadow: 0 2px 4px rgba(245, 158, 11, 0.3);
  }
  .stop-name {
    color: var(--color-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-weight: 500;
  }
  .tour-card-footer {
    margin-top: auto;
  }
  .btn-tour {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    text-align: center;
    background: linear-gradient(135deg, #ffd700, #d97706);
    color: #1a1a1a;
    font-size: 0.95rem;
    font-weight: 800;
    padding: 0.75rem 1.25rem;
    border-radius: var(--border-radius-md);
    text-decoration: none;
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
    box-shadow: 0 4px 12px rgba(217, 119, 6, 0.25);
  }
  .btn-tour:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(217, 119, 6, 0.4);
  }
</style>
