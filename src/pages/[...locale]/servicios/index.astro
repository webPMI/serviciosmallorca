---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Navbar from "../../../components/Navbar.astro";
import Footer from "../../../components/Footer.astro";
import ServiceCard from "../../../components/ServiceCard.astro";
import AdSenseSlot from "../../../components/AdSenseSlot.astro";
import BusinessJoinBanner from "../../../components/BusinessJoinBanner.astro";
import { getActiveCategories, CATEGORIES } from "../../../data/categories";
import { MALLORCA_ZONES } from "../../../data/zones";
import { SERVICES } from "../../../data/services";
import { getLocaleFromUrl, loadTranslations, getLangPrefix, type Locale } from "../../../i18n";

export const prerender = false;

const locale = getLocaleFromUrl(Astro.url) as Locale;
const translations = await loadTranslations(locale);
const prefix = getLangPrefix(locale);

const activeCategories = getActiveCategories(SERVICES);

// Count active services per category
const categoryCountMap = new Map<string, number>();
SERVICES.filter((s) => s.status !== "permanently_closed").forEach((s) => {
  if (s.category) categoryCountMap.set(s.category, (categoryCountMap.get(s.category) || 0) + 1);
  if (s.secondaryCategories && Array.isArray(s.secondaryCategories)) {
    s.secondaryCategories.forEach((sec) => categoryCountMap.set(sec, (categoryCountMap.get(sec) || 0) + 1));
  }
});

// Sort active categories alphabetically with counts
const sortedCategories = CATEGORIES.filter(
  (cat) => categoryCountMap.has(cat.id) && (categoryCountMap.get(cat.id) || 0) > 0,
).sort((a, b) => (a.name[locale] || a.name.es).localeCompare(b.name[locale] || b.name.es, locale));

// Query parameters from URL for initial SSR rendering
const selectedCategory = Astro.url.searchParams.get("categoria") || "";
const selectedZone = Astro.url.searchParams.get("zona") || "";
const searchQuery = (Astro.url.searchParams.get("q") || "").toLowerCase().trim();

// Filter services for initial SSR
const initialFilteredServices = SERVICES.filter((service) => {
  if (selectedCategory && service.category !== selectedCategory) {
    return false;
  }
  if (selectedZone && service.zone !== selectedZone) {
    return false;
  }
  if (searchQuery) {
    const nameMatch = service.name.toLowerCase().includes(searchQuery);
    const descMatch = (service.shortDescription[locale] || service.shortDescription.en)
      .toLowerCase()
      .includes(searchQuery);
    const tagMatch = service.tags.some((t) => t.toLowerCase().includes(searchQuery));
    if (!nameMatch && !descMatch && !tagMatch) {
      return false;
    }
  }
  return true;
});
---

<BaseLayout
  title={`${translations["services.title"]} - ${translations["site.title"]}`}
  lang={locale}
  description={translations["services.subtitle"]}
>
  <Navbar currentLocale={locale} translations={translations} getLangPrefix={getLangPrefix} />

  <main class="container section">
    <!-- Header -->
    <header class="directory-header text-center fade-in">
      <span class="badge badge-primary">🌴 Mallorca</span>
      <h1 class="directory-title">{translations["services.title"]}</h1>
      <p class="directory-subtitle">{translations["services.subtitle"]}</p>
    </header>

    <!-- Interactive Search & Filters Bar -->
    <section class="filters-card card card-glass fade-in">
      <form id="directory-filter-form" method="GET" action={`${prefix}servicios`} class="filters-form">
        <!-- Search Input with live search icon -->
        <div class="filter-group filter-search">
          <span class="search-icon-inside">🔍</span>
          <input
            type="text"
            id="live-search-input"
            name="q"
            value={searchQuery}
            placeholder={translations["home.search.placeholder"] || "Buscar por nombre, especialidad o zona..."}
            class="input-field with-icon"
            aria-label="Buscar servicios"
            autocomplete="off"
          />
          <button
            type="button"
            id="clear-search-btn"
            class="clear-search-btn"
            style={searchQuery ? "display:block;" : "display:none;"}>✕</button
          >
        </div>

        <!-- Category Dropdown (Sorted alphabetically with exact real counts) -->
        <div class="filter-group">
          <select
            id="category-filter-select"
            name="categoria"
            class="select-field"
            aria-label={translations["services.allCategories"] || "Filtrar por categoría"}
          >
            <option value="">{translations["services.allCategories"] || "Todas las Categorías"}</option>
            {
              sortedCategories.map((cat) => {
                const count = categoryCountMap.get(cat.id) || 0;
                return (
                  <option value={cat.id} selected={selectedCategory === cat.id}>
                    {cat.icon} {cat.name[locale] || cat.name.es} ({count})
                  </option>
                );
              })
            }
          </select>
        </div>

        <!-- Zone Dropdown -->
        <div class="filter-group">
          <select id="zone-filter-select" name="zona" class="select-field" aria-label="Filtrar por zona">
            <option value="">{translations["services.allZones"]}</option>
            {
              MALLORCA_ZONES.map((zone) => (
                <option value={zone.id} selected={selectedZone === zone.id}>
                  📍 {zone.name[locale]}
                </option>
              ))
            }
          </select>
        </div>

        <!-- Action Buttons -->
        <div class="filter-actions">
          <button type="submit" class="btn btn-primary btn-sm">
            {translations["home.search.button"]}
          </button>
          <a
            id="reset-filters-btn"
            href={`${prefix}servicios`}
            class="btn btn-secondary btn-sm"
            style={selectedCategory || selectedZone || searchQuery ? "display:inline-flex;" : "display:none;"}
          >
            {translations["services.clearFilters"] || "Limpiar"}
          </a>
        </div>
      </form>

      <!-- Intent Quick Filter Chips -->
      <div class="intent-chips-bar" aria-label={translations["services.filter.intentsTitle"] || "Filtros Rápidos"}>
        <span class="intent-chips-label">⚡ {translations["services.filter.intentsTitle"] || "Filtros Rápidos"}:</span>
        <button type="button" class="intent-chip-btn" data-intent-filter="open-now">
          <span class="chip-icon">🕒</span>
          <span>{translations["services.filter.openNow"] || "Abierto Ahora"}</span>
        </button>
        <button type="button" class="intent-chip-btn" data-intent-filter="multilingual">
          <span class="chip-icon">🌐</span>
          <span>{translations["services.filter.multilingual"] || "Inglés / Alemán"}</span>
        </button>
        <button type="button" class="intent-chip-btn" data-intent-filter="terrace">
          <span class="chip-icon">☀️</span>
          <span>{translations["services.filter.terrace"] || "Con Terraza"}</span>
        </button>
        <button type="button" class="intent-chip-btn" data-intent-filter="pet-friendly">
          <span class="chip-icon">🐾</span>
          <span>{translations["services.filter.petFriendly"] || "Pet Friendly"}</span>
        </button>
        <button type="button" class="intent-chip-btn" data-intent-filter="accessible">
          <span class="chip-icon">♿</span>
          <span>{translations["services.filter.accessible"] || "Accesible PMR"}</span>
        </button>
      </div>
    </section>

    <!-- Category Quick Filter Pills (Only active categories) -->
    {
      activeCategories.length > 0 && (
        <div class="category-pills-bar">
          <a href={`${prefix}servicios`} class:list={["pill-link", { active: !selectedCategory }]} data-cat-pill="">
            <span>🌟</span>
            <span>{translations["services.allCategories"]}</span>
          </a>
          {activeCategories.map((cat) => (
            <a
              href={`${prefix}servicios?categoria=${cat.id}${selectedZone ? `&zona=${selectedZone}` : ""}`}
              class:list={["pill-link", { active: selectedCategory === cat.id }]}
              data-cat-pill={cat.id}
            >
              <span>{cat.icon}</span>
              <span>{cat.name[locale]}</span>
            </a>
          ))}
        </div>
      )
    }

    <!-- Active Filter & Count Stats Toolbar -->
    <div class="results-stats-toolbar">
      <div class="results-count-text">
        <span class="count-badge" id="results-count-num">{initialFilteredServices.length}</span>
        <span>
          {translations["services.results.showing"] || "Mostrando"}
          <strong id="results-count-display">{initialFilteredServices.length}</strong>
          {translations["services.results.of"] || "de"}
          {SERVICES.filter((s) => s.status !== "permanently_closed").length}
          {translations["services.results.label"] || "servicios"}
        </span>
      </div>
      <div class="results-toolbar-right">
        <!-- Sort selector -->
        <div class="sort-wrap">
          <label for="sort-select" class="sort-label">{translations["services.sort.label"] || "Ordenar"}:</label>
          <select id="sort-select" class="select-field select-sm" aria-label={translations["services.sort.label"]}>
            <option value="default">{translations["services.sort.rating"] || "Mejor valorado"}</option>
            <option value="az">{translations["services.sort.az"] || "A - Z"}</option>
            <option value="newest">{translations["services.sort.newest"] || "Más reciente"}</option>
          </select>
        </div>
        <!-- View toggle -->
        <div class="view-toggle" role="group" aria-label="Vista">
          <button
            id="view-grid-btn"
            class="view-toggle-btn active"
            aria-pressed="true"
            title={translations["services.viewToggle.grid"] || "Grid"}
          >
            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <rect x="0" y="0" width="7" height="7" rx="1"></rect>
              <rect x="9" y="0" width="7" height="7" rx="1"></rect>
              <rect x="0" y="9" width="7" height="7" rx="1"></rect>
              <rect x="9" y="9" width="7" height="7" rx="1"></rect>
            </svg>
          </button>
          <button
            id="view-list-btn"
            class="view-toggle-btn"
            aria-pressed="false"
            title={translations["services.viewToggle.list"] || "Lista"}
          >
            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <rect x="0" y="1" width="16" height="3" rx="1"></rect>
              <rect x="0" y="6" width="16" height="3" rx="1"></rect>
              <rect x="0" y="11" width="16" height="3" rx="1"></rect>
            </svg>
          </button>
        </div>
        <div class="quick-add-service-cta">
          <a href={`${prefix}dashboard`} class="btn btn-outline-primary btn-xs">
            <span>+ Publicar Negocio</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Banner Informativo de Transparencia del Directorio -->
    <div class="directory-transparency-banner">
      <p>
        <span
          >🤖 <strong>Transparencia Informativa:</strong> Los datos de comercios no reclamados se recopilan de fuentes públicas
          abiertas (Google Maps y webs oficiales) para facilitar el contacto. Recomendamos verificar horarios y precios con
          cada establecimiento antes de acudir. ¿Eres titular? <a href={`${prefix}dashboard`}>Reclama tu ficha gratis</a
          >.</span
        >
      </p>
    </div>

    <!-- Results Directory Grid -->
    <div id="services-grid" class="services-directory-grid" data-view="grid">
      {
        SERVICES.map((service) => {
          const isMatch = initialFilteredServices.some((s) => s.id === service.id);
          const hasTerrace = Boolean(service.capabilities?.terrace || service.amenities?.includes("terrace"));
          const isPetFriendly = Boolean(service.capabilities?.petFriendly || service.amenities?.includes("pet_friendly"));
          const isAccessible = Boolean(service.capabilities?.wheelchairAccessible || service.amenities?.includes("wheelchair_accessible"));
          const isMultilingual = Boolean(
            service.languagesSpoken?.some((l) => l === "en" || l === "de") ||
            service.culturalIdentity === "german_oriented" ||
            service.culturalIdentity === "british_oriented"
          );

          return (
            <div
              class="service-item-wrapper"
              data-id={service.id}
              data-name={service.name.toLowerCase()}
              data-desc={(service.shortDescription[locale] || service.shortDescription.en).toLowerCase()}
              data-tags={service.tags.join(" ").toLowerCase()}
              data-category={service.category}
              data-zone={service.zone}
              data-rating={service.rating || 0}
              data-slug={service.slug}
              data-schedule={service.schedule || ""}
              data-status={service.status || "open"}
              data-multilingual={String(isMultilingual)}
              data-terrace={String(hasTerrace)}
              data-pet={String(isPetFriendly)}
              data-accessible={String(isAccessible)}
              style={isMatch ? "display:block;" : "display:none;"}
            >
              <ServiceCard
                service={service}
                currentLocale={locale}
                getLangPrefix={getLangPrefix}
                translations={translations}
              />
            </div>
          );
        })
      }
    </div>

    <!-- No Results Box -->
    <div
      id="no-results-box"
      class="no-results-box card card-glass text-center"
      style={initialFilteredServices.length === 0 ? "display:flex;" : "display:none;"}
    >
      <span class="no-results-icon">🔎</span>
      <h3>{translations["services.noResults"]}</h3>
      <p>Prueba a buscar por otra palabra clave, cambiar de categoría o restablecer los filtros.</p>
      <button type="button" id="no-results-reset-btn" class="btn btn-primary btn-sm" style="margin-top: 1rem;">
        Ver todos los servicios
      </button>
    </div>

    <!-- Banner de Captación para Dueños de Negocios en Mallorca -->
    <BusinessJoinBanner locale={locale} translations={translations} />

    <!-- AdSense Bottom Slot -->
    <AdSenseSlot format="horizontal" slotId="services-directory-bottom" />
  </main>

  <Footer translations={translations} currentLocale={locale} getLangPrefix={getLangPrefix} />
</BaseLayout>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const searchInput = document.getElementById("live-search-input");
    const categorySelect = document.getElementById("category-filter-select");
    const zoneSelect = document.getElementById("zone-filter-select");
    const clearBtn = document.getElementById("clear-search-btn");
    const resetBtn = document.getElementById("reset-filters-btn");
    const noResultsResetBtn = document.getElementById("no-results-reset-btn");
    const countNum = document.getElementById("results-count-num");
    const countDisplay = document.getElementById("results-count-display");
    const noResultsBox = document.getElementById("no-results-box");
    const items = Array.from(document.querySelectorAll(".service-item-wrapper"));
    const catPills = Array.from(document.querySelectorAll("[data-cat-pill]"));
    const intentChips = Array.from(document.querySelectorAll("[data-intent-filter]"));

    const activeIntents = new Set();

    function isBusinessCurrentlyOpen(scheduleText, status) {
      if (status === "permanently_closed" || status === "seasonal_closure") return false;
      if (!scheduleText || scheduleText.trim() === "") return true; // Default fallback to active

      const raw = scheduleText.toLowerCase();
      if (raw.includes("24 horas") || raw.includes("24h") || raw.includes("24/7")) return true;

      // Madrid / Mallorca current time
      const now = new Date();
      const formatterHour = new Intl.DateTimeFormat("es-ES", {
        timeZone: "Europe/Madrid",
        hour: "numeric",
        minute: "numeric",
        hour12: false,
      });
      const formatterDay = new Intl.DateTimeFormat("es-ES", {
        timeZone: "Europe/Madrid",
        weekday: "short",
      });

      const dayStr = formatterDay.format(now).toLowerCase();
      const [hStr, mStr] = formatterHour.format(now).split(":");
      const currentMin = parseInt(hStr, 10) * 60 + parseInt(mStr || "0", 10);

      const isSunday = dayStr.startsWith("dom") || dayStr.startsWith("sun");
      if (isSunday && (raw.includes("lun - sáb") || raw.includes("lunes a viernes") || raw.includes("domingo cerrado") || raw.includes("dom: cerrado"))) {
        return false;
      }

      const isSaturday = dayStr.startsWith("sáb") || dayStr.startsWith("sab") || dayStr.startsWith("sat");
      if (isSaturday && (raw.includes("lunes a viernes") || raw.includes("lun - vie") || raw.includes("sáb: cerrado"))) {
        return false;
      }

      const regex = /(\d{1,2})[:.](\d{2})\s*(?:-|a|–)\s*(\d{1,2})[:.](\d{2})/g;
      let match;
      let hasRanges = false;
      while ((match = regex.exec(scheduleText)) !== null) {
        hasRanges = true;
        const startMin = parseInt(match[1], 10) * 60 + parseInt(match[2], 10);
        const endMin = parseInt(match[3], 10) * 60 + parseInt(match[4], 10);
        if (currentMin >= startMin && currentMin < endMin) {
          return true;
        }
      }

      return !hasRanges; // Si no hay horas explícitas, asumir abierto si el día concuerda
    }

    function applyFilters() {
      const q = (searchInput?.value || "").toLowerCase().trim();
      const cat = categorySelect?.value || "";
      const zone = zoneSelect?.value || "";

      if (clearBtn) {
        clearBtn.style.display = q ? "block" : "none";
      }

      const hasActiveFilters = q || cat || zone || activeIntents.size > 0;
      if (resetBtn) {
        resetBtn.style.display = hasActiveFilters ? "inline-flex" : "none";
      }

      // Update cat pills active state
      catPills.forEach((pill) => {
        const pillCat = pill.getAttribute("data-cat-pill");
        if (pillCat === cat) {
          pill.classList.add("active");
        } else {
          pill.classList.remove("active");
        }
      });

      let visibleCount = 0;

      items.forEach((el) => {
        const itemCat = el.getAttribute("data-category") || "";
        const itemZone = el.getAttribute("data-zone") || "";
        const name = el.getAttribute("data-name") || "";
        const desc = el.getAttribute("data-desc") || "";
        const tags = el.getAttribute("data-tags") || "";
        const schedule = el.getAttribute("data-schedule") || "";
        const status = el.getAttribute("data-status") || "open";
        const isMultilingual = el.getAttribute("data-multilingual") === "true";
        const hasTerrace = el.getAttribute("data-terrace") === "true";
        const isPet = el.getAttribute("data-pet") === "true";
        const isAccessible = el.getAttribute("data-accessible") === "true";

        let match = true;

        if (cat && itemCat !== cat) match = false;
        if (zone && itemZone !== zone) match = false;
        if (q && !name.includes(q) && !desc.includes(q) && !tags.includes(q)) match = false;

        // Intent filters
        if (match && activeIntents.has("open-now") && !isBusinessCurrentlyOpen(schedule, status)) {
          match = false;
        }
        if (match && activeIntents.has("multilingual") && !isMultilingual) {
          match = false;
        }
        if (match && activeIntents.has("terrace") && !hasTerrace) {
          match = false;
        }
        if (match && activeIntents.has("pet-friendly") && !isPet) {
          match = false;
        }
        if (match && activeIntents.has("accessible") && !isAccessible) {
          match = false;
        }

        if (match) {
          el.style.display = "block";
          visibleCount++;
        } else {
          el.style.display = "none";
        }
      });

      if (countNum) countNum.textContent = String(visibleCount);
      if (countDisplay) countDisplay.textContent = String(visibleCount);

      if (noResultsBox) {
        noResultsBox.style.display = visibleCount === 0 ? "flex" : "none";
      }
    }

    // Toggle Intent Chips
    intentChips.forEach((chip) => {
      chip.addEventListener("click", () => {
        const intentKey = chip.getAttribute("data-intent-filter");
        if (!intentKey) return;

        if (activeIntents.has(intentKey)) {
          activeIntents.delete(intentKey);
          chip.classList.remove("active");
        } else {
          activeIntents.add(intentKey);
          chip.classList.add("active");
        }
        applyFilters();
      });
    });

    // Debounced live typing search
    let debounceTimer;
    searchInput?.addEventListener("input", () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(applyFilters, 150);
    });

    categorySelect?.addEventListener("change", applyFilters);
    zoneSelect?.addEventListener("change", applyFilters);

    clearBtn?.addEventListener("click", () => {
      if (searchInput) searchInput.value = "";
      applyFilters();
      searchInput?.focus();
    });

    const resetAll = () => {
      if (searchInput) searchInput.value = "";
      if (categorySelect) categorySelect.value = "";
      if (zoneSelect) zoneSelect.value = "";
      activeIntents.clear();
      intentChips.forEach((chip) => chip.classList.remove("active"));
      applyFilters();
    };

    resetBtn?.addEventListener("click", (e) => {
      e.preventDefault();
      resetAll();
    });

    noResultsResetBtn?.addEventListener("click", resetAll);

    // ─── SORT ───
    const sortSelect = document.getElementById("sort-select");
    const grid = document.getElementById("services-grid");

    sortSelect?.addEventListener("change", () => {
      const sortVal = sortSelect.value;
      const visibleItems = items.filter((el) => el.style.display !== "none");
      visibleItems.sort((a, b) => {
        if (sortVal === "az") {
          return (a.getAttribute("data-name") || "").localeCompare(b.getAttribute("data-name") || "");
        }
        if (sortVal === "newest") {
          return (b.getAttribute("data-slug") || "").localeCompare(a.getAttribute("data-slug") || "");
        }
        return parseFloat(b.getAttribute("data-rating") || "0") - parseFloat(a.getAttribute("data-rating") || "0");
      });
      visibleItems.forEach((el) => grid?.appendChild(el));
    });

    // ─── VIEW TOGGLE ───
    const gridBtn = document.getElementById("view-grid-btn");
    const listBtn = document.getElementById("view-list-btn");

    gridBtn?.addEventListener("click", () => {
      grid?.setAttribute("data-view", "grid");
      gridBtn.classList.add("active");
      gridBtn.setAttribute("aria-pressed", "true");
      listBtn?.classList.remove("active");
      listBtn?.setAttribute("aria-pressed", "false");
    });

    listBtn?.addEventListener("click", () => {
      grid?.setAttribute("data-view", "list");
      listBtn.classList.add("active");
      listBtn.setAttribute("aria-pressed", "true");
      gridBtn?.classList.remove("active");
      gridBtn?.setAttribute("aria-pressed", "false");
    });
  });
</script>

<style>
  .directory-header {
    margin-bottom: var(--space-xl);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
  }

  .directory-title {
    font-size: clamp(2rem, 4vw, var(--font-size-4xl));
    font-weight: 800;
    margin: 0;
    line-height: 1.15;
  }

  .directory-subtitle {
    color: var(--color-text-muted);
    font-size: var(--font-size-base);
    max-width: 620px;
    margin: 0;
  }

  .results-stats-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
    padding: var(--space-sm) 0;
  }

  .results-toolbar-right {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .sort-wrap {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .sort-label {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    font-weight: 600;
    white-space: nowrap;
  }

  .select-sm {
    padding: 0.3rem 0.6rem;
    font-size: var(--font-size-xs);
  }

  .view-toggle {
    display: flex;
    gap: 2px;
    background: var(--color-surface-hover);
    border-radius: var(--border-radius-sm);
    padding: 2px;
    border: 1px solid var(--color-surface-border);
  }

  .view-toggle-btn {
    width: 32px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    background: transparent;
    border-radius: calc(var(--border-radius-sm) - 2px);
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .view-toggle-btn.active {
    background: var(--color-surface);
    color: var(--color-primary);
    box-shadow: var(--shadow-sm);
  }

  .view-toggle-btn:hover:not(.active) {
    color: var(--color-text);
    background: rgba(0, 0, 0, 0.04);
  }

  /* List view mode */
  #services-grid[data-view="list"] {
    grid-template-columns: 1fr !important;
  }

  #services-grid[data-view="list"] .service-item-wrapper {
    max-width: 100%;
