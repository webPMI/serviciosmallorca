---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Navbar from "../../../components/Navbar.astro";
import Footer from "../../../components/Footer.astro";
import AdSenseSlot from "../../../components/AdSenseSlot.astro";
import ServiceImage from "../../../components/ServiceImage.astro";
import VisualGalleryShowcase from "../../../components/VisualGalleryShowcase.astro";
import MapsRatingBox from "../../../components/MapsRatingBox.astro";
import SocialFeedSection from "../../../components/SocialFeedSection.astro";
import LiveScheduleBadge from "../../../components/LiveScheduleBadge.astro";
import { getServiceById } from "../../../data/services";
import { CATEGORIES } from "../../../data/categories";
import { MALLORCA_ZONES } from "../../../data/zones";
import { BLOG_POSTS } from "../../../data/posts";
import { getLocaleFromUrl, loadTranslations, getLangPrefix, type Locale } from "../../../i18n";

export const prerender = false;

const locale = getLocaleFromUrl(Astro.url) as Locale;
const translations = await loadTranslations(locale);
const prefix = getLangPrefix(locale);

const { slug } = Astro.params;
const service = slug ? getServiceById(slug) : undefined;

if (!service) {
  return Astro.redirect(`${prefix}servicios`);
}

const category = CATEGORIES.find((c) => c.id === service.category);
const zone = MALLORCA_ZONES.find((z) => z.id === service.zone);
const categoryName = category?.name[locale] || service.category;
const zoneName = zone?.name[locale] || service.zone;

// Related blog posts
const relatedPosts = BLOG_POSTS.filter((p) => p.relatedServiceIds.includes(service.id));

// Schema.org structured data for Local SEO and AI Search Engines (Perplexity, ChatGPT, SGE)
const schemaOrg = {
  "@context": "https://schema.org",
  "@type": service.category === "arte-tatuajes" ? ["LocalBusiness", "TattooParlor"] : "LocalBusiness",
  name: service.name,
  image: service.image,
  telephone: service.phone,
  email: service.email,
  url: service.website || Astro.url.href,
  hasMap: service.googleMapsUrl,
  sameAs: [service.googleMapsUrl, service.appleMapsUrl, service.bingMapsUrl, service.website].filter(Boolean),
  priceRange: service.priceRange,
  openingHours: service.schedule,
  geo: service.coordinates
    ? {
        "@type": "GeoCoordinates",
        latitude: service.coordinates.lat,
        longitude: service.coordinates.lng,
      }
    : undefined,
  address: {
    "@type": "PostalAddress",
    streetAddress: service.address,
    addressLocality: "Palma de Mallorca",
    addressRegion: "Illes Balears",
    postalCode: "07002",
    addressCountry: "ES",
  },
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: service.rating,
    reviewCount: service.reviewCount,
    bestRating: "5",
    worstRating: "1",
  },
  description: service.fullDescription[locale],
};
---

<BaseLayout
  title={`${service.name} - ${translations["site.title"]}`}
  lang={locale}
  description={service.shortDescription[locale]}
>
  <!-- Schema.org for Local SEO -->
  <script type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />

  <Navbar currentLocale={locale} translations={translations} getLangPrefix={getLangPrefix} />

  <main class="container section">
    <!-- Breadcrumb -->
    <nav class="breadcrumb-nav" aria-label="Breadcrumb">
      <a href={prefix}>{translations["nav.home"]}</a>
      <span>/</span>
      <a href={`${prefix}servicios`}>{translations["nav.services"]}</a>
      <span>/</span>
      <span class="active-crumb">{service.name}</span>
    </nav>

    <!-- Header Section -->
    <div class="service-detail-header">
      <div class="header-main">
        <div class="header-badges">
          <span class="badge badge-primary">{category?.icon} {categoryName}</span>
          <span class="badge badge-accent">📍 {zoneName}</span>
          {service.verified && <span class="badge badge-success">✓ {translations["services.verifiedBadge"]}</span>}
          <span class="badge badge-price">{service.priceRange}</span>
        </div>

        <h1 class="detail-title">{service.name}</h1>
        <p class="detail-lead">{service.shortDescription[locale]}</p>

        <div class="rating-bar">
          <span class="rating-stars">★★★★★</span>
          <strong class="rating-val">{service.rating.toFixed(1)}</strong>
          <span class="rating-reviews">({service.reviewCount} {translations["services.reviews"]})</span>
        </div>
      </div>
    </div>

    <!-- Layout Grid: Main Content & Sidebar -->
    <div class="detail-grid">
      <!-- Left Column: Media & Information -->
      <div class="detail-content">
        <!-- Main Image / Gallery -->
        <div class="gallery-container card">
          <div class="main-image-wrap">
            <ServiceImage
              id="detail-main-display-img"
              src={service.image}
              alt={service.name}
              categoryIcon={category?.icon}
              categoryName={categoryName}
              aspectRatio="auto"
              className="detail-main-img"
              loading="eager"
            />
          </div>
          {
            service.gallery && service.gallery.length > 0 && (
              <div class="gallery-thumbnails" id="gallery-thumbs-row">
                {service.image && (
                  <button type="button" class="thumb-btn active" data-img-url={service.image}>
                    <img
                      src={service.image}
                      alt={`${service.name} portada`}
                      class="thumb-img"
                      loading="lazy"
                      onerror="this.parentElement.style.display='none';"
                    />
                  </button>
                )}
                {service.gallery.map((imgUrl, index) => (
                  <button type="button" class="thumb-btn" data-img-url={imgUrl}>
                    <img
                      src={imgUrl}
                      alt={`${service.name} foto ${index + 1}`}
                      class="thumb-img"
                      loading="lazy"
                      onerror="this.parentElement.style.display='none';"
                    />
                  </button>
                ))}
              </div>
            )
          }
        </div>

        <!-- Full Description -->
        <section class="card section-box">
          <h2 class="box-title">Acerca de este Servicio</h2>
          <p class="desc-text">{service.fullDescription[locale]}</p>
        </section>

        <!-- Highlights & Guarantees -->
        <section class="card section-box">
          <h2 class="box-title">{translations["services.highlights"]}</h2>
          <ul class="highlights-list">
            {
              service.highlights[locale].map((item) => (
                <li class="highlight-item">
                  <span class="check-icon">✓</span>
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </section>

        <!-- Services Included -->
        <section class="card section-box">
          <h2 class="box-title">{translations["services.provided"]}</h2>
          <div class="services-chips">
            {service.servicesProvided[locale].map((srv) => <span class="service-chip">🔹 {srv}</span>)}
          </div>
        </section>

        <!-- Founder Story & Heritage (If Available) -->
        {
          (service.founderStory?.[locale] || service.foundedYear) && (
            <section class="card section-box founder-story-box">
              <div class="story-header-flex">
                <span class="story-icon">📜</span>
                <div>
                  <h2 class="box-title">
                    Historia de Autor {service.foundedYear ? `· Desde ${service.foundedYear}` : ""}
                  </h2>
                  {service.founderName && (
                    <p class="founder-subtitle">
                      Fundado y dirigido por <strong>{service.founderName}</strong>
                    </p>
                  )}
                </div>
              </div>
              {service.founderStory?.[locale] && <p class="story-text">{service.founderStory[locale]}</p>}
            </section>
          )
        }

        <!-- Awards & Recognition (If Available) -->
        {
          service.awards && service.awards.length > 0 && (
            <section class="card section-box awards-box">
              <h2 class="box-title">🏆 Premios & Reconocimientos Oficiales</h2>
              <div class="awards-grid">
                {service.awards.map((award) => (
                  <div class="award-card">
                    <div class="award-icon">🥇</div>
                    <div class="award-details">
                      <strong class="award-title">{award.title}</strong>
                      <span class="award-meta">
                        {award.issuer} {award.year ? `(${award.year})` : ""}
                      </span>
                    </div>
                  </div>
                ))}
              </div>
            </section>
          )
        }

        <!-- Official Visual Portfolio & Photo Gallery Showcase -->
        <VisualGalleryShowcase
          businessName={service.name}
          mainImage={service.image}
          gallery={service.gallery}
          currentLocale={locale}
        />

        <!-- Team & Resident Artists (If Available) -->
        {
          service.teamMembers && service.teamMembers.length > 0 && (
            <section class="card section-box team-section">
              <h2 class="box-title">🎨 Equipo de Profesionales & Artistas Residentes</h2>
              <div class="team-grid">
                {service.teamMembers.map((member) => (
                  <div class="team-member-card">
                    {member.avatarUrl ? (
                      <img src={member.avatarUrl} alt={member.name} class="team-avatar" />
                    ) : (
                      <div class="team-avatar-placeholder">{member.name.charAt(0)}</div>
                    )}
                    <div class="team-info">
                      <strong class="team-name">{member.name}</strong>
                      <span class="team-role">{member.role[locale]}</span>
                      {member.specialty && <span class="team-specialty">Especialidad: {member.specialty}</span>}
                      {member.instagramHandle && <span class="team-ig">📸 {member.instagramHandle}</span>}
                    </div>
                  </div>
                ))}
              </div>
            </section>
          )
        }

        <!-- Pricing & Rate Information (If Available) -->
        {
          service.pricing && (
            <section class="card section-box pricing-section">
              <h2 class="box-title">💶 Tarifas Orientativas & Condiciones</h2>
              <div class="pricing-card-inner">
                {service.pricing.startingPrice && (
                  <div class="pricing-pill-highlight">
                    <span class="pricing-label">Precio Mínimo:</span>
                    <strong class="pricing-val">{service.pricing.startingPrice}</strong>
                  </div>
                )}
                {service.pricing.depositRequired && (
                  <p class="pricing-note">
                    📌 <strong>Reserva:</strong> {service.pricing.depositRequired}
                  </p>
                )}
                {service.pricing.notes?.[locale] && <p class="pricing-note-sub">{service.pricing.notes[locale]}</p>}
              </div>
            </section>
          )
        }

        <!-- Amenities, Accessibility & Payment Methods -->
        {
          ((service.amenities && service.amenities.length > 0) ||
            (service.paymentMethods && service.paymentMethods.length > 0) ||
            (service.certifications && service.certifications.length > 0)) && (
            <section class="card section-box amenities-payments-box">
              <h2 class="box-title">✨ Comodidades, Métodos de Pago & Certificaciones</h2>

              {service.paymentMethods && service.paymentMethods.length > 0 && (
                <div class="amenity-group">
                  <span class="amenity-group-title">💳 Métodos de Pago Aceptados:</span>
                  <div class="chips-row">
                    {service.paymentMethods.map((pm) => (
                      <span class="chip-item">
                        {pm === "credit_card"
                          ? "💳 Tarjeta"
                          : pm === "cash"
                            ? "💶 Efectivo"
                            : pm === "bizum"
                              ? "📱 Bizum"
                              : pm === "apple_pay"
                                ? "🍎 Apple Pay"
                                : pm === "crypto"
                                  ? "₿ Cripto"
                                  : pm}
                      </span>
                    ))}
                  </div>
                </div>
              )}

              {service.amenities && service.amenities.length > 0 && (
                <div class="amenity-group">
                  <span class="amenity-group-title">🛋️ Comodidades e Instalaciones:</span>
                  <div class="chips-row">
                    {service.amenities.map((am) => (
                      <span class="chip-item">
                        {am === "wifi"
                          ? "📶 Wi-Fi Gratis"
                          : am === "air_conditioning"
                            ? "❄️ Climatizado"
                            : am === "wheelchair_accessible"
                              ? "♿ Accesible PMR"
                              : am === "parking_nearby"
                                ? "🅿️ Parking Cercano"
                                : am === "pet_friendly"
                                  ? "🐾 Pet Friendly"
                                  : am}
                      </span>
                    ))}
                  </div>
                </div>
              )}

              {service.certifications && service.certifications.length > 0 && (
                <div class="amenity-group">
                  <span class="amenity-group-title">🛡️ Certificaciones Oficiales:</span>
                  <div class="chips-row">
                    {service.certifications.map((cert) => (
                      <span class="chip-item cert-item">✓ {cert}</span>
                    ))}
                  </div>
                </div>
              )}
            </section>
          )
        }

        <!-- Business FAQs (If Available) -->
        {
          service.faqs && service.faqs.length > 0 && (
            <section class="card section-box faqs-section">
              <h2 class="box-title">❓ Preguntas Frecuentes sobre {service.name}</h2>
              <div class="faqs-list">
                {service.faqs.map((faq) => (
                  <details class="faq-item">
                    <summary class="faq-question">
                      <strong>{faq.question[locale]}</strong>
                    </summary>
                    <p class="faq-answer">{faq.answer[locale]}</p>
                  </details>
                ))}
              </div>
            </section>
          )
        }

        <!-- Press & Media Mentions (If Available) -->
        {
          service.pressMentions && service.pressMentions.length > 0 && (
            <section class="card section-box press-box">
              <h2 class="box-title">📰 En los Medios & Prensa Balear</h2>
              <div class="press-list">
                {service.pressMentions.map((press) => (
                  <div class="press-item">
                    <div class="press-header-row">
                      <span class="press-source-tag">🗞️ {press.mediaName}</span>
                      {press.date && <span class="press-date">{press.date}</span>}
                    </div>
                    <h4 class="press-title">
                      {press.url ? (
                        <a href={press.url} target="_blank" rel="noopener noreferrer">
                          "{press.title}" ↗
                        </a>
                      ) : (
                        `"${press.title}"`
                      )}
                    </h4>
                    {press.quote && <p class="press-quote">«{press.quote}»</p>}
                  </div>
                ))}
              </div>
            </section>
          )
        }

        <!-- Location & Interactive Maps -->
        <section class="card section-box location-map-box">
          <h2 class="box-title">📍 {translations["services.address"]}: {service.address}</h2>
          <div class="map-embed-wrapper">
            <iframe
              title={`Mapa de ubicación de ${service.name}`}
              class="map-iframe"
              loading="lazy"
              src={`https://www.openstreetmap.org/export/embed.html?bbox=${service.coordinates.lng - 0.008}%2C${service.coordinates.lat - 0.006}%2C${service.coordinates.lng + 0.008}%2C${service.coordinates.lat + 0.006}&layer=mapnik&marker=${service.coordinates.lat}%2C${service.coordinates.lng}`}
            ></iframe>
          </div>

          <div class="maps-navigation-toolbar">
            <span class="nav-label">🗺️ Abrir indicaciones en:</span>
            <div class="maps-links-grid">
              <a
                href={service.googleMapsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-sm btn-map-action google-maps-btn"
              >
                <span>📍 Google Maps</span>
              </a>
              <a
                href={service.appleMapsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-sm btn-map-action apple-maps-btn"
              >
                <span>🍎 Apple Maps</span>
              </a>
              <a
                href={service.bingMapsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-sm btn-map-action bing-maps-btn"
              >
                <span>🌐 Bing Maps</span>
              </a>
            </div>
          </div>
        </section>

        <!-- Official Maps Presence & Ratings (Google Maps, Apple Maps, Bing Maps) -->
        <MapsRatingBox service={service} translations={translations} currentLocale={locale} />

        <!-- Official Social Media Feed & Community Posts -->
        <SocialFeedSection
          businessName={service.name}
          socialLinks={service.socialLinks}
          socialPosts={service.socialPosts}
          currentLocale={locale}
        />

        <!-- Community Reviews & Star Ratings Section (Servicios Mallorca Local Community) -->
        <section class="card section-box reviews-section" id="reviews-section">
          <div class="reviews-header-wrap">
            <div>
              <h2 class="box-title">{translations["reviews.title"]}</h2>
              <div class="rating-bar-large">
                <span class="rating-stars-large">★★★★★</span>
                <strong class="rating-score">{service.rating.toFixed(1)}</strong>
                <span class="rating-sub">/ 5.0 ({service.reviewCount} {translations["services.reviews"]})</span>
              </div>
            </div>
            <button id="toggle-review-form-btn" class="btn btn-primary btn-sm">
              ✍️ {translations["reviews.leaveReview"]}
            </button>
          </div>

          <!-- Review Form Container -->
          <div id="review-form-container" class="review-form-card" style="display: none;">
            <div id="review-auth-gate" style="display: none;" class="auth-gate-card">
              <p class="auth-gate-text">🔒 {translations["reviews.loginRequired"]}</p>
              <a href={`${prefix}login`} class="btn btn-sm btn-primary">🔑 Iniciar Sesión</a>
            </div>

            <form id="service-review-form" class="review-form-inner" style="display: none;">
              <h3 class="form-section-title">⭐ {translations["reviews.leaveReview"]}</h3>

              <div id="review-alert-success" class="alert-success" style="display: none;">
                {translations["reviews.success"]}
              </div>
              <div id="review-alert-error" class="alert-error" style="display: none;"></div>

              <div class="rating-selector-group">
                <label class="rating-label">{translations["reviews.yourRating"]}:</label>
                <div class="star-rating-selector" id="star-rating-picker">
                  <button type="button" class="star-picker-btn active" data-rating="1">★</button>
                  <button type="button" class="star-picker-btn active" data-rating="2">★</button>
                  <button type="button" class="star-picker-btn active" data-rating="3">★</button>
                  <button type="button" class="star-picker-btn active" data-rating="4">★</button>
                  <button type="button" class="star-picker-btn active" data-rating="5">★</button>
                </div>
                <span id="star-rating-text" class="star-text-val">5 / 5 Excelente</span>
                <input type="hidden" id="review-rating-val" value="5" />
              </div>

              <div class="form-group">
                <textarea
                  id="review-comment-input"
                  class="review-textarea"
                  rows="3"
                  required
                  placeholder={translations["reviews.yourComment"]}></textarea>
              </div>

              <div class="review-form-actions">
                <button type="button" id="close-review-form-btn" class="btn btn-sm btn-secondary">Cancelar</button>
                <button type="submit" id="submit-review-btn" class="btn btn-sm btn-primary">
                  <span>🚀 {translations["reviews.submit"]}</span>
                </button>
              </div>
            </form>
          </div>

          <!-- Reviews List -->
          <!-- Verified Client Testimonials from Multi-Maps & Official Sources -->
          {
            service.reviews && service.reviews.length > 0 && (
              <div class="verified-external-reviews-grid">
                <h3 class="external-reviews-title">💬 Reseñas y Experiencias Verificadas</h3>
                <div class="reviews-cards-list">
                  {service.reviews.map((rev) => (
                    <div class="verified-review-card">
                      <div class="review-top-meta">
                        <div class="author-info">
                          <span class="author-avatar">{rev.authorName.charAt(0).toUpperCase()}</span>
                          <div>
                            <strong class="author-name">{rev.authorName}</strong>
                            {rev.verifiedCustomer && <span class="verified-badge">✓ Verificado</span>}
                          </div>
                        </div>
                        <div class="review-platform-badge">
                          <span>
                            {rev.platform === "google_maps"
                              ? "📍 Google Maps"
                              : rev.platform === "bing_maps"
                                ? "🌐 Bing Maps"
                                : rev.platform === "tripadvisor"
                                  ? "🦉 TripAdvisor"
                                  : "✓ Verificada"}
                          </span>
                        </div>
                      </div>
                      <div class="review-stars-row">
                        <span class="stars-gold">{"★".repeat(rev.rating)}</span>
                        <span class="review-date">{rev.date}</span>
                      </div>
                      <p class="review-comment-body">«{rev.comment}»</p>
                    </div>
                  ))}
                </div>
              </div>
            )
          }

          <div id="reviews-list-container" class="reviews-list-container" data-service-id={service.id}>
            <div class="reviews-loading">
              <p>⏳ Cargando opiniones de la comunidad...</p>
            </div>
          </div>
        </section>

        <!-- Related Blog Guides -->
        {
          relatedPosts.length > 0 && (
            <section class="card section-box">
              <h2 class="box-title">{translations["blog.relatedServices"]}</h2>
              <div class="related-posts-list">
                {relatedPosts.map((post) => (
                  <a href={`${prefix}blog/${post.slug}`} class="related-post-card">
                    <img src={post.coverImage} alt={post.title[locale]} class="related-post-img" />
                    <div>
                      <h4 class="related-post-title">{post.title[locale]}</h4>
                      <span class="related-post-time">⏱️ {post.readTime}</span>
                    </div>
                  </a>
                ))}
              </div>
            </section>
          )
        }
      </div>

      <!-- Right Column: Sticky Contact Card -->
      <aside class="detail-sidebar">
        <div class="contact-card card card-glass sticky-card">
          <h3 class="contact-title">{translations["services.contact"]}</h3>
          <p class="contact-subtitle">Contacta de forma directa e inmediata con el proveedor verificado.</p>

          <div class="contact-buttons-stack">
            <!-- WhatsApp button -->
            {
              service.whatsapp && (
                <a
                  href={`https://wa.me/${service.whatsapp.replace(/[^0-9]/g, "")}?text=Hola,%20he%20visto%20su%20servicio%20en%20Servicios%20Mallorca`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-primary btn-full whatsapp-btn"
                >
                  <span>💬</span>
                  <span>{translations["services.whatsapp"]}</span>
                </a>
              )
            }

            <!-- Call button -->
            {
              service.phone && (
                <a href={`tel:${service.phone.replace(/[^0-9+]/g, "")}`} class="btn btn-secondary btn-full">
                  <span>📞</span>
                  <span>
                    {translations["services.call"]} ({service.phone})
                  </span>
                </a>
              )
            }

            <!-- Website button -->
            {
              service.website && (
                <a href={service.website} target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-full">
                  <span>🌐</span>
                  <span>{translations["services.website"]}</span>
                </a>
              )
            }

            <!-- Share button -->
            <button
              type="button"
              id="share-service-btn"
              class="btn btn-secondary btn-full"
              data-service-title={service.name}
              data-service-desc={service.shortDescription[locale]}
            >
              <span>📤</span>
              <span>Compartir Negocio</span>
            </button>
          </div>

          <!-- Info Details with 1-click copy -->
          <div class="contact-meta-info">
            <div class="info-row">
              <span class="info-label">📍 {translations["services.address"]}:</span>
              <div class="info-val-wrap">
                <span class="info-val">{service.address}</span>
                <button type="button" class="btn-copy-info" data-copy-text={service.address} title="Copiar dirección">
                  📋
                </button>
              </div>
            </div>

            {
              service.phone && (
                <div class="info-row">
                  <span class="info-label">📞 Teléfono:</span>
                  <div class="info-val-wrap">
                    <span class="info-val">{service.phone}</span>
                    <button type="button" class="btn-copy-info" data-copy-text={service.phone} title="Copiar teléfono">
                      📋
                    </button>
                  </div>
                </div>
              )
            }

            <!-- Live Opening Hours with Human Disclaimer -->
            <LiveScheduleBadge
              scheduleText={service.schedule}
              serviceStatus={service.status}
              phone={service.phone}
              whatsapp={service.whatsapp}
              businessName={service.name}
              showDisclaimer={true}
            />

            <div class="info-row">
              <span class="info-label">🕒 {translations["services.schedule"]}:</span>
              <span class="info-val">{service.schedule}</span>
            </div>

            <div class="info-row">
              <span class="info-label">💶 {translations["services.price"]}:</span>
              <span class="info-val">{service.priceRange}</span>
            </div>
          </div>

          <div class="tags-cloud">
            {service.tags.map((tag) => <span class="tag-pill">#{tag}</span>)}
          </div>

          <!-- B2B Actions: Claim, Opt-out & Suggest Changes -->
          <div class="business-owner-actions">
            <button type="button" id="open-claim-modal-btn" class="btn btn-outline-primary btn-sm btn-full">
              <span>🏢</span>
              <span>{translations["services.claimBusiness"]}</span>
            </button>
            <button
              type="button"
              id="open-report-modal-btn"
              class="btn btn-secondary btn-sm btn-full"
              style="margin-top: 0.35rem;"
            >
              <span>{translations["services.reportError"]}</span>
            </button>
            <button type="button" id="open-delete-modal-btn" class="optout-link-btn">
              {translations["services.deleteRequest"]}
            </button>
          </div>
        </div>

        <!-- AdSense Sidebar Rectangle -->
        <AdSenseSlot format="rectangle" slotId="service-sidebar-banner" />
      </aside>
    </div>

    <!-- MOBILE STICKY FLOATING CTA BAR -->
    <aside class="mobile-sticky-cta" aria-label="Acciones rápidas de contacto">
      <div class="mobile-cta-inner">
        {
          service.whatsapp && (
            <a
              href={`https://wa.me/${service.whatsapp.replace(/[^0-9]/g, "")}?text=Hola,%20he%20visto%20su%20servicio%20en%20Servicios%20Mallorca`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary btn-sm mobile-cta-btn"
            >
              <span>💬 WhatsApp</span>
            </a>
          )
        }
        {
          service.phone && (
            <a href={`tel:${service.phone.replace(/[^0-9+]/g, "")}`} class="btn btn-secondary btn-sm mobile-cta-btn">
              <span>📞 Llamar</span>
            </a>
          )
        }
        <a
          href={service.googleMapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-secondary btn-sm mobile-cta-btn"
        >
          <span>📍 Cómo Llegar</span>
        </a>
      </div>
    </aside>

    <!-- MODAL: RECLAMAR NEGOCIO -->
    <div id="claim-modal" class="custom-modal-overlay" style="display: none;">
      <div class="custom-modal-card card-glass">
        <div class="modal-header-flex">
          <h3>🏢 {translations["services.claimBusiness"]}</h3>
          <button type="button" class="modal-close-btn" data-close-modal="claim-modal">&times;</button>
        </div>
        <p class="modal-desc">{translations["services.claimSubtitle"]}</p>

        <div id="claim-alert-success" class="alert-success" style="display: none;">
          {translations["services.claimSuccess"]}
        </div>
        <div id="claim-alert-error" class="alert-error" style="display: none;"></div>

        <form id="claim-form" class="modal-form">
          <input type="hidden" id="claim-service-id" value={service.id} />
          <input type="hidden" id="claim-service-name" value={service.name} />

          <div class="form-group">
            <label class="form-label" for="claim-name">Nombre y Apellidos del Solicitante</label>
            <input type="text" id="claim-name" class="form-input" required placeholder="Tu nombre" />
          </div>

          <div class="form-group">
            <label class="form-label" for="claim-email">Correo Electrónico de Contacto</label>
            <input type="email" id="claim-email" class="form-input" required placeholder="nombre@empresa.com" />
          </div>

          <div class="form-group">
            <label class="form-label" for="claim-phone">{translations["services.claimPhone"]}</label>
            <input type="tel" id="claim-phone" class="form-input" required placeholder="+34 600 000 000" />
          </div>

          <div class="form-group">
            <label class="form-label" for="claim-cif">{translations["services.claimCif"]}</label>
            <input type="text" id="claim-cif" class="form-input" required placeholder="CIF o documento acreditativo" />
          </div>

          <div class="modal-actions">
            <button type="submit" id="claim-submit-btn" class="btn btn-primary btn-full">
              {translations["services.claimSubmit"]}
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- MODAL: SOLICITAR BAJA / SUPRESIÓN -->
    <div id="delete-modal" class="custom-modal-overlay" style="display: none;">
      <div class="custom-modal-card card-glass">
        <div class="modal-header-flex">
          <h3>🗑️ {translations["services.deleteRequest"]}</h3>
          <button type="button" class="modal-close-btn" data-close-modal="delete-modal">&times;</button>
        </div>
        <p class="modal-desc">
          Conforme a la normativa RGPD/LOPD, el titular legítimo puede solicitar la retirada de su ficha en cualquier
          momento.
        </p>

        <div id="delete-alert-success" class="alert-success" style="display: none;">
          {translations["services.deleteSuccess"]}
        </div>
        <div id="delete-alert-error" class="alert-error" style="display: none;"></div>

        <form id="delete-form" class="modal-form">
          <input type="hidden" id="delete-service-id" value={service.id} />
          <input type="hidden" id="delete-service-name" value={service.name} />

          <div class="form-group">
            <label class="form-label" for="delete-email">Correo Electrónico del Solicitante</label>
            <input type="email" id="delete-email" class="form-input" required placeholder="titular@empresa.com" />
          </div>

          <div class="form-group">
            <label class="form-label" for="delete-reason">{translations["services.deleteReason"]}</label>
            <textarea
              id="delete-reason"
              class="form-input form-textarea"
              required
              placeholder="Indica el motivo de la supresión o acreditación de titularidad..."></textarea>
          </div>

          <div class="modal-actions">
            <button type="submit" id="delete-submit-btn" class="btn btn-danger btn-full">
              {translations["services.deleteSubmit"]}
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- MODAL: REPORTAR ERROR / SUGERIR CAMBIOS -->
    <div id="report-modal" class="custom-modal-overlay" style="display: none;">
      <div class="custom-modal-card card-glass">
        <div class="modal-header-flex">
          <h3>🚩 {translations["services.reportError"]}</h3>
          <button type="button" class="modal-close-btn" data-close-modal="report-modal">&times;</button>
        </div>
        <p class="modal-desc">{translations["services.reportSubtitle"]}</p>

        <div id="report-alert-success" class="alert-success" style="display: none;">
          {translations["services.reportSuccess"]}
        </div>
        <div id="report-alert-error" class="alert-error" style="display: none;"></div>

        <form id="report-form" class="modal-form">
          <input type="hidden" id="report-service-id" value={service.id} />
          <input type="hidden" id="report-service-name" value={service.name} />

          <div class="form-group">
            <label class="form-label" for="report-category">{translations["services.reportCategory"]}</label>
            <select id="report-category" class="form-input" required>
              <option value="horario_incorrecto">{translations["services.reportCat.horario"]}</option>
              <option value="ubicacion_erronea">{translations["services.reportCat.ubicacion"]}</option>
              <option value="contacto_invalido">{translations["services.reportCat.contacto"]}</option>
              <option value="negocio_cerrado">{translations["services.reportCat.cerrado"]}</option>
              <option value="sugerencia_cambio" selected>{translations["services.reportCat.sugerencia"]}</option>
              <option value="otro">{translations["services.reportCat.otro"]}</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label" for="report-description">{translations["services.reportDesc"]}</label>
            <textarea
              id="report-description"
              class="form-input form-textarea"
              required
              minlength="10"
              placeholder="Describe con detalle qué información está desactualizada o errónea, y qué dato correcto deberíamos usar..."
            ></textarea>
          </div>

          <div class="form-group">
            <label class="form-label" for="report-email">Tu correo (opcional, para seguimiento)</label>
            <input type="email" id="report-email" class="form-input" placeholder="tu@correo.com" />
          </div>

          <div class="modal-actions">
            <button type="submit" id="report-submit-btn" class="btn btn-primary btn-full">
              {translations["services.reportSubmit"]}
            </button>
          </div>
        </form>
      </div>
    </div>
  </main>

  <Footer translations={translations} currentLocale={locale} getLangPrefix={getLangPrefix} />
</BaseLayout>

<style>
  .breadcrumb-nav {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    margin-bottom: var(--space-md);
  }

  .breadcrumb-nav a {
    color: var(--color-text-light);
    text-decoration: none;
  }

  .breadcrumb-nav a:hover {
    color: var(--color-primary);
  }

  .active-crumb {
    color: var(--color-primary);
    font-weight: 600;
  }

  .service-detail-header {
    margin-bottom: var(--space-xl);
  }

  .header-badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-bottom: var(--space-xs);
  }

  .detail-title {
    font-size: clamp(2rem, 4vw, var(--font-size-3xl));
    font-weight: 800;
    line-height: 1.2;
    margin-top: var(--space-xs);
  }

  .detail-lead {
    font-size: var(--font-size-lg);
    color: var(--color-text-light);
    max-width: 800px;
    margin-top: var(--space-xs);
    line-height: 1.5;
  }

  .rating-bar {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: var(--space-sm);
  }

  .rating-stars {
    color: var(--color-accent);
    letter-spacing: 2px;
  }

  .rating-val {
    font-size: var(--font-size-base);
  }

  .rating-reviews {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  /* DETAIL GRID */
  .detail-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: var(--space-xl);
    align-items: start;
  }

  .gallery-container {
    padding: 0;
    overflow: hidden;
    margin-bottom: var(--space-lg);
  }

  .main-image-wrap {
    width: 100%;
    height: 400px;
    overflow: hidden;
  }

  .detail-main-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gallery-thumbnails {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-xs);
    padding: var(--space-xs);
    background: var(--color-bg);
  }

  .thumb-img {
    width: 100%;
    height: 100px;
    object-fit: cover;
    border-radius: var(--border-radius-sm);
  }

  .section-box {
    margin-bottom: var(--space-lg);
    padding: var(--space-lg);
  }

  .box-title {
    font-size: var(--font-size-xl);
    font-weight: 700;
    margin-bottom: var(--space-sm);
    border-bottom: 1px solid var(--color-surface-border);
    padding-bottom: var(--space-xs);
  }

  .desc-text {
    font-size: var(--font-size-base);
    color: var(--color-text);
    line-height: 1.7;
  }

  /* Founder Story */
  .founder-story-box {
    background: linear-gradient(135deg, var(--color-surface), rgba(245, 158, 11, 0.05));
    border-left: 4px solid #f59e0b;
  }

  .story-header-flex {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-sm);
  }

  .story-icon {
    font-size: 2rem;
  }

  .founder-subtitle {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    margin: 0;
  }

  .story-text {
    font-size: var(--font-size-sm);
    line-height: 1.6;
    color: var(--color-text);
  }

  /* Awards */
  .awards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-md);
    margin-top: var(--space-sm);
  }

  .award-card {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-md);
    background: var(--color-bg);
    border: 1px solid var(--color-surface-border);
    border-radius: var(--border-radius-md);
  }

  .award-icon {
    font-size: 1.8rem;
  }

  .award-title {
    display: block;
    font-size: var(--font-size-sm);
    color: var(--color-text);
  }

  .award-meta {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  /* Team & Resident Artists */
  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-md);
    margin-top: var(--space-sm);
  }

  .team-member-card {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-md);
    background: var(--color-bg);
    border: 1px solid var(--color-surface-border);
    border-radius: var(--border-radius-sm);
  }

  .team-avatar {
    width: 54px;
    height: 54px;
    border-radius: 999px;
    object-fit: cover;
  }

  .team-avatar-placeholder {
    width: 54px;
    height: 54px;
    border-radius: 999px;
    background: var(--color-primary-bg);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 1.3rem;
  }

  .team-info {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .team-name {
    font-size: var(--font-size-sm);
    color: var(--color-text);
  }

  .team-role {
    font-size: var(--font-size-xs);
    color: var(--color-primary);
    font-weight: 600;
  }

  .team-specialty {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .team-ig {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-weight: 600;
  }

  /* Pricing Details */
  .pricing-card-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-md);
    background: var(--color-bg);
    border: 1px solid var(--color-surface-border);
    border-radius: var(--border-radius-sm);
  }

  .pricing-pill-highlight {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .pricing-label {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .pricing-val {
    font-size: 1.3rem;
    font-weight: 800;
    color: #10b981;
  }

  .pricing-note {
    font-size: 0.85rem;
    color: var(--color-text);
    margin: 0;
  }

  .pricing-note-sub {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  /* Amenities, Payments, Certifications */
  .amenity-group {
    margin-bottom: var(--space-md);
  }

  .amenity-group:last-child {
    margin-bottom: 0;
  }

  .amenity-group-title {
    display: block;
    font-size: var(--font-size-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-xs);
  }

  .chips-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .chip-item {
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    background: var(--color-bg);
    border: 1px solid var(--color-surface-border);
    color: var(--color-text);
  }

  .chip-item.cert-item {
    background: rgba(16, 185, 129, 0.1);
    border-color: #10b981;
    color: #10b981;
  }

  /* FAQs */
  .faqs-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .faq-item {
    padding: var(--space-sm) var(--space-md);
    background: var(--color-bg);
    border: 1px solid var(--color-surface-border);
    border-radius: var(--border-radius-sm);
    cursor: pointer;
  }

  .faq-question {
    font-size: var(--font-size-sm);
    color: var(--color-text);
    outline: none;
  }

  .faq-answer {
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--color-text-muted);
    margin: var(--space-xs) 0 0 0;
    padding-top: var(--space-xs);
    border-top: 1px dashed var(--color-surface-border);
  }

  /* Verified External Reviews Grid */
  .verified-external-reviews-grid {
    margin: var(--space-md) 0 var(--space-lg) 0;
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--color-surface-border);
  }

  .external-reviews-title {
    font-size: var(--font-size-md);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: var(--space-sm);
  }

  .reviews-cards-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-md);
  }

  .verified-review-card {
    padding: var(--space-md);
    background: var(--color-bg);
    border: 1px solid var(--color-surface-border);
    border-radius: var(--border-radius-sm);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .review-top-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-xs);
  }

  .author-info {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .author-avatar {
    width: 32px;
    height: 32px;
    border-radius: 999px;
    background: var(--color-primary-bg);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 0.85rem;
  }

  .author-name {
    display: block;
    font-size: 0.85rem;
    color: var(--color-text);
  }

  .verified-badge {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 700;
    color: #10b981;
  }

  .review-platform-badge {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--color-text-muted);
    background: var(--color-surface);
    border: 1px solid var(--color-surface-border);
    padding: 0.15rem 0.4rem;
    border-radius: 999px;
  }

  .review-stars-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .review-date {
    font-size: 0.72rem;
    color: var(--color-text-muted);
  }

  .review-comment-body {
    font-size: 0.82rem;
    line-height: 1.45;
    color: var(--color-text);
    font-style: italic;
    margin: 0;
  }

  /* Press */
  .press-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin-top: var(--space-sm);
  }

  .press-item {
    padding: var(--space-md);
    background: var(--color-bg);
    border: 1px solid var(--color-surface-border);
    border-radius: var(--border-radius-md);
  }

  .press-header-row {
    display: flex;
    justify-content: space-between;
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    margin-bottom: 0.25rem;
  }

  .press-source-tag {
    font-weight: 700;
    color: var(--color-primary);
  }

  .press-title {
    font-size: var(--font-size-md);
    margin: 0 0 0.25rem 0;
  }

  .press-title a {
    color: var(--color-text);
    text-decoration: none;
  }

  .press-title a:hover {
    color: var(--color-primary);
  }

  .press-quote {
    font-size: var(--font-size-sm);
    font-style: italic;
    color: var(--color-text-light);
    margin: 0;
  }

  .highlights-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .highlight-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    font-size: var(--font-size-sm);
    line-height: 1.5;
  }

  .check-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    background: var(--color-success-bg);
    color: var(--color-success);
    border-radius: 50%;
    font-weight: bold;
    font-size: 0.8rem;
    flex-shrink: 0;
  }

  .services-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .service-chip {
    padding: 0.4rem 0.85rem;
    border-radius: var(--border-radius-full);
    background: var(--color-primary-bg);
    color: var(--color-primary-dark);
    font-weight: 600;
    font-size: var(--font-size-xs);
  }

  /* Interactive Map Styles */
  .location-map-box {
    overflow: hidden;
  }

  .map-embed-wrapper {
    width: 100%;
    height: 280px;
    border-radius: var(--border-radius-sm);
    overflow: hidden;
    margin: var(--space-md) 0;
    border: 1px solid var(--color-surface-border);
  }

  .map-iframe {
    width: 100%;
    height: 100%;
    border: none;
  }

  .maps-navigation-toolbar {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .nav-label {
    font-size: var(--font-size-xs);
    font-weight: 700;
    color: var(--color-text-muted);
  }

  .maps-links-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: var(--space-sm);
