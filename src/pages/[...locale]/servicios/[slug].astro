---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Navbar from "../../../components/Navbar.astro";
import Footer from "../../../components/Footer.astro";
import ServiceHeaderHero from "../../../components/ServiceHeaderHero.astro";
import ServiceQuickNav from "../../../components/ServiceQuickNav.astro";
import ServiceMobileStickyBar from "../../../components/ServiceMobileStickyBar.astro";
import ServiceQuickFacts from "../../../components/ServiceQuickFacts.astro";
import ServiceGallerySection from "../../../components/ServiceGallerySection.astro";
import ServiceDescription from "../../../components/ServiceDescription.astro";
import ServiceHighlights from "../../../components/ServiceHighlights.astro";
import ServiceIncluded from "../../../components/ServiceIncluded.astro";
import ServiceFounderStory from "../../../components/ServiceFounderStory.astro";
import ServiceAwards from "../../../components/ServiceAwards.astro";
import VisualGalleryShowcase from "../../../components/VisualGalleryShowcase.astro";
import OnlineStoreShowcase from "../../../components/OnlineStoreShowcase.astro";
import ServiceTeam from "../../../components/ServiceTeam.astro";
import ServicePricingAndAmenities from "../../../components/ServicePricingAndAmenities.astro";
import ServiceLocationMap from "../../../components/ServiceLocationMap.astro";
import MapsRatingBox from "../../../components/MapsRatingBox.astro";
import SocialFeedSection from "../../../components/SocialFeedSection.astro";
import ServiceReviewsSection from "../../../components/ServiceReviewsSection.astro";
import ServiceRelatedList from "../../../components/ServiceRelatedList.astro";
import SmartMatchRecommendations from "../../../components/SmartMatchRecommendations.astro";
import BusinessQualityFeedbackModal from "../../../components/BusinessQualityFeedbackModal.astro";
import ServiceSidebarContact from "../../../components/ServiceSidebarContact.astro";
import ServiceClaimDeleteModals from "../../../components/ServiceClaimDeleteModals.astro";
import ServiceShareModal from "../../../components/ServiceShareModal.astro";
import HonorCheckoutModal from "../../../components/HonorCheckoutModal.astro";
import CommunityBoostWall from "../../../components/CommunityBoostWall.astro";
import UnclaimedDataDisclaimer from "../../../components/UnclaimedDataDisclaimer.astro";
import BusinessJoinBanner from "../../../components/BusinessJoinBanner.astro";

import { getServiceById } from "../../../data/services";
import { CATEGORIES } from "../../../data/categories";
import { MALLORCA_ZONES } from "../../../data/zones";
import { BLOG_POSTS } from "../../../data/posts";
import { getLocaleFromUrl, loadTranslations, getLangPrefix, type Locale } from "../../../i18n";
import { generateServiceJsonLd } from "../../../lib/jsonLdGenerator";
import "../../../styles/service-detail.css";

export const prerender = false;

const locale = getLocaleFromUrl(Astro.url) as Locale;
const translations = await loadTranslations(locale);
const prefix = getLangPrefix(locale);

const { slug } = Astro.params;
const service = slug ? getServiceById(slug) : undefined;

if (!service) {
  return Astro.redirect(`${prefix}servicios`);
}

const category = CATEGORIES.find((c) => c.id === service.category);
const zone = MALLORCA_ZONES.find((z) => z.id === service.zone);
const categoryName = category?.name[locale] || service.category;
const zoneName = zone?.name[locale] || service.zone;

// Related blog posts with smart fallback by category / tags
let relatedPosts = BLOG_POSTS.filter((p) => p.relatedServiceIds.includes(service.id));
if (relatedPosts.length === 0) {
  relatedPosts = BLOG_POSTS.filter(
    (p) =>
      p.category === service.category ||
      (service.tags && p.tags && p.tags.some((tag) => service.tags.includes(tag.toLowerCase()))),
  ).slice(0, 3);
}

// Dynamic Localized SEO Title & Meta Description with Search Intent
const seoTitle = `${service.name} (${zoneName}, Mallorca) | ${categoryName} | ⭐ ${service.rating ? service.rating.toFixed(1) : "N/A"}`;
const cleanDescText = (service.shortDescription?.[locale] || service.fullDescription?.[locale] || "")
  .replace(/\s+/g, " ")
  .trim();
const seoDescription = cleanDescText.length > 155 ? `${cleanDescText.slice(0, 152)}...` : cleanDescText;
const canonicalUrl = `${Astro.url.origin}${Astro.url.pathname}`;

// Schema.org structured data for Local SEO and AI Search Engines (Perplexity, ChatGPT, SGE)
const schemaOrg = generateServiceJsonLd(service, locale, canonicalUrl);

// BreadcrumbList Schema.org
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: translations["nav.home"] || "Inicio",
      item: `https://serviciosmallorca.com${prefix}`,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: translations["nav.services"] || "Servicios",
      item: `https://serviciosmallorca.com${prefix}servicios`,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: service.name,
      item: canonicalUrl,
    },
  ],
};
---

<BaseLayout
  title={seoTitle}
  lang={locale}
  description={seoDescription}
  image={service.image}
  canonicalUrl={canonicalUrl}
  ogType="business.business"
>
  <!-- Schema.org for Local SEO & LLM Ingestion -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <!-- Open Graph & Local Business Meta Tags -->
  <meta slot="head" property="og:type" content="business.business" />
  <meta slot="head" property="og:title" content={seoTitle} />
  <meta slot="head" property="og:description" content={seoDescription} />
  <meta slot="head" property="og:image" content={service.image} />
  <meta slot="head" property="og:url" content={canonicalUrl} />
  {
    service.coordinates?.lat && (
      <meta slot="head" property="place:location:latitude" content={String(service.coordinates.lat)} />
    )
  }
  {
    service.coordinates?.lng && (
      <meta slot="head" property="place:location:longitude" content={String(service.coordinates.lng)} />
    )
  }
  <meta slot="head" property="business:contact_data:locality" content={zoneName} />
  <meta slot="head" property="business:contact_data:region" content="Illes Balears" />
  <meta slot="head" property="business:contact_data:country_name" content="Spain" />
  {service.phone && <meta slot="head" property="business:contact_data:phone_number" content={service.phone} />}
  {service.website && <meta slot="head" property="business:contact_data:website" content={service.website} />}
  <meta slot="head" name="twitter:card" content="summary_large_image" />
  <meta slot="head" name="twitter:title" content={seoTitle} />
  <meta slot="head" name="twitter:description" content={seoDescription} />
  <meta slot="head" name="twitter:image" content={service.image} />

  <!-- Reading Progress Bar -->
  <div
    id="reading-progress-bar"
    role="progressbar"
    aria-label="Progreso"
    aria-valuenow={0}
    aria-valuemin={0}
    aria-valuemax={100}
  >
  </div>

  <Navbar currentLocale={locale} translations={translations} getLangPrefix={getLangPrefix} />

  <main class="container section">
    <!-- Breadcrumbs Navigation -->
    <nav class="breadcrumb-nav" aria-label="Breadcrumb">
      <a href={prefix}>{translations["nav.home"]}</a>
      <span>/</span>
      <a href={`${prefix}servicios`}>{translations["nav.services"]}</a>
      <span>/</span>
      <span class="active-crumb">{service.name}</span>
    </nav>

    <!-- Header Section (Breadcrumbs, Title, Badges, Quick Actions) -->
    <ServiceHeaderHero service={service} category={category} zone={zone} translations={translations} locale={locale} />

    <!-- Quick Navigation (Pill Tabs for Zero-Friction Deep Linking) -->
    <ServiceQuickNav service={service} locale={locale} />

    <!-- Layout Grid: Main Content & Sidebar -->
    <div class="detail-grid">
      <!-- Left Column: Media, Portfolio, Details & Reviews -->
      <div class="detail-content">
        <!-- Transparency & Public Data Notice -->
        <UnclaimedDataDisclaimer service={service} locale={locale} translations={translations} />

        <ServiceGallerySection service={service} category={category} categoryName={categoryName} />

        <!-- Semantic AI Quick Facts Box -->
        <ServiceQuickFacts service={service} category={category} zone={zone} locale={locale} />

        <ServiceDescription service={service} locale={locale} />
        <ServiceHighlights service={service} translations={translations} locale={locale} />
        <ServiceIncluded service={service} translations={translations} locale={locale} />
        <ServiceFounderStory service={service} locale={locale} />
        <ServiceAwards service={service} translations={translations} locale={locale} />

        <VisualGalleryShowcase
          businessName={service.name}
          mainImage={service.image}
          gallery={service.gallery}
          currentLocale={locale}
        />

        {
          (service.onlineStore?.hasOnlineStore || (service.products && service.products.length > 0)) && (
            <OnlineStoreShowcase
              onlineStore={service.onlineStore}
              products={service.products}
              currentLocale={locale}
              businessName={service.name}
            />
          )
        }

        <ServiceTeam service={service} locale={locale} />
        <ServicePricingAndAmenities service={service} locale={locale} />
        <ServiceLocationMap service={service} translations={translations} />
        <MapsRatingBox service={service} translations={translations} currentLocale={locale} />

        <SocialFeedSection
          businessName={service.name}
          socialLinks={service.socialLinks}
          socialPosts={service.socialPosts}
          currentLocale={locale}
        />

        <CommunityBoostWall
          serviceId={service.id}
          serviceName={service.name}
          serviceSlug={service.slug}
          category={service.category}
          translations={translations}
        />

        <ServiceReviewsSection service={service} translations={translations} prefix={prefix} />
        <BusinessJoinBanner locale={locale} translations={translations} />
        <ServiceRelatedList relatedPosts={relatedPosts} translations={translations} locale={locale} prefix={prefix} />
        <SmartMatchRecommendations currentService={service} currentLocale={locale} getLangPrefix={getLangPrefix} />
        <BusinessQualityFeedbackModal businessSlug={service.slug} businessName={service.name} currentLocale={locale} />
      </div>

      <!-- Right Column: Sticky Contact Card -->
      <ServiceSidebarContact service={service} translations={translations} prefix={prefix} />
    </div>

    <!-- Modals (Claim Ownership, Delete Request, Report Error) -->
    <ServiceClaimDeleteModals service={service} translations={translations} />

    <!-- Modal Social Share Enriquecido -->
    <ServiceShareModal service={service} locale={locale} translations={translations} pageUrl={canonicalUrl} />

    <!-- Modal Honor Checkout & Impulso Comunitario -->
    <HonorCheckoutModal
      locale={locale}
      translations={translations}
      preselectedServiceId={service.id}
      preselectedServiceName={service.name}
      preselectedServiceSlug={service.slug}
      minBidRequired={1.0}
    />

    <!-- Mobile Sticky Conversion Bar -->
    <ServiceMobileStickyBar service={service} locale={locale} />
  </main>

  <Footer translations={translations} currentLocale={locale} getLangPrefix={getLangPrefix} />
</BaseLayout>

<script>
  import { initServiceDetailClient } from "../../../scripts/service-detail-client";
  initServiceDetailClient();

  // Reading progress bar
  const progressBar = document.getElementById("reading-progress-bar");
  if (progressBar) {
    window.addEventListener(
      "scroll",
      () => {
        const scrollTop = window.scrollY || document.documentElement.scrollTop;
        const scrollHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        const progress = scrollHeight > 0 ? Math.min((scrollTop / scrollHeight) * 100, 100) : 0;
        progressBar.style.width = `${progress}%`;
        progressBar.setAttribute("aria-valuenow", String(Math.round(progress)));
      },
      { passive: true },
    );
  }
</script>
