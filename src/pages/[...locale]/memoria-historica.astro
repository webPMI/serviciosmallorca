---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { getLocaleFromUrl, loadTranslations, getLangPrefix, type Locale } from "../../i18n";
import {
  getHistoricalBusinesses,
  getCentenaryBusinesses,
  getLongevityStatistics,
  getYearsOfOperation,
  resolveHistoricalSignificance,
} from "../../lib/historicalHub.ts";

export const prerender = false;

const locale = getLocaleFromUrl(Astro.url) as Locale;
const translations = await loadTranslations(locale);
const prefix = getLangPrefix(locale);

const stats = getLongevityStatistics();
const allHistorical = getHistoricalBusinesses({ minYears: 15 });
const centenaryList = getCentenaryBusinesses();

// Chronological sort for the timeline
const timelinePioneers = [
  ...centenaryList,
  ...allHistorical.filter((h) => (h.foundedYear || 0) < 1950 && !centenaryList.some((c) => c.id === h.id)),
]
  .filter((item) => item.foundedYear && item.foundedYear > 0)
  .sort((a, b) => (a.foundedYear || 0) - (b.foundedYear || 0));

const titles: Record<Locale, string> = {
  es: "Muro de la Memoria Histórica & Negocios Emblemáticos de Mallorca",
  en: "Mallorca Heritage Wall & Centenary Landmark Businesses",
  ca: "Mur de la Memòria Històrica i Negocis Emblemàtics de Mallorca",
  de: "Historisches Gedächtnis & Traditionelle Traditionsbetriebe Mallorcas",
};

const descriptions: Record<Locale, string> = {
  es: "Observatorio de longevidad empresarial, comercios centenarios, artesanía viva y registro histórico del tejido comercial de Mallorca.",
  en: "Business longevity observatory, centenary artisan workshops, living heritage, and commercial historical registry of Mallorca.",
  ca: "Observatori de longevitat empresarial, comerços centenaris, artesania viva i registre històric del teixit comercial de Mallorca.",
  de: "Wirtschafts- und Traditions-Observatorium, hundertjährige Handwerksbetriebe und historisches Wirtschaftsarchiv Mallorcas.",
};

const schemaOrg = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      name: titles[locale],
      description: descriptions[locale],
      url: `https://serviciosmallorca.com${prefix}memoria-historica`,
    },
    {
      "@type": "ItemList",
      name: titles[locale],
      numberOfItems: allHistorical.length,
      itemListElement: allHistorical.map((item, idx) => ({
        "@type": "ListItem",
        position: idx + 1,
        name: item.name,
        description: item.shortDescription[locale] || item.shortDescription.es,
        item: {
          "@type": "LocalBusiness",
          name: item.name,
          address: item.address,
          foundingDate: item.foundedYear ? `${item.foundedYear}` : undefined,
        },
      })),
    },
  ],
};
---

<BaseLayout title={`${titles[locale]} | Servicios Mallorca`} lang={locale} description={descriptions[locale]}>
  <script type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />
  <Navbar currentLocale={locale} translations={translations} getLangPrefix={getLangPrefix} />

  <main class="container section">
    <!-- Breadcrumbs Navigation -->
    <nav class="breadcrumb-nav" aria-label="Breadcrumb">
      <a href={prefix}>{translations["nav.home"] || "Inicio"}</a>
      <span>/</span>
      <span class="active-crumb">{titles[locale]}</span>
    </nav>

    <!-- Header Hero -->
    <header class="heritage-hero">
      <div class="badge-heritage">
        <span>🏛️</span>
        <span>
          {
            locale === "de"
              ? "Historisches Erbe & Kunsthandwerk"
              : locale === "en"
                ? "Living Heritage & Master Craft"
                : locale === "ca"
                  ? "Patrimoni Viu & Mestre Artesà"
                  : "Patrimonio Vivo & Memoria Comercial"
          }
        </span>
      </div>
      <h1 class="hero-title">{titles[locale]}</h1>
      <p class="hero-subtitle">{descriptions[locale]}</p>
    </header>

    <!-- Statistics Overview -->
    <section class="stats-grid" aria-label="Estadísticas de longevidad">
      <div class="stat-card stat-card-gold">
        <span class="stat-icon">👑</span>
        <span class="stat-number">{stats.centenaryCount}+</span>
        <span class="stat-label">
          {
            locale === "de"
              ? "Hundertjährige Betriebe (+100 J.)"
              : locale === "en"
                ? "Centenary Heritage (+100 yrs)"
                : locale === "ca"
                  ? "Comerços Centenaris (+100 anys)"
                  : "Comercios Centenarios (+100 años)"
          }
        </span>
      </div>
      <div class="stat-card">
        <span class="stat-icon">🏛️</span>
        <span class="stat-number">{stats.heritage50Count}+</span>
        <span class="stat-label">
          {
            locale === "de"
              ? "Traditionshäuser (+50 J.)"
              : locale === "en"
                ? "Heritage Landmarks (+50 yrs)"
                : locale === "ca"
                  ? "Negocis de Llegat (+50 anys)"
                  : "Negocios de Legado (+50 años)"
          }
        </span>
      </div>
      <div class="stat-card">
        <span class="stat-icon">⏳</span>
        <span class="stat-number">{stats.landmark30Count}+</span>
        <span class="stat-label">
          {
            locale === "de"
              ? "Etablierte Pioniere (+30 J.)"
              : locale === "en"
                ? "Established Icons (+30 yrs)"
                : locale === "ca"
                  ? "Icones Consolidats (+30 anys)"
                  : "Iconos Consolidados (+30 años)"
          }
        </span>
      </div>
      <div class="stat-card">
        <span class="stat-icon">📜</span>
        <span class="stat-number">{stats.totalHistoricalTracked}</span>
        <span class="stat-label">
          {
            locale === "de"
              ? "Gesamtes Historisches Archiv"
              : locale === "en"
                ? "Total Heritage Tracked"
                : locale === "ca"
                  ? "Total Arxiu Històric"
                  : "Total Registro Histórico"
          }
        </span>
      </div>
    </section>

    <!-- Visual Interactive Chronological Timeline -->
    <section class="timeline-section card-premium">
      <div class="timeline-header">
        <span class="badge badge-accent"
          >⏳ {translations["heritage.timeline.title"] || "Línea Temporal de Pioneros"}</span
        >
        <h2 class="timeline-title">{translations["heritage.timeline.title"]}</h2>
        <p class="timeline-subtitle">{translations["heritage.timeline.subtitle"]}</p>
      </div>

      <div class="timeline-track">
        {
          timelinePioneers.map((pioneer) => {
            const years = getYearsOfOperation(pioneer);
            return (
              <div class="timeline-node" data-year={pioneer.foundedYear}>
                <div class="node-milestone">
                  <span class="node-year-badge">{pioneer.foundedYear}</span>
                  <div class="node-pin" />
                </div>
                <div class="node-content card">
                  <div class="node-meta">
                    <span class="node-years-tag">
                      👑 +{years}{" "}
                      {locale === "de" ? "Jahre" : locale === "en" ? "Years" : locale === "ca" ? "Anys" : "Años"}
                    </span>
                    <span class="node-town">📍 {pioneer.zone}</span>
                  </div>
                  <h3 class="node-title">
                    <a href={`${prefix}servicios/${pioneer.slug}`}>{pioneer.name}</a>
                  </h3>
                  <p class="node-excerpt">{pioneer.shortDescription[locale] || pioneer.shortDescription.es}</p>
                  <a href={`${prefix}servicios/${pioneer.slug}`} class="node-link">
                    {locale === "de"
                      ? "Geschichte ansehen →"
                      : locale === "en"
                        ? "View history →"
                        : locale === "ca"
                          ? "Veure història →"
                          : "Ver historia →"}
                  </a>
                </div>
              </div>
            );
          })
        }
      </div>
    </section>

    <!-- Interactive Filter Toolbar & Search Bar -->
    <section class="heritage-explorer-toolbar">
      <div class="toolbar-search-wrap">
        <span class="search-icon">🔍</span>
        <input
          type="search"
          id="heritage-search-input"
          class="heritage-search-input"
          placeholder={translations["heritage.search.placeholder"] || "Buscar por nombre, oficio, pueblo o año..."}
          aria-label="Buscar comercios históricos"
        />
      </div>

      <div class="heritage-filter-pills" id="heritage-filter-pills">
        <button type="button" class="filter-pill active" data-era="all">
          🌴 {translations["heritage.filter.all"] || "Todos los comercios"}
        </button>
        <button type="button" class="filter-pill" data-era="centenary">
          {translations["heritage.filter.centenary"] || "👑 Centenarios (+100)"}
        </button>
        <button type="button" class="filter-pill" data-era="s18-19">
          {translations["heritage.filter.s1819"] || "🏛️ Siglos XVIII-XIX"}
        </button>
        <button type="button" class="filter-pill" data-era="s20">
          {translations["heritage.filter.s20"] || "🏭 Siglo XX"}
        </button>
        <button type="button" class="filter-pill" data-era="memorial">
          {translations["heritage.filter.memorial"] || "🕊️ Memorial"}
        </button>
      </div>

      <div class="heritage-counter-bar">
        <span id="heritage-counter-text">
          {translations["heritage.results.showing"] || "Mostrando"}
          <strong id="heritage-count-visible">{allHistorical.length}</strong>
          {translations["heritage.results.of"] || "de"}
          {allHistorical.length}
          {translations["heritage.results.label"] || "comercios históricos"}
        </span>
      </div>
    </section>

    <!-- Centenary Showcase -->
    <section class="heritage-section" id="centenary-section">
      <div class="section-heading">
        <h2>
          👑 {
            locale === "de"
              ? "Comercios Centenarios Vivos de Mallorca"
              : locale === "en"
                ? "Living Centenary Heritage (+100 Years)"
                : locale === "ca"
                  ? "Comerços Centenaris Vius (+100 Anys)"
                  : "Comercios Centenarios Vivos (+100 Años)"
          }
        </h2>
        <p>
          {
            locale === "de"
              ? "Geschäfte und Werkstätten, die seit über einem Jahrhundert Geschichte schreiben."
              : "Negocios y talleres artesanos que llevan más de un siglo forjando la identidad de la isla."
          }
        </p>
      </div>

      <div class="cards-grid" id="centenary-cards-grid">
        {
          centenaryList.map((item) => {
            const years = getYearsOfOperation(item);
            const foundedYear = item.foundedYear || 0;
            let eraClass = "s20";
            if (foundedYear > 0 && foundedYear < 1900) eraClass = "s18-19";
            return (
              <article
                class="heritage-card centenary"
                data-era="centenary"
                data-subera={eraClass}
                data-name={item.name.toLowerCase()}
                data-zone={item.zone?.toLowerCase()}
                data-desc={(item.shortDescription[locale] || item.shortDescription.es).toLowerCase()}
                data-year={foundedYear}
              >
                <div class="card-header">
                  <span class="badge-gold">
                    👑 +{years}{" "}
                    {locale === "de" ? "Jahre" : locale === "en" ? "Years" : locale === "ca" ? "Anys" : "Años"}
                  </span>
                  <span class="founded-year">{item.foundedYear ? `Fund. ${item.foundedYear}` : ""}</span>
                </div>
                <h3 class="business-name">{item.name}</h3>
                <p class="business-zone">📍 {item.address || item.zone}</p>
                <p class="business-desc">{item.shortDescription[locale] || item.shortDescription.es}</p>
                {item.founderStory && (
                  <blockquote class="founder-excerpt">
                    "
                    {item.founderStory[locale]
                      ? item.founderStory[locale].slice(0, 140)
                      : (item.founderStory.es || "").slice(0, 140)}
                    ..."
                  </blockquote>
                )}
                <div class="card-footer">
                  <a href={`${prefix}servicios/${item.slug}`} class="btn-history">
                    {locale === "de"
                      ? "Geschichte & Details ansehen"
                      : locale === "en"
                        ? "View History & Details"
                        : locale === "ca"
                          ? "Veure Història i Detalls"
                          : "Ver Historia y Detalles"}{" "}
                    &rarr;
                  </a>
                </div>
              </article>
            );
          })
        }
      </div>
    </section>

    <!-- General Historical Archive -->
    <section class="heritage-section" id="full-archive-section">
      <div class="section-heading">
        <h2>
          📜 {
            locale === "de"
              ? "Alle Traditions- und Vorzeigebetriebe"
              : locale === "en"
                ? "Full Heritage & Landmark Archive"
                : locale === "ca"
                  ? "Catàleg Històric Complet (+15 a +100 Anys)"
                  : "Catálogo Histórico Completo (+15 a +100 Años)"
          }
        </h2>
        <p>
          {
            locale === "de"
              ? "Entdecken Sie die Geschichte und Widerstandskraft des balearischen Unternehmertums."
              : locale === "en"
                ? "Discover the artisanal stories and commercial resilience of Mallorca."
                : locale === "ca"
                  ? "Coneix les històries d'autor i la resiliència comercial de l'illa de Mallorca."
                  : "Conoce las historias de autor y la resiliencia comercial de la isla de Mallorca."
          }
        </p>
      </div>

      <div class="cards-grid" id="heritage-cards-grid">
        {
          allHistorical.map((item) => {
            const years = getYearsOfOperation(item);
            const significance = resolveHistoricalSignificance(item);
            const isClosed = item.status === "permanently_closed";
            const foundedYear = item.foundedYear || 0;
            let eraClass = "s20";
            if (years >= 100) eraClass = "centenary";
            else if (foundedYear > 0 && foundedYear < 1900) eraClass = "s18-19";
            if (isClosed) eraClass = "memorial";

            return (
              <article
                class={`heritage-card ${years >= 100 ? "centenary" : ""} ${isClosed ? "closed-memorial" : ""}`}
                data-era={isClosed ? "memorial" : years >= 100 ? "centenary" : eraClass}
                data-subera={eraClass}
                data-name={item.name.toLowerCase()}
                data-zone={item.zone?.toLowerCase()}
                data-desc={(item.shortDescription[locale] || item.shortDescription.es).toLowerCase()}
                data-year={foundedYear}
              >
                <div class="card-header">
                  <span class={years >= 100 ? "badge-gold" : "badge-legacy"}>
                    {isClosed
                      ? locale === "de"
                        ? "🕊️ Historisches Archiv"
                        : locale === "en"
                          ? "🕊️ Historical Memorial"
                          : locale === "ca"
                            ? "🕊️ Memòria Històrica"
                            : "🕊️ Memoria Histórica"
                      : `⏳ ${years} ${locale === "de" ? "Jahre" : locale === "en" ? "Years" : locale === "ca" ? "Anys" : "Años"}`}
                  </span>
                  <span class="significance-tag">
                    {item.foundedYear ? `Fund. ${item.foundedYear}` : significance.replace("_", " ")}
                  </span>
                </div>
                <h3 class="business-name">{item.name}</h3>
                <p class="business-zone">📍 {item.address || item.zone}</p>
                <p class="business-desc">{item.shortDescription[locale] || item.shortDescription.es}</p>
                {isClosed && item.closureReason && (
                  <div class="closure-notice">
                    <strong>
                      {locale === "de"
                        ? "Schließungsgrund:"
                        : locale === "en"
                          ? "Closure Reason:"
                          : locale === "ca"
                            ? "Motiu històric de cessament:"
                            : "Motivo histórico de cese:"}
                    </strong>{" "}
                    {item.closureReason} ({item.closureYear})
                  </div>
                )}
                <div class="card-footer">
                  <a
                    href={`${prefix}servicios/${item.slug}`}
                    class={years >= 100 ? "btn-history" : "btn-history-outline"}
                  >
                    {locale === "de"
                      ? "Historischer Eintrag"
                      : locale === "en"
                        ? "Historical Record"
                        : locale === "ca"
                          ? "Fitxa Històrica"
                          : "Ficha Histórica"}{" "}
                    &rarr;
                  </a>
                </div>
              </article>
            );
          })
        }
      </div>
    </section>
  </main>

  <Footer translations={translations} currentLocale={locale} getLangPrefix={getLangPrefix} />
</BaseLayout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const searchInput = document.getElementById("heritage-search-input") as HTMLInputElement | null;
    const filterPills = document.querySelectorAll(".filter-pill");
    const cards = document.querySelectorAll<HTMLElement>(".heritage-card");
    const countVisibleEl = document.getElementById("heritage-count-visible");

    let currentEra = "all";
    let searchQuery = "";

    function applyFilters() {
      let visibleCount = 0;
      const normalizedQuery = searchQuery.trim().toLowerCase();

      cards.forEach((card) => {
        const era = card.getAttribute("data-era") || "";
        const subera = card.getAttribute("data-subera") || "";
        const name = card.getAttribute("data-name") || "";
        const zone = card.getAttribute("data-zone") || "";
        const desc = card.getAttribute("data-desc") || "";
        const year = card.getAttribute("data-year") || "";

        // Era filter matching
        let matchesEra = true;
        if (currentEra === "all") {
          matchesEra = true;
        } else if (currentEra === "centenary") {
          matchesEra = era === "centenary" || subera === "centenary";
        } else if (currentEra === "s18-19") {
          matchesEra = era === "s18-19" || subera === "s18-19";
        } else if (currentEra === "s20") {
          matchesEra = era === "s20" || subera === "s20";
        } else if (currentEra === "memorial") {
          matchesEra = era === "memorial";
        }

        // Search query matching
        let matchesSearch = true;
        if (normalizedQuery) {
          matchesSearch =
            name.includes(normalizedQuery) ||
            zone.includes(normalizedQuery) ||
            desc.includes(normalizedQuery) ||
            year.includes(normalizedQuery);
        }

        if (matchesEra && matchesSearch) {
          card.style.display = "flex";
          visibleCount++;
        } else {
          card.style.display = "none";
        }
      });

      if (countVisibleEl) {
        countVisibleEl.textContent = String(visibleCount);
      }
    }

    // Pill click listener
    filterPills.forEach((pill) => {
      pill.addEventListener("click", () => {
        filterPills.forEach((p) => p.classList.remove("active"));
        pill.classList.add("active");
        currentEra = pill.getAttribute("data-era") || "all";
        applyFilters();
      });
    });

    // Search input with debounce
    let debounceTimer: ReturnType<typeof setTimeout>;
    searchInput?.addEventListener("input", () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => {
        searchQuery = searchInput.value;
        applyFilters();
      }, 150);
    });
  });
</script>

<style>
  .breadcrumb-nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }
  .breadcrumb-nav a {
    color: var(--color-accent);
    text-decoration: none;
  }
  .active-crumb {
    color: var(--color-text-main);
    font-weight: 500;
  }
  .heritage-hero {
    text-align: center;
    max-width: 840px;
    margin: 0 auto 3rem;
  }
  .badge-heritage {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.95rem;
    background: rgba(212, 175, 55, 0.15);
    border: 1px solid var(--color-accent);
    border-radius: 9999px;
    color: var(--color-accent);
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }
  .hero-title {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    font-weight: 800;
    color: var(--color-text-main);
    line-height: 1.2;
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
  }
  .hero-subtitle {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  /* Stats Grid */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 150px), 1fr));
    gap: 1rem;
    margin-bottom: 3.5rem;
  }
  .stat-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    padding: 1.5rem 1rem;
    text-align: center;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.05);
    position: relative;
    transition: transform 0.2s ease;
  }
  .stat-card:hover {
    transform: translateY(-2px);
  }
  .stat-card-gold {
    border-color: var(--color-accent);
    background: linear-gradient(180deg, var(--color-surface) 0%, rgba(212, 175, 55, 0.08) 100%);
  }
  .stat-icon {
    font-size: 1.4rem;
    display: block;
    margin-bottom: 0.25rem;
  }
  .stat-number {
    display: block;
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--color-accent);
    margin-bottom: 0.25rem;
    letter-spacing: -0.02em;
  }
  .stat-label {
    font-size: 0.825rem;
    color: var(--color-text-muted);
    font-weight: 600;
  }

  /* Timeline Section */
  .timeline-section {
    padding: 2.5rem 2rem;
    border-radius: 1.25rem;
    margin-bottom: 4rem;
    background: linear-gradient(180deg, var(--color-surface) 0%, rgba(212, 175, 55, 0.03) 100%);
    border: 1px solid rgba(212, 175, 55, 0.3);
  }
  .timeline-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 2.5rem;
  }
  .timeline-title {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--color-text-main);
    margin: 0.75rem 0 0.5rem;
  }
  .timeline-subtitle {
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }
  .timeline-track {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 1.5rem;
    position: relative;
  }
  .timeline-node {
    display: flex;
    flex-direction: column;
  }
  .node-milestone {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }
  .node-year-badge {
    background: var(--color-accent);
    color: #000;
    font-weight: 800;
    font-size: 0.9rem;
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    box-shadow: 0 2px 8px rgba(212, 175, 55, 0.3);
  }
  .node-pin {
    flex-grow: 1;
    height: 2px;
    background: linear-gradient(90deg, var(--color-accent) 0%, transparent 100%);
  }
  .node-content {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.85rem;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease;
  }
  .node-content:hover {
    transform: translateY(-3px);
    border-color: var(--color-accent);
  }
  .node-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.75rem;
    margin-bottom: 0.5rem;
  }
  .node-years-tag {
    color: var(--color-accent);
    font-weight: 700;
  }
