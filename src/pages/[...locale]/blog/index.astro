---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Navbar from "../../../components/Navbar.astro";
import Footer from "../../../components/Footer.astro";
import BlogCard from "../../../components/BlogCard.astro";
import AdSenseSlot from "../../../components/AdSenseSlot.astro";
import { CATEGORIES } from "../../../data/categories";
import { BLOG_POSTS } from "../../../data/posts";
import { getLocaleFromUrl, loadTranslations, getLangPrefix, type Locale } from "../../../i18n";

export const prerender = false;

const locale = getLocaleFromUrl(Astro.url) as Locale;
const translations = await loadTranslations(locale);
const prefix = getLangPrefix(locale);

const selectedCategory = Astro.url.searchParams.get("categoria") || "";
const searchQuery = (Astro.url.searchParams.get("q") || "").toLowerCase().trim();

const filteredPosts = BLOG_POSTS.filter((post) => {
  if (selectedCategory && post.category !== selectedCategory) {
    return false;
  }
  if (searchQuery) {
    const titleMatch = post.title[locale].toLowerCase().includes(searchQuery);
    const excerptMatch = post.excerpt[locale].toLowerCase().includes(searchQuery);
    const tagMatch = post.tags.some((t) => t.toLowerCase().includes(searchQuery));
    if (!titleMatch && !excerptMatch && !tagMatch) {
      return false;
    }
  }
  return true;
});

// Featured hero post (first featured post)
const heroPost = BLOG_POSTS.find((p) => p.featured);
const heroCategory = heroPost ? CATEGORIES.find((c) => c.id === heroPost.category) : null;

// Category post counts
const categoryCounts = CATEGORIES.reduce(
  (acc, cat) => {
    acc[cat.id] = BLOG_POSTS.filter((p) => p.category === cat.id).length;
    return acc;
  },
  {} as Record<string, number>,
);

// Blog categories that have at least 1 post
const activeCategories = CATEGORIES.filter((cat) => (categoryCounts[cat.id] || 0) > 0);
---

<BaseLayout
  title={`${translations["blog.title"]} - ${translations["site.title"]}`}
  lang={locale}
  description={translations["blog.subtitle"]}
>
  <meta slot="head" property="og:type" content="website" />
  <meta slot="head" property="og:title" content={`${translations["blog.title"]} - ${translations["site.title"]}`} />
  <meta slot="head" property="og:description" content={translations["blog.subtitle"]} />
  {heroPost && <meta slot="head" property="og:image" content={heroPost.coverImage} />}

  <Navbar currentLocale={locale} translations={translations} getLangPrefix={getLangPrefix} />

  <!-- ═══ HERO SECTION ═══ -->
  {
    heroPost && !selectedCategory && !searchQuery && (
      <section class="blog-hero">
        <div class="blog-hero-inner container">
          {/* Left: text */}
          <div class="blog-hero-text">
            <span class="badge badge-accent">{translations["blog.featured"] || "Artículo Destacado"}</span>
            {heroCategory && (
              <span class="hero-category-pill">
                {heroCategory.icon} {heroCategory.name[locale]}
              </span>
            )}
            <h1 class="blog-hero-title">{heroPost.title[locale]}</h1>
            <p class="blog-hero-excerpt">{heroPost.excerpt[locale]}</p>
            <div class="blog-hero-meta">
              <img
                src={heroPost.author.avatar}
                alt={heroPost.author.name}
                class="hero-avatar"
                loading="lazy"
                onerror="this.style.display='none'"
              />
              <span class="hero-author-name">{heroPost.author.name}</span>
              <span class="hero-sep">·</span>
              <time datetime={heroPost.publishDate}>{heroPost.publishDate}</time>
              <span class="hero-sep">·</span>
              <span>
                ⏱️ {heroPost.readTime} {translations["blog.readTime"]}
              </span>
            </div>
            <a href={`${prefix}blog/${heroPost.slug}`} class="btn btn-primary hero-cta">
              {translations["blog.backToBlog"] ? translations["nav.blog"] : "Leer artículo"} →
            </a>
          </div>
          {/* Right: image */}
          <a href={`${prefix}blog/${heroPost.slug}`} class="blog-hero-image-wrap" tabindex="-1" aria-hidden="true">
            <img
              src={heroPost.coverImage}
              alt={heroPost.title[locale]}
              class="blog-hero-img"
              loading="eager"
              onerror="this.src='https://images.unsplash.com/photo-1544551763-46a013bb70d5?auto=format&fit=crop&w=800&q=80'"
            />
            <div class="blog-hero-img-overlay" />
          </a>
        </div>
      </section>
    )
  }

  <main class="container section">
    <!-- Page title when filtering -->
    {
      (selectedCategory || searchQuery) && (
        <header class="blog-header text-center">
          <span class="badge badge-accent">📝 Blog & Guías</span>
          <h1 class="blog-main-title">{translations["blog.title"]}</h1>
          <p class="blog-main-subtitle">{translations["blog.subtitle"]}</p>
        </header>
      )
    }
    {
      !selectedCategory && !searchQuery && (
        <h2 class="blog-section-title">{translations["blog.allArticles"] || "Todos los artículos"}</h2>
      )
    }

    <!-- ═══ SEARCH BAR ═══ -->
    <div class="blog-search-wrap">
      <div class="blog-search-box">
        <span class="blog-search-icon" aria-hidden="true">🔍</span>
        <input
          id="blog-search-input"
          type="search"
          class="blog-search-input"
          placeholder={translations["blog.search.placeholder"] || "Buscar artículos..."}
          value={searchQuery}
          autocomplete="off"
          aria-label={translations["blog.search.placeholder"] || "Buscar artículos"}
        />
        {
          searchQuery && (
            <a
              href={`${prefix}blog${selectedCategory ? `?categoria=${selectedCategory}` : ""}`}
              class="blog-search-clear"
              aria-label="Limpiar búsqueda"
            >
              ✕
            </a>
          )
        }
      </div>
    </div>

    <!-- ═══ CATEGORY PILLS ═══ -->
    <div class="category-pills-bar" role="navigation" aria-label="Categorías del blog">
      <a
        href={`${prefix}blog`}
        class:list={["pill-link", { active: !selectedCategory }]}
        aria-current={!selectedCategory ? "page" : undefined}
      >
        🌟 {translations["blog.allArticles"] || "Todos"}
        <span class="pill-count">{BLOG_POSTS.length}</span>
      </a>
      {
        activeCategories.map((cat) => (
          <a
            href={`${prefix}blog?categoria=${cat.id}`}
            class:list={["pill-link", { active: selectedCategory === cat.id }]}
            aria-current={selectedCategory === cat.id ? "page" : undefined}
          >
            <span>{cat.icon}</span>
            <span>{cat.name[locale]}</span>
            <span class="pill-count">{categoryCounts[cat.id]}</span>
          </a>
        ))
      }
    </div>

    <!-- ═══ POSTS GRID ═══ -->
    {
      filteredPosts.length > 0 ? (
        <div class="blog-posts-grid" id="blog-posts-grid">
          {filteredPosts.map((post, idx) => (
            <div
              class:list={[
                "blog-grid-item",
                { "blog-grid-item--wide": idx === 0 && !selectedCategory && !searchQuery },
              ]}
              style={`animation-delay: ${idx * 0.06}s`}
            >
              <BlogCard post={post} currentLocale={locale} getLangPrefix={getLangPrefix} translations={translations} />
            </div>
          ))}
        </div>
      ) : (
        <div class="no-results-box card text-center">
          <span class="no-results-icon">🔎</span>
          <h3>{translations["blog.search.noResults"] || "No se encontraron artículos"}</h3>
          <p>Intenta con otros términos o visualiza todos los artículos.</p>
          <a href={`${prefix}blog`} class="btn btn-primary btn-sm" style="margin-top: 1rem;">
            {translations["blog.search.clearFilters"] || "Ver todos los artículos"}
          </a>
        </div>
      )
    }

    <!-- AdSense Bottom Slot -->
    <AdSenseSlot format="horizontal" slotId="blog-directory-bottom" />
  </main>

  <Footer translations={translations} currentLocale={locale} getLangPrefix={getLangPrefix} />
</BaseLayout>

<!-- Live search script -->
<script>
  const input = document.getElementById("blog-search-input") as HTMLInputElement | null;
  if (input) {
    let debounceTimer: ReturnType<typeof setTimeout>;
    input.addEventListener("input", () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => {
        const q = input.value.trim();
        const url = new URL(window.location.href);
        if (q) {
          url.searchParams.set("q", q);
        } else {
          url.searchParams.delete("q");
        }
        window.location.href = url.toString();
      }, 420);
    });
    // Focus on load if has value
    if (input.value) input.focus();
  }
</script>

<style>
  /* ═══ HERO ═══ */
  .blog-hero {
    background: linear-gradient(
      135deg,
      var(--color-primary-dark) 0%,
      var(--color-primary) 60%,
      var(--color-primary-light) 100%
    );
    padding: var(--space-2xl) 0;
    margin-bottom: var(--space-2xl);
    overflow: hidden;
  }

  .blog-hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2xl);
    align-items: center;
    min-height: 360px;
  }

  .blog-hero-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    animation: fadeSlideUp 0.6s ease both;
  }

  .hero-category-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.2rem 0.65rem;
    border-radius: var(--border-radius-full);
    background: rgba(255, 255, 255, 0.18);
    color: rgba(255, 255, 255, 0.92);
    font-size: var(--font-size-xs);
    font-weight: 600;
    width: fit-content;
    backdrop-filter: blur(6px);
  }

  .blog-hero-title {
    font-size: clamp(1.6rem, 3.5vw, 2.5rem);
    font-weight: 900;
    color: #fff;
    line-height: 1.2;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.25);
  }

  .blog-hero-excerpt {
    font-size: var(--font-size-base);
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.6;
    max-width: 520px;
  }

  .blog-hero-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--font-size-xs);
    color: rgba(255, 255, 255, 0.75);
    flex-wrap: wrap;
  }

  .hero-avatar {
    width: 28px;
    height: 28px;
    border-radius: var(--border-radius-full);
    object-fit: cover;
    border: 2px solid rgba(255, 255, 255, 0.4);
  }

  .hero-author-name {
    font-weight: 700;
    color: rgba(255, 255, 255, 0.9);
  }

  .hero-sep {
    opacity: 0.5;
  }

  .hero-cta {
    margin-top: var(--space-xs);
    width: fit-content;
    background: #fff !important;
    color: var(--color-primary-dark) !important;
    font-weight: 800;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
  }

  .hero-cta:hover {
    background: var(--color-accent) !important;
    color: var(--color-text) !important;
    transform: translateY(-2px);
  }

  .blog-hero-image-wrap {
    position: relative;
    border-radius: var(--border-radius-lg);
    overflow: hidden;
    height: 360px;
    animation: fadeSlideUp 0.7s ease 0.1s both;
    box-shadow: var(--shadow-lg);
    display: block;
  }

  .blog-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .blog-hero-image-wrap:hover .blog-hero-img {
    transform: scale(1.04);
  }

  .blog-hero-img-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, transparent 50%, rgba(0, 0, 0, 0.15) 100%);
  }

  /* ═══ SECTION TITLE ═══ */
  .blog-section-title {
    font-size: var(--font-size-2xl);
    font-weight: 800;
    margin-bottom: var(--space-lg);
    color: var(--color-text);
    border-left: 4px solid var(--color-primary);
    padding-left: var(--space-sm);
  }

  /* ═══ PAGE HEADER (filter mode) ═══ */
  .blog-header {
    margin-bottom: var(--space-xl);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
  }

  .blog-main-title {
    font-size: clamp(2rem, 4vw, var(--font-size-3xl));
    font-weight: 800;
  }

  .blog-main-subtitle {
    color: var(--color-text-muted);
    font-size: var(--font-size-base);
    max-width: 600px;
  }

  /* ═══ SEARCH ═══ */
  .blog-search-wrap {
    margin-bottom: var(--space-lg);
  }

  .blog-search-box {
    position: relative;
    max-width: 540px;
    margin: 0 auto;
  }

  .blog-search-icon {
    position: absolute;
    left: var(--space-md);
    top: 50%;
    transform: translateY(-50%);
    font-size: 1rem;
    pointer-events: none;
  }

  .blog-search-input {
    width: 100%;
    padding: 0.75rem var(--space-2xl) 0.75rem 2.8rem;
    border: 1.5px solid var(--color-surface-border);
    border-radius: var(--border-radius-full);
    background: var(--color-surface);
    color: var(--color-text);
    font-size: var(--font-size-sm);
    font-family: var(--font-family);
    transition:
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);
    outline: none;
    -webkit-appearance: none;
  }

  .blog-search-input:focus {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px var(--color-primary-ring);
  }

  .blog-search-clear {
    position: absolute;
    right: var(--space-sm);
    top: 50%;
    transform: translateY(-50%);
    width: 28px;
    height: 28px;
    border-radius: var(--border-radius-full);
    background: var(--color-surface-hover);
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    font-size: 0.7rem;
    transition:
      background var(--transition-fast),
      color var(--transition-fast);
  }

  .blog-search-clear:hover {
    background: var(--color-danger-bg);
    color: var(--color-danger);
  }

  /* ═══ CATEGORY PILLS ═══ */
  .category-pills-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-xs);
    margin-bottom: var(--space-xl);
  }

  .pill-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.4rem 0.9rem;
    border-radius: var(--border-radius-full);
    background: var(--color-surface);
    border: 1.5px solid var(--color-surface-border);
    font-size: var(--font-size-xs);
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .pill-link:hover,
  .pill-link.active {
    background: var(--color-primary);
    color: var(--color-white);
    border-color: var(--color-primary);
    box-shadow: 0 2px 12px rgba(45, 106, 79, 0.25);
  }

  .pill-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 20px;
    height: 18px;
    padding: 0 0.3rem;
    border-radius: var(--border-radius-full);
    background: rgba(0, 0, 0, 0.12);
    font-size: 0.65rem;
    font-weight: 800;
  }

  .pill-link.active .pill-count {
    background: rgba(255, 255, 255, 0.25);
  }

  /* ═══ POSTS GRID ═══ */
  .blog-posts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }

  .blog-grid-item {
    animation: fadeSlideUp 0.5s ease both;
  }

  /* First item spans 2 columns when not filtering */
  .blog-grid-item--wide {
    grid-column: span 2;
  }

  /* No results */
  .no-results-box {
    padding: var(--space-2xl);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
  }

  .no-results-icon {
    font-size: 3rem;
  }

  @keyframes fadeSlideUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ═══ RESPONSIVE ═══ */
  @media (max-width: 1024px) {
    .blog-posts-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .blog-grid-item--wide {
      grid-column: span 2;
    }
  }

  @media (max-width: 768px) {
    .blog-hero-inner {
      grid-template-columns: 1fr;
      min-height: auto;
    }
    .blog-hero-image-wrap {
      height: 240px;
    }
    .blog-posts-grid {
      grid-template-columns: 1fr;
    }
    .blog-grid-item--wide {
      grid-column: span 1;
    }
  }

  @media (max-width: 480px) {
    .blog-hero {
      padding: var(--space-lg) 0;
    }
    .blog-hero-title {
      font-size: 1.5rem;
    }
  }
</style>
