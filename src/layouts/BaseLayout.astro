---
import "../styles/global.css";
import ToastContainer from "../components/ToastContainer.astro";
import BetaBanner from "../components/BetaBanner.astro";
import CommunityVoiceModal from "../components/CommunityVoiceModal.astro";

export interface Props {
  title: string;
  lang?: string;
  description?: string;
  image?: string;
  ogType?: string;
  canonicalUrl?: string;
  twitterCard?: "summary" | "summary_large_image";
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
}

const {
  title,
  lang = "es",
  description = "Servicios Mallorca - Guía y directorio de los mejores servicios y profesionales en Mallorca",
  image,
  ogType = "website",
  canonicalUrl,
  twitterCard = "summary_large_image",
  jsonLd,
} = Astro.props;

const currentOrigin = Astro.url.origin || "https://serviciosmallorca.com";
const pageCanonical = canonicalUrl || `${currentOrigin}${Astro.url.pathname}`;

// Alternates Multilingües para SEO Internacional e IA (hreflang)
const rawPath = Astro.url.pathname;
const pathWithoutLocale = rawPath.replace(/^\/(es|en|ca|de)(\/|$)/, "/");
const cleanSuffix = pathWithoutLocale.length > 1 ? pathWithoutLocale : "";

const hreflangAlternates = [
  { lang: "es", href: `${currentOrigin}/es${cleanSuffix}` },
  { lang: "en", href: `${currentOrigin}/en${cleanSuffix}` },
  { lang: "ca", href: `${currentOrigin}/ca${cleanSuffix}` },
  { lang: "de", href: `${currentOrigin}/de${cleanSuffix}` },
  { lang: "x-default", href: `${currentOrigin}/es${cleanSuffix}` },
];

// Imagen absoluta para Open Graph, WhatsApp y Twitter Cards
const defaultOgImage = `${currentOrigin}/og-image.jpg`;
let absoluteImageUrl = defaultOgImage;

if (image && !image.endsWith(".svg")) {
  if (image.startsWith("http://") || image.startsWith("https://")) {
    absoluteImageUrl = image;
  } else {
    absoluteImageUrl = `${currentOrigin}${image.startsWith("/") ? image : `/${image}`}`;
  }
}

const ogLocaleMap: Record<string, string> = {
  es: "es_ES",
  en: "en_GB",
  ca: "ca_ES",
  de: "de_DE",
};
const ogLocale = ogLocaleMap[lang] || "es_ES";

// Structured Data Global (WebSite con SearchAction y Organization)
const globalWebsiteSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${currentOrigin}/#website`,
      url: currentOrigin,
      name: "Servicios Mallorca",
      description: "Guía y directorio oficial de empresas, profesionales y servicios verificados en Mallorca",
      inLanguage: ["es", "en", "ca", "de"],
      potentialAction: {
        "@type": "SearchAction",
        target: {
          "@type": "EntryPoint",
          urlTemplate: `${currentOrigin}/${lang}/servicios?q={search_term_string}`,
        },
        "query-input": "required name=search_term_string",
      },
    },
    {
      "@type": "Organization",
      "@id": `${currentOrigin}/#organization`,
      name: "Servicios Mallorca",
      url: currentOrigin,
      logo: `${currentOrigin}/favicon.svg`,
      areaServed: {
        "@type": "AdministrativeArea",
        name: "Mallorca, Illes Balears, España",
      },
      knowsAbout: ["Servicios profesionales", "Restaurantes", "Náutica", "Reformas", "Salud y Belleza", "Deporte"],
    },
  ],
};

const loadingText = lang === "en" ? "Loading..." : lang === "ca" ? "Carregant..." : "Cargando...";
const loadingAria =
  lang === "en" ? "Loading application" : lang === "ca" ? "Carregant aplicació" : "Cargando aplicación";

const isAdSenseDisabled = import.meta.env.PUBLIC_ENABLE_ADSENSE === "false";
const shouldLoadAdSense =
  !isAdSenseDisabled &&
  import.meta.env.PROD &&
  !Astro.url.hostname.includes("localhost") &&
  !Astro.url.hostname.includes("127.0.0.1");
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={pageCanonical} />

    <!-- Hreflang Alternates Multilingües (SEO Internacional & AI Positioning) -->
    {hreflangAlternates.map((alt) => <link rel="alternate" hreflang={alt.lang} href={alt.href} />)}

    <!-- Robots & AI Crawling Directives (Google, ChatGPT, Claude, Perplexity) -->
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="bingbot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

    <!-- Geo & Local SEO Tags (Mallorca / Islas Baleares) -->
    <meta name="geo.region" content="ES-IB" />
    <meta name="geo.placename" content="Mallorca, Illes Balears, España" />
    <meta name="geo.position" content="39.6953;3.0176" />
    <meta name="ICBM" content="39.6953, 3.0176" />

    <!-- Open Graph / WhatsApp / Facebook / Telegram / LinkedIn Meta Tags -->
    <meta property="og:site_name" content="Servicios Mallorca" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:image" content={absoluteImageUrl} />
    <meta property="og:image:secure_url" content={absoluteImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={ogLocale} />
    <link rel="image_src" href={absoluteImageUrl} />

    <!-- Twitter / X Meta Tags -->
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImageUrl} />
    <meta name="twitter:image:alt" content={title} />

    <!-- Security meta tags -->
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{title}</title>

    <!-- Global WebSite & Organization JSON-LD -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(globalWebsiteSchema)} />

    <!-- Page Specific Structured Data JSON-LD -->
    {
      jsonLd && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(Array.isArray(jsonLd) && jsonLd.length === 1 ? jsonLd[0] : jsonLd)}
        />
      )
    }

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-PN0STSN2FR"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-PN0STSN2FR");
    </script>

    <!-- Google AdSense (Loaded only when explicitly enabled and on verified production domains) -->
    {
      shouldLoadAdSense && (
        <script
          is:inline
          async
          src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1988580228487420"
          crossorigin="anonymous"
        />
      )
    }

    <!-- Theme initialization script to prevent FOUC (defaults to Mediterranean Gold) -->
    <script is:inline>
      (function () {
        const THEME_KEY = "webapp-theme";
        const VALID_THEMES = ["light", "dark", "golden", "golden-dark"];
        const stored = localStorage.getItem(THEME_KEY);
        if (stored && VALID_THEMES.includes(stored)) {
          document.documentElement.setAttribute("data-theme", stored);
        } else if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
          document.documentElement.setAttribute("data-theme", "golden-dark");
        } else {
          document.documentElement.setAttribute("data-theme", "golden");
        }
      })();
    </script>
    <!-- DevTools mode: auto-activate on localhost, or via ?devtools flag -->
    <script is:inline>
      (function () {
        const D = "__devtools_enabled";
        const isLocalhost =
          window.location.hostname === "localhost" ||
          window.location.hostname === "127.0.0.1" ||
          window.location.hostname === "[::1]";
        const hasFlag = window.location.search.includes("devtools") || window.location.search.includes("dev");
        if (isLocalhost || hasFlag) {
          document.cookie = D + "=1;path=/;max-age=" + 365 * 24 * 60 * 60 + ";SameSite=Lax";
        }

        // Siempre cargar el logger para telemetría de salud y diagnóstico de errores en vivo
        const ls = document.createElement("script");
        ls.src = "/devtools-logger.js";
        ls.defer = true;
        document.head.appendChild(ls);

        const m = document.cookie.match(new RegExp("(?:^|;\\s*)" + D + "=([^;]+)"));
        if (m && m[1] === "1") {
          const fs = document.createElement("script");
          fs.src = "/devtools-floating.js";
          fs.defer = true;
          document.head.appendChild(fs);
        }
      })();
    </script>

    <!-- Inline loading screen styles (paints before Astro JS) -->
    <style is:inline>
      #app-loading-overlay {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--color-bg, #f8faf9);
        transition:
          opacity 0.35s cubic-bezier(0.4, 0, 0.2, 1),
          visibility 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      }
      #app-loading-overlay.is-hidden {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
      }
      .loader-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.5rem;
        animation: loaderFadeIn 0.4s ease-out both;
      }
      @keyframes loaderFadeIn {
        from {
          opacity: 0;
          transform: translateY(12px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      .loader-brand {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
      }
      .loader-badge {
        display: inline-block;
        padding: 0.35rem 1rem;
        background: rgba(45, 106, 79, 0.1);
        color: #40916c;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        border-radius: 9999px;
      }
      .loader-title {
        font-size: 1.5rem;
        font-weight: 800;
        color: #1a1a2e;
        letter-spacing: -0.02em;
      }
      .loader-spinner {
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .spinner-ring {
        width: 36px;
        height: 36px;
        border: 3px solid rgba(0, 0, 0, 0.08);
        border-top-color: #40916c;
        border-radius: 50%;
        animation: spin 0.7s linear infinite;
      }
      @keyframes spin {
        to {
          transform: rotate(360deg);
        }
      }
      .loader-text {
        font-size: 0.875rem;
        color: #8c8c9e;
        font-weight: 500;
      }
    </style>
  </head>
  <body>
    <!-- ============================================================
    Loading Screen — inline HTML for instant paint.
    Hidden when app:ready custom event fires or after DOMContentLoaded.
    ============================================================ -->
    <!-- Loading Screen -->
    <div id="app-loading-overlay" role="status" aria-label={loadingAria}>
      <div class="loader-content">
        <div class="loader-brand">
          <span class="loader-badge">🌴 Mallorca</span>
          <span class="loader-title">Servicios Mallorca</span>
        </div>
        <div class="loader-spinner">
          <div class="spinner-ring"></div>
        </div>
        <p class="loader-text">{loadingText}</p>
      </div>
    </div>

    <!-- Global Toast Container for reactive notifications -->
    <ToastContainer />

    <!-- Top Informative Beta Banner (v0.01) -->
    <BetaBanner currentLocale={lang as any} />

    <slot />

    <!-- Universal Community Voice & Quality Feedback Modal -->
    <CommunityVoiceModal currentLocale={lang as any} translations={{}} />

    <!-- Loading screen controller (inline, fires before any module JS) -->
    <script is:inline>
      (function () {
        const overlay = document.getElementById("app-loading-overlay");
        function hide() {
          if (overlay && !overlay.classList.contains("is-hidden")) {
            overlay.classList.add("is-hidden");
          }
        }
        // Listen for custom readiness event from authStore or main app
        window.addEventListener("app:ready", hide, { once: true });
        // Fallback: hide after DOM is fully ready + small buffer
        window.addEventListener(
          "DOMContentLoaded",
          function () {
            setTimeout(hide, 600);
          },
          { once: true },
        );
      })();
    </script>

    <script>
      import { initClientErrorReporter } from "../scripts/client-error-reporter";
      initClientErrorReporter();
    </script>
  </body>
</html>
