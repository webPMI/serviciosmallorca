---
import type { ServiceItem } from "../data/services/types";
import type { Locale } from "../i18n";

interface Props {
  service: ServiceItem;
  translations: Record<string, string>;
  locale: Locale;
}

const { service, translations, locale } = Astro.props;
const items = service.servicesProvided?.[locale] || [];
---

{
  items.length > 0 && (
    <section class="card section-box">
      <h2 class="box-title">{translations["services.included"]}</h2>
      <div class="services-chips">
        {items.map((s: string) => (
          <span class="service-chip">🔹 {s}</span>
        ))}
      </div>
    </section>
  )
}
