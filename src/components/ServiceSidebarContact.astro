---
import type { ServiceItem } from "../data/services/types";
import LiveScheduleBadge from "./LiveScheduleBadge.astro";
import AdSenseSlot from "./AdSenseSlot.astro";

interface Props {
  service: ServiceItem;
  translations: Record<string, string>;
  prefix?: string;
}

const { service, translations, prefix = "/es/" } = Astro.props;
---

<aside class="detail-sidebar">
  <div class="contact-card card card-glass sticky-card">
    <h3 class="contact-title">{translations["services.contact"]}</h3>
    <p class="contact-subtitle">Contacta de forma directa e inmediata con el proveedor verificado.</p>

    <div class="contact-buttons-stack">
      <!-- WhatsApp button -->
      {
        service.whatsapp && (
          <a
            href={`https://wa.me/${service.whatsapp.replace(/[^0-9]/g, "")}?text=Hola,%20he%20visto%20su%20servicio%20en%20Servicios%20Mallorca`}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary btn-full whatsapp-btn"
          >
            <span>💬</span>
            <span>{translations["services.whatsapp"]}</span>
          </a>
        )
      }

      <!-- Call button -->
      {
        service.phone && (
          <a href={`tel:${service.phone.replace(/[^0-9+]/g, "")}`} class="btn btn-secondary btn-full">
            <span>📞</span>
            <span>
              {translations["services.call"]} ({service.phone})
            </span>
          </a>
        )
      }

      <!-- Website button -->
      {
        service.website && (
          <a href={service.website} target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-full">
            <span>🌐</span>
            <span>{translations["services.website"]}</span>
          </a>
        )
      }

      <!-- Share button -->
      <button
        type="button"
        id="share-service-btn"
        class="btn btn-secondary btn-full"
        data-open-modal="social-share-modal"
        data-service-title={service.name}
        data-service-desc={service.shortDescription?.es || ""}
      >
        <span>📤</span>
        <span>{translations["services.share"] || "Compartir Negocio"}</span>
      </button>
    </div>

    <!-- Info Details with 1-click copy -->
    <div class="contact-meta-info">
      <div class="info-row">
        <span class="info-label">📍 {translations["services.address"]}:</span>
        <div class="info-val-wrap">
          <span class="info-val">{service.address}</span>
          <button type="button" class="btn-copy-info" data-copy-text={service.address} title="Copiar Dirección">
            📋
          </button>
        </div>
      </div>

      {
        service.phone && (
          <div class="info-row">
            <span class="info-label">📞 {translations["services.phone"]}:</span>
            <div class="info-val-wrap">
              <span class="info-val phone-display-text">{service.phone}</span>
              <button type="button" class="btn-copy-info" data-copy-text={service.phone} title="Copiar Teléfono">
                📋
              </button>
            </div>
          </div>
        )
      }

      <!-- Live Operational Status Badge -->
      {
        service.schedule && (
          <div class="info-row">
            <LiveScheduleBadge
              scheduleText={service.schedule}
              serviceStatus={service.status}
              phone={service.phone}
              whatsapp={service.whatsapp}
              businessName={service.name}
            />
          </div>
        )
      }

      {
        service.schedule && (
          <div class="info-row">
            <span class="info-label">🕒 {translations["services.schedule"]}:</span>
            <span class="info-val schedule-display-text">{service.schedule}</span>
          </div>
        )
      }

      <div class="info-row">
        <span class="info-label">💶 {translations["services.price"]}:</span>
        <span class="info-val">{service.priceRange}</span>
      </div>

      {
        service.tags && service.tags.length > 0 && (
          <div class="tags-cloud">
            {service.tags.map((tag: string) => (
              <span class="tag-pill">#{tag}</span>
            ))}
          </div>
        )
      }

      <!-- Community Boost Trigger Button -->
      <div class="community-boost-cta-box">
        <button
          type="button"
          id="boost-service-btn"
          class="btn btn-sm btn-primary btn-full boost-pulse-btn"
          data-service-id={service.id}
          data-service-name={service.name}
          data-service-slug={service.slug}
        >
          <span>❤️ Impulsar & Aupar a Favorito (+1€)</span>
        </button>
        <span class="boost-helper-txt">
          {
            service.communityBackersCount && service.communityBackersCount > 0
              ? `🔥 ${service.communityBackersCount} vecinos han aportado ${service.communityBoostTotal || 0}€`
              : "Sé el primer vecino en respaldar este comercio"
          }
        </span>
      </div>

      <div class="business-owner-box">
        <div class="owner-box-header">
          <span class="owner-icon">🏢</span>
          <div>
            <strong>¿Eres el titular de este negocio?</strong>
            <p>Reclama la ficha gratis (0€) para editar horarios, fotos y acceder al Cuadro de Honor.</p>
          </div>
        </div>
        <div class="business-owner-actions">
          <button type="button" id="open-claim-modal-btn" class="btn btn-sm btn-accent btn-full">
            ⚡ Reclamar Titularidad (0€)
          </button>
          <a
            href={`${prefix}unete`}
            class="btn btn-sm btn-outline-secondary btn-full"
            style="text-align: center; text-decoration: none;"
          >
            📋 Ver Pasos, Tarifas & Puestos (+1€)
          </a>
          <div class="minor-actions-row">
            <button
              type="button"
              id="open-report-modal-btn"
              class="optout-link-btn"
              style="color: var(--color-warning, #d97706); text-decoration: none;"
            >
              🚩 {translations["services.reportError"]}
            </button>
            <button type="button" id="open-delete-modal-btn" class="optout-link-btn">
              {translations["services.optoutLink"]}
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- AdSense Sidebar Banner -->
    <div style="margin-top: var(--space-md);">
      <AdSenseSlot slotId="service-sidebar-banner" format="rectangle" />
    </div>
  </div>
</aside>

<style>
  .community-boost-cta-box {
    margin-top: var(--space-md, 1rem);
    padding: 10px;
    background: rgba(37, 99, 235, 0.08);
    border: 1px solid rgba(59, 130, 246, 0.25);
    border-radius: var(--radius-md, 8px);
    text-align: center;
  }

  .boost-pulse-btn {
    font-weight: 700;
    letter-spacing: 0.2px;
  }

  .boost-helper-txt {
    display: block;
    font-size: 0.73rem;
    color: var(--color-primary-light, #93c5fd);
    margin-top: 6px;
    font-weight: 600;
  }

  .business-owner-box {
    margin-top: var(--space-md, 1rem);
    padding: var(--space-md, 1rem);
    background: rgba(255, 215, 0, 0.06);
    border: 1px dashed rgba(255, 215, 0, 0.35);
    border-radius: var(--radius-md, 8px);
  }

  .owner-box-header {
    display: flex;
    gap: 8px;
    margin-bottom: var(--space-sm, 0.75rem);
  }

  .owner-icon {
    font-size: 1.3rem;
    flex-shrink: 0;
  }

  .owner-box-header strong {
    display: block;
    font-size: 0.88rem;
    color: var(--color-accent, #ffd700);
    line-height: 1.3;
  }

  .owner-box-header p {
    font-size: 0.78rem;
    color: var(--color-text-secondary, #cbd5e1);
    margin: 2px 0 0 0;
    line-height: 1.35;
  }

  .minor-actions-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 6px;
    padding-top: 6px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .optout-link-btn {
    background: transparent;
    border: none;
    font-size: 0.72rem;
    color: var(--color-text-muted, #94a3b8);
    cursor: pointer;
    padding: 2px 4px;
  }

  .optout-link-btn:hover {
    text-decoration: underline;
  }
</style>
