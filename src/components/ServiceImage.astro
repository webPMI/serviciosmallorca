---
interface Props {
  src?: string;
  alt: string;
  categoryIcon?: string;
  categoryName?: string;
  className?: string;
  aspectRatio?: "16/9" | "4/3" | "1/1" | "21/9" | "auto";
  loading?: "lazy" | "eager";
  id?: string;
}

const {
  src,
  alt,
  categoryIcon = "📍",
  categoryName = "Servicio Mallorca",
  className = "",
  aspectRatio = "16/9",
  loading = "lazy",
  id,
} = Astro.props;

const hasValidSrc = Boolean(src && src.trim().length > 0);
---

<div class:list={["service-image-wrapper", `ratio-${aspectRatio.replace("/", "-")}`, className]}>
  {
    hasValidSrc && (
      <div class="service-img-skeleton" aria-hidden="true">
        <div class="skeleton-shimmer" />
        <div class="skeleton-icon-placeholder">
          <span class="skeleton-icon">{categoryIcon}</span>
        </div>
      </div>
    )
  }

  {
    hasValidSrc ? (
      <img
        id={id}
        src={src}
        alt={alt}
        loading={loading}
        decoding="async"
        class="service-real-img"
        onload="this.classList.add('is-loaded'); const sk = this.parentElement.querySelector('.service-img-skeleton'); if(sk) sk.classList.add('fade-out');"
        onerror="this.style.display='none'; const sk = this.parentElement.querySelector('.service-img-skeleton'); if(sk) sk.remove(); if(this.nextElementSibling) this.nextElementSibling.style.display='flex';"
      />
    ) : null
  }

  <!-- Graceful Fallback if image fails or is absent -->
  <div
    class="service-img-placeholder"
    style={hasValidSrc ? "display: none;" : "display: flex;"}
    aria-label={`Imagen no disponible para ${alt}`}
  >
    <div class="placeholder-content">
      <div class="placeholder-icon-wrap">
        <span class="placeholder-icon">{categoryIcon}</span>
      </div>
      <span class="placeholder-title">{alt}</span>
      <span class="placeholder-badge">
        <span>📸</span>
        <span>Foto no disponible</span>
      </span>
      <span class="placeholder-category">{categoryName}</span>
    </div>
  </div>
</div>

<style>
  .service-image-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: var(--color-surface, #f1f5f9);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ratio-16-9 {
    aspect-ratio: 16 / 9;
  }

  .ratio-4-3 {
    aspect-ratio: 4 / 3;
  }

  .ratio-1-1 {
    aspect-ratio: 1 / 1;
  }

  .ratio-21-9 {
    aspect-ratio: 21 / 9;
  }

  .ratio-auto {
    height: 100%;
  }

  /* Skeleton Shimmer Styles */
  .service-img-skeleton {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-surface-hover, #e2e8f0);
    overflow: hidden;
    transition:
      opacity 0.35s ease-out,
      visibility 0.35s ease-out;
  }

  .service-img-skeleton.fade-out {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .skeleton-shimmer {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.25) 50%, transparent 100%);
    background-size: 200% 100%;
    animation: skeleton-wave 1.6s infinite cubic-bezier(0.4, 0, 0.2, 1);
  }

  [data-theme="golden-dark"] .skeleton-shimmer,
  [data-theme="dark"] .skeleton-shimmer {
    background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.08) 50%, transparent 100%);
  }

  .skeleton-icon-placeholder {
    opacity: 0.35;
    transform: scale(1.4);
    filter: grayscale(1);
  }

  .skeleton-icon {
    font-size: 2rem;
  }

  @keyframes skeleton-wave {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(100%);
    }
  }

  /* Smooth image transition */
  .service-real-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    image-orientation: from-image;
    display: block;
    opacity: 0;
    transform: scale(1.02);
    transition:
      opacity 0.4s cubic-bezier(0.4, 0, 0.2, 1),
      transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .service-real-img.is-loaded {
    opacity: 1;
    transform: scale(1);
  }

  /* Fallback placeholder */
  .service-img-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--color-surface, #f8fafc) 0%, var(--color-surface-hover, #f1f5f9) 100%);
    padding: var(--space-4, 1rem);
    text-align: center;
    border: 1px dashed var(--color-surface-border, #cbd5e1);
  }

  .placeholder-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-1, 0.25rem);
  }

  .placeholder-icon-wrap {
    width: 48px;
    height: 48px;
    border-radius: var(--border-radius-full, 9999px);
    background: var(--color-surface, #ffffff);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-sm, 0 1px 2px rgba(0, 0, 0, 0.05));
    margin-bottom: var(--space-1, 0.25rem);
  }

  .placeholder-icon {
    font-size: 1.5rem;
  }

  .placeholder-title {
    font-weight: 700;
    font-size: var(--font-size-xs, 0.75rem);
    color: var(--color-text, #1e293b);
    max-width: 200px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .placeholder-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--color-text-muted, #64748b);
    background: var(--color-surface, #ffffff);
    padding: 0.15rem 0.5rem;
    border-radius: var(--border-radius-full, 9999px);
    border: 1px solid var(--color-surface-border, #e2e8f0);
  }

  .placeholder-category {
    font-size: 0.65rem;
    color: var(--color-primary, #c9933e);
    font-weight: 600;
  }
</style>
