---
import ThemeSwitcher from "./ThemeSwitcher.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";

interface Props {
  currentLocale: "es" | "en" | "ca" | "de" | string;
  translations: Record<string, string>;
  getLangPrefix: (locale: "es" | "en" | "ca" | "de") => string;
  currentPath: string;
}

const { currentLocale, translations, getLangPrefix, currentPath } = Astro.props;
const localeTyped = (currentLocale as "es" | "en" | "ca" | "de") || "es";
const prefix = getLangPrefix(localeTyped);
const homeUrl = prefix || "/";

// Helper para detectar si un enlace está activo
const isActive = (path: string): boolean => {
  const normalizedCurrent = currentPath.split("#")[0].replace(/\/$/, "") || "/";
  const normalizedTarget = path.split("#")[0].replace(/\/$/, "") || "/";
  return normalizedCurrent === normalizedTarget;
};

const isHomeActive = isActive(homeUrl);
const isServicesActive = isActive(`${homeUrl}servicios`) || currentPath.includes("/servicios");
const isSportsActive = isActive(`${homeUrl}deporte`) || currentPath.includes("/deporte");
const isAssistantActive = isActive(`${homeUrl}asistente`) || currentPath.includes("/asistente");
const isToursActive = isActive(`${homeUrl}tours`) || currentPath.includes("/tours");
const isHistoryActive = isActive(`${homeUrl}memoria-historica`) || currentPath.includes("/memoria-historica");
const isStatsActive = isActive(`${homeUrl}estadisticas`) || currentPath.includes("/estadisticas");
const isGuidesActive = isActive(`${homeUrl}guias`) || currentPath.includes("/guias");
const isNormativaActive = isActive(`${homeUrl}normativa`) || currentPath.includes("/normativa");
const isCommunityActive = isActive(`${homeUrl}comunidad`) || currentPath.includes("/comunidad");
const isHonorActive = isActive(`${homeUrl}cuadro-de-honor`) || currentPath.includes("/cuadro-de-honor");
const isJoinActive = isActive(`${homeUrl}unete`) || currentPath.includes("/unete");
const isBlogActive = isActive(`${homeUrl}blog`) || currentPath.includes("/blog");
const isAboutActive = isActive(`${homeUrl}sobre-nosotros`) || currentPath.includes("/sobre-nosotros");
const isLoginActive = isActive(`${homeUrl}login`);
const isRegisterActive = isActive(`${homeUrl}register`);
---

<header class="navbar-header nav-public">
  <div class="container navbar-container">
    <!-- Brand Logo / Title -->
    <a href={homeUrl} class="navbar-brand" aria-label={translations["nav.aria.publicBrand"] || "Servicios Mallorca"}>
      <span class="brand-badge badge badge-primary">🌴 Mallorca</span>
      <span class="brand-title">Servicios Mallorca</span>
    </a>

    <!-- Mobile Hamburger Toggle Button -->
    <button
      id="public-menu-toggle"
      class="mobile-toggle-btn mobile-menu-button"
      aria-label={translations["nav.aria.openPublicMenu"] || "Abrir menú de navegación"}
      aria-expanded="false"
    >
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>

    <!-- Public Navigation Menu -->
    <div id="public-navbar-menu" class="navbar-menu">
      <nav class="navbar-links" aria-label={translations["nav.aria.publicNav"] || "Navegación pública"}>
        <!-- ── SECCIÓN 1: EXPLORAR MALLORCA ── -->
        <span class="nav-section-title">🧭 {translations["nav.section.explore"] || "Explorar Mallorca"}</span>

        <a
          href={homeUrl}
          class:list={["nav-link", "nav-desktop-link", { active: isHomeActive }]}
          aria-current={isHomeActive ? "page" : undefined}
        >
          {translations["nav.home"] || "Inicio"}
        </a>
        <a
          href={`${homeUrl}servicios`}
          class:list={["nav-link", "nav-desktop-link", { active: isServicesActive }]}
          aria-current={isServicesActive ? "page" : undefined}
        >
          🌴 {translations["nav.services"] || "Servicios"}
        </a>
        <a
          href={`${homeUrl}deporte`}
          class:list={["nav-link", "nav-desktop-link", { active: isSportsActive }]}
          aria-current={isSportsActive ? "page" : undefined}
        >
          🏃 {translations["nav.sports"] || "Deporte"}
        </a>
        <a
          href={`${homeUrl}asistente`}
          class:list={["nav-link", "nav-desktop-link", { active: isAssistantActive }]}
          aria-current={isAssistantActive ? "page" : undefined}
        >
          🤖 {translations["nav.assistant"] || "Asistente"}
        </a>

        <!-- ── Desktop "Explorar" Submenu Dropdown ── -->
        <div class="nav-explore-dropdown nav-desktop-link">
          <details class="explore-details" id="explore-dropdown-details">
            <summary class="explore-summary" aria-label={translations["nav.section.explore"] || "Explorar"}>
              <span>🧭 {translations["nav.section.explore"] || "Explorar"}</span>
              <span class="explore-arrow" aria-hidden="true">▾</span>
            </summary>
            <div class="explore-menu" role="menu">
              <a href={`${homeUrl}tours`} class="explore-item" role="menuitem">
                <span class="explore-icon">🗺️</span>
                <span>{translations["nav.tours"] || "Rutas & Experiencias"}</span>
              </a>
              <a href={`${homeUrl}memoria-historica`} class="explore-item" role="menuitem">
                <span class="explore-icon">🏛️</span>
                <span>{translations["nav.history"] || "Memoria Histórica"}</span>
              </a>
              <a href={`${homeUrl}estadisticas`} class="explore-item" role="menuitem">
                <span class="explore-icon">📊</span>
                <span>{translations["nav.stats"] || "Estadísticas Oficiales"}</span>
              </a>
              <a href={`${homeUrl}estadisticas/comparativas`} class="explore-item" role="menuitem">
                <span class="explore-icon">📈</span>
                <span
                  >{
                    localeTyped === "ca"
                      ? "Comparatives 20 Anys"
                      : localeTyped === "en"
                        ? "20-Yr Comparisons"
                        : localeTyped === "de"
                          ? "20-Jahre-Vergleich"
                          : "Comparativas 20 Años"
                  }</span
                >
              </a>
              <a href={`${homeUrl}guias`} class="explore-item" role="menuitem">
                <span class="explore-icon">📋</span>
                <span>{translations["nav.guides"] || "Trámites & Guías"}</span>
              </a>
              <a href={`${homeUrl}normativa`} class="explore-item" role="menuitem">
                <span class="explore-icon">⚖️</span>
                <span
                  >{
                    localeTyped === "ca"
                      ? "Normativa & BOIB"
                      : localeTyped === "en"
                        ? "Regulations & BOIB"
                        : localeTyped === "de"
                          ? "Gesetze & BOIB"
                          : "Normativa & BOIB"
                  }</span
                >
              </a>
              <a href={`${homeUrl}blog`} class="explore-item" role="menuitem">
                <span class="explore-icon">📰</span>
                <span>{translations["nav.blog"] || "Blog & Artículos"}</span>
              </a>
              <a href={`${homeUrl}actualizaciones`} class="explore-item" role="menuitem">
                <span class="explore-icon">🚀</span>
                <span>{translations["nav.changelog"] || "Actualizaciones & Beta"}</span>
              </a>
              <a href={`${homeUrl}sobre-nosotros`} class="explore-item" role="menuitem">
                <span class="explore-icon">🌿</span>
                <span>{translations["nav.about"] || "Sobre Nosotros"}</span>
              </a>
            </div>
          </details>
        </div>
        <a
          href={`${homeUrl}tours`}
          class:list={["nav-link", "nav-drawer-only", { active: isToursActive }]}
          aria-current={isToursActive ? "page" : undefined}
        >
          🗺️ {translations["nav.tours"] || "Rutas & Experiencias"}
        </a>
        <a
          href={`${homeUrl}memoria-historica`}
          class:list={["nav-link", "nav-drawer-only", { active: isHistoryActive }]}
          aria-current={isHistoryActive ? "page" : undefined}
        >
          🏛️ {translations["nav.history"] || "Memoria Histórica"}
        </a>
        <a
          href={`${homeUrl}estadisticas`}
          class:list={[
            "nav-link",
            "nav-drawer-only",
            { active: isStatsActive && !currentPath.includes("/comparativas") },
          ]}
          aria-current={isStatsActive && !currentPath.includes("/comparativas") ? "page" : undefined}
        >
          📊 {translations["nav.stats"] || "Estadísticas"}
        </a>
        <a
          href={`${homeUrl}estadisticas/comparativas`}
          class:list={["nav-link", "nav-drawer-only", { active: currentPath.includes("/estadisticas/comparativas") }]}
          aria-current={currentPath.includes("/estadisticas/comparativas") ? "page" : undefined}
        >
          📈 {
            localeTyped === "ca"
              ? "Comparatives 20 Anys"
              : localeTyped === "en"
                ? "20-Yr Comparisons"
                : localeTyped === "de"
                  ? "20-Jahre-Vergleich"
                  : "Comparativas 20 Años"
          }
        </a>
        <a
          href={`${homeUrl}guias`}
          class:list={["nav-link", "nav-drawer-only", { active: isGuidesActive }]}
          aria-current={isGuidesActive ? "page" : undefined}
        >
          📋 {translations["nav.guides"] || "Trámites & Guías"}
        </a>
        <a
          href={`${homeUrl}normativa`}
          class:list={["nav-link", "nav-drawer-only", { active: isNormativaActive }]}
          aria-current={isNormativaActive ? "page" : undefined}
        >
          ⚖️ {
            localeTyped === "ca"
              ? "Normativa & BOIB"
              : localeTyped === "en"
                ? "Regulations & BOIB"
                : localeTyped === "de"
                  ? "Gesetze & BOIB"
                  : "Normativa & BOIB"
          }
        </a>

        <!-- ── SECCIÓN 2: COMUNIDAD & ÉLITE ── -->
        <span class="nav-section-title">🌟 {translations["nav.section.community"] || "Comunidad & Reconocimiento"}</span
        >

        <a
          href={`${homeUrl}cuadro-de-honor`}
          class:list={["nav-link", "nav-desktop-link", { active: isHonorActive }]}
          aria-current={isHonorActive ? "page" : undefined}
        >
          👑 {translations["nav.honor"] || "Cuadro de Honor"}
        </a>
        <a
          href={`${homeUrl}comunidad`}
          class:list={["nav-link", "nav-desktop-link", { active: isCommunityActive }]}
          aria-current={isCommunityActive ? "page" : undefined}
        >
          💬 {translations["nav.community"] || "Comunidad"}
        </a>
        <a
          href={`${homeUrl}blog`}
          class:list={["nav-link", "nav-drawer-only", { active: isBlogActive }]}
          aria-current={isBlogActive ? "page" : undefined}
        >
          📰 {translations["nav.blog"] || "Blog & Guías"}
        </a>
        <a
          href={`${homeUrl}sobre-nosotros`}
          class:list={["nav-link", "nav-drawer-only", { active: isAboutActive }]}
          aria-current={isAboutActive ? "page" : undefined}
        >
          🌿 {translations["nav.about"] || "Sobre Nosotros"}
        </a>

        <!-- ── SECCIÓN 3: EMPRESAS ── -->
        <span class="nav-section-title">💼 {translations["nav.section.business"] || "Empresas & Profesionales"}</span>

        <a
          href={`${homeUrl}unete`}
          class:list={["nav-link", "nav-highlight-link", { active: isJoinActive }]}
          aria-current={isJoinActive ? "page" : undefined}
        >
          🚀 {translations["nav.join"] || "Para Empresas"}
        </a>
      </nav>

      <!-- ── SECCIÓN 4: ACCIONES & PREFERENCIAS ── -->
      <div class="navbar-actions">
        <span class="nav-section-title drawer-prefs-title"
          >⚙️ {translations["nav.section.preferences"] || "Preferencias & Acceso"}</span
        >

        <LanguageSwitcher
          currentLocale={localeTyped}
          translations={{
            "nav.es": translations["nav.es"] || "ES",
            "nav.en": translations["nav.en"] || "EN",
            "nav.ca": translations["nav.ca"] || "CA",
            "nav.de": translations["nav.de"] || "DE",
          }}
          getLangPrefix={getLangPrefix}
          currentPath={currentPath}
        />
        <ThemeSwitcher
          translations={{
            "theme.light": translations["theme.light"],
            "theme.dark": translations["theme.dark"],
            "theme.toggle": translations["theme.toggle"],
            "theme.selectTheme": translations["theme.selectTheme"],
          }}
        />
        <div class="auth-buttons">
          <a
            href={`${homeUrl}login`}
            class:list={["btn", "btn-secondary", "btn-sm", { active: isLoginActive }]}
            aria-current={isLoginActive ? "page" : undefined}
          >
            {translations["nav.login"] || "Iniciar Sesión"}
          </a>
          <a
            href={`${homeUrl}register`}
            class:list={["btn", "btn-primary", "btn-sm", { active: isRegisterActive }]}
            aria-current={isRegisterActive ? "page" : undefined}
          >
            {translations["nav.register"] || "Registrarse"}
          </a>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  import { initMobileMenuToggle } from "../lib/toggleMobileMenu";
  initMobileMenuToggle("public-menu-toggle", "public-navbar-menu");

  // Close explore details when clicking outside
  document.addEventListener("click", (e) => {
    const details = document.getElementById("explore-dropdown-details") as HTMLDetailsElement | null;
    if (details && details.open && !details.contains(e.target as Node)) {
      details.removeAttribute("open");
    }
  });
</script>

<style>
  .navbar-header {
    background: var(--glass-bg);
    border-bottom: 1px solid var(--color-surface-border);
  }

  .nav-explore-dropdown {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .explore-details {
    position: relative;
    display: inline-block;
  }

  .explore-summary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: var(--space-xs) var(--space-sm);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    font-weight: 600;
    cursor: pointer;
    list-style: none;
    border-radius: var(--border-radius-md);
    transition: all var(--transition-fast);
  }

  .explore-summary::-webkit-details-marker {
    display: none;
  }

  .explore-summary:hover {
    color: var(--color-primary);
    background-color: var(--color-surface-hover);
  }

  .explore-arrow {
    font-size: 0.7em;
    transition: transform var(--transition-fast);
  }

  .explore-details[open] .explore-arrow {
    transform: rotate(180deg);
  }

  .explore-menu {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    min-width: 250px;
    background-color: var(--color-surface);
    border: 1px solid var(--color-surface-border);
    border-radius: var(--border-radius-lg);
    box-shadow: var(--shadow-xl);
    padding: var(--space-xs);
    display: flex;
    flex-direction: column;
    gap: 2px;
    z-index: 1000;
  }

  .explore-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    border-radius: var(--border-radius-md);
    font-size: var(--font-size-xs);
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .explore-item:hover {
    background-color: var(--color-surface-hover);
    color: var(--color-primary);
  }

  @media (max-width: 1024px) {
    .nav-explore-dropdown {
      display: none !important;
    }
  }
</style>
