---
import ThemeSwitcher from "./ThemeSwitcher.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";

interface Props {
  currentLocale: "es" | "en" | "ca" | "de" | string;
  translations: Record<string, string>;
  getLangPrefix: (locale: "es" | "en" | "ca" | "de") => string;
  currentPath: string;
}

const { currentLocale, translations, getLangPrefix, currentPath } = Astro.props;
const localeTyped = (currentLocale as "es" | "en" | "ca" | "de") || "es";
const prefix = getLangPrefix(localeTyped);
const homeUrl = prefix || "/";

// Helper para detectar si un enlace está activo
const isActive = (path: string): boolean => {
  const normalizedCurrent = currentPath.split("#")[0].replace(/\/$/, "") || "/";
  const normalizedTarget = path.split("#")[0].replace(/\/$/, "") || "/";
  return normalizedCurrent === normalizedTarget;
};

const isHomeActive = isActive(homeUrl);
const isServicesActive = isActive(`${homeUrl}servicios`) || currentPath.includes("/servicios");
const isSportsActive = isActive(`${homeUrl}deporte`) || currentPath.includes("/deporte");
const isToursActive = isActive(`${homeUrl}tours`) || currentPath.includes("/tours");
const isHistoryActive = isActive(`${homeUrl}memoria-historica`) || currentPath.includes("/memoria-historica");
const isAboutActive = isActive(`${homeUrl}sobre-nosotros`) || currentPath.includes("/sobre-nosotros");
const isBlogActive = isActive(`${homeUrl}blog`) || currentPath.includes("/blog");
const isCommunityActive = isActive(`${homeUrl}comunidad`) || currentPath.includes("/comunidad");
const isHonorActive = isActive(`${homeUrl}cuadro-de-honor`) || currentPath.includes("/cuadro-de-honor");
const isJoinActive = isActive(`${homeUrl}unete`) || currentPath.includes("/unete");
const isLoginActive = isActive(`${homeUrl}login`);
const isRegisterActive = isActive(`${homeUrl}register`);

// ¿Algún link del grupo "Más" está activo?
const isMoreActive = isHistoryActive || isCommunityActive || isHonorActive || isBlogActive || isAboutActive;
---

<header class="navbar-header nav-public">
  <div class="container navbar-container">
    <!-- Brand Logo / Title -->
    <a href={homeUrl} class="navbar-brand" aria-label={translations["nav.aria.publicBrand"] || "Servicios Mallorca"}>
      <span class="brand-badge badge badge-primary">🌴 Mallorca</span>
      <span class="brand-title">Servicios Mallorca</span>
    </a>

    <!-- Mobile Hamburger Toggle Button -->
    <button
      id="public-menu-toggle"
      class="mobile-toggle-btn mobile-menu-button"
      aria-label={translations["nav.aria.openPublicMenu"] || "Abrir menú de navegación"}
      aria-expanded="false"
    >
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>

    <!-- Public Navigation Menu -->
    <div id="public-navbar-menu" class="navbar-menu">
      <nav class="navbar-links" aria-label={translations["nav.aria.publicNav"] || "Navegación pública"}>
        <!-- ── ENLACES PRIMARIOS (siempre visibles en desktop) ── -->
        <a
          href={homeUrl}
          class:list={["nav-link", { active: isHomeActive }]}
          aria-current={isHomeActive ? "page" : undefined}
        >
          {translations["nav.home"] || "Inicio"}
        </a>
        <a
          href={`${homeUrl}servicios`}
          class:list={["nav-link", { active: isServicesActive }]}
          aria-current={isServicesActive ? "page" : undefined}
        >
          {translations["nav.services"] || "Servicios"}
        </a>
        <a
          href={`${homeUrl}deporte`}
          class:list={["nav-link", { active: isSportsActive }]}
          aria-current={isSportsActive ? "page" : undefined}
        >
          🏃 {translations["nav.sports"] || "Deporte"}
        </a>
        <a
          href={`${homeUrl}tours`}
          class:list={["nav-link", { active: isToursActive }]}
          aria-current={isToursActive ? "page" : undefined}
        >
          🗺️ {translations["nav.tours"] || "Rutas"}
        </a>
        <a
          href={`${homeUrl}unete`}
          class:list={["nav-link", "nav-highlight-link", { active: isJoinActive }]}
          aria-current={isJoinActive ? "page" : undefined}
        >
          🚀 {translations["nav.join"] || "Para Empresas"}
        </a>

        <!-- ── DROPDOWN "MÁS ▾" — agrupa enlaces secundarios en desktop ── -->
        <div class:list={["nav-more-dropdown", { active: isMoreActive }]}>
          <button
            class:list={["nav-link", "nav-more-btn", { active: isMoreActive }]}
            aria-haspopup="true"
            aria-expanded="false"
            id="nav-more-trigger"
            type="button"
          >
            {translations["nav.more"] || "Más"}
            <span class="nav-more-chevron" aria-hidden="true">▾</span>
          </button>
          <div class="nav-more-panel" role="menu" aria-labelledby="nav-more-trigger">
            <a
              href={`${homeUrl}memoria-historica`}
              class:list={["nav-more-item", { active: isHistoryActive }]}
              role="menuitem"
              aria-current={isHistoryActive ? "page" : undefined}
            >
              🏛️ {translations["nav.history"] || "Memoria"}
            </a>
            <a
              href={`${homeUrl}comunidad`}
              class:list={["nav-more-item", { active: isCommunityActive }]}
              role="menuitem"
              aria-current={isCommunityActive ? "page" : undefined}
            >
              💬 {translations["nav.community"] || "Comunidad"}
            </a>
            <a
              href={`${homeUrl}cuadro-de-honor`}
              class:list={["nav-more-item", { active: isHonorActive }]}
              role="menuitem"
              aria-current={isHonorActive ? "page" : undefined}
            >
              👑 {translations["nav.honor"] || "Cuadro de Honor"}
            </a>
            <a
              href={`${homeUrl}blog`}
              class:list={["nav-more-item", { active: isBlogActive }]}
              role="menuitem"
              aria-current={isBlogActive ? "page" : undefined}
            >
              📰 {translations["nav.blog"] || "Blog"}
            </a>
            <a
              href={`${homeUrl}sobre-nosotros`}
              class:list={["nav-more-item", { active: isAboutActive }]}
              role="menuitem"
              aria-current={isAboutActive ? "page" : undefined}
            >
              🌿 {translations["nav.about"] || "Misión"}
            </a>
          </div>
        </div>

        <!-- ── ENLACES SECUNDARIOS VISIBLES SOLO EN EL DRAWER MÓVIL ── -->
        <a
          href={`${homeUrl}memoria-historica`}
          class:list={["nav-link", "nav-mobile-only", { active: isHistoryActive }]}
          aria-current={isHistoryActive ? "page" : undefined}
        >
          🏛️ {translations["nav.history"] || "Memoria"}
        </a>
        <a
          href={`${homeUrl}comunidad`}
          class:list={["nav-link", "nav-mobile-only", { active: isCommunityActive }]}
          aria-current={isCommunityActive ? "page" : undefined}
        >
          💬 {translations["nav.community"] || "Comunidad"}
        </a>
        <a
          href={`${homeUrl}cuadro-de-honor`}
          class:list={["nav-link", "nav-mobile-only", { active: isHonorActive }]}
          aria-current={isHonorActive ? "page" : undefined}
        >
          👑 {translations["nav.honor"] || "Cuadro de Honor"}
        </a>
        <a
          href={`${homeUrl}blog`}
          class:list={["nav-link", "nav-mobile-only", { active: isBlogActive }]}
          aria-current={isBlogActive ? "page" : undefined}
        >
          📰 {translations["nav.blog"] || "Blog"}
        </a>
        <a
          href={`${homeUrl}sobre-nosotros`}
          class:list={["nav-link", "nav-mobile-only", { active: isAboutActive }]}
          aria-current={isAboutActive ? "page" : undefined}
        >
          🌿 {translations["nav.about"] || "Misión"}
        </a>
      </nav>

      <div class="navbar-actions">
        <LanguageSwitcher
          currentLocale={localeTyped}
          translations={{
            "nav.es": translations["nav.es"] || "ES",
            "nav.en": translations["nav.en"] || "EN",
            "nav.ca": translations["nav.ca"] || "CA",
            "nav.de": translations["nav.de"] || "DE",
          }}
          getLangPrefix={getLangPrefix}
          currentPath={currentPath}
        />
        <ThemeSwitcher
          translations={{
            "theme.light": translations["theme.light"],
            "theme.dark": translations["theme.dark"],
            "theme.toggle": translations["theme.toggle"],
            "theme.selectTheme": translations["theme.selectTheme"],
          }}
        />
        <div class="auth-buttons">
          <a
            href={`${homeUrl}login`}
            class:list={["btn", "btn-secondary", "btn-sm", { active: isLoginActive }]}
            aria-current={isLoginActive ? "page" : undefined}
          >
            {translations["nav.login"] || "Iniciar Sesión"}
          </a>
          <a
            href={`${homeUrl}register`}
            class:list={["btn", "btn-primary", "btn-sm", { active: isRegisterActive }]}
            aria-current={isRegisterActive ? "page" : undefined}
          >
            {translations["nav.register"] || "Registrarse"}
          </a>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  import { initMobileMenuToggle } from "../lib/toggleMobileMenu";
  initMobileMenuToggle("public-menu-toggle", "public-navbar-menu");

  // ── Dropdown "Más ▾" toggle ──────────────────────────────────────────────
  const trigger = document.getElementById("nav-more-trigger");
  const dropdown = trigger?.closest(".nav-more-dropdown");
  const panel = dropdown?.querySelector(".nav-more-panel");

  if (trigger && dropdown && panel) {
    function openMore() {
      trigger!.setAttribute("aria-expanded", "true");
      dropdown!.classList.add("open");
    }
    function closeMore() {
      trigger!.setAttribute("aria-expanded", "false");
      dropdown!.classList.remove("open");
    }

    trigger.addEventListener("click", (e) => {
      e.stopPropagation();
      const isOpen = dropdown!.classList.contains("open");
      isOpen ? closeMore() : openMore();
    });

    // Cerrar al hacer clic fuera
    document.addEventListener("click", (e) => {
      if (!dropdown!.contains(e.target as Node)) closeMore();
    });

    // Cerrar con Escape
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeMore();
    });

    // Cerrar al navegar a un ítem
    panel.querySelectorAll("a").forEach((a) => {
      a.addEventListener("click", closeMore);
    });
  }
</script>

<style>
  .navbar-header {
    background: var(--glass-bg);
    border-bottom: 1px solid var(--color-surface-border);
  }
</style>
