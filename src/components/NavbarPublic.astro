---
import ThemeSwitcher from "./ThemeSwitcher.astro";

interface Props {
  currentLocale: "es" | "en" | "ca" | string;
  translations: Record<string, string>;
  getLangPrefix: (locale: "es" | "en" | "ca") => string;
  currentPath: string;
}

const { currentLocale, translations, getLangPrefix, currentPath } = Astro.props;
const prefix = getLangPrefix(currentLocale as "es" | "en" | "ca");
const homeUrl = prefix || "/";

// Helper para detectar si un enlace está activo
const isActive = (path: string): boolean => {
  // Normalizar paths para comparación
  const normalizedCurrent = currentPath.split("#")[0].replace(/\/$/, "") || "/";
  const normalizedTarget = path.split("#")[0].replace(/\/$/, "") || "/";
  return normalizedCurrent === normalizedTarget;
};

const isHomeActive = isActive(homeUrl);
const isFeaturesActive =
  isActive(`${homeUrl}#features`) || currentPath === homeUrl;
const isLoginActive = isActive(`${homeUrl}login`);
const isRegisterActive = isActive(`${homeUrl}register`);
---

<header class="navbar-header nav-public">
  <div class="container navbar-container">
    <!-- Brand Logo / Title -->
    <a href={homeUrl} class="navbar-brand" aria-label={translations["nav.aria.publicBrand"] || "WebApp Starter Home"}>
      <span class="brand-badge badge badge-primary">🚀 WebApp</span>
      <span class="brand-title">Starter Template</span>
    </a>

    <!-- Mobile Hamburger Toggle Button -->
    <button
      id="public-menu-toggle"
      class="mobile-toggle-btn mobile-menu-button"
      aria-label={translations["nav.aria.openPublicMenu"] || "Abrir menú de navegación"}
      aria-expanded="false"
    >
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>

    <!-- Public Navigation Menu -->
    <div id="public-navbar-menu" class="navbar-menu">
      <nav class="navbar-links" aria-label={translations["nav.aria.publicNav"] || "Navegación pública"}>
        <a
          href={homeUrl}
          class="nav-link"
          class:list={["nav-link", { active: isHomeActive }]}
          aria-current={isHomeActive ? "page" : undefined}
        >
          {translations["nav.home"] || "Inicio"}
        </a>
        <a
          href={`${homeUrl}#features`}
          class="nav-link"
          class:list={["nav-link", { active: isFeaturesActive }]}
          aria-current={isFeaturesActive ? "page" : undefined}
        >
          {translations["nav.features"] || "Características"}
        </a>
      </nav>

      <div class="navbar-actions">
        <ThemeSwitcher
          translations={{
            "theme.light": translations["theme.light"],
            "theme.dark": translations["theme.dark"],
            "theme.toggle": translations["theme.toggle"],
            "theme.selectTheme": translations["theme.selectTheme"],
          }}
        />
        <div class="auth-buttons">
          <a
            href={`${homeUrl}login`}
            class="btn btn-secondary btn-sm"
            class:list={[
              "btn",
              "btn-secondary",
              "btn-sm",
              { active: isLoginActive },
            ]}
            aria-current={isLoginActive ? "page" : undefined}
          >
            {translations["nav.login"] || "Iniciar Sesión"}
          </a>
          <a
            href={`${homeUrl}register`}
            class="btn btn-primary btn-sm"
            class:list={[
              "btn",
              "btn-primary",
              "btn-sm",
              { active: isRegisterActive },
            ]}
            aria-current={isRegisterActive ? "page" : undefined}
          >
            {translations["nav.register"] || "Registrarse"}
          </a>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  import { initMobileMenuToggle } from "../lib/toggleMobileMenu";
  initMobileMenuToggle("public-menu-toggle", "public-navbar-menu");
</script>
