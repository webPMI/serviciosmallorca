---
import type { Translations, Locale } from "../i18n";
import { getLangPrefix } from "../i18n";

interface Props {
  translations: Translations;
  locale: string;
}

const { translations, locale } = Astro.props;
const prefix = getLangPrefix(locale as Locale);

const AVATAR_PRESETS = ["👤", "🚀", "⚡", "👑", "🦊", "🦉", "🎨", "💻", "🌿", "🔥"];
---

<div class="profile-container" data-locale={locale} data-prefix={prefix}>
  <!-- Profile Hero Card -->
  <div class="profile-hero card-glass fade-in">
    <div class="profile-hero-inner">
      <!-- Avatar Large -->
      <div class="hero-avatar-wrap">
        <div class="hero-avatar" id="profile-current-avatar">
          <span class="avatar-symbol" id="profile-avatar-symbol">👤</span>
        </div>
        <div class="hero-avatar-badge" id="profile-role-badge">Usuario</div>
      </div>

      <!-- Name & Email -->
      <div class="hero-meta">
        <h1 class="hero-name" id="profile-display-name-header">Cargando...</h1>
        <p class="hero-email" id="profile-email-header">correo@ejemplo.com</p>
        <div class="hero-stats">
          <span class="hero-stat">🌴 Miembro de Servicios Mallorca</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Alerts -->
  <div id="profile-success-alert" class="alert-success" style="display: none;" role="alert"></div>
  <div id="profile-error-alert" class="alert-error" style="display: none;" role="alert"></div>

  <!-- Tab Navigation -->
  <div class="profile-tabs">
    <button class="profile-tab active" id="tab-info" data-tab="info">
      {translations["profile.tabInfo"] || "👤 Información de Cuenta"}
    </button>
    <button class="profile-tab" id="tab-purchases" data-tab="purchases">
      {translations["profile.tabPurchases"] || "🧾 Mis Compras & Facturas"}
    </button>
    <button class="profile-tab" id="tab-business" data-tab="business">
      {translations["profile.tabBusiness"] || "🏢 Mi Negocio & Impulsos"}
    </button>
    <button class="profile-tab" id="tab-security" data-tab="security">
      {translations["profile.tabSecurity"] || "🔐 Seguridad"}
    </button>
  </div>

  <!-- Tab: Account Info -->
  <section class="profile-tab-panel active" id="panel-info">
    <div class="profile-panel-grid">
      <!-- Left: Form -->
      <div class="card profile-form-card">
        <h2 class="panel-title">✏️ {translations["profile.accountInfo"] || "Editar Perfil"}</h2>

        <form
          id="profile-info-form"
          class="profile-form"
          data-success-msg={translations["profile.successUpdated"]}
          data-error-name={translations["auth.nameRequired"]}
          data-error-general={translations["auth.errors.generalError"]}
        >
          <div class="form-group">
            <label for="profile-name" class="form-label">{translations["profile.name"]}</label>
            <div class="input-wrapper">
              <span class="input-icon">✏️</span>
              <input
                type="text"
                id="profile-name"
                name="displayName"
                class="form-input"
                required
                placeholder="Tu nombre completo"
              />
            </div>
          </div>

          <div class="form-group">
            <label for="profile-email" class="form-label">{translations["profile.email"]}</label>
            <div class="input-wrapper">
              <span class="input-icon">📧</span>
              <input type="email" id="profile-email" class="form-input form-input-disabled" disabled readonly />
            </div>
            <span class="form-helper">El correo no puede modificarse directamente por seguridad.</span>
          </div>

          <!-- Avatar Picker -->
          <div class="form-group">
            <label class="form-label">{translations["profile.avatar"]}</label>
            <div class="avatar-presets-grid" id="avatar-presets">
              {
                AVATAR_PRESETS.map((icon) => (
                  <button
                    type="button"
                    class="avatar-preset-btn"
                    data-preset={icon}
                    aria-label={`Seleccionar avatar ${icon}`}
                  >
                    {icon}
                  </button>
                ))
              }
            </div>

            <label for="profile-custom-photo" class="form-label-sub">{translations["profile.customAvatarUrl"]}</label>
            <div class="input-wrapper">
              <span class="input-icon">🔗</span>
              <input
                type="url"
                id="profile-custom-photo"
                name="photoURL"
                class="form-input"
                placeholder="https://ejemplo.com/tu-foto.jpg"
              />
            </div>
          </div>

          <div class="form-actions">
            <button type="submit" id="save-profile-btn" class="btn btn-primary btn-full">
              <span class="btn-text">{translations["profile.saveChanges"]}</span>
              <span class="btn-loader" style="display: none;">⌛</span>
            </button>
          </div>
        </form>
      </div>

      <!-- Right: Role and System Info -->
      <div class="card profile-info-card">
        <h2 class="panel-title">🛡️ {translations["profile.role"] || "Rol en el Sistema"}</h2>
        <div class="role-display-box" id="role-display-box">
          <div class="role-badge-large" id="role-badge-large">Usuario</div>
          <p class="role-description" id="role-description">Acceso para gestionar tu cuenta personal y favoritos.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Tab: Claimed Business & Boosts -->
  <section class="profile-tab-panel" id="panel-business">
    <div class="business-panel-stack">
      <!-- Flash Notification of recent boost transaction -->
      <div id="boost-success-banner" class="boost-success-banner" style="display: none;">
        <div class="boost-banner-header">
          <span class="boost-banner-icon">🎉</span>
          <div>
            <h3 class="boost-title">
              {translations["profile.boostSuccessTitle"] || "¡Aportación e Impulso Registrado con Éxito!"}
            </h3>
            <p class="boost-subtitle">
              {
                translations["profile.boostSuccessSubtitle"] ||
                  "Tu micro-patrocinio ha sido contabilizado en la bolsa comunitaria y el comercio ha sido añadido a tus favoritos."
              }
            </p>
          </div>
        </div>
        <div class="boost-meta-strip">
          <span id="boost-amount-label">{translations["profile.boostMetaAmount"] || "Importe:"} 0.00€</span>
          <span>·</span>
          <span id="boost-slug-label">{translations["profile.boostMetaBiz"] || "Comercio:"} -</span>
          <span>·</span>
          <span>{translations["profile.boostMetaInvoice"] || "Factura emitida con 21% IVA"}</span>
        </div>
      </div>

      <!-- Outbid / Displacement Alert Card (Motor de Rivalidad Recurrente) -->
      <div
        id="displacement-alert-card"
        class="displacement-alert-card card"
        style="display: none; border-left: 4px solid #ef4444; background: rgba(239, 68, 68, 0.08);"
      >
        <div class="displacement-alert-header" style="display: flex; gap: 12px; align-items: flex-start;">
          <span class="alert-icon-anim" style="font-size: 1.5rem;">👑⚠️</span>
          <div>
            <h3 class="displacement-title" style="color: #f87171; margin: 0 0 4px 0; font-size: 1.05rem;">
              ¡Atención! Has sido superado en el Cuadro de Honor
            </h3>
            <p id="displacement-desc" style="font-size: 0.85rem; color: #cbd5e1; margin: 0;">
              Tu negocio ha pasado al puesto #2. Recupera la corona #1 ahora mismo.
            </p>
          </div>
        </div>
        <div
          class="displacement-action-row"
          style="margin-top: 12px; display: flex; gap: 10px; align-items: center; flex-wrap: wrap;"
        >
          <a id="displacement-reclaim-btn" href="#" class="btn btn-accent btn-sm pulse-hover">
            ⚡ Recuperar Puesto #1 (+1€)
          </a>
          <button type="button" id="displacement-dismiss-btn" class="btn btn-outline-secondary btn-sm">
            Entendido
          </button>
        </div>
      </div>

      <!-- Claimed Business Audit Status Card -->
      <div class="card profile-form-card">
        <div class="section-title-row">
          <h2 class="panel-title">{translations["profile.claimedTitle"] || "🏢 Mi Empresa / Ficha Reclamada"}</h2>
          <span class="badge badge-accent" id="business-status-badge">Verificando...</span>
        </div>

        <div id="no-business-box" class="business-empty-state">
          <p>{translations["profile.noBusiness"] || "Aún no tienes ninguna empresa reclamada bajo tu cuenta."}</p>
          <a href={`${prefix}unete`} class="btn btn-accent btn-sm">
            {translations["profile.claimCta"] || "🚀 Ver Pasos para Reclamar o Registrar Negocio (0€)"}
          </a>
        </div>

        <div id="claimed-business-box" class="claimed-status-box" style="display: none;">
          <div class="claimed-header">
            <div class="claimed-icon">🛡️</div>
            <div>
              <h3 id="claimed-business-name" class="claimed-name">Nombre Empresa</h3>
              <p id="claimed-audit-desc" class="claimed-audit-text">
                {
                  translations["profile.claimedPending"] ||
                    "⏳ Solicitud de cesión en proceso de validación fiscal por nuestro equipo de auditoría."
                }
              </p>
            </div>
          </div>
          <div class="claimed-actions">
            <a href={`${prefix}cuadro-de-honor`} class="btn btn-secondary btn-sm">
              {translations["profile.viewHonorSpot"] || "👑 Ver mi Puesto en Cuadro de Honor"}
            </a>
            <a href={`${prefix}unete`} class="btn btn-outline-secondary btn-sm">
              {translations["profile.pricingGuide"] || "📋 Guía de Tarifas & Mando"}
            </a>
          </div>
        </div>
      </div>

      <!-- Community Boosts & Backed Favorites Card -->
      <div class="card profile-form-card">
        <h2 class="panel-title">{translations["profile.backedFavsTitle"] || "❤️ Mis Negocios Favoritos Aupados"}</h2>
        <p class="panel-description">
          {
            translations["profile.backedFavsDesc"] ||
              "Comercios de Mallorca que has respaldado con tu deseo e impulso popular comunitario."
          }
        </p>
        <div class="favs-boosted-grid" id="favs-boosted-list">
          <div class="empty-favs-txt">Cargando tus negocios respaldados...</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Tab: Purchases, Official Invoices & Abandoned Carts / Drafts -->
  <section class="profile-tab-panel" id="panel-purchases">
    <div class="profile-panel-grid">
      <!-- 1. Abandoned Carts / Pending Drafts Drawer -->
      <div id="pending-drafts-card" class="card profile-form-card pending-draft-box" style="display: none;">
        <div class="pending-draft-header">
          <span class="draft-badge-icon">🛒</span>
          <div class="draft-title-wrap">
            <h3 class="pending-draft-title">
              {translations["profile.draftTitle"] || "Aportación o Compra Pendiente de Completar"}
            </h3>
            <p class="pending-draft-subtitle">
              {
                translations["profile.draftSubtitle"] ||
                  "Tienes una gestión o impulso a medias guardado en este dispositivo. Puedes reanudarla y finalizar el pago en 1 clic."
              }
            </p>
          </div>
        </div>
        <div class="pending-draft-content">
          <div class="draft-meta-row">
            <span class="draft-label">🏢 Comercio:</span>
            <strong id="draft-biz-name" class="draft-val">-</strong>
          </div>
          <div class="draft-meta-row">
            <span class="draft-label">💰 Importe configurado:</span>
            <strong id="draft-amount-val" class="draft-price">0.00€</strong>
          </div>
          <div class="draft-meta-row" id="draft-message-row" style="display: none;">
            <span class="draft-label">✍️ Dedicatoria:</span>
            <span id="draft-message-val" class="draft-desc"></span>
          </div>
          <div class="draft-meta-row">
            <span class="draft-label">⏱️ Guardado el:</span>
            <span id="draft-date-val" class="draft-time"></span>
          </div>
        </div>
        <div class="pending-draft-actions">
          <button type="button" id="btn-resume-draft" class="btn btn-primary btn-sm pulse-hover">
            ⚡ {translations["profile.resumeDraftBtn"] || "Reanudar y Pagar Ahora →"}
          </button>
          <button type="button" id="btn-discard-draft" class="btn btn-outline-secondary btn-sm">
            🗑️ {translations["profile.discardDraftBtn"] || "Descartar Borrador"}
          </button>
        </div>
      </div>

      <!-- 2. Confirmed Official Invoices & Payments -->
      <div class="card profile-form-card">
        <div class="section-title-row">
          <h2 class="panel-title">
            {translations["profile.invoicesTitle"] || "🧾 Facturas Oficiales & Historial de Pagos"}
          </h2>
          <span class="badge badge-primary">IVA 21% Deducible</span>
        </div>
        <p class="panel-description">
          {
            translations["profile.invoicesDesc"] ||
              "Todas tus aportaciones, compras de posicionamiento e impulsos oficiales con factura fiscal emitida."
          }
        </p>

        <div id="invoices-list-container" class="invoices-list-grid">
          <div class="empty-invoices-box">
            <p>Cargando facturas y transacciones...</p>
          </div>
        </div>
      </div>

      <!-- 3. Cancelled Transactions History -->
      <div id="cancelled-history-card" class="card profile-form-card" style="display: none;">
        <h2 class="panel-title">{translations["profile.cancelledTitle"] || "❌ Gestiones Canceladas / Sin Cargo"}</h2>
        <p class="panel-description">
          {
            translations["profile.cancelledDesc"] ||
              "Intentos de aportación que fueron cancelados antes de procesar el cobro. No se realizó ningún cargo en tu tarjeta."
          }
        </p>
        <div id="cancelled-list-container" class="cancelled-list-grid">
          <!-- Populated dynamically via JS -->
        </div>
      </div>
    </div>
  </section>

  <!-- Tab: Security & Password -->
  <section class="profile-tab-panel" id="panel-security">
    <div class="card profile-form-card" id="profile-security-section">
      <h2 class="panel-title">🔐 {translations["profile.changePassword"]}</h2>

      <!-- Google Provider Notice -->
      <div id="google-auth-notice" class="alert-info" style="display: none;">
        <span class="notice-icon">🌐</span>
        <div>
          <strong>Cuenta vinculada con Google</strong>
          <p>
            {
              translations["profile.googleAuthNotice"] ||
                "Iniciaste sesión con Google. La gestión y seguridad de tu contraseña se realiza a través de tu cuenta de Google."
            }
          </p>
        </div>
      </div>

      <!-- Password Change Form for Email/Password users -->
      <form
        id="profile-password-form"
        class="profile-form"
        data-success-msg={translations["profile.successPassword"]}
        data-error-required={translations["auth.passwordRequired"]}
        data-error-mismatch={translations["auth.passwordMismatch"]}
        data-error-weak={translations["auth.errors.weakPassword"]}
        data-error-reauth={translations["profile.reauthRequired"]}
        data-error-general={translations["auth.errors.generalError"]}
        data-strength-weak={translations["auth.passwordStrength.weak"]}
        data-strength-medium={translations["auth.passwordStrength.medium"]}
        data-strength-strong={translations["auth.passwordStrength.strong"]}
      >
        <div class="form-group">
          <label for="new-password" class="form-label">{translations["profile.newPassword"]}</label>
          <div class="input-wrapper">
            <span class="input-icon">🔒</span>
            <input
              type="password"
              id="new-password"
              name="newPassword"
              class="form-input"
              required
              placeholder="••••••••"
              autocomplete="new-password"
            />
            <button
              type="button"
              id="toggle-new-password"
              class="toggle-password-btn"
              aria-label={translations["auth.togglePassword.ariaLabel"]}
            >
              👁️
            </button>
          </div>
          <div class="password-strength" id="profilePasswordStrength">
            <div class="strength-bar">
              <div class="strength-fill" id="profileStrengthFill"></div>
            </div>
            <span class="strength-text" id="profileStrengthText"></span>
          </div>
        </div>

        <div class="form-group">
          <label for="confirm-new-password" class="form-label">{translations["profile.confirmNewPassword"]}</label>
          <div class="input-wrapper">
            <span class="input-icon">🔒</span>
            <input
              type="password"
              id="confirm-new-password"
              name="confirmNewPassword"
              class="form-input"
              required
              placeholder="••••••••"
              autocomplete="new-password"
            />
            <button
              type="button"
              id="toggle-confirm-new-password"
              class="toggle-password-btn"
              aria-label={translations["auth.togglePassword.ariaLabel"]}
            >
              👁️
            </button>
          </div>
          <span class="form-error" id="profile-password-error"></span>
        </div>

        <div class="form-actions">
          <button type="submit" id="update-password-btn" class="btn btn-secondary btn-full">
            <span class="btn-text">{translations["profile.updatePassword"]}</span>
            <span class="btn-loader" style="display: none;">⌛</span>
          </button>
        </div>
      </form>
    </div>

    <!-- RGPD & Legal Compliance Management Card -->
    <div class="card profile-form-card" style="margin-top: var(--space-lg, 1.5rem);">
      <h2 class="panel-title">📜 {translations["profile.legalTitle"] || "Consentimientos y Cumplimiento Legal (RGPD)"}</h2>
      <p class="panel-description">
        {translations["profile.legalDesc"] || "Tus datos personales y consentimientos están protegidos conforme al Reglamento General de Protección de Datos (RGPD) y la LOPD-GDD."}
      </p>

      <div class="legal-profile-status-box">
        <div class="legal-status-row">
          <span class="legal-status-label">Versión de Términos Vigente:</span>
          <span class="badge badge-primary" id="profile-legal-version">v2026.2</span>
        </div>
        <div class="legal-status-row">
          <span class="legal-status-label">Estado de Aceptación:</span>
          <strong class="legal-status-val text-success" id="profile-legal-status">✅ Al día con la normativa vigente</strong>
        </div>
        <div class="legal-status-row">
          <span class="legal-status-label">Fecha del Consentimiento:</span>
          <span class="legal-status-val" id="profile-legal-date">Reciente</span>
        </div>
      </div>

      <div class="legal-profile-actions">
        <button type="button" id="btn-download-consent-cert" class="btn btn-outline-secondary btn-sm">
          📄 Descargar Certificado RGPD
        </button>
        <a href={`${prefix}privacy`} class="btn btn-secondary btn-sm" target="_blank" rel="noopener">
          🛡️ Ejercer Derechos ARCO (Baja / Rectificación)
        </a>
      </div>
    </div>
  </section>
</div>

<script>
  import { updateProfile, updatePassword, onAuthStateChanged } from "firebase/auth";
  import { auth, db } from "../lib/firebase";
  import { authStore } from "../lib/authStore";
  import { getUserProfile, updateUserProfile } from "../lib/userProfile";
  import { getUserClaims } from "../lib/serviceActions";
  import { toast } from "../lib/toast";
  import {
    CURRENT_LEGAL_VERSION,
    getUserLegalConsent,
    recordUserLegalConsent,
    generateConsentAuditCertificate,
  } from "../lib/legalComplianceEngine";

  // Elements
  const headerName = document.getElementById("profile-display-name-header");
  const headerEmail = document.getElementById("profile-email-header");
  const headerRole = document.getElementById("profile-role-badge");
  const currentAvatarEl = document.getElementById("profile-current-avatar");

  const infoForm = document.getElementById("profile-info-form") as HTMLFormElement | null;
  const nameInput = document.getElementById("profile-name") as HTMLInputElement | null;
  const emailInput = document.getElementById("profile-email") as HTMLInputElement | null;
  const customPhotoInput = document.getElementById("profile-custom-photo") as HTMLInputElement | null;
  const saveProfileBtn = document.getElementById("save-profile-btn") as HTMLButtonElement | null;

  const passwordForm = document.getElementById("profile-password-form") as HTMLFormElement | null;
  const newPasswordInput = document.getElementById("new-password") as HTMLInputElement | null;
  const confirmNewPasswordInput = document.getElementById("confirm-new-password") as HTMLInputElement | null;
  const passwordError = document.getElementById("profile-password-error");
  const updatePasswordBtn = document.getElementById("update-password-btn") as HTMLButtonElement | null;
  const googleNotice = document.getElementById("google-auth-notice");

  const successAlert = document.getElementById("profile-success-alert");
  const errorAlert = document.getElementById("profile-error-alert");

  const toggleNewPassBtn = document.getElementById("toggle-new-password");
  const toggleConfirmPassBtn = document.getElementById("toggle-confirm-new-password");
  const strengthFill = document.getElementById("profileStrengthFill");
  const strengthText = document.getElementById("profileStrengthText");

  // Preview elements
  const previewAvatarEl = document.getElementById("preview-avatar-display");
  const previewNameEl = document.getElementById("preview-name-display");
  const previewEmailEl = document.getElementById("preview-email-display");
  const previewRoleEl = document.getElementById("preview-role-display");

  let selectedAvatar: string | null = null;

  // --- Tab Switching ---
  document.querySelectorAll(".profile-tab").forEach((tab) => {
    tab.addEventListener("click", () => {
      const target = (tab as HTMLElement).dataset.tab;
      document.querySelectorAll(".profile-tab").forEach((t) => t.classList.remove("active"));
      document.querySelectorAll(".profile-tab-panel").forEach((p) => p.classList.remove("active"));
      tab.classList.add("active");
      const panel = document.getElementById(`panel-${target}`);
      if (panel) panel.classList.add("active");
    });
  });

  function showSuccess(msg: string) {
    if (errorAlert) errorAlert.style.display = "none";
    if (successAlert) {
      successAlert.textContent = msg;
      successAlert.style.display = "block";
      successAlert.scrollIntoView({ behavior: "smooth", block: "nearest" });
    }
    toast.success(msg);
  }

  function showError(msg: string) {
    if (successAlert) successAlert.style.display = "none";
    if (errorAlert) {
      errorAlert.textContent = msg;
      errorAlert.style.display = "block";
      errorAlert.scrollIntoView({ behavior: "smooth", block: "nearest" });
    }
    toast.error(msg);
  }

  // Render current avatar
  function setAvatarDisplay(photo: string | null, name: string | null) {
    // Update hero header avatar
    if (currentAvatarEl) {
      if (photo && (photo.startsWith("http://") || photo.startsWith("https://") || photo.startsWith("data:"))) {
        currentAvatarEl.innerHTML = `<img src="${photo}" alt="Avatar" class="profile-avatar-img" />`;
      } else if (photo && photo.length <= 8) {
        currentAvatarEl.innerHTML = `<span class="avatar-symbol">${photo}</span>`;
      } else {
        const initial = name && name.trim() ? name.trim()[0].toUpperCase() : "👤";
        currentAvatarEl.innerHTML = `<span class="avatar-symbol">${initial}</span>`;
      }
    }
    // Update preview avatar
    if (previewAvatarEl) {
      if (photo && (photo.startsWith("http://") || photo.startsWith("https://") || photo.startsWith("data:"))) {
        previewAvatarEl.innerHTML = `<img src="${photo}" alt="Avatar" class="preview-avatar-img" />`;
      } else if (photo && photo.length <= 8) {
        previewAvatarEl.innerHTML = `<span>${photo}</span>`;
      } else {
        const initial = name && name.trim() ? name.trim()[0].toUpperCase() : "👤";
        previewAvatarEl.innerHTML = `<span>${initial}</span>`;
      }
    }
  }

  function populateUser(user: any, role: string = "user") {
    if (!user) return;

    const displayName = user.displayName || (user.email ? user.email.split("@")[0] : "Usuario");
    const email = user.email || "";

    if (headerName) headerName.textContent = displayName;
    if (headerEmail) headerEmail.textContent = email;
    if (emailInput) emailInput.value = email;
    if (nameInput && !nameInput.value) nameInput.value = displayName;

    // Preview sync
    if (previewNameEl) previewNameEl.textContent = displayName;
    if (previewEmailEl) previewEmailEl.textContent = email;
    if (previewRoleEl) {
      previewRoleEl.textContent = role.toUpperCase();
      previewRoleEl.className = `preview-badge badge badge-${role === "admin" ? "admin" : role === "manager" ? "manager" : "primary"}`;
    }

    if (headerRole) {
      headerRole.textContent = role.toUpperCase();
      headerRole.className = `hero-avatar-badge badge-role-${role}`;
    }

    selectedAvatar = user.photoURL;
    if (customPhotoInput && user.photoURL && (user.photoURL.startsWith("http") || user.photoURL.startsWith("data:"))) {
      customPhotoInput.value = user.photoURL;
    }

    setAvatarDisplay(user.photoURL, displayName);

    // Highlight preset if matching
    if (user.photoURL) {
      document.querySelectorAll(".avatar-preset-btn").forEach((btn) => {
        if (btn.getAttribute("data-preset") === user.photoURL) {
          btn.classList.add("is-selected");
        } else {
          btn.classList.remove("is-selected");
        }
      });
    }

    // Check Google Auth provider
    const isGoogle = user.providerData && user.providerData.some((p: any) => p.providerId === "google.com");
    if (isGoogle) {
      if (passwordForm) passwordForm.style.display = "none";
      if (googleNotice) googleNotice.style.display = "flex";
    } else {
      if (passwordForm) passwordForm.style.display = "flex";
      if (googleNotice) googleNotice.style.display = "none";
    }
  }

  // 1. Direct onAuthStateChanged listener
  onAuthStateChanged(auth, async (user) => {
    if (!user) {
      // Redirect if not logged in
      const currentPath = window.location.pathname;
      const langPrefix = currentPath.split("/")[1] || "es";
      window.location.href = `/${langPrefix}/login`;
      return;
    }

    // Get Firestore profile role if available
    let role = "user";
    try {
      const profile = await getUserProfile(db, user.uid);
      if (profile && profile.role) role = profile.role;
    } catch {
      // Fallback
    }

    populateUser(user, role);
  });

  // 2. AuthStore subscription
  authStore.subscribe(({ user, role, loading }) => {
    if (loading) return;
    if (user) {
      populateUser(user, role);
    }
  });

  // Avatar presets selection
  document.querySelectorAll(".avatar-preset-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll(".avatar-preset-btn").forEach((b) => b.classList.remove("is-selected"));
      btn.classList.add("is-selected");
      const icon = btn.getAttribute("data-preset");
      if (icon) {
        selectedAvatar = icon;
        if (customPhotoInput) customPhotoInput.value = "";
        setAvatarDisplay(icon, nameInput?.value || null);
      }
    });
  });

  // Custom photo input change
  if (customPhotoInput) {
    customPhotoInput.addEventListener("input", () => {
      const val = customPhotoInput.value.trim();
      if (val) {
        document.querySelectorAll(".avatar-preset-btn").forEach((b) => b.classList.remove("is-selected"));
        selectedAvatar = val;
        setAvatarDisplay(val, nameInput?.value || null);
      }
    });
  }

  // Live preview: sync name input
  if (nameInput) {
    nameInput.addEventListener("input", () => {
      const val = nameInput.value.trim();
      if (previewNameEl) previewNameEl.textContent = val || "Tu nombre";
      if (headerName) headerName.textContent = val || "Tu nombre";
    });
  }

  // Update Profile Info
  if (infoForm && nameInput) {
    infoForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      const currentUser = auth.currentUser;
      if (!currentUser) return;

      const newName = nameInput.value.trim();
      if (!newName) {
        showError(infoForm.dataset.errorName || "El nombre es requerido");
        return;
      }

      const photoToSave = selectedAvatar || customPhotoInput?.value.trim() || null;

      if (saveProfileBtn) saveProfileBtn.disabled = true;

      try {
        // 1. Update Firebase Auth Profile
        await updateProfile(currentUser, {
          displayName: newName,
          photoURL: photoToSave,
        });

        // 2. Update Firestore document
        await updateUserProfile(db, currentUser.uid, {
          displayName: newName,
          photoURL: photoToSave,
        });

        // 3. Refresh display
        if (headerName) headerName.textContent = newName;
        setAvatarDisplay(photoToSave, newName);

        // 4. Update dynamic Navbar if present
        const navName =
          document.getElementById("user-nav-name") ||
          document.getElementById("manager-nav-name") ||
          document.getElementById("admin-nav-name");
        if (navName) navName.textContent = newName;

        showSuccess(infoForm.dataset.successMsg || "¡Perfil actualizado con éxito!");
      } catch (err: any) {
        console.error("Error updating profile:", err);
        showError(err.message || infoForm.dataset.errorGeneral || "Ocurrió un error al procesar tu solicitud.");
      } finally {
        if (saveProfileBtn) saveProfileBtn.disabled = false;
      }
    });
  }

  // Password Toggles
  if (toggleNewPassBtn && newPasswordInput) {
    toggleNewPassBtn.addEventListener("click", () => {
      const isPass = newPasswordInput.type === "password";
      newPasswordInput.type = isPass ? "text" : "password";
      toggleNewPassBtn.textContent = isPass ? "🙈" : "👁️";
    });
  }

  if (toggleConfirmPassBtn && confirmNewPasswordInput) {
    toggleConfirmPassBtn.addEventListener("click", () => {
      const isPass = confirmNewPasswordInput.type === "password";
      confirmNewPasswordInput.type = isPass ? "text" : "password";
      toggleConfirmPassBtn.textContent = isPass ? "🙈" : "👁️";
    });
  }

  // Strength Meter for Profile Password Form
  if (newPasswordInput && strengthFill && strengthText && passwordForm) {
    newPasswordInput.addEventListener("input", () => {
      const val = newPasswordInput.value;
      let score = 0;
      if (val.length >= 8) score++;
      if (/\d/.test(val)) score++;
      if (/[a-z]/.test(val) && /[A-Z]/.test(val)) score++;
      if (/[^A-Za-z0-9]/.test(val)) score++;

      if (val.length === 0) {
        strengthFill.className = "strength-fill";
        strengthText.textContent = "";
      } else if (score <= 1) {
        strengthFill.className = "strength-fill weak";
        strengthText.textContent = passwordForm.dataset.strengthWeak || "Débil";
      } else if (score <= 3) {
        strengthFill.className = "strength-fill medium";
        strengthText.textContent = passwordForm.dataset.strengthMedium || "Media";
      } else {
        strengthFill.className = "strength-fill strong";
        strengthText.textContent = passwordForm.dataset.strengthStrong || "Fuerte";
      }
    });
  }

  // Update Password
  if (passwordForm && newPasswordInput && confirmNewPasswordInput) {
    passwordForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (passwordError) passwordError.textContent = "";

      const newPass = newPasswordInput.value;
      const confirmPass = confirmNewPasswordInput.value;

      if (!newPass) {
        if (passwordError)
          passwordError.textContent = passwordForm.dataset.errorRequired || "La contraseña es requerida";
        return;
      }

      if (newPass.length < 6) {
        if (passwordError)
          passwordError.textContent =
            passwordForm.dataset.errorWeak || "La contraseña debe tener al menos 6 caracteres.";
        return;
      }

      if (newPass !== confirmPass) {
        if (passwordError)
          passwordError.textContent = passwordForm.dataset.errorMismatch || "Las contraseñas no coinciden";
        return;
      }

      const currentUser = auth.currentUser;
      if (!currentUser) return;

      if (updatePasswordBtn) updatePasswordBtn.disabled = true;

      try {
        await updatePassword(currentUser, newPass);
        passwordForm.reset();
        if (strengthFill) strengthFill.className = "strength-fill";
        if (strengthText) strengthText.textContent = "";
        showSuccess(passwordForm.dataset.successMsg || "¡Contraseña actualizada con éxito!");
      } catch (err: any) {
        console.error("Error updating password:", err);
        if (err.code === "auth/requires-recent-login") {
          showError(
            passwordForm.dataset.errorReauth ||
              "Por seguridad, debes haber iniciado sesión recientemente para cambiar tu contraseña.",
          );
        } else {
          showError(err.message || passwordForm.dataset.errorGeneral || "Ocurrió un error al procesar tu solicitud.");
        }
      } finally {
        if (updatePasswordBtn) updatePasswordBtn.disabled = false;
      }
    });
  }

  // --- Handle URL parameters for Post-Payment Boost / Claimed Redirect ---
  try {
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get("boostSuccess") === "1") {
      const tabBusiness = document.getElementById("tab-business");
      const boostBanner = document.getElementById("boost-success-banner");
      const boostAmountLabel = document.getElementById("boost-amount-label");
      const boostSlugLabel = document.getElementById("boost-slug-label");

      if (tabBusiness) {
        document.querySelectorAll(".profile-tab").forEach((t) => t.classList.remove("active"));
        document.querySelectorAll(".profile-tab-panel").forEach((p) => p.classList.remove("active"));
        tabBusiness.classList.add("active");
        const panel = document.getElementById("panel-business");
        if (panel) panel.classList.add("active");
      }

      if (boostBanner) {
        boostBanner.style.display = "block";
        if (boostAmountLabel) boostAmountLabel.textContent = `Importe: ${urlParams.get("amount") || "1"}€`;
        if (boostSlugLabel) {
          boostSlugLabel.textContent = `Comercio: ${decodeURIComponent(urlParams.get("slug") || "Mallorca")}`;
        }
      }
      showSuccess("¡Aportación e impulso popular completado con éxito!");
    }

    // Populate user claimed businesses
    const currentUser = auth.currentUser;
    const uid = currentUser?.uid || "guest";
    const claims = await getUserClaims(db, uid);
    const noBizBox = document.getElementById("no-business-box");
    const claimedBox = document.getElementById("claimed-business-box");
    const claimedName = document.getElementById("claimed-business-name");
    const claimedAuditDesc = document.getElementById("claimed-audit-desc");
    const statusBadge = document.getElementById("business-status-badge");

    if (claims.length > 0) {
      const latestClaim = claims[0];
      if (noBizBox) noBizBox.style.display = "none";
      if (claimedBox) claimedBox.style.display = "block";
      if (claimedName) claimedName.textContent = latestClaim.serviceName;
      if (statusBadge) {
        statusBadge.textContent = latestClaim.status.toUpperCase();
        statusBadge.className = `badge ${latestClaim.status === "approved" ? "badge-primary" : latestClaim.status === "pending" ? "badge-accent" : "badge-secondary"}`;
      }
      if (claimedAuditDesc) {
        claimedAuditDesc.textContent =
          latestClaim.status === "approved"
            ? "✅ Titularidad verificada. Tienes control administrativo sobre este negocio."
            : latestClaim.status === "pending"
              ? "⏳ Solicitud de cesión en proceso de validación fiscal por nuestro equipo de auditoría."
              : "❌ Solicitud no aprobada. Puedes volver a enviar la documentación.";
      }
    } else {
      if (statusBadge) {
        statusBadge.textContent = "Sin Negocio";
        statusBadge.className = "badge badge-secondary";
      }
    }

    // Populate displacement alerts (Rivalry & Outbid Engine)
    const displacementCard = document.getElementById("displacement-alert-card");
    const displacementDesc = document.getElementById("displacement-desc");
    const displacementReclaimBtn = document.getElementById("displacement-reclaim-btn") as HTMLAnchorElement | null;
    const displacementDismissBtn = document.getElementById("displacement-dismiss-btn");

    try {
      const allAlerts: any[] = JSON.parse(localStorage.getItem("sm_displacement_alerts") || "[]");
      const unreadAlert = allAlerts.find((a) => !a.read);
      if (unreadAlert && displacementCard) {
        displacementCard.style.display = "block";
        if (displacementDesc) {
          displacementDesc.textContent = `${unreadAlert.newLeaderServiceName} ha superado a tu negocio en el puesto #1 (${unreadAlert.categoryTitle}) con una puja de ${Number(unreadAlert.newLeaderBidEuros || 0).toFixed(2)}€. Recupera tu trono #1 ahora mismo por ${Number(unreadAlert.counterBidPriceEuros || 1).toFixed(2)}€.`;
        }
        if (displacementReclaimBtn) {
          displacementReclaimBtn.href = unreadAlert.oneClickReclaimUrl || "#";
        }
        if (displacementDismissBtn) {
          displacementDismissBtn.addEventListener("click", () => {
            unreadAlert.read = true;
            localStorage.setItem("sm_displacement_alerts", JSON.stringify(allAlerts));
            displacementCard.style.display = "none";
          });
        }
      }
    } catch (err) {
      console.warn("Could not check displacement alerts:", err);
    }

    // Populate favorites and backed businesses
    const favsBoostedList = document.getElementById("favs-boosted-list");
    if (favsBoostedList) {
      const favs: string[] = JSON.parse(localStorage.getItem("user_favorites") || "[]");
      if (favs.length === 0) {
        favsBoostedList.innerHTML = `<div class="empty-favs-txt">Aún no has impulsado ningún comercio. <a href="/es/servicios" class="link-gold">Explorar el catálogo →</a></div>`;
      } else {
        favsBoostedList.innerHTML = favs
          .map(
            (slug) => `
          <div class="fav-boost-item card card-glass">
            <span class="fav-icon">❤️</span>
            <div class="fav-info">
              <strong>${slug.replace(/-/g, " ").toUpperCase()}</strong>
              <span>Respaldado por la comunidad · Favorito</span>
            </div>
            <a href="/es/servicios/${slug}" class="btn btn-secondary btn-xs">Ver Ficha →</a>
          </div>
        `,
          )
          .join("");
      }
    }

    // --- Purchases, Official Invoices & Abandoned Cart / Drafts Loader ---
    const prefix = document.querySelector(".profile-container")?.getAttribute("data-prefix") || "/es/";
    const pendingDraftsCard = document.getElementById("pending-drafts-card");
    const draftBizName = document.getElementById("draft-biz-name");
    const draftAmountVal = document.getElementById("draft-amount-val");
    const draftMessageRow = document.getElementById("draft-message-row");
    const draftMessageVal = document.getElementById("draft-message-val");
    const draftDateVal = document.getElementById("draft-date-val");
    const btnResumeDraft = document.getElementById("btn-resume-draft");
    const btnDiscardDraft = document.getElementById("btn-discard-draft");

    const invoicesContainer = document.getElementById("invoices-list-container");
    const cancelledCard = document.getElementById("cancelled-history-card");
    const cancelledContainer = document.getElementById("cancelled-list-container");

    // Check tab query parameter
    if (urlParams.get("tab") === "purchases" || urlParams.get("tab") === "invoices") {
      const tabPurchases = document.getElementById("tab-purchases");
      if (tabPurchases) {
        document.querySelectorAll(".profile-tab").forEach((t) => t.classList.remove("active"));
        document.querySelectorAll(".profile-tab-panel").forEach((p) => p.classList.remove("active"));
        tabPurchases.classList.add("active");
        const panel = document.getElementById("panel-purchases");
        if (panel) panel.classList.add("active");
      }
    }

    // 1. Populate Pending Drafts (Abandoned Cart Recovery)
    try {
      const draftStr = localStorage.getItem("sm_pending_checkout_draft");
      if (draftStr && pendingDraftsCard) {
        const draft = JSON.parse(draftStr);
        if (draft && draft.serviceName) {
          pendingDraftsCard.style.display = "block";
          if (draftBizName) draftBizName.textContent = draft.serviceName;
          if (draftAmountVal) draftAmountVal.textContent = `${Number(draft.amount || 1).toFixed(2)}€`;
          if (draft.backerMessage && draftMessageRow && draftMessageVal) {
            draftMessageRow.style.display = "flex";
            draftMessageVal.textContent = `"${draft.backerMessage}"`;
          }
          if (draftDateVal && draft.savedAt) {
            draftDateVal.textContent = new Date(draft.savedAt).toLocaleString("es-ES");
          }

          btnResumeDraft?.addEventListener("click", () => {
            window.location.href = `${prefix}cuadro-de-honor?intent=boost&resumeDraft=1`;
          });

          btnDiscardDraft?.addEventListener("click", () => {
            localStorage.removeItem("sm_pending_checkout_draft");
            sessionStorage.removeItem("sm_pending_checkout_draft");
            pendingDraftsCard.style.display = "none";
            showSuccess("Borrador de aportación descartado correctamente.");
          });
        }
      }
    } catch (draftErr) {
      console.warn("Could not load draft:", draftErr);
    }

    // 2. Populate Confirmed Official Invoices (Financial History)
    if (invoicesContainer) {
      try {
        const allTx: any[] = JSON.parse(localStorage.getItem("user_honor_transactions") || "[]");
        // Also check user private storage if user is logged in
        const userTxKey = currentUser?.uid ? `sm_user_${currentUser.uid}_transactions` : null;
        const userSpecificTx: any[] = userTxKey ? JSON.parse(localStorage.getItem(userTxKey) || "[]") : [];

        // Merge and deduplicate by invoiceId
        const mergedMap = new Map<string, any>();
        [...userSpecificTx, ...allTx].forEach((tx) => {
          if (tx && tx.invoiceId) mergedMap.set(tx.invoiceId, tx);
        });
        const transactions = Array.from(mergedMap.values());

        if (transactions.length === 0) {
          invoicesContainer.innerHTML = `
            <div class="empty-invoices-box">
              <span class="empty-invoice-icon">🧾</span>
              <p>Aún no tienes ninguna factura oficial ni aportación completada.</p>
              <a href="${prefix}cuadro-de-honor" class="btn btn-primary btn-sm">👑 Explorar Cuadro de Honor & Aupar</a>
            </div>
          `;
        } else {
          invoicesContainer.innerHTML = transactions
            .map(
              (tx) => `
            <div class="invoice-item-card card card-glass">
              <div class="invoice-card-top">
                <div class="invoice-identity">
                  <span class="invoice-chip-badge">✅ Factura Oficial</span>
                  <code class="invoice-num-code">${tx.invoiceId || "INV-HONOR"}</code>
                </div>
                <strong class="invoice-price-total">${Number(tx.amount || 0).toFixed(2)}€</strong>
              </div>

              <div class="invoice-details-grid">
                <div class="inv-col">
                  <span class="inv-lbl">Comercio Impulsado:</span>
                  <strong class="inv-val">
                    <a href="${prefix}servicios/${tx.slug || ""}" class="inv-link">${tx.serviceName || "Comercio de Mallorca"} →</a>
                  </strong>
                </div>
                <div class="inv-col">
                  <span class="inv-lbl">Desglose Fiscal:</span>
                  <span class="inv-val">Base: ${Number(tx.subtotal || 0).toFixed(2)}€ + IVA (21%): ${Number(tx.tax || 0).toFixed(2)}€</span>
                </div>
                <div class="inv-col">
                  <span class="inv-lbl">Fecha & Hora:</span>
                  <span class="inv-val">${tx.at ? new Date(tx.at).toLocaleString("es-ES") : "Reciente"}</span>
                </div>
                <div class="inv-col">
                  <span class="inv-lbl">Titular / Pagador:</span>
                  <span class="inv-val">${tx.backerName || "Usuario"}${tx.isB2B && tx.b2bLegalName ? ` (${tx.b2bLegalName} - ${tx.b2bTaxId || ""})` : ""}</span>
                </div>
              </div>

              <div class="invoice-footer-actions">
                <button type="button" class="btn btn-secondary btn-xs btn-print-single-invoice" data-invoice="${tx.invoiceId}">
                  🖨️ Imprimir Factura / Guardar PDF
                </button>
                <a href="${prefix}cuadro-de-honor" class="btn btn-outline-secondary btn-xs">
                  👑 Ver en Cuadro de Honor
                </a>
              </div>
            </div>
          `,
            )
            .join("");

          // Add print handlers to buttons
          document.querySelectorAll(".btn-print-single-invoice").forEach((btn) => {
            btn.addEventListener("click", () => {
              window.print();
            });
          });
        }
      } catch (txErr) {
        console.warn("Could not load invoices:", txErr);
      }
    }

    // 3. Populate Cancelled Transactions (No charge made, full audit record)
    try {
      const guestCancelled: any[] = JSON.parse(localStorage.getItem("sm_cancelled_transactions_guest") || "[]");
      const cancelledKey = currentUser?.uid ? `sm_user_${currentUser.uid}_cancelled_transactions` : null;
      let cancelledList: any[] = cancelledKey ? JSON.parse(localStorage.getItem(cancelledKey) || "[]") : guestCancelled;

      if (cancelledKey && guestCancelled.length > 0) {
        cancelledList = [...guestCancelled, ...cancelledList];
        localStorage.setItem(cancelledKey, JSON.stringify(cancelledList.slice(0, 25)));
        localStorage.removeItem("sm_cancelled_transactions_guest");
      }

      if (cancelledList.length > 0 && cancelledCard && cancelledContainer) {
        cancelledCard.style.display = "block";
        cancelledContainer.innerHTML = cancelledList
          .map(
            (c) => `
          <div class="cancelled-item-row">
            <span class="cancelled-icon">ℹ️</span>
            <div class="cancelled-text">
              <strong>${c.serviceSlug ? c.serviceSlug.replace(/-/g, " ").toUpperCase() : "Gestión cancelada"}</strong>
              <span class="cancelled-date">${c.at ? new Date(c.at).toLocaleString("es-ES") : ""} · ${c.reason || "Sin cargo bancario"}</span>
            </div>
            <a href="${prefix}cuadro-de-honor" class="btn btn-secondary btn-xs">🔄 Reintentar</a>
          </div>
        `,
          )
          .join("");
      }
    } catch (cErr) {
      console.warn("Could not load cancelled list:", cErr);
    }

    // 4. Populate Legal Consent & RGPD Compliance Status
    try {
      const legalVerEl = document.getElementById("profile-legal-version");
      const legalStatusEl = document.getElementById("profile-legal-status");
      const legalDateEl = document.getElementById("profile-legal-date");
      const btnDownloadCert = document.getElementById("btn-download-consent-cert");

      if (legalVerEl) legalVerEl.textContent = `v${CURRENT_LEGAL_VERSION}`;

      let consent = currentUser?.uid ? getUserLegalConsent(currentUser.uid) : null;
      if (!consent && currentUser?.uid) {
        // Registrar consentimiento inicial si el usuario está autenticado y aún no tenía registro
        consent = recordUserLegalConsent(currentUser.uid, "profile", ["terms", "privacy", "cookies"]);
      }

      if (consent) {
        if (legalStatusEl) {
          if (consent.version === CURRENT_LEGAL_VERSION) {
            legalStatusEl.textContent = "✅ Al día con la normativa vigente";
            legalStatusEl.className = "legal-status-val text-success";
          } else {
            legalStatusEl.textContent = `⚠️ Requiere actualización (Tu versión: v${consent.version})`;
            legalStatusEl.className = "legal-status-val text-warning";
          }
        }
        if (legalDateEl && consent.acceptedAt) {
          legalDateEl.textContent = new Date(consent.acceptedAt).toLocaleString("es-ES");
        }

        btnDownloadCert?.addEventListener("click", () => {
          const certText = generateConsentAuditCertificate(consent!);
          const blob = new Blob([certText], { type: "text/plain;charset=utf-8" });
          const url = URL.createObjectURL(blob);
          const a = document.createElement("a");
          a.href = url;
          a.download = `Certificado_RGPD_${currentUser?.uid || "usuario"}.txt`;
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          URL.revokeObjectURL(url);
        });
      }
    } catch (legalErr) {
      console.warn("Could not load legal consent:", legalErr);
    }
  } catch (err) {
    console.warn("Profile params handling warning:", err);
  }
</script>

<style>
  /* ===============================================================
   * PROFILE FORM — Premium Redesign
   * =============================================================== */

  .profile-container {
    max-width: 1000px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  /* ── Hero Card ──────────────────────────────────────────────── */
  .profile-hero {
    padding: var(--space-2xl, 3rem) var(--space-xl);
    border-radius: var(--border-radius-xl, 1.5rem);
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--color-primary) 12%, var(--color-surface)),
      color-mix(in srgb, var(--color-accent) 8%, var(--color-surface))
    );
    position: relative;
    overflow: hidden;
  }

  .profile-hero::before {
    content: "";
    position: absolute;
    top: -60px;
    right: -60px;
    width: 220px;
    height: 220px;
    border-radius: 50%;
    background: radial-gradient(circle, var(--color-primary) 0%, transparent 70%);
    opacity: 0.08;
    pointer-events: none;
  }

  .profile-hero-inner {
    display: flex;
    align-items: center;
    gap: var(--space-2xl, 2.5rem);
    position: relative;
  }

  /* Avatar Hero */
  .hero-avatar-wrap {
    flex-shrink: 0;
    position: relative;
  }

  .hero-avatar {
    width: 110px;
    height: 110px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow:
      0 8px 32px var(--shadow-overlay, rgba(0, 0, 0, 0.3)),
      0 0 0 4px var(--color-surface);
    overflow: hidden;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .hero-avatar:hover {
    transform: scale(1.04);
    box-shadow:
      0 12px 40px var(--shadow-overlay),
      0 0 0 4px var(--color-primary);
  }

  .hero-avatar .avatar-symbol {
    font-size: 3.5rem;
    line-height: 1;
    user-select: none;
  }

  .hero-avatar .profile-avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-avatar-badge {
    position: absolute;
    bottom: -6px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-primary);
    color: #fff;
    font-size: 0.65rem;
    font-weight: 800;
    padding: 2px 10px;
    border-radius: 999px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    border: 2px solid var(--color-surface);
  }

  .badge-role-admin {
    background: var(--color-danger, #e53e3e);
  }
  .badge-role-manager {
    background: var(--color-accent, #7c3aed);
  }

  /* Hero Meta */
  .hero-meta {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .hero-name {
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    font-weight: 800;
    color: var(--color-text);
    margin: 0;
    line-height: 1.15;
  }

  .hero-email {
    font-size: var(--font-size-base);
    color: var(--color-text-muted);
    margin: 0;
  }

  .hero-stats {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-top: var(--space-xs);
  }

  .hero-stat {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    background: var(--color-surface);
    padding: 3px 10px;
    border-radius: 999px;
    border: 1px solid var(--color-surface-border);
  }

  /* ── Tab Navigation ─────────────────────────────────────────── */
  .profile-tabs {
    display: flex;
    gap: var(--space-xs);
    background: var(--color-surface);
    padding: 5px;
    border-radius: var(--border-radius-md);
    border: 1px solid var(--color-surface-border);
    max-width: 100%;
    flex-wrap: wrap;
  }

  .profile-tab {
    padding: 0.55rem 1rem;
    border: none;
    background: transparent;
    color: var(--color-text-muted);
    font-weight: 600;
    font-size: var(--font-size-sm);
    border-radius: var(--border-radius-sm);
    cursor: pointer;
    transition: all 0.2s ease;
    font-family: inherit;
    white-space: normal;
    text-align: center;
    word-break: break-word;
    line-height: 1.25;
  }

  .profile-tab:hover {
    color: var(--color-text);
    background: var(--color-surface-hover);
  }

  .profile-tab.active {
    background: var(--color-primary);
    color: #fff;
    box-shadow: 0 2px 12px var(--color-primary-ring);
  }

  /* ── Tab Panels ─────────────────────────────────────────────── */
  .profile-tab-panel {
    display: none;
  }

  .profile-tab-panel.active {
    display: block;
    animation: fadeUp 0.25s ease;
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Panel grid: Form + Preview side by side */
  .profile-panel-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: var(--space-xl);
    align-items: start;
  }

  .profile-form-card,
  .profile-preview-card {
    padding: var(--space-xl);
    border-radius: var(--border-radius-lg);
  }

  .panel-title {
    font-size: var(--font-size-lg);
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 var(--space-lg);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--color-surface-border);
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  /* ── Live Preview Card ──────────────────────────────────────── */
  .preview-profile-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-xl) var(--space-lg);
    background: linear-gradient(
      160deg,
      color-mix(in srgb, var(--color-primary) 10%, var(--color-surface)),
      var(--color-surface)
    );
    border-radius: var(--border-radius-lg);
    border: 1px solid var(--color-surface-border);
    text-align: center;
  }

  .preview-avatar {
    width: 90px;
    height: 90px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.8rem;
    box-shadow: 0 4px 20px var(--shadow-overlay);
    overflow: hidden;
  }

  .preview-avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .preview-name {
    font-size: var(--font-size-xl);
    font-weight: 800;
    color: var(--color-text);
    line-height: 1.2;
  }

  .preview-email {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .preview-badge {
    font-size: var(--font-size-xs);
  }

  .preview-joined {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    margin-top: var(--space-xs);
    padding: 4px 14px;
    background: var(--color-surface);
    border-radius: 999px;
    border: 1px solid var(--color-surface-border);
  }

  /* ── Form Elements ──────────────────────────────────────────── */
  .profile-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .form-label {
    font-size: var(--font-size-sm);
    font-weight: 700;
    color: var(--color-text);
  }

  .form-label-sub {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    margin-top: var(--space-xs);
    font-weight: 600;
  }

  .form-helper {
    font-size: 0.72rem;
    color: var(--color-text-muted);
  }

  .input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .input-icon {
    position: absolute;
    left: 0.85rem;
    font-size: 1.1rem;
    pointer-events: none;
    z-index: 1;
  }

  .form-input {
    width: 100%;
    padding: 0.75rem 1rem 0.75rem 2.8rem;
    border: 1px solid var(--color-surface-border);
    border-radius: var(--border-radius-sm);
    background-color: var(--color-bg);
    color: var(--color-text);
    font-family: inherit;
    font-size: var(--font-size-base);
    transition: all 0.2s ease-in-out;
  }

  .form-input:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px var(--color-primary-ring);
  }

  .form-input-disabled {
    opacity: 0.65;
    cursor: not-allowed;
    background: var(--color-surface);
  }

  .toggle-password-btn {
    position: absolute;
    right: 0.75rem;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1.1rem;
    padding: 0.25rem;
    color: var(--color-text-muted);
    transition: color 0.15s;
  }

  .toggle-password-btn:hover {
    color: var(--color-text);
  }

  /* Avatar Picker */
  .avatar-presets-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.4rem;
    margin-bottom: var(--space-xs);
  }

  .avatar-preset-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.9rem;
    padding: 0.55rem 0.4rem;
    background: var(--color-surface);
    border: 2px solid var(--color-surface-border);
    border-radius: var(--border-radius-sm);
    cursor: pointer;
    transition: all 0.18s ease;
    aspect-ratio: 1;
  }

  .avatar-preset-btn:hover {
    border-color: var(--color-primary);
    transform: translateY(-3px) scale(1.1);
    background: var(--color-primary-bg, rgba(99, 102, 241, 0.08));
    box-shadow: 0 4px 12px var(--color-primary-ring);
  }

  .avatar-preset-btn.is-selected {
    border-color: var(--color-primary);
    background: var(--color-primary-bg, rgba(99, 102, 241, 0.12));
    box-shadow: 0 0 0 3px var(--color-primary);
    transform: scale(1.05);
  }

  /* Password Strength */
  .password-strength {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-top: 0.25rem;
  }

  .strength-bar {
    height: 4px;
    background-color: var(--color-surface-border);
    border-radius: 2px;
    overflow: hidden;
  }

  .strength-fill {
    height: 100%;
    width: 0%;
    transition: all 0.3s ease;
    border-radius: 2px;
  }

  .strength-fill.weak {
    width: 33%;
    background-color: var(--color-danger);
  }
  .strength-fill.medium {
    width: 66%;
    background-color: #f59e0b;
  }
  .strength-fill.strong {
    width: 100%;
    background-color: #10b981;
  }

  .strength-text {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  .form-error {
    color: var(--color-danger);
    font-size: var(--font-size-xs);
    font-weight: 500;
  }

  /* Alerts */
  .alert-success {
    background-color: var(--color-success-bg, #ecfdf5);
    border: 1px solid var(--color-success-border, #10b981);
    color: var(--color-success, #065f46);
    padding: 0.85rem 1.25rem;
    border-radius: var(--border-radius-sm);
    font-size: var(--font-size-sm);
    font-weight: 500;
  }

  .alert-error {
    background-color: var(--color-danger-bg, #fef2f2);
    border: 1px solid var(--color-danger-border, #ef4444);
    color: var(--color-danger, #991b1b);
    padding: 0.85rem 1.25rem;
    border-radius: var(--border-radius-sm);
    font-size: var(--font-size-sm);
    font-weight: 500;
  }

  .alert-info {
    background-color: var(--color-primary-bg);
    border: 1px solid var(--color-surface-border);
    color: var(--color-text);
    padding: 1rem 1.25rem;
    border-radius: var(--border-radius-sm);
    font-size: var(--font-size-sm);
    line-height: 1.5;
    display: flex;
    gap: var(--space-sm);
    align-items: flex-start;
  }

  .notice-icon {
    font-size: 1.5rem;
    flex-shrink: 0;
  }

  .btn-full {
    width: 100%;
    justify-content: center;
    padding: 0.78rem;
    font-weight: 700;
    font-size: var(--font-size-base);
  }

  .form-actions {
    margin-top: var(--space-sm);
  }

  /* ── Responsive ─────────────────────────────────────────────── */
  @media (max-width: 900px) {
    .profile-panel-grid {
      grid-template-columns: 1fr;
    }

    .profile-preview-card {
      order: -1; /* show preview above form on tablet */
    }

    .preview-profile-card {
      flex-direction: row;
      text-align: left;
      gap: var(--space-lg);
    }

    .preview-avatar {
      width: 70px;
      height: 70px;
      font-size: 2.2rem;
      flex-shrink: 0;
    }
  }

  @media (max-width: 640px) {
    .profile-hero-inner {
      flex-direction: column;
      text-align: center;
      gap: var(--space-lg);
    }

    .hero-meta {
      align-items: center;
    }

    .profile-tabs {
      width: 100%;
      justify-content: stretch;
    }

    .profile-tab {
      flex: 1;
      text-align: center;
      padding: 0.55rem 0.5rem;
      font-size: 0.8rem;
    }

    .profile-hero {
      padding: var(--space-xl) var(--space-md);
    }

    .profile-form-card,
    .profile-preview-card {
      padding: var(--space-lg);
    }

    .preview-profile-card {
      flex-direction: column;
      text-align: center;
    }

    .preview-avatar {
      width: 80px;
      height: 80px;
    }

    .avatar-presets-grid {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  @media (max-width: 480px) {
    .profile-tabs {
      flex-direction: column;
      width: auto;
    }

    .profile-tab {
      flex: none;
    }
  }

  /* Business & Boosts Panel Styles */
  .business-panel-stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl, 1.5rem);
  }

  .boost-success-card {
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.15), rgba(6, 78, 59, 0.25));
    border: 1px solid rgba(16, 185, 129, 0.4);
    padding: var(--space-lg, 1.5rem);
    border-radius: var(--radius-lg, 12px);
  }

  .boost-banner-header {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .boost-icon {
    font-size: 2rem;
  }

  .boost-title {
    font-size: 1.2rem;
    font-weight: 800;
    color: #34d399;
    margin: 0 0 4px 0;
  }

  .boost-subtitle {
    font-size: 0.9rem;
    color: var(--color-text-secondary, #cbd5e1);
    margin: 0;
  }

  .boost-meta-strip {
    display: flex;
    gap: 8px;
    font-size: 0.78rem;
    color: #a7f3d0;
    margin-top: 10px;
    padding-top: 8px;
    border-top: 1px solid rgba(16, 185, 129, 0.2);
  }

  .section-title-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-md, 1rem);
  }

  .business-empty-state {
    padding: var(--space-lg, 1.5rem);
    text-align: center;
    background: rgba(255, 255, 255, 0.03);
    border: 1px dashed rgba(255, 255, 255, 0.12);
    border-radius: 8px;
  }

  .business-empty-state p {
    color: var(--color-text-secondary, #cbd5e1);
    margin-bottom: var(--space-md, 1rem);
  }

  .favs-boosted-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 8px;
    margin-top: var(--space-md, 1rem);
  }

  .fav-boost-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
  }

  .fav-icon {
    font-size: 1.3rem;
  }

  .fav-info {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .fav-info strong {
    font-size: 0.88rem;
    color: var(--color-text, #fff);
  }

  .fav-info span {
    font-size: 0.75rem;
    color: var(--color-accent, #ffd700);
  }

  .empty-favs-txt {
    font-size: 0.85rem;
    color: var(--color-text-muted, #94a3b8);
    text-align: center;
    padding: var(--space-md, 1rem);
  }

  /* ── Purchases & Drafts Styles (GR-01, GR-02) ──────────────── */
  .pending-draft-box {
    border: 1px solid var(--color-accent, #ffd700);
    background: var(--color-surface);
    border-radius: var(--border-radius-md, 12px);
    padding: var(--space-lg);
    box-shadow: var(--shadow-md);
    position: relative;
    overflow: hidden;
  }

  .pending-draft-box::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
    background: var(--color-accent, #ffd700);
  }

  .pending-draft-header {
    display: flex;
    align-items: flex-start;
    gap: var(--space-md);
    margin-bottom: var(--space-md);
  }

  .draft-badge-icon {
    font-size: 1.8rem;
    line-height: 1;
  }

  .pending-draft-title {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--color-accent, #ffd700);
    margin: 0 0 4px 0;
  }

  .pending-draft-subtitle {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.4;
  }

  .pending-draft-content {
    background: var(--color-bg);
    border: 1px solid var(--color-surface-border);
    border-radius: var(--border-radius-sm, 8px);
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: var(--space-md);
  }

  .draft-meta-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.85rem;
    flex-wrap: wrap;
    gap: 6px;
  }

  .draft-label {
    color: var(--color-text-muted);
  }

  .draft-price {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--color-primary);
  }

  .pending-draft-actions {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .invoices-list-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin-top: var(--space-md);
  }

  .invoice-item-card {
    padding: var(--space-lg);
    border: 1px solid var(--color-surface-border);
    border-radius: var(--border-radius-md, 12px);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    transition:
      transform var(--transition-fast),
      border-color var(--transition-fast);
  }

  .invoice-item-card:hover {
    border-color: var(--color-primary);
  }

  .invoice-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-sm);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--color-surface-border);
  }

  .invoice-identity {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .invoice-chip-badge {
    background: var(--color-success-bg, rgba(34, 197, 94, 0.12));
    color: var(--color-success, #22c55e);
    border: 1px solid var(--color-success, #22c55e);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: var(--border-radius-full, 9999px);
  }

  .invoice-num-code {
    font-size: 0.82rem;
    background: var(--color-bg);
    padding: 2px 6px;
    border-radius: 4px;
    color: var(--color-text-muted);
  }

  .invoice-price-total {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-primary);
  }

  .invoice-details-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-sm);
  }

  .inv-col {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .inv-lbl {
    font-size: 0.72rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    font-weight: 600;
  }

  .inv-val {
    font-size: 0.85rem;
    color: var(--color-text);
  }

  .inv-link {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .invoice-footer-actions {
    display: flex;
    justify-content: flex-end;
    gap: var(--space-sm);
    padding-top: var(--space-sm);
    border-top: 1px dashed var(--color-surface-border);
    flex-wrap: wrap;
  }

  .empty-invoices-box {
    text-align: center;
    padding: var(--space-xl);
    background: var(--color-bg);
    border: 1px dashed var(--color-surface-border);
    border-radius: var(--border-radius-md, 12px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
  }

  .empty-invoice-icon {
    font-size: 2.2rem;
  }

  .cancelled-list-grid {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: var(--space-sm);
  }

  .cancelled-item-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 14px;
    background: var(--color-bg);
    border: 1px solid var(--color-surface-border);
    border-radius: var(--border-radius-sm, 8px);
    flex-wrap: wrap;
  }

  .cancelled-text {
    display: flex;
    flex-direction: column;
    flex: 1;
    font-size: 0.85rem;
  }

  .cancelled-date {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  /* RGPD Legal Status Box */
  .legal-profile-status-box {
    background: var(--color-bg);
    border: 1px solid var(--color-surface-border);
    border-radius: var(--border-radius-md, 10px);
    padding: var(--space-md, 1rem);
    margin: var(--space-md, 1rem) 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .legal-status-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    font-size: 0.88rem;
  }

  .legal-status-label {
    color: var(--color-text-light);
  }

  .legal-status-val {
    font-weight: 600;
  }

  .legal-profile-actions {
    display: flex;
    gap: var(--space-sm, 0.75rem);
    flex-wrap: wrap;
    margin-top: var(--space-sm, 0.75rem);
  }

  .text-success {
