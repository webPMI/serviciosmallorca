---
import type { Translations } from "../i18n";

interface Props {
  translations: Translations;
  locale: string;
}

const { translations, locale } = Astro.props;

const AVATAR_PRESETS = ["👤", "🚀", "⚡", "👑", "🦊", "🦉", "🎨", "💻", "🌿", "🔥"];
---

<div class="profile-container" data-locale={locale}>
  <!-- Profile Hero Card -->
  <div class="profile-hero card-glass fade-in">
    <div class="profile-hero-inner">
      <!-- Avatar Large -->
      <div class="hero-avatar-wrap">
        <div class="hero-avatar" id="profile-current-avatar">
          <span class="avatar-symbol" id="profile-avatar-symbol">👤</span>
        </div>
        <div class="hero-avatar-badge" id="profile-role-badge">Usuario</div>
      </div>

      <!-- Name & Email -->
      <div class="hero-meta">
        <h1 class="hero-name" id="profile-display-name-header">Cargando...</h1>
        <p class="hero-email" id="profile-email-header">correo@ejemplo.com</p>
        <div class="hero-stats">
          <span class="hero-stat">🌴 Miembro de Servicios Mallorca</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Alerts -->
  <div id="profile-success-alert" class="alert-success" style="display: none;" role="alert"></div>
  <div id="profile-error-alert" class="alert-error" style="display: none;" role="alert"></div>

  <!-- Tab Navigation -->
  <div class="profile-tabs">
    <button class="profile-tab active" id="tab-info" data-tab="info"> 👤 Información de Cuenta </button>
    <button class="profile-tab" id="tab-security" data-tab="security"> 🔐 Seguridad </button>
  </div>

  <!-- Tab: Account Info -->
  <section class="profile-tab-panel active" id="panel-info">
    <div class="profile-panel-grid">
      <!-- Left: Form -->
      <div class="card profile-form-card">
        <h2 class="panel-title">✏️ Editar Perfil</h2>

        <form
          id="profile-info-form"
          class="profile-form"
          data-success-msg={translations["profile.successUpdated"]}
          data-error-name={translations["auth.nameRequired"]}
          data-error-general={translations["auth.errors.generalError"]}
        >
          <div class="form-group">
            <label for="profile-name" class="form-label">{translations["profile.name"]}</label>
            <div class="input-wrapper">
              <span class="input-icon">✏️</span>
              <input
                type="text"
                id="profile-name"
                name="displayName"
                class="form-input"
                required
                placeholder="Tu nombre completo"
              />
            </div>
          </div>

          <div class="form-group">
            <label for="profile-email" class="form-label">{translations["profile.email"]}</label>
            <div class="input-wrapper">
              <span class="input-icon">📧</span>
              <input type="email" id="profile-email" class="form-input form-input-disabled" disabled readonly />
            </div>
            <span class="form-helper">El correo no puede modificarse directamente por seguridad.</span>
          </div>

          <!-- Avatar Picker -->
          <div class="form-group">
            <label class="form-label">{translations["profile.avatar"]}</label>
            <div class="avatar-presets-grid" id="avatar-presets">
              {
                AVATAR_PRESETS.map((icon) => (
                  <button
                    type="button"
                    class="avatar-preset-btn"
                    data-preset={icon}
                    aria-label={`Seleccionar avatar ${icon}`}
                  >
                    {icon}
                  </button>
                ))
              }
            </div>

            <label for="profile-custom-photo" class="form-label-sub">{translations["profile.customAvatarUrl"]}</label>
            <div class="input-wrapper">
              <span class="input-icon">🔗</span>
              <input
                type="url"
                id="profile-custom-photo"
                name="photoURL"
                class="form-input"
                placeholder="https://ejemplo.com/tu-foto.jpg"
              />
            </div>
          </div>

          <div class="form-actions">
            <button type="submit" id="save-profile-btn" class="btn btn-primary btn-full">
              <span class="btn-text">{translations["profile.saveChanges"]}</span>
              <span class="btn-loader" style="display: none;">⌛</span>
            </button>
          </div>
        </form>
      </div>

      <!-- Right: Live Preview -->
      <div class="card profile-preview-card">
        <h2 class="panel-title">👁️ Vista Previa</h2>
        <div class="preview-profile-card">
          <div class="preview-avatar" id="preview-avatar-display">
            <span>👤</span>
          </div>
          <div class="preview-name" id="preview-name-display">Tu nombre</div>
          <div class="preview-email" id="preview-email-display">tu@correo.com</div>
          <div class="preview-badge badge badge-primary" id="preview-role-display">Usuario</div>
          <div class="preview-joined">🌴 Comunidad Servicios Mallorca</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Tab: Security & Password -->
  <section class="profile-tab-panel" id="panel-security">
    <div class="card profile-form-card" id="profile-security-section">
      <h2 class="panel-title">🔐 {translations["profile.changePassword"]}</h2>

      <!-- Google Provider Notice -->
      <div id="google-auth-notice" class="alert-info" style="display: none;">
        <span class="notice-icon">🌐</span>
        <div>
          <strong>Cuenta vinculada con Google</strong>
          <p>
            {
              translations["profile.googleAuthNotice"] ||
                "Iniciaste sesión con Google. La gestión y seguridad de tu contraseña se realiza a través de tu cuenta de Google."
            }
          </p>
        </div>
      </div>

      <!-- Password Change Form for Email/Password users -->
      <form
        id="profile-password-form"
        class="profile-form"
        data-success-msg={translations["profile.successPassword"]}
        data-error-required={translations["auth.passwordRequired"]}
        data-error-mismatch={translations["auth.passwordMismatch"]}
        data-error-weak={translations["auth.errors.weakPassword"]}
        data-error-reauth={translations["profile.reauthRequired"]}
        data-error-general={translations["auth.errors.generalError"]}
        data-strength-weak={translations["auth.passwordStrength.weak"]}
        data-strength-medium={translations["auth.passwordStrength.medium"]}
        data-strength-strong={translations["auth.passwordStrength.strong"]}
      >
        <div class="form-group">
          <label for="new-password" class="form-label">{translations["profile.newPassword"]}</label>
          <div class="input-wrapper">
            <span class="input-icon">🔒</span>
            <input
              type="password"
              id="new-password"
              name="newPassword"
              class="form-input"
              required
              placeholder="••••••••"
              autocomplete="new-password"
            />
            <button
              type="button"
              id="toggle-new-password"
              class="toggle-password-btn"
              aria-label={translations["auth.togglePassword.ariaLabel"]}
            >
              👁️
            </button>
          </div>
          <div class="password-strength" id="profilePasswordStrength">
            <div class="strength-bar">
              <div class="strength-fill" id="profileStrengthFill"></div>
            </div>
            <span class="strength-text" id="profileStrengthText"></span>
          </div>
        </div>

        <div class="form-group">
          <label for="confirm-new-password" class="form-label">{translations["profile.confirmNewPassword"]}</label>
          <div class="input-wrapper">
            <span class="input-icon">🔒</span>
            <input
              type="password"
              id="confirm-new-password"
              name="confirmNewPassword"
              class="form-input"
              required
              placeholder="••••••••"
              autocomplete="new-password"
            />
            <button
              type="button"
              id="toggle-confirm-new-password"
              class="toggle-password-btn"
              aria-label={translations["auth.togglePassword.ariaLabel"]}
            >
              👁️
            </button>
          </div>
          <span class="form-error" id="profile-password-error"></span>
        </div>

        <div class="form-actions">
          <button type="submit" id="update-password-btn" class="btn btn-secondary btn-full">
            <span class="btn-text">{translations["profile.updatePassword"]}</span>
            <span class="btn-loader" style="display: none;">⌛</span>
          </button>
        </div>
      </form>
    </div>
  </section>
</div>

<script>
  import { updateProfile, updatePassword, onAuthStateChanged } from "firebase/auth";
  import { auth, db } from "../lib/firebase";
  import { authStore } from "../lib/authStore";
  import { getUserProfile, updateUserProfile } from "../lib/userProfile";
  import { toast } from "../lib/toast";

  // Elements
  const headerName = document.getElementById("profile-display-name-header");
  const headerEmail = document.getElementById("profile-email-header");
  const headerRole = document.getElementById("profile-role-badge");
  const currentAvatarEl = document.getElementById("profile-current-avatar");

  const infoForm = document.getElementById("profile-info-form") as HTMLFormElement | null;
  const nameInput = document.getElementById("profile-name") as HTMLInputElement | null;
  const emailInput = document.getElementById("profile-email") as HTMLInputElement | null;
  const customPhotoInput = document.getElementById("profile-custom-photo") as HTMLInputElement | null;
  const saveProfileBtn = document.getElementById("save-profile-btn") as HTMLButtonElement | null;

  const passwordForm = document.getElementById("profile-password-form") as HTMLFormElement | null;
  const newPasswordInput = document.getElementById("new-password") as HTMLInputElement | null;
  const confirmNewPasswordInput = document.getElementById("confirm-new-password") as HTMLInputElement | null;
  const passwordError = document.getElementById("profile-password-error");
  const updatePasswordBtn = document.getElementById("update-password-btn") as HTMLButtonElement | null;
  const googleNotice = document.getElementById("google-auth-notice");

  const successAlert = document.getElementById("profile-success-alert");
  const errorAlert = document.getElementById("profile-error-alert");

  const toggleNewPassBtn = document.getElementById("toggle-new-password");
  const toggleConfirmPassBtn = document.getElementById("toggle-confirm-new-password");
  const strengthFill = document.getElementById("profileStrengthFill");
  const strengthText = document.getElementById("profileStrengthText");

  // Preview elements
  const previewAvatarEl = document.getElementById("preview-avatar-display");
  const previewNameEl = document.getElementById("preview-name-display");
  const previewEmailEl = document.getElementById("preview-email-display");
  const previewRoleEl = document.getElementById("preview-role-display");

  let selectedAvatar: string | null = null;

  // --- Tab Switching ---
  document.querySelectorAll(".profile-tab").forEach((tab) => {
    tab.addEventListener("click", () => {
      const target = (tab as HTMLElement).dataset.tab;
      document.querySelectorAll(".profile-tab").forEach((t) => t.classList.remove("active"));
      document.querySelectorAll(".profile-tab-panel").forEach((p) => p.classList.remove("active"));
      tab.classList.add("active");
      const panel = document.getElementById(`panel-${target}`);
      if (panel) panel.classList.add("active");
    });
  });

  function showSuccess(msg: string) {
    if (errorAlert) errorAlert.style.display = "none";
    if (successAlert) {
      successAlert.textContent = msg;
      successAlert.style.display = "block";
      successAlert.scrollIntoView({ behavior: "smooth", block: "nearest" });
    }
    toast.success(msg);
  }

  function showError(msg: string) {
    if (successAlert) successAlert.style.display = "none";
    if (errorAlert) {
      errorAlert.textContent = msg;
      errorAlert.style.display = "block";
      errorAlert.scrollIntoView({ behavior: "smooth", block: "nearest" });
    }
    toast.error(msg);
  }

  // Render current avatar
  function setAvatarDisplay(photo: string | null, name: string | null) {
    // Update hero header avatar
    if (currentAvatarEl) {
      if (photo && (photo.startsWith("http://") || photo.startsWith("https://") || photo.startsWith("data:"))) {
        currentAvatarEl.innerHTML = `<img src="${photo}" alt="Avatar" class="profile-avatar-img" />`;
      } else if (photo && photo.length <= 8) {
        currentAvatarEl.innerHTML = `<span class="avatar-symbol">${photo}</span>`;
      } else {
        const initial = name && name.trim() ? name.trim()[0].toUpperCase() : "👤";
        currentAvatarEl.innerHTML = `<span class="avatar-symbol">${initial}</span>`;
      }
    }
    // Update preview avatar
    if (previewAvatarEl) {
      if (photo && (photo.startsWith("http://") || photo.startsWith("https://") || photo.startsWith("data:"))) {
        previewAvatarEl.innerHTML = `<img src="${photo}" alt="Avatar" class="preview-avatar-img" />`;
      } else if (photo && photo.length <= 8) {
        previewAvatarEl.innerHTML = `<span>${photo}</span>`;
      } else {
        const initial = name && name.trim() ? name.trim()[0].toUpperCase() : "👤";
        previewAvatarEl.innerHTML = `<span>${initial}</span>`;
      }
    }
  }

  function populateUser(user: any, role: string = "user") {
    if (!user) return;

    const displayName = user.displayName || (user.email ? user.email.split("@")[0] : "Usuario");
    const email = user.email || "";

    if (headerName) headerName.textContent = displayName;
    if (headerEmail) headerEmail.textContent = email;
    if (emailInput) emailInput.value = email;
    if (nameInput && !nameInput.value) nameInput.value = displayName;

    // Preview sync
    if (previewNameEl) previewNameEl.textContent = displayName;
    if (previewEmailEl) previewEmailEl.textContent = email;
    if (previewRoleEl) {
      previewRoleEl.textContent = role.toUpperCase();
      previewRoleEl.className = `preview-badge badge badge-${role === "admin" ? "admin" : role === "manager" ? "manager" : "primary"}`;
    }

    if (headerRole) {
      headerRole.textContent = role.toUpperCase();
      headerRole.className = `hero-avatar-badge badge-role-${role}`;
    }

    selectedAvatar = user.photoURL;
    if (customPhotoInput && user.photoURL && (user.photoURL.startsWith("http") || user.photoURL.startsWith("data:"))) {
      customPhotoInput.value = user.photoURL;
    }

    setAvatarDisplay(user.photoURL, displayName);

    // Highlight preset if matching
    if (user.photoURL) {
      document.querySelectorAll(".avatar-preset-btn").forEach((btn) => {
        if (btn.getAttribute("data-preset") === user.photoURL) {
          btn.classList.add("is-selected");
        } else {
          btn.classList.remove("is-selected");
        }
      });
    }

    // Check Google Auth provider
    const isGoogle = user.providerData && user.providerData.some((p: any) => p.providerId === "google.com");
    if (isGoogle) {
      if (passwordForm) passwordForm.style.display = "none";
      if (googleNotice) googleNotice.style.display = "flex";
    } else {
      if (passwordForm) passwordForm.style.display = "flex";
      if (googleNotice) googleNotice.style.display = "none";
    }
  }

  // 1. Direct onAuthStateChanged listener
  onAuthStateChanged(auth, async (user) => {
    if (!user) {
      // Redirect if not logged in
      const currentPath = window.location.pathname;
      const langPrefix = currentPath.split("/")[1] || "es";
      window.location.href = `/${langPrefix}/login`;
      return;
    }

    // Get Firestore profile role if available
    let role = "user";
    try {
      const profile = await getUserProfile(db, user.uid);
      if (profile && profile.role) role = profile.role;
    } catch {
      // Fallback
    }

    populateUser(user, role);
  });

  // 2. AuthStore subscription
  authStore.subscribe(({ user, role, loading }) => {
    if (loading) return;
    if (user) {
      populateUser(user, role);
    }
  });

  // Avatar presets selection
  document.querySelectorAll(".avatar-preset-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll(".avatar-preset-btn").forEach((b) => b.classList.remove("is-selected"));
      btn.classList.add("is-selected");
      const icon = btn.getAttribute("data-preset");
      if (icon) {
        selectedAvatar = icon;
        if (customPhotoInput) customPhotoInput.value = "";
        setAvatarDisplay(icon, nameInput?.value || null);
      }
    });
  });

  // Custom photo input change
  if (customPhotoInput) {
    customPhotoInput.addEventListener("input", () => {
      const val = customPhotoInput.value.trim();
      if (val) {
        document.querySelectorAll(".avatar-preset-btn").forEach((b) => b.classList.remove("is-selected"));
        selectedAvatar = val;
        setAvatarDisplay(val, nameInput?.value || null);
      }
    });
  }

  // Live preview: sync name input
  if (nameInput) {
    nameInput.addEventListener("input", () => {
      const val = nameInput.value.trim();
      if (previewNameEl) previewNameEl.textContent = val || "Tu nombre";
      if (headerName) headerName.textContent = val || "Tu nombre";
    });
  }

  // Update Profile Info
  if (infoForm && nameInput) {
    infoForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      const currentUser = auth.currentUser;
      if (!currentUser) return;

      const newName = nameInput.value.trim();
      if (!newName) {
        showError(infoForm.dataset.errorName || "El nombre es requerido");
        return;
      }

      const photoToSave = selectedAvatar || customPhotoInput?.value.trim() || null;

      if (saveProfileBtn) saveProfileBtn.disabled = true;

      try {
        // 1. Update Firebase Auth Profile
        await updateProfile(currentUser, {
          displayName: newName,
          photoURL: photoToSave,
        });

        // 2. Update Firestore document
        await updateUserProfile(db, currentUser.uid, {
          displayName: newName,
          photoURL: photoToSave,
        });

        // 3. Refresh display
        if (headerName) headerName.textContent = newName;
        setAvatarDisplay(photoToSave, newName);

        // 4. Update dynamic Navbar if present
        const navName =
          document.getElementById("user-nav-name") ||
          document.getElementById("manager-nav-name") ||
          document.getElementById("admin-nav-name");
        if (navName) navName.textContent = newName;

        showSuccess(infoForm.dataset.successMsg || "¡Perfil actualizado con éxito!");
      } catch (err: any) {
        console.error("Error updating profile:", err);
        showError(err.message || infoForm.dataset.errorGeneral || "Ocurrió un error al procesar tu solicitud.");
      } finally {
        if (saveProfileBtn) saveProfileBtn.disabled = false;
      }
    });
  }

  // Password Toggles
  if (toggleNewPassBtn && newPasswordInput) {
    toggleNewPassBtn.addEventListener("click", () => {
      const isPass = newPasswordInput.type === "password";
      newPasswordInput.type = isPass ? "text" : "password";
      toggleNewPassBtn.textContent = isPass ? "🙈" : "👁️";
    });
  }

  if (toggleConfirmPassBtn && confirmNewPasswordInput) {
    toggleConfirmPassBtn.addEventListener("click", () => {
      const isPass = confirmNewPasswordInput.type === "password";
      confirmNewPasswordInput.type = isPass ? "text" : "password";
      toggleConfirmPassBtn.textContent = isPass ? "🙈" : "👁️";
    });
  }

  // Strength Meter for Profile Password Form
  if (newPasswordInput && strengthFill && strengthText && passwordForm) {
    newPasswordInput.addEventListener("input", () => {
      const val = newPasswordInput.value;
      let score = 0;
      if (val.length >= 8) score++;
      if (/\d/.test(val)) score++;
      if (/[a-z]/.test(val) && /[A-Z]/.test(val)) score++;
      if (/[^A-Za-z0-9]/.test(val)) score++;

      if (val.length === 0) {
        strengthFill.className = "strength-fill";
        strengthText.textContent = "";
      } else if (score <= 1) {
        strengthFill.className = "strength-fill weak";
        strengthText.textContent = passwordForm.dataset.strengthWeak || "Débil";
      } else if (score <= 3) {
        strengthFill.className = "strength-fill medium";
        strengthText.textContent = passwordForm.dataset.strengthMedium || "Media";
      } else {
        strengthFill.className = "strength-fill strong";
        strengthText.textContent = passwordForm.dataset.strengthStrong || "Fuerte";
      }
    });
  }

  // Update Password
  if (passwordForm && newPasswordInput && confirmNewPasswordInput) {
    passwordForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (passwordError) passwordError.textContent = "";

      const newPass = newPasswordInput.value;
      const confirmPass = confirmNewPasswordInput.value;

      if (!newPass) {
        if (passwordError)
          passwordError.textContent = passwordForm.dataset.errorRequired || "La contraseña es requerida";
        return;
      }

      if (newPass.length < 6) {
        if (passwordError)
          passwordError.textContent =
            passwordForm.dataset.errorWeak || "La contraseña debe tener al menos 6 caracteres.";
        return;
      }

      if (newPass !== confirmPass) {
        if (passwordError)
          passwordError.textContent = passwordForm.dataset.errorMismatch || "Las contraseñas no coinciden";
        return;
      }

      const currentUser = auth.currentUser;
      if (!currentUser) return;

      if (updatePasswordBtn) updatePasswordBtn.disabled = true;

      try {
        await updatePassword(currentUser, newPass);
        passwordForm.reset();
        if (strengthFill) strengthFill.className = "strength-fill";
        if (strengthText) strengthText.textContent = "";
        showSuccess(passwordForm.dataset.successMsg || "¡Contraseña actualizada con éxito!");
      } catch (err: any) {
        console.error("Error updating password:", err);
        if (err.code === "auth/requires-recent-login") {
          showError(
            passwordForm.dataset.errorReauth ||
              "Por seguridad, debes haber iniciado sesión recientemente para cambiar tu contraseña.",
          );
        } else {
          showError(err.message || passwordForm.dataset.errorGeneral || "Ocurrió un error al procesar tu solicitud.");
        }
      } finally {
        if (updatePasswordBtn) updatePasswordBtn.disabled = false;
      }
    });
  }
</script>

<style>
  /* ===============================================================
   * PROFILE FORM — Premium Redesign
   * =============================================================== */

  .profile-container {
    max-width: 1000px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  /* ── Hero Card ──────────────────────────────────────────────── */
  .profile-hero {
    padding: var(--space-2xl, 3rem) var(--space-xl);
    border-radius: var(--border-radius-xl, 1.5rem);
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--color-primary) 12%, var(--color-surface)),
      color-mix(in srgb, var(--color-accent) 8%, var(--color-surface))
    );
    position: relative;
    overflow: hidden;
  }

  .profile-hero::before {
    content: "";
    position: absolute;
    top: -60px;
    right: -60px;
    width: 220px;
    height: 220px;
    border-radius: 50%;
    background: radial-gradient(circle, var(--color-primary) 0%, transparent 70%);
    opacity: 0.08;
    pointer-events: none;
  }

  .profile-hero-inner {
    display: flex;
    align-items: center;
    gap: var(--space-2xl, 2.5rem);
    position: relative;
  }

  /* Avatar Hero */
  .hero-avatar-wrap {
    flex-shrink: 0;
    position: relative;
  }

  .hero-avatar {
    width: 110px;
    height: 110px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow:
      0 8px 32px var(--shadow-overlay, rgba(0, 0, 0, 0.3)),
      0 0 0 4px var(--color-surface);
    overflow: hidden;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .hero-avatar:hover {
    transform: scale(1.04);
    box-shadow:
      0 12px 40px var(--shadow-overlay),
      0 0 0 4px var(--color-primary);
  }

  .hero-avatar .avatar-symbol {
    font-size: 3.5rem;
    line-height: 1;
    user-select: none;
  }

  .hero-avatar .profile-avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-avatar-badge {
    position: absolute;
    bottom: -6px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-primary);
    color: #fff;
    font-size: 0.65rem;
    font-weight: 800;
    padding: 2px 10px;
    border-radius: 999px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    border: 2px solid var(--color-surface);
  }

  .badge-role-admin {
    background: var(--color-danger, #e53e3e);
  }
  .badge-role-manager {
    background: var(--color-accent, #7c3aed);
  }

  /* Hero Meta */
  .hero-meta {
    display: flex;
    flex-direction: column;
