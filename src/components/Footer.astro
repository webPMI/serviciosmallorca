---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import ThemeSwitcher from "./ThemeSwitcher.astro";

interface Props {
  currentLocale: "es" | "en" | "ca" | "de";
  translations: Record<string, string>;
  getLangPrefix: (locale: "es" | "en" | "ca" | "de") => string;
}

const { currentLocale, translations, getLangPrefix } = Astro.props;
const currentPath = Astro.url.pathname;
---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <!-- Brand column -->
      <div class="footer-col brand-col">
        <div class="footer-brand">
          <span class="footer-logo">🌴 Servicios Mallorca</span>
        </div>
        <p class="footer-tagline">{translations["footer.tagline"]}</p>
      </div>

      <!-- Quick links column -->
      <div class="footer-col nav-col">
        <h4 class="footer-heading">{translations["nav.services"] || "Servicios"}</h4>
        <nav class="footer-nav">
          <a href={`${getLangPrefix(currentLocale)}servicios`} class="footer-link">
            {translations["nav.services"] || "Directorio"}
          </a>
          <a href={`${getLangPrefix(currentLocale)}comunidad`} class="footer-link">
            💬 {translations["nav.community"] || "Comunidad & Foro"}
          </a>
          <a href={`${getLangPrefix(currentLocale)}blog`} class="footer-link">
            {translations["nav.blog"] || "Blog & Guías"}
          </a>
          <a href={`${getLangPrefix(currentLocale)}sobre-nosotros`} class="footer-link">
            🌿 {translations["nav.about"] || "Sobre Nosotros"}
          </a>
          <a href={`${getLangPrefix(currentLocale)}actualizaciones`} class="footer-link">
            🚀 {translations["nav.changelog"] || "Actualizaciones & Beta v0.01"}
          </a>
          <a href={`${getLangPrefix(currentLocale)}terms`} class="footer-link">
            {translations["footer.terms"]}
          </a>
          <a href={`${getLangPrefix(currentLocale)}privacy`} class="footer-link">
            {translations["footer.privacy"]}
          </a>
        </nav>
      </div>

      <!-- Specialized Hubs column -->
      <div class="footer-col nav-col">
        <h4 class="footer-heading">
          {
            translations["nav.section.explore"] ||
              (currentLocale === "de"
                ? "Entdecken"
                : currentLocale === "en"
                  ? "Explore"
                  : currentLocale === "ca"
                    ? "Explorar"
                    : "Explorar")
          }
        </h4>
        <nav class="footer-nav">
          <a href={`${getLangPrefix(currentLocale)}deporte`} class="footer-link">
            🏃 {translations["nav.sports"] || "Deporte & Parques"}
          </a>
          <a href={`${getLangPrefix(currentLocale)}tours`} class="footer-link">
            🗺️ {translations["nav.tours"] || "Rutas & Tours"}
          </a>
          <a href={`${getLangPrefix(currentLocale)}memoria-historica`} class="footer-link">
            🏛️ {translations["nav.history"] || "Memoria Histórica"}
          </a>
          <a href={`${getLangPrefix(currentLocale)}estadisticas`} class="footer-link">
            📊 {translations["nav.stats"] || "Estadísticas Oficiales"}
          </a>
          <a href={`${getLangPrefix(currentLocale)}guias`} class="footer-link">
            📋 {translations["nav.guides"] || "Trámites & Guías"}
          </a>
          <a href={`${getLangPrefix(currentLocale)}cuadro-de-honor`} class="footer-link">
            👑 {translations["nav.honor"] || "Cuadro de Honor"}
          </a>
          <a href={`${getLangPrefix(currentLocale)}unete`} class="footer-link">
            🚀 {translations["nav.join"] || "Para Empresas & Tarifas"}
          </a>
          <a href={`${getLangPrefix(currentLocale)}favoritos`} class="footer-link">
            ❤️ {translations["nav.favorites"] || "Favoritos & Wishlist"}
          </a>
        </nav>
      </div>

      <!-- Controls column (Language + Theme) -->
      <div class="footer-col controls-col">
        <h4 class="footer-heading">{translations["footer.preferences"] || "Preferencias"}</h4>
        <div class="footer-controls">
          <LanguageSwitcher
            currentLocale={currentLocale}
            translations={{
              "nav.es": translations["nav.es"] || "ES",
              "nav.en": translations["nav.en"] || "EN",
              "nav.ca": translations["nav.ca"] || "CA",
              "nav.de": translations["nav.de"] || "DE",
            }}
            getLangPrefix={getLangPrefix}
            currentPath={currentPath}
          />

          <ThemeSwitcher
            variant="footer"
            translations={{
              "theme.light": translations["theme.light"],
              "theme.dark": translations["theme.dark"],
              "theme.toggle": translations["theme.toggle"],
              "theme.selectTheme": translations["theme.selectTheme"],
            }}
          />
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© 2025 {translations["site.title"]}. {translations["footer.rights"]}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-primary-dark);
    color: var(--color-white);
    padding-top: var(--space-2xl);
    padding-bottom: var(--space-lg);
    border-top: 1px solid var(--footer-border-light);
    margin-top: auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.8fr 1fr 1fr 1.2fr;
    gap: var(--space-xl);
    margin-bottom: var(--space-xl);
  }

  .footer-logo {
    font-size: var(--font-size-2xl);
    font-weight: 700;
    color: var(--color-white);
    display: inline-block;
    margin-bottom: var(--space-xs);
  }

  .footer-tagline {
    color: var(--footer-text-light);
    font-size: var(--font-size-base);
    max-width: 320px;
    line-height: 1.5;
  }

  .footer-heading {
    color: var(--color-white);
    font-size: var(--font-size-base);
    font-weight: 600;
    margin-bottom: var(--space-md);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .footer-nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .footer-link {
    color: var(--footer-text-light);
    text-decoration: none;
    font-size: var(--font-size-sm);
    transition: color 0.2s ease;
  }

  .footer-link:hover {
    color: var(--color-accent);
  }

  .footer-controls {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    align-items: flex-start;
  }

  .footer-bottom {
    border-top: 1px solid var(--footer-border-light);
    padding-top: var(--space-md);
    text-align: center;
  }

  .footer-bottom p {
    color: var(--footer-text-muted);
    font-size: var(--font-size-xs);
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }
  }
</style>
