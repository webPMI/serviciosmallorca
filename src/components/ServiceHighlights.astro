---
import { type Locale } from "../../../i18n";

export const ServiceHighlights = ({
  service,
  translations,
  locale
}: {
  service: any;
  translations: any;
  locale: Locale;
}) => {
  return (
    <section class="card section-box">
      <h2 class="box-title">{translations["services.highlights"]}</h2>
      <ul class="highlights-list">
        {
          service.highlights[locale].map((item) => (
            <li class="highlight-item">
              <span class="check-icon">✓</span>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </section>
  );
};
