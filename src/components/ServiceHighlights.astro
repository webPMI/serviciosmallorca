---
import type { ServiceItem } from "../data/services/types";
import type { Locale } from "../i18n";

interface Props {
  service: ServiceItem;
  translations: Record<string, string>;
  locale: Locale;
}

const { service, translations, locale } = Astro.props;
---

{
  service.highlights && service.highlights[locale]?.length > 0 && (
    <section class="card section-box" id="destacados">
      <h2 class="box-title">{translations["services.highlights"]}</h2>
      <ul class="highlights-list">
        {service.highlights[locale].map((item: string) => (
          <li class="highlight-item">
            <span class="check-icon">✓</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </section>
  )
}
