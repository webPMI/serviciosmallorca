---
import type { Locale } from "../i18n";
import { getLangPrefix } from "../i18n";
import type { HonorCategory } from "../lib/honorBoardEngine";
import { PUBLIC_SERVICES } from "../data/services";

interface Props {
  locale?: Locale;
  translations?: Record<string, string>;
  preselectedServiceId?: string;
  preselectedServiceName?: string;
  preselectedServiceSlug?: string;
  preselectedCategory?: HonorCategory;
  minBidRequired?: number;
}

const {
  locale = "es" as Locale,
  translations = {},
  preselectedServiceId = "",
  preselectedServiceName = "",
  preselectedServiceSlug = "",
  preselectedCategory = "elite-general",
  minBidRequired = 1.0,
} = Astro.props;

const prefix = getLangPrefix(locale);
const verifiedBusinesses = PUBLIC_SERVICES.filter((s) => (s.confidenceScore ?? 0) >= 80 && s.status === "open");
---

<!-- Modal de Checkout & Posicionamiento (Multi-step Wizard, Theme Adaptive, Validated) -->
<div
  id="honor-checkout-modal"
  class="honor-modal-backdrop"
  data-prefix={prefix}
  data-default-category={preselectedCategory}
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
>
  <div class="honor-modal-dialog">
    <!-- Header -->
    <div class="modal-header-row">
      <div class="modal-title-wrap">
        <span class="live-pill">
          <span class="pulse-dot"></span>
          {translations["honor.modal.live"] || "Pasarela de Autoridad Balear"}
        </span>
        <h3 id="modal-heading-title" class="modal-main-title">
          {translations["honor.modal.title"] || "Impulso & Puesto en el Cuadro de Honor"}
        </h3>
      </div>
      <button type="button" class="modal-close-btn" id="close-honor-modal-btn" aria-label="Cerrar modal"> ✕ </button>
    </div>

    <!-- Progress Steps Header (1 -> 2 -> 3) -->
    <div class="checkout-steps-track" role="navigation" aria-label="Pasos de checkout">
      <div class="step-badge active" id="step-indicator-1">
        <span class="step-num">1</span>
        <span class="step-label">{translations["honor.modal.step1"] || "Datos & Negocio"}</span>
      </div>
      <div class="step-arrow" id="step-arrow-1">→</div>
      <div class="step-badge" id="step-indicator-2">
        <span class="step-num">2</span>
        <span class="step-label">{translations["honor.modal.step2"] || "Importe & Pago SSL"}</span>
      </div>
      <div class="step-arrow" id="step-arrow-2">→</div>
      <div class="step-badge" id="step-indicator-3">
        <span class="step-num">3</span>
        <span class="step-label">{translations["honor.modal.step3"] || "Factura 21% IVA"}</span>
      </div>
    </div>

    <!-- Step 1 Pane: Negocio y Datos del Pagador -->
    <div id="checkout-step-1" class="wizard-pane">
      <!-- Mode Switcher Tabs -->
      <div class="checkout-mode-tabs" role="tablist">
        <button type="button" class="mode-tab active" id="tab-community-boost" role="tab" aria-selected="true">
          <span>{translations["honor.modal.tabCommunity"] || "❤️ Impulso Popular (Vecinos & Fans)"}</span>
        </button>
        <button type="button" class="mode-tab" id="tab-owner-bid" role="tab" aria-selected="false">
          <span>{translations["honor.modal.tabOwner"] || "👑 Puja Oficial de Titular (+1€)"}</span>
        </button>
      </div>

      <!-- Selected Business Display Card -->
      <div class="business-target-card" id="business-target-card">
        <div class="target-icon">🏢</div>
        <div class="target-details">
          <div class="target-title-row">
            <span class="target-label"
              >{translations["honor.modal.bizTarget"] || "Negocio a Impulsar / Posicionar:"}</span
            >
            <button type="button" id="btn-toggle-biz-select" class="btn-change-biz">
              {translations["honor.modal.chooseBiz"] || "✏️ Elegir / Cambiar"}
            </button>
          </div>
          <strong id="display-target-name" class="target-name">
            {
              preselectedServiceName ||
                translations["honor.modal.selectBizPlaceholder"] ||
                "Seleccionar Comercio de Mallorca..."
            }
          </strong>
        </div>
      </div>

      <!-- Verified Business Selector Dropdown -->
      <div
        class="form-group"
        id="biz-selector-group"
        style={preselectedServiceName ? "display: none;" : "display: block;"}
      >
        <label for="select-honor-business" class="form-label">
          {translations["honor.modal.selectBizPrompt"] || "Selecciona el Comercio Verificado (Zero Fake Data) *"}
        </label>
        <select id="select-honor-business" class="form-input form-select-biz">
          <option value=""
            >{
              translations["honor.modal.selectBizPlaceholder"] || "-- Elige el negocio que deseas aupar o posicionar --"
            }</option
          >
          {
            verifiedBusinesses.map((s) => (
              <option
                value={s.id}
                data-slug={s.slug}
                data-name={s.name}
                data-category={s.category}
                data-zone={s.zone}
                data-score={s.confidenceScore || 90}
                selected={s.id === preselectedServiceId}
              >
                {s.name} ({s.zone}) · {s.confidenceScore || 90}% {translations["honor.confidence"] || "Confianza"}
              </option>
            ))
          }
        </select>
        <span class="form-helper">
          {
            translations["honor.modal.selectBizHelper"] ||
              "Solo se admiten comercios de Mallorca con auditoría oficial y score ≥ 80% (Regla GR-11)."
          }
        </span>
      </div>

      <!-- User Information (Auto-Filled from AuthStore) -->
      <div class="form-row-grid">
        <div class="form-group">
          <label for="input-backer-name" class="form-label"
            >{translations["honor.modal.backerName"] || "Tu Nombre o Alias Público *"}</label
          >
          <input
            type="text"
            id="input-backer-name"
            class="form-input"
            placeholder={translations["honor.modal.backerNamePlaceholder"] || "Ej. Joan García (Vecino de Inca)"}
            required
          />
          <span id="err-backer-name" class="inline-error" style="display: none;">Por favor introduce tu nombre.</span>
        </div>
        <div class="form-group">
          <label for="input-backer-email" class="form-label"
            >{translations["honor.modal.backerEmail"] || "Email para Factura / Notificación *"}</label
          >
          <input type="email" id="input-backer-email" class="form-input" placeholder="tu-email@gmail.com" required />
          <span id="err-backer-email" class="inline-error" style="display: none;"
            >Introduce un email válido para la factura.</span
          >
        </div>
      </div>

      <!-- Dedication Message / Reason -->
      <div class="form-group">
        <label for="input-backer-message" class="form-label"
          >{translations["honor.modal.dedication"] || "Dedicatoria o Motivo del Apoyo (Opcional)"}</label
        >
        <input
          type="text"
          id="input-backer-message"
          class="form-input"
          placeholder={translations["honor.modal.dedicationPlaceholder"] ||
            "Ej. 'El mejor pan artesanal de Mallorca desde 1862'"}
          maxlength="140"
        />
      </div>

      <!-- B2B Fiscal Invoice Drawer (Empresa / Autónomo) -->
      <div class="b2b-invoice-toggle-box">
        <label class="b2b-checkbox-label">
          <input type="checkbox" id="checkbox-b2b-invoice" />
          <span
            >🏢 {
              translations["honor.modal.b2bCheckbox"] ||
                "Solicitar Factura Fiscal para Empresa / Autónomo (Deducción 21% IVA)"
            }</span
          >
        </label>

        <div id="b2b-fields-drawer" class="b2b-fields-drawer" style="display: none; margin-top: 10px;">
          <div class="form-row-grid">
            <div class="form-group">
              <label for="input-b2b-taxid" class="form-label"
                >{translations["honor.modal.b2bTaxId"] || "CIF / NIF de Empresa *"}</label
              >
              <input type="text" id="input-b2b-taxid" class="form-input" placeholder="Ej. B-07123456 o 43123456Z" />
              <span id="err-b2b-taxid" class="inline-error" style="display: none;">Introduce un CIF/NIF válido.</span>
            </div>
            <div class="form-group">
              <label for="input-b2b-legalname" class="form-label"
                >{translations["honor.modal.b2bLegalName"] || "Razón Social / Nombre Fiscal *"}</label
              >
              <input type="text" id="input-b2b-legalname" class="form-input" placeholder="Ej. Hostelería Balear S.L." />
              <span id="err-b2b-legalname" class="inline-error" style="display: none;">Introduce la razón social.</span>
            </div>
          </div>
          <div class="form-group">
            <label for="input-b2b-address" class="form-label"
              >{translations["honor.modal.b2bAddress"] || "Dirección Fiscal (Calle, CP, Municipio) *"}</label
            >
            <input
              type="text"
              id="input-b2b-address"
              class="form-input"
              placeholder="Ej. Carrer del Sindicat 12, 07002 Palma"
            />
          </div>
        </div>
      </div>

      <!-- Step 1 Action Button -->
      <div class="modal-actions-footer">
        <button type="button" id="btn-next-step-1" class="btn btn-primary btn-lg btn-full">
          <span>Continuar al Importe & Pago SSL →</span>
        </button>
      </div>
    </div>

    <!-- Step 2 Pane: Importe & Pasarela de Pago SSL -->
    <div id="checkout-step-2" class="wizard-pane" style="display: none;">
      <!-- Quick Review of Target Business -->
      <div class="selected-biz-summary">
        <span class="sum-icon">📍</span>
        <div class="sum-text">
          <span class="sum-label">Destinatario del patrocinio:</span>
          <strong id="summary-biz-name" class="sum-val">Comercio de Mallorca</strong>
        </div>
      </div>

      <!-- Amount Selector & Quick Chips -->
      <div class="amount-selection-box">
        <div class="amount-header">
          <label for="input-bid-amount" class="form-label"
            >{translations["honor.modal.amount"] || "Importe a Aportar (€) *"}</label
          >
          <span id="label-min-hint" class="min-hint"
            >{translations["honor.modal.minRequired"] || "Mínimo requerido:"} {minBidRequired.toFixed(2)}€</span
          >
        </div>

        <div class="amount-input-row">
          <span class="currency-symbol">€</span>
          <input
            type="number"
            id="input-bid-amount"
            class="form-input amount-input"
            step="1"
            min="1"
            value={minBidRequired}
            required
          />
        </div>

        <!-- Real-time Collision Status Chip -->
        <div id="collision-status-box" class="collision-chip collision-ok">
          <span class="collision-icon">✨</span>
          <span id="collision-msg-text"
            >{translations["honor.modal.collisionOk"] || "Importe disponible y conforme con la regla +1€"}</span
          >
        </div>

        <!-- Quick Amount Chips -->
        <div class="quick-chips-row">
          <button type="button" class="chip-btn" data-add="1">+1€</button>
          <button type="button" class="chip-btn" data-add="5">+5€</button>
          <button type="button" class="chip-btn" data-add="10">+10€</button>
          <button type="button" class="chip-btn" data-add="25">+25€</button>
          <button type="button" class="chip-btn" data-add="50">+50€</button>
        </div>
      </div>

      <!-- Live Fiscal Invoice Breakdown -->
      <div class="invoice-summary-box">
        <div class="summary-line">
          <span>{translations["honor.modal.subtotal"] || "Subtotal Base:"}</span>
          <span id="calc-subtotal">0.83€</span>
        </div>
        <div class="summary-line">
          <span>{translations["honor.modal.tax"] || "IVA Balear (21%):"}</span>
          <span id="calc-tax">0.17€</span>
        </div>
        <div class="summary-line summary-total">
          <strong>{translations["honor.modal.total"] || "Total a Pagar:"}</strong>
          <strong id="calc-total" class="total-amount">{minBidRequired.toFixed(2)}€</strong>
        </div>
        <div class="invoice-preview-chip">
          <span
            >🧾 {translations["honor.modal.invoiceNum"] || "Factura Oficial:"}
            <code id="calc-invoice-id">INV-HONOR-...</code></span
          >
        </div>
      </div>

      <!-- Payment Method Selector -->
      <div class="payment-methods-selector">
        <span class="form-label">{translations["honor.modal.paymentMethod"] || "Método de Pago Seguro:"}</span>
        <div class="payment-tabs-grid">
          <label class="pay-radio active">
            <input type="radio" name="paymentMethod" value="card" checked />
            <span class="pay-label">{translations["honor.modal.card"] || "💳 Tarjeta SSL"}</span>
          </label>
          <label class="pay-radio">
            <input type="radio" name="paymentMethod" value="bizum" />
            <span class="pay-label">{translations["honor.modal.bizum"] || "📱 Bizum"}</span>
          </label>
          <label class="pay-radio">
            <input type="radio" name="paymentMethod" value="apple_pay" />
            <span class="pay-label">{translations["honor.modal.applePay"] || "🍏 Apple / Google Pay"}</span>
          </label>
        </div>
      </div>

      <!-- Step 2 Actions Footer -->
      <div class="step-2-actions-row">
        <button type="button" id="btn-back-step-2" class="btn btn-secondary">
          <span>← Modificar Datos</span>
        </button>
        <button type="button" id="submit-honor-btn" class="btn btn-primary btn-lg pulse-hover btn-flex-grow">
          <span id="btn-submit-spinner" class="btn-spinner" style="display: none;">🔒</span>
          <span id="btn-submit-text">{translations["honor.modal.submitCommunity"] || "⚡ Confirmar y Pagar"}</span>
        </button>
      </div>
      <p class="security-guarantee-txt">
        {
          translations["honor.modal.security"] ||
            "🔒 Pago blindado anti-duplicados · Cifrado SSL 256 bits · Factura fiscal con 21% IVA deducible"
        }
      </p>
    </div>

    <!-- Hidden Form Fields for State & Idempotency -->
    <form id="honor-checkout-form" style="display: none;">
      <input type="hidden" id="input-checkout-mode" name="checkoutMode" value="community_boost" />
      <input type="hidden" id="input-service-id" name="serviceId" value={preselectedServiceId} />
      <input type="hidden" id="input-service-slug" name="serviceSlug" value={preselectedServiceSlug} />
      <input type="hidden" id="input-min-required" value={minBidRequired} />
      <input type="hidden" id="input-idempotency-key" name="idempotencyKey" value="" />
    </form>

    <!-- Step 3 Pane: Factura & Recibo de Éxito -->
    <div id="checkout-success-view" class="checkout-success-screen" style="display: none;">
      <div class="success-header-badge">
        <span class="success-big-icon">🎉</span>
        <h3 class="success-title">{translations["honor.modal.successTitle"] || "¡Aportación Confirmada con Éxito!"}</h3>
        <p class="success-subtitle">
          {
            translations["honor.modal.successSubtitle"] ||
              "Tu impulso ha sido validado e incorporado al Cuadro de Honor de Mallorca."
          }
        </p>
      </div>

      <div class="receipt-card">
        <div class="receipt-row">
          <span>{translations["honor.modal.receiptBiz"] || "Negocio Impulsado:"}</span>
          <strong id="receipt-biz-name" class="receipt-highlight">Forn Inca Tradició</strong>
        </div>
        <div class="receipt-row">
          <span>{translations["honor.modal.receiptAmount"] || "Importe Aportado:"}</span>
          <strong id="receipt-total-amount" class="receipt-price">25.00€</strong>
        </div>
        <div class="receipt-row receipt-sub">
          <span>{translations["honor.modal.receiptSubtotal"] || "Subtotal Base (sin IVA):"}</span>
          <span id="receipt-subtotal">20.66€</span>
        </div>
        <div class="receipt-row receipt-sub">
          <span>{translations["honor.modal.receiptTax"] || "IVA Balear (21%):"}</span>
          <span id="receipt-tax">4.34€</span>
        </div>
        <div id="receipt-b2b-row" class="receipt-row receipt-sub" style="display: none;">
          <span>{translations["honor.modal.b2bCustomer"] || "Facturado a Empresa:"}</span>
          <span id="receipt-b2b-info">Empresa S.L. (B-07123456)</span>
        </div>
        <div class="receipt-row receipt-sub">
          <span>{translations["honor.modal.receiptInvoice"] || "Nº Factura Fiscal:"}</span>
          <code id="receipt-invoice-id">INV-HONOR-2026-XXXX</code>
        </div>
        <div class="receipt-row receipt-sub">
          <span>{translations["honor.modal.receiptDateTime"] || "Fecha & Hora:"}</span>
          <span id="receipt-datetime">28/08/2026</span>
        </div>
      </div>

      <div class="success-actions-grid">
        <a id="receipt-link-honor" href={`${prefix}cuadro-de-honor`} class="btn btn-primary btn-full">
          {translations["honor.modal.viewHonor"] || "👑 Ver Puesto en Cuadro de Honor"}
        </a>
        <a id="receipt-link-profile" href={`${prefix}profile?tab=business`} class="btn btn-secondary btn-full">
          {translations["honor.modal.viewProfile"] || "👤 Ir a Mi Perfil & Negocios"}
        </a>
        <button type="button" id="receipt-print-btn" class="btn btn-secondary btn-full btn-sm">
          {translations["honor.modal.printInvoice"] || "🖨️ Imprimir Factura Fiscal / PDF"}
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  /* Base Backdrop */
  .honor-modal-backdrop {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(10px);
    z-index: 99999;
    align-items: center;
    justify-content: center;
    padding: var(--space-md, 1rem);
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .honor-modal-backdrop.is-active {
    display: flex;
    opacity: 1;
  }

  /* Modal Dialog Box — 100% Theme Reactive */
  .honor-modal-dialog {
    width: 100%;
    max-width: 580px;
    max-height: 90vh;
    overflow-y: auto;
    background: var(--color-surface);
    color: var(--color-text);
    border: 1px solid var(--color-surface-border);
    border-radius: var(--border-radius, 16px);
    box-shadow: var(--shadow-lg);
    padding: var(--space-xl, 1.75rem);
    display: flex;
    flex-direction: column;
    gap: var(--space-md, 1rem);
  }

  .modal-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-sm);
  }

  .live-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-primary);
    background: var(--color-primary-bg);
    border: 1px solid var(--color-primary-border);
    padding: 2px 10px;
    border-radius: var(--border-radius-full, 9999px);
    margin-bottom: 4px;
  }

  .pulse-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-primary);
    box-shadow: 0 0 8px var(--color-primary);
  }

  .modal-main-title {
    font-size: 1.3rem;
    font-weight: 800;
    margin: 0;
    color: var(--color-text);
    line-height: 1.25;
  }

  .modal-close-btn {
    background: var(--color-surface-hover);
    border: 1px solid var(--color-surface-border);
    color: var(--color-text);
    width: 34px;
    height: 34px;
    border-radius: 50%;
    font-size: 1rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background var(--transition-fast);
    flex-shrink: 0;
  }

  .modal-close-btn:hover {
    background: var(--color-surface-border);
  }

  /* Progress Steps Header */
  .checkout-steps-track {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 8px 10px;
    background: var(--color-bg);
    border: 1px solid var(--color-surface-border);
    border-radius: var(--border-radius-sm, 8px);
    font-size: 0.78rem;
    flex-wrap: wrap;
  }

  .step-badge {
    display: flex;
    align-items: center;
    gap: 5px;
    color: var(--color-text-muted);
    font-weight: 600;
    font-size: clamp(0.7rem, 2.5vw, 0.78rem);
  }

  .step-badge.active {
    color: var(--color-primary);
    font-weight: 700;
  }

  .step-badge.done {
    color: var(--color-success);
  }

  .step-badge .step-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--color-surface-border);
    color: var(--color-text-muted);
    font-size: 0.72rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  .step-badge.active .step-num {
    background: var(--color-primary);
    color: var(--color-btn-primary-text, #fff);
  }

  .step-badge.done .step-num {
    background: var(--color-success);
    color: #fff;
  }

  .step-arrow {
    color: var(--color-text-muted);
    font-size: 0.8rem;
  }

  /* Wizard Panes */
  .wizard-pane {
    display: flex;
    flex-direction: column;
    gap: var(--space-md, 1rem);
  }

  /* Mode Switcher */
  .checkout-mode-tabs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
    background: var(--color-bg);
    border: 1px solid var(--color-surface-border);
    padding: 4px;
    border-radius: var(--border-radius-sm, 8px);
  }

  .mode-tab {
    background: transparent;
    border: none;
    padding: 8px 6px;
    border-radius: var(--border-radius-sm, 6px);
    color: var(--color-text-light);
    font-weight: 600;
    font-size: 0.8rem;
    cursor: pointer;
    transition: all var(--transition-fast);
    text-align: center;
    white-space: normal;
    word-break: break-word;
    line-height: 1.3;
    min-height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mode-tab.active {
    background: var(--color-surface);
    color: var(--color-primary);
    font-weight: 700;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--color-surface-border);
  }

  /* Target Business Card */
  .business-target-card {
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--color-bg);
    border: 1px solid var(--color-surface-border);
    border-radius: var(--border-radius-sm, 8px);
    padding: 10px 14px;
  }

  .target-icon {
    font-size: 1.6rem;
    flex-shrink: 0;
  }

  .target-details {
    flex: 1;
    min-width: 0;
  }

  .target-title-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 6px;
    margin-bottom: 2px;
    flex-wrap: wrap;
  }

  .target-label {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-weight: 600;
  }

