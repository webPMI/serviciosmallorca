</style>

<script>
  import { authStore } from "../lib/authStore";

  function initHonorCheckoutClient() {
    const modal = document.getElementById("honor-checkout-modal");
    const closeBtn = document.getElementById("close-honor-modal-btn");

    // Panes
    const step1Pane = document.getElementById("checkout-step-1");
    const step2Pane = document.getElementById("checkout-step-2");
    const successPane = document.getElementById("checkout-success-view");

    // Indicators
    const stepInd1 = document.getElementById("step-indicator-1");
    const stepInd2 = document.getElementById("step-indicator-2");
    const stepInd3 = document.getElementById("step-indicator-3");

    // Navigation Buttons
    const btnNextStep1 = document.getElementById("btn-next-step-1");
    const btnBackStep2 = document.getElementById("btn-back-step-2");
    const submitBtn = document.getElementById("submit-honor-btn") as HTMLButtonElement | null;
    const btnSubmitSpinner = document.getElementById("btn-submit-spinner");
    const btnSubmitText = document.getElementById("btn-submit-text");

    // Step 1 Inputs
    const modeInput = document.getElementById("input-checkout-mode") as HTMLInputElement | null;
    const serviceIdInput = document.getElementById("input-service-id") as HTMLInputElement | null;
    const serviceSlugInput = document.getElementById("input-service-slug") as HTMLInputElement | null;
    const minRequiredInput = document.getElementById("input-min-required") as HTMLInputElement | null;
    const idempotencyKeyInput = document.getElementById("input-idempotency-key") as HTMLInputElement | null;
    const targetNameDisplay = document.getElementById("display-target-name");
    const summaryBizName = document.getElementById("summary-biz-name");

    const nameInput = document.getElementById("input-backer-name") as HTMLInputElement | null;
    const emailInput = document.getElementById("input-backer-email") as HTMLInputElement | null;
    const messageInput = document.getElementById("input-backer-message") as HTMLInputElement | null;

    // Error labels
    const errName = document.getElementById("err-backer-name");
    const errEmail = document.getElementById("err-backer-email");
    const errTaxId = document.getElementById("err-b2b-taxid");
    const errLegalName = document.getElementById("err-b2b-legalname");

    // B2B Inputs
    const checkboxB2B = document.getElementById("checkbox-b2b-invoice") as HTMLInputElement | null;
    const b2bDrawer = document.getElementById("b2b-fields-drawer");
    const b2bTaxIdInput = document.getElementById("input-b2b-taxid") as HTMLInputElement | null;
    const b2bLegalNameInput = document.getElementById("input-b2b-legalname") as HTMLInputElement | null;
    const b2bAddressInput = document.getElementById("input-b2b-address") as HTMLInputElement | null;

    // Step 2 Inputs & Calculations
    const amountInput = document.getElementById("input-bid-amount") as HTMLInputElement | null;
    const calcSubtotal = document.getElementById("calc-subtotal");
    const calcTax = document.getElementById("calc-tax");
    const calcTotal = document.getElementById("calc-total");
    const calcInvoiceId = document.getElementById("calc-invoice-id");
    const collisionStatusBox = document.getElementById("collision-status-box");
    const collisionMsgText = document.getElementById("collision-msg-text");

    const tabCommunity = document.getElementById("tab-community-boost");
    const tabOwner = document.getElementById("tab-owner-bid");
    const chipBtns = document.querySelectorAll(".chip-btn");
    const payRadios = document.querySelectorAll(".pay-radio");

    // Receipt Elements
    const receiptBizName = document.getElementById("receipt-biz-name");
    const receiptTotalAmount = document.getElementById("receipt-total-amount");
    const receiptSubtotal = document.getElementById("receipt-subtotal");
    const receiptTax = document.getElementById("receipt-tax");
    const receiptInvoiceId = document.getElementById("receipt-invoice-id");
    const receiptDatetime = document.getElementById("receipt-datetime");
    const receiptB2BRow = document.getElementById("receipt-b2b-row");
    const receiptB2BInfo = document.getElementById("receipt-b2b-info");
    const receiptPrintBtn = document.getElementById("receipt-print-btn");

    if (!modal || !amountInput) return;

    // Toggle B2B Drawer
    if (checkboxB2B && b2bDrawer) {
      checkboxB2B.addEventListener("change", () => {
        b2bDrawer.style.display = checkboxB2B.checked ? "block" : "none";
      });
    }

    // Step 1 Business Dropdown Toggle
    const selectHonorBiz = document.getElementById("select-honor-business") as HTMLSelectElement | null;
    const bizSelectorGroup = document.getElementById("biz-selector-group");
    const btnToggleBiz = document.getElementById("btn-toggle-biz-select");

    if (btnToggleBiz && bizSelectorGroup) {
      btnToggleBiz.addEventListener("click", () => {
        const isHidden = bizSelectorGroup.style.display === "none";
        bizSelectorGroup.style.display = isHidden ? "block" : "none";
      });
    }

    if (selectHonorBiz) {
      selectHonorBiz.addEventListener("change", () => {
        const opt = selectHonorBiz.options[selectHonorBiz.selectedIndex];
        if (opt && opt.value) {
          const bizId = opt.value;
          const bizSlug = opt.getAttribute("data-slug") || "";
          const bizName = opt.getAttribute("data-name") || opt.textContent?.split("·")[0].trim() || "";
          if (serviceIdInput) serviceIdInput.value = bizId;
          if (serviceSlugInput) serviceSlugInput.value = bizSlug;
          if (targetNameDisplay) targetNameDisplay.textContent = bizName;
          if (summaryBizName) summaryBizName.textContent = bizName;
          if (bizSelectorGroup) bizSelectorGroup.style.display = "none";
        }
      });
    }

    // Mode Toggle
    tabCommunity?.addEventListener("click", () => {
      tabCommunity.classList.add("active");
      tabCommunity.setAttribute("aria-selected", "true");
      tabOwner?.classList.remove("active");
      tabOwner?.setAttribute("aria-selected", "false");
      if (modeInput) modeInput.value = "community_boost";
      if (btnSubmitText) btnSubmitText.textContent = "⚡ Confirmar y Aupar al Podio";
    });

    tabOwner?.addEventListener("click", () => {
      tabOwner.classList.add("active");
      tabOwner.setAttribute("aria-selected", "true");
      tabCommunity?.classList.remove("active");
      tabCommunity?.setAttribute("aria-selected", "false");
      if (modeInput) modeInput.value = "owner_bid";
      if (btnSubmitText) btnSubmitText.textContent = "👑 Pujar Récord & Tomar el Puesto #1";
    });

    // Calculations in Step 2
    function recalculateInvoice() {
      const amount = Math.max(1, Number(amountInput?.value) || 1);
      const minRequired = Number(minRequiredInput?.value) || 1;
      const subtotal = Number((amount / 1.21).toFixed(2));
      const tax = Number((amount - subtotal).toFixed(2));

      if (calcSubtotal) calcSubtotal.textContent = `${subtotal.toFixed(2)}€`;
      if (calcTax) calcTax.textContent = `${tax.toFixed(2)}€`;
      if (calcTotal) calcTotal.textContent = `${amount.toFixed(2)}€`;
      if (calcInvoiceId) {
        calcInvoiceId.textContent = `INV-HONOR-${Date.now().toString(36).toUpperCase()}`;
      }

      if (amount < minRequired) {
        if (collisionStatusBox) {
          collisionStatusBox.className = "collision-chip collision-warning";
        }
        if (collisionMsgText) {
          collisionMsgText.textContent = `⚠️ Importe inferior al mínimo requerido (${minRequired.toFixed(2)}€). Debe superar el récord en +1€`;
        }
        if (submitBtn) submitBtn.disabled = true;
      } else {
        if (collisionStatusBox) {
          collisionStatusBox.className = "collision-chip collision-ok";
        }
        if (collisionMsgText) {
          collisionMsgText.textContent = "✨ Importe disponible y conforme con la regla +1€";
        }
        if (submitBtn) submitBtn.disabled = false;
      }
    }

    amountInput.addEventListener("input", recalculateInvoice);

    // Quick Chips
    chipBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const add = Number(btn.getAttribute("data-add") || 1);
        const current = Number(amountInput.value) || 1;
        amountInput.value = (current + add).toString();
        recalculateInvoice();
      });
    });

    // Payment Radio Selector
    payRadios.forEach((radio) => {
      radio.addEventListener("click", () => {
        payRadios.forEach((r) => r.classList.remove("active"));
        radio.classList.add("active");
      });
    });

    // Step 1 -> Step 2 Validation & Navigation
    btnNextStep1?.addEventListener("click", () => {
      let isValid = true;

      // Validate Business selected
      if (!serviceIdInput?.value && selectHonorBiz && !selectHonorBiz.value) {
        if (bizSelectorGroup) bizSelectorGroup.style.display = "block";
        selectHonorBiz?.focus();
        isValid = false;
      }

      // Validate Name
      const nameVal = nameInput?.value.trim() || "";
      if (nameVal.length < 2) {
        if (errName) errName.style.display = "block";
        nameInput?.focus();
        isValid = false;
      } else if (errName) {
        errName.style.display = "none";
      }

      // Validate Email
      const emailVal = emailInput?.value.trim() || "";
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(emailVal)) {
        if (errEmail) errEmail.style.display = "block";
        if (isValid) emailInput?.focus();
        isValid = false;
      } else if (errEmail) {
        errEmail.style.display = "none";
      }

      // Validate B2B if checked
      if (checkboxB2B?.checked) {
        const taxId = b2bTaxIdInput?.value.trim() || "";
        const legalName = b2bLegalNameInput?.value.trim() || "";
        if (taxId.length < 5) {
          if (errTaxId) errTaxId.style.display = "block";
          if (isValid) b2bTaxIdInput?.focus();
          isValid = false;
        } else if (errTaxId) {
          errTaxId.style.display = "none";
        }

        if (legalName.length < 2) {
          if (errLegalName) errLegalName.style.display = "block";
          if (isValid) b2bLegalNameInput?.focus();
          isValid = false;
        } else if (errLegalName) {
          errLegalName.style.display = "none";
        }
      }

      if (!isValid) return;

      // Go to Step 2
      if (step1Pane) step1Pane.style.display = "none";
      if (step2Pane) step2Pane.style.display = "flex";
      if (summaryBizName && targetNameDisplay) {
        summaryBizName.textContent = targetNameDisplay.textContent || "Comercio de Mallorca";
      }

      stepInd1?.classList.remove("active");
      stepInd1?.classList.add("done");
      stepInd2?.classList.add("active");

      recalculateInvoice();
    });

    // Step 2 -> Step 1 (Back Button)
    btnBackStep2?.addEventListener("click", () => {
      if (step2Pane) step2Pane.style.display = "none";
      if (step1Pane) step1Pane.style.display = "flex";

      stepInd2?.classList.remove("active");
      stepInd1?.classList.remove("done");
      stepInd1?.classList.add("active");
    });

    // Step 2 -> Confirm & Process Payment
    submitBtn?.addEventListener("click", () => {
      const amount = Number(amountInput.value) || 1;
      const minRequired = Number(minRequiredInput?.value) || 1;

      if (amount < minRequired) {
        alert(`El importe debe ser de al menos ${minRequired.toFixed(2)}€.`);
        return;
      }

      if (submitBtn) submitBtn.disabled = true;
      if (btnSubmitSpinner) btnSubmitSpinner.style.display = "inline-block";
      if (btnSubmitText) btnSubmitText.textContent = "🔒 Conectando con pasarela SSL...";

      const backerName = nameInput?.value.trim() || "Vecino de Mallorca";
      const backerEmail = emailInput?.value.trim() || "";
      const slug = serviceSlugInput?.value || "servicio";
      const bizName = targetNameDisplay?.textContent?.trim() || "Comercio de Mallorca";
      const mode = modeInput?.value || "community_boost";
      const idempotencyKey = idempotencyKeyInput?.value || `idemp_${Date.now()}`;
      const invoiceId = `INV-HONOR-${new Date().getFullYear()}-${Date.now().toString(36).toUpperCase()}`;
      const subtotalVal = Number((amount / 1.21).toFixed(2));
      const taxVal = Number((amount - subtotalVal).toFixed(2));

      // Persist local records
      try {
        const favs = JSON.parse(localStorage.getItem("user_favorites") || "[]");
        if (!favs.includes(slug)) {
          favs.push(slug);
          localStorage.setItem("user_favorites", JSON.stringify(favs));
        }

        const isB2B = Boolean(checkboxB2B?.checked);
        const b2bTaxId = b2bTaxIdInput?.value.trim() || "";
        const b2bLegalName = b2bLegalNameInput?.value.trim() || "";
        const b2bAddress = b2bAddressInput?.value.trim() || "";

        const transactions = JSON.parse(localStorage.getItem("user_honor_transactions") || "[]");
        transactions.unshift({
          invoiceId,
          slug,
          serviceName: bizName,
          amount,
          subtotal: subtotalVal,
          tax: taxVal,
          backerName,
          backerEmail,
          mode,
          idempotencyKey,
          isB2B,
          b2bTaxId,
          b2bLegalName,
          b2bAddress,
          at: new Date().toISOString(),
        });
        localStorage.setItem("user_honor_transactions", JSON.stringify(transactions));
      } catch (err) {
        console.warn("Storage warning:", err);
      }

      // Finish 3DS and advance to Step 3 (Receipt)
      setTimeout(() => {
        if (step2Pane) step2Pane.style.display = "none";
        if (successPane) {
          successPane.style.display = "flex";
          if (receiptBizName) receiptBizName.textContent = bizName;
          if (receiptTotalAmount) receiptTotalAmount.textContent = `${amount.toFixed(2)}€`;
          if (receiptSubtotal) receiptSubtotal.textContent = `${subtotalVal.toFixed(2)}€`;
          if (receiptTax) receiptTax.textContent = `${taxVal.toFixed(2)}€`;
          if (receiptInvoiceId) receiptInvoiceId.textContent = invoiceId;
          if (receiptDatetime) receiptDatetime.textContent = new Date().toLocaleString("es-ES");

          if (checkboxB2B?.checked && receiptB2BRow && receiptB2BInfo) {
            receiptB2BRow.style.display = "flex";
            const name = b2bLegalNameInput?.value.trim() || "Empresa";
            const cif = b2bTaxIdInput?.value.trim() || "NIF";
            receiptB2BInfo.textContent = `${name} (${cif})`;
          } else if (receiptB2BRow) {
            receiptB2BRow.style.display = "none";
          }
        }

        stepInd2?.classList.remove("active");
        stepInd2?.classList.add("done");
        stepInd3?.classList.add("done");
      }, 900);
    });

    if (receiptPrintBtn) {
      receiptPrintBtn.addEventListener("click", () => {
        window.print();
      });
    }

    // Modal Triggers & Event Listeners
    window.addEventListener("open-honor-checkout", (e: any) => {
      const data = e.detail || {};
      if (data.serviceId && serviceIdInput) serviceIdInput.value = data.serviceId;
      if (data.serviceSlug && serviceSlugInput) serviceSlugInput.value = data.serviceSlug;
      if (data.serviceName && targetNameDisplay) targetNameDisplay.textContent = data.serviceName;

      if (selectHonorBiz && data.serviceId) {
        selectHonorBiz.value = data.serviceId;
        if (bizSelectorGroup) bizSelectorGroup.style.display = "none";
      } else if (bizSelectorGroup && !data.serviceId && !data.serviceSlug) {
        bizSelectorGroup.style.display = "block";
      }

      if (data.mode === "owner_bid") {
        tabOwner?.click();
      } else if (data.mode === "community_boost") {
        tabCommunity?.click();
      }

      if (data.minBid && amountInput) {
        amountInput.value = data.minBid.toString();
        if (minRequiredInput) minRequiredInput.value = data.minBid.toString();
      }

      // Idempotency Key
      const randomKey = `idemp_${data.serviceId || "serv"}_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`;
      if (idempotencyKeyInput) idempotencyKeyInput.value = randomKey;

      // Auto-fill from AuthStore
      const currentUser = authStore.getState().user;
      if (currentUser) {
        if (nameInput && !nameInput.value) {
          nameInput.value = currentUser.displayName || currentUser.email?.split("@")[0] || "Vecino Autenticado";
        }
        if (emailInput && !emailInput.value) {
          emailInput.value = currentUser.email || "";
        }
      }

      // Reset Step Panes to Step 1
      if (step1Pane) step1Pane.style.display = "flex";
      if (step2Pane) step2Pane.style.display = "none";
      if (successPane) successPane.style.display = "none";

      stepInd1?.classList.add("active");
      stepInd1?.classList.remove("done");
      stepInd2?.classList.remove("active", "done");
      stepInd3?.classList.remove("active", "done");

      if (submitBtn) submitBtn.disabled = false;
      if (btnSubmitSpinner) btnSubmitSpinner.style.display = "none";

      recalculateInvoice();
      modal.classList.add("is-active");
      modal.setAttribute("aria-hidden", "false");
    });

    function closeModal() {
      modal?.classList.remove("is-active");
      modal?.setAttribute("aria-hidden", "true");
    }

    closeBtn?.addEventListener("click", closeModal);
    modal.addEventListener("click", (e) => {
      if (e.target === modal) closeModal();
    });
  }

  document.addEventListener("DOMContentLoaded", initHonorCheckoutClient);
</script>
