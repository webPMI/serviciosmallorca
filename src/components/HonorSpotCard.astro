---
import type { HonorSpotEntry } from "../lib/honorBoardEngine";
import { calculateNextBidPrice } from "../lib/honorBoardEngine";

interface Props {
  spot: HonorSpotEntry;
  catId: string;
  catTitle: string;
  prefix: string;
  translations: Record<string, string>;
  locale: string;
}

const { spot, catId, catTitle, prefix, translations, locale } = Astro.props;

const tierClass =
  spot.position === 1
    ? "spot-diamond"
    : spot.position === 2
      ? "spot-gold"
      : spot.position === 3
        ? "spot-silver"
        : "spot-bronze";

const rankLabel =
  spot.position === 1
    ? translations["honor.diamond"] || "💎 #1 Diamante"
    : spot.position === 2
      ? translations["honor.gold"] || "🥇 #2 Oro"
      : spot.position === 3
        ? translations["honor.silver"] || "🥈 #3 Plata"
        : (translations["honor.bronze"] || "🥉 #{pos} Cuadro de Honor").replace("{pos}", String(spot.position));

const nextPrice = calculateNextBidPrice(spot.currentBidEuros);
---

<article class={`spot-card card ${tierClass}`}>
  <div class="spot-rank-badge">
    {rankLabel}
  </div>

  <div class="spot-card-body">
    {
      spot.avatarImage && (
        <div class="spot-avatar">
          <img src={spot.avatarImage} alt={spot.serviceName} loading="lazy" />
        </div>
      )
    }

    <div class="spot-details">
      <h4 class="spot-business-name">
        <a href={`${prefix}servicios/${spot.serviceSlug}`}>{spot.serviceName}</a>
      </h4>
      <p class="spot-honor-title">"{spot.honorTitle[locale as "es" | "en" | "ca" | "de"] || spot.honorTitle.es}"</p>

      <div class="spot-meta">
        <span class="meta-tag">📍 {spot.zone}</span>
        <span class="meta-tag trust-tag">
          🛡️ {spot.confidenceScore}% {translations["honor.confidence"] || "Confianza"}
        </span>
        <span class="meta-tag bid-tag">💰 {spot.currentBidEuros.toFixed(2)}€</span>
      </div>

      {
        spot.sponsorMessage && (
          <blockquote class="spot-quote">
            "{spot.sponsorMessage}"
            <cite>
              — {translations["honor.sponsoredBy"] || "Patrocinado por"} {spot.sponsorName}
            </cite>
          </blockquote>
        )
      }
    </div>
  </div>

  <div class="spot-card-footer">
    <a href={`${prefix}servicios/${spot.serviceSlug}`} class="btn btn-secondary btn-sm">
      {translations["honor.viewDetails"] || "Ver Ficha Completa"}
    </a>
    <button
      class="btn btn-primary btn-sm open-nominate-modal"
      data-cat-id={catId}
      data-cat-title={catTitle}
      data-service-id={spot.serviceId}
      data-service-slug={spot.serviceSlug}
      data-service-name={spot.serviceName}
      data-next-price={nextPrice}
      data-mode="owner_bid"
    >
      {(translations["honor.outbid"] || "Superar con {price}€").replace("{price}", nextPrice.toFixed(2))}
    </button>
  </div>
</article>

<style>
  .spot-card {
    padding: var(--space-lg);
    border-radius: var(--border-radius-lg);
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition:
      transform var(--transition-smooth),
      box-shadow var(--transition-smooth),
      border-color var(--transition-smooth);
    border: 1px solid var(--color-surface-border);
    width: 100%;
    box-sizing: border-box;
    min-width: 0;
    overflow: hidden;
    background: var(--color-surface);
    backdrop-filter: blur(8px);
  }

  .spot-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 32px rgba(0, 0, 0, 0.12);
  }

  .spot-diamond {
    border: 2px solid rgba(0, 210, 255, 0.6);
    background: radial-gradient(circle at top right, rgba(0, 210, 255, 0.15) 0%, var(--color-surface) 75%);
    box-shadow: 0 4px 20px rgba(0, 210, 255, 0.15);
  }

  .spot-diamond:hover {
    box-shadow: 0 8px 30px rgba(0, 210, 255, 0.3);
    border-color: #00d2ff;
  }

  .spot-gold {
    border: 2px solid rgba(255, 215, 0, 0.6);
    background: radial-gradient(circle at top right, rgba(255, 215, 0, 0.15) 0%, var(--color-surface) 75%);
    box-shadow: 0 4px 20px rgba(255, 215, 0, 0.15);
  }

  .spot-gold:hover {
    box-shadow: 0 8px 30px rgba(255, 215, 0, 0.3);
    border-color: #ffd700;
  }

  .spot-silver {
    border: 2px solid rgba(192, 192, 192, 0.6);
    background: radial-gradient(circle at top right, rgba(192, 192, 192, 0.12) 0%, var(--color-surface) 75%);
    box-shadow: 0 4px 15px rgba(192, 192, 192, 0.1);
  }

  .spot-bronze {
    border: 2px solid rgba(205, 127, 50, 0.5);
    background: radial-gradient(circle at top right, rgba(205, 127, 50, 0.1) 0%, var(--color-surface) 75%);
  }

  .spot-rank-badge {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-sm);
    font-weight: 800;
    font-size: 0.75rem;
    padding: 4px 10px;
    border-radius: var(--border-radius-full);
    background: rgba(15, 23, 42, 0.85);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(6px);
    z-index: 1;
    letter-spacing: 0.02em;
  }

  .spot-avatar img {
    width: 100%;
    height: 140px;
    object-fit: cover;
    border-radius: var(--border-radius-sm);
    margin-bottom: var(--space-md);
  }

  .spot-business-name {
    font-size: 1.15rem;
    font-weight: 800;
    margin-bottom: var(--space-3xs);
    line-height: 1.3;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  .spot-business-name a {
    color: inherit;
    text-decoration: none;
  }

  .spot-business-name a:hover {
    color: var(--color-primary);
  }

  .spot-honor-title {
    font-style: italic;
    color: var(--color-text-light);
    font-size: 0.85rem;
    margin-bottom: var(--space-sm);
    word-break: break-word;
    overflow-wrap: break-word;
  }

  .spot-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: var(--space-md);
  }

  .meta-tag {
    font-size: 0.72rem;
    padding: 2px 8px;
    border-radius: var(--border-radius-sm);
    background: var(--color-surface-border);
    font-weight: 600;
    word-break: break-word;
  }

  .trust-tag {
    background: rgba(46, 204, 113, 0.15);
    color: #2ecc71;
  }

  .bid-tag {
    background: rgba(255, 215, 0, 0.15);
    color: var(--color-accent, #ffd700);
    font-weight: 700;
  }

  .spot-quote {
    font-size: 0.8rem;
    border-left: 2px solid var(--color-primary);
    padding-left: var(--space-sm);
    margin-bottom: var(--space-md);
    color: var(--color-text-light);
    line-height: 1.4;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  .spot-quote cite {
    display: block;
    font-size: 0.72rem;
    margin-top: 4px;
    font-weight: 700;
    color: var(--color-text);
  }

  .spot-card-footer {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: space-between;
    margin-top: var(--space-md);
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-surface-border);
  }

  .spot-card-footer .btn {
    flex: 1 1 120px;
    text-align: center;
    justify-content: center;
    font-size: 0.8rem;
    padding: 0.45rem 0.75rem;
    white-space: normal;
    word-break: break-word;
    line-height: 1.25;
  }

  @media (max-width: 480px) {
    .spot-card {
      padding: var(--space-md);
    }
    .spot-card-footer {
      flex-direction: column;
      gap: var(--space-xs);
    }
    .spot-card-footer .btn {
      width: 100%;
      min-width: 100%;
      padding: 0.6rem 0.8rem;
    }
  }
</style>
