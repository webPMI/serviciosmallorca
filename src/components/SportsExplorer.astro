  @media (max-width: 640px) {
    .sports-header-bar {
      flex-direction: column;
      align-items: flex-start;
    }

    .sports-mode-tabs {
      width: 100%;
      justify-content: space-between;
    }

    .mode-tab {
      flex: 1;
      justify-content: center;
      padding: 0.4rem 0.5rem;
      font-size: 0.775rem;
    }

    .filter-secondary-row {
      flex-direction: column;
    }

    .zone-selector-wrap {
      width: 100%;
    }
  }
</style>

<script>
  function initSportsExplorer() {
    const root = document.getElementById("sports-explorer");
    if (!root) return;

    const modeTabs = root.querySelectorAll<HTMLButtonElement>(".mode-tab");
    const chipBtns = root.querySelectorAll<HTMLButtonElement>(".chip-btn");
    const zoneSelect = root.querySelector<HTMLSelectElement>("#zone-select");
    const togglePills = root.querySelectorAll<HTMLButtonElement>(".toggle-pill");
    const mapSection = root.querySelector<HTMLElement>("#sports-map-view");
    const cards = root.querySelectorAll<HTMLElement>(".sports-poi-card");

    let currentActivity = "all";
    let currentZone = zoneSelect?.value || "all";
    const activeAmenities: Record<string, boolean> = {
      tieneSombra: false,
      fuenteAgua: false,
      accesiblePmr: false,
      petFriendly: false,
      gratis: false,
    };

    function filterCards() {
      cards.forEach((card) => {
        const activities: string[] = JSON.parse(card.dataset.activities || "[]");
        const zone = card.dataset.zone || "";
        const sombra = card.dataset.amenitySombra === "true";
        const agua = card.dataset.amenityAgua === "true";
        const pmr = card.dataset.amenityPmr === "true";
        const pet = card.dataset.amenityPet === "true";
        const gratis = card.dataset.amenityGratis === "true";

        const matchActivity = currentActivity === "all" || activities.includes(currentActivity);
        const matchZone = currentZone === "all" || zone === currentZone;
        const matchSombra = !activeAmenities.tieneSombra || sombra;
        const matchAgua = !activeAmenities.fuenteAgua || agua;
        const matchPmr = !activeAmenities.accesiblePmr || pmr;
        const matchPet = !activeAmenities.petFriendly || pet;
        const matchGratis = !activeAmenities.gratis || gratis;

        if (matchActivity && matchZone && matchSombra && matchAgua && matchPmr && matchPet && matchGratis) {
          card.style.display = "flex";
        } else {
          card.style.display = "none";
        }
      });
    }

    // 1. Mode Switching
    modeTabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        modeTabs.forEach((t) => {
          t.classList.remove("active");
          t.setAttribute("aria-selected", "false");
        });
        tab.classList.add("active");
        tab.setAttribute("aria-selected", "true");

        const mode = tab.dataset.mode;
        if (mode === "explorar") {
          if (mapSection) mapSection.style.display = "block";
        } else if (mode === "recomendados") {
          if (mapSection) mapSection.style.display = "none";
          // Activar actividades recomendadas
          currentActivity = "padel";
          chipBtns.forEach((c) => c.classList.toggle("active", c.dataset.activity === "padel"));
          filterCards();
        } else {
          if (mapSection) mapSection.style.display = "none";
        }
      });
    });

    // 2. Activity Chips
    chipBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        chipBtns.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        currentActivity = btn.dataset.activity || "all";
        filterCards();
      });
    });

    // 3. Zone Select
    zoneSelect?.addEventListener("change", () => {
      currentZone = zoneSelect.value;
      filterCards();
    });

    // 4. Amenity Toggles
    togglePills.forEach((pill) => {
      pill.addEventListener("click", () => {
        const key = pill.dataset.amenity;
        if (!key) return;
        activeAmenities[key] = !activeAmenities[key];
        pill.classList.toggle("active", activeAmenities[key]);
        pill.setAttribute("aria-pressed", String(activeAmenities[key]));
        filterCards();
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initSportsExplorer);
  } else {
    initSportsExplorer();
  }
</script>
