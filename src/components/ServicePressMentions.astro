---
import type { ServiceItem } from "../data/services/types";
import type { Locale } from "../i18n";

interface Props {
  service: ServiceItem;
  translations?: Record<string, string>;
  locale?: Locale;
}

const { service } = Astro.props;
const hasMentions = service.pressMentions && service.pressMentions.length > 0;
---

{
  hasMentions && (
    <section class="card section-box press-box">
      <h2 class="box-title">📰 En los Medios & Prensa Balear</h2>
      <div class="press-list">
        {service.pressMentions!.map((press) => (
          <div class="press-item">
            <div class="press-header-row">
              <span class="press-source-tag">🗞️ {press.mediaName}</span>
              {press.date && <span class="press-date">{press.date}</span>}
            </div>
            <h4 class="press-title">
              {press.url ? (
                <a href={press.url} target="_blank" rel="noopener noreferrer">
                  "{press.title}" ↗
                </a>
              ) : (
                `"${press.title}"`
              )}
            </h4>
            {press.quote && <p class="press-quote">«{press.quote}»</p>}
          </div>
        ))}
      </div>
    </section>
  )
}
