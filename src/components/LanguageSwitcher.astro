---
interface Props {
  currentLocale: "es" | "en" | "ca" | "de";
  translations: {
    "nav.es": string;
    "nav.en": string;
    "nav.ca": string;
    "nav.de"?: string;
  };
  getLangPrefix: (locale: "es" | "en" | "ca" | "de") => string;
  currentPath?: string;
}

const { currentLocale, translations, getLangPrefix, currentPath = "" } = Astro.props;

// Cleanly calculate path suffix (e.g. "servicios", "login", or "")
const rawPath = currentPath.replace(/^\/(es|en|ca|de)(\/|$)/, "");
const cleanPath = rawPath.replace(/^\/+/, "");

const currentLabel =
  currentLocale === "es"
    ? translations["nav.es"] || "ES"
    : currentLocale === "en"
      ? translations["nav.en"] || "EN"
      : currentLocale === "ca"
        ? translations["nav.ca"] || "CA"
        : translations["nav.de"] || "DE";

const localesList = [
  { code: "es" as const, label: translations["nav.es"] || "ES", name: "Castellano", flag: "🇪🇸" },
  { code: "en" as const, label: translations["nav.en"] || "EN", name: "English", flag: "🇬🇧" },
  { code: "ca" as const, label: translations["nav.ca"] || "CA", name: "Català", flag: "🏴" },
  { code: "de" as const, label: translations["nav.de"] || "DE", name: "Deutsch", flag: "🇩🇪" },
];
---

<div class="language-dropdown-wrapper">
  <!-- Desktop & Tablet Compact Dropdown -->
  <details class="lang-details" id="lang-dropdown-details">
    <summary class="lang-summary" aria-label="Seleccionar idioma">
      <span class="lang-icon" aria-hidden="true">🌐</span>
      <span class="lang-current">{currentLabel}</span>
      <span class="lang-arrow" aria-hidden="true">▾</span>
    </summary>
    <div class="lang-menu" role="menu">
      {
        localesList.map((loc) => (
          <a
            href={`${getLangPrefix(loc.code)}${cleanPath}`}
            data-locale={loc.code}
            class:list={["lang-option", { active: currentLocale === loc.code }]}
            role="menuitem"
          >
            <span class="lang-flag">{loc.flag}</span>
            <span class="lang-name">{loc.name}</span>
            <span class="lang-code">({loc.label})</span>
          </a>
        ))
      }
    </div>
  </details>

  <!-- Mobile Segmented Bar (rendered inside drawer) -->
  <div class="lang-mobile-bar" aria-label="Idiomas disponibles">
    {
      localesList.map((loc) => (
        <a
          href={`${getLangPrefix(loc.code)}${cleanPath}`}
          data-locale={loc.code}
          class:list={["lang-mobile-btn", { active: currentLocale === loc.code }]}
          aria-label={loc.name}
        >
          <span class="lang-flag">{loc.flag}</span>
          <span>{loc.label}</span>
        </a>
      ))
    }
  </div>
</div>

<style>
  .language-dropdown-wrapper {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  /* Desktop Details Dropdown */
  .lang-details {
    position: relative;
    display: inline-block;
  }

  .lang-summary {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 0.32rem 0.55rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-surface-border);
    border-radius: var(--border-radius-full);
    font-size: var(--font-size-xs);
    font-weight: 700;
    color: var(--color-text);
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition: all var(--transition-fast);
  }

  .lang-summary::-webkit-details-marker {
    display: none;
  }

  .lang-summary:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
    background-color: var(--color-surface-hover);
  }

  .lang-arrow {
    font-size: 0.65em;
    opacity: 0.7;
    transition: transform var(--transition-fast);
  }

  .lang-details[open] .lang-arrow {
    transform: rotate(180deg);
  }

  .lang-menu {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    min-width: 150px;
    background-color: var(--color-surface);
    border: 1px solid var(--color-surface-border);
    border-radius: var(--border-radius-md);
    box-shadow: var(--shadow-lg);
    padding: 4px;
    z-index: 10002;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .lang-option {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0.4rem 0.6rem;
    font-size: var(--font-size-xs);
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
    border-radius: var(--border-radius-sm);
    transition: all var(--transition-fast);
    white-space: nowrap;
  }

  .lang-option:hover {
    background-color: var(--color-surface-hover);
    color: var(--color-primary);
  }

  .lang-option.active {
    background-color: var(--color-primary-bg);
    color: var(--color-primary);
    font-weight: 800;
  }

  .lang-code {
    font-size: 0.75em;
    opacity: 0.6;
    margin-left: auto;
  }

  /* Mobile Bar (hidden on desktop) */
  .lang-mobile-bar {
    display: none;
    width: 100%;
    grid-template-columns: repeat(4, 1fr);
    gap: 4px;
    background-color: var(--color-surface-hover);
    padding: 4px;
    border-radius: var(--border-radius-md);
    border: 1px solid var(--color-surface-border);
  }

  .lang-mobile-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    padding: 0.45rem 0.2rem;
    font-size: var(--font-size-xs);
    font-weight: 700;
    color: var(--color-text-light);
    text-decoration: none;
    border-radius: var(--border-radius-sm);
    transition: all var(--transition-fast);
  }

  .lang-mobile-btn.active {
    background-color: var(--color-surface);
    color: var(--color-primary);
    box-shadow: var(--shadow-sm);
  }

  @media (max-width: 1024px) {
    .language-dropdown-wrapper {
      width: 100%;
    }
    .lang-details {
      display: none;
    }
    .lang-mobile-bar {
      display: grid;
    }
  }
</style>

<script>
  function setupLanguageSwitcher() {
    // Cerrar el details al hacer clic fuera
    document.addEventListener("click", (e) => {
      const details = document.getElementById("lang-dropdown-details") as HTMLDetailsElement | null;
      if (details && details.open && !details.contains(e.target as Node)) {
        details.open = false;
      }
    });

    // Guardar cookie al cambiar idioma
    document.querySelectorAll(".lang-option, .lang-mobile-btn").forEach((link) => {
      link.addEventListener("click", (e) => {
        const target = e.currentTarget as HTMLAnchorElement;
        const href = target.getAttribute("href") || "";
        const match = href.match(/^\/(es|en|ca|de)(\/|$)/);
        if (match && match[1]) {
          const selectedLocale = match[1];
          document.cookie = `locale=${selectedLocale}; path=/; max-age=31536000; SameSite=Lax`;
          try {
            localStorage.setItem("preferred_locale", selectedLocale);
          } catch {
            // Safe fallback
          }
        }
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupLanguageSwitcher);
  } else {
    setupLanguageSwitcher();
  }
  document.addEventListener("astro:page-load", setupLanguageSwitcher);
</script>
