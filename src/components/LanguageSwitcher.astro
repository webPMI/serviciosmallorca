---
interface Props {
  currentLocale: "es" | "en" | "ca" | "de";
  translations: {
    "nav.es": string;
    "nav.en": string;
    "nav.ca": string;
    "nav.de"?: string;
  };
  getLangPrefix: (locale: "es" | "en" | "ca" | "de") => string;
  currentPath?: string;
}

const { currentLocale, translations, getLangPrefix, currentPath = "" } = Astro.props;

// Cleanly calculate path suffix (e.g. "login", "profile", or "")
const rawPath = currentPath.replace(/^\/(es|en|ca|de)(\/|$)/, "");
const cleanPath = rawPath.replace(/^\/+/, "");
---

<div class="language-switcher">
  <span class="language-label">Idioma:</span>
  <nav class="language-nav" aria-label="Cambiar idioma">
    <a href={`${getLangPrefix("es")}${cleanPath}`} class:list={["language-link", { active: currentLocale === "es" }]}>
      {translations["nav.es"]}
    </a>
    <span class="language-separator">|</span>
    <a href={`${getLangPrefix("en")}${cleanPath}`} class:list={["language-link", { active: currentLocale === "en" }]}>
      {translations["nav.en"]}
    </a>
    <span class="language-separator">|</span>
    <a href={`${getLangPrefix("ca")}${cleanPath}`} class:list={["language-link", { active: currentLocale === "ca" }]}>
      {translations["nav.ca"]}
    </a>
    <span class="language-separator">|</span>
    <a href={`${getLangPrefix("de")}${cleanPath}`} class:list={["language-link", { active: currentLocale === "de" }]}>
      {translations["nav.de"] || "DE"}
    </a>
  </nav>
</div>

<style>
  .language-switcher {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.6rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-surface-border);
    border-radius: var(--border-radius-full);
    box-shadow: var(--shadow-sm);
    max-width: 100%;
    flex-shrink: 0;
  }

  .language-label {
    font-weight: 600;
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
  }

  .language-nav {
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
    flex-wrap: nowrap;
  }

  .language-link {
    color: var(--color-text-light);
    text-decoration: none;
    font-weight: 700;
    font-size: var(--font-size-xs);
    padding: 0.2rem 0.4rem;
    border-radius: var(--border-radius-full);
    transition: all var(--transition-fast);
    display: inline-block;
    line-height: 1.2;
  }

  .language-link:hover {
    color: var(--color-primary);
    background-color: var(--color-surface-hover);
  }

  .language-link.active {
    color: var(--color-primary);
    background-color: var(--color-surface);
    box-shadow: var(--shadow-sm);
    pointer-events: none;
  }

  .language-separator {
    color: var(--color-surface-border);
    user-select: none;
    font-size: var(--font-size-xs);
    opacity: 0.7;
  }

  @media (max-width: 640px) {
    .language-label {
      display: none;
    }

    .language-switcher {
      padding: 0.2rem 0.4rem;
      gap: 0.15rem;
    }

    .language-link {
      padding: 0.15rem 0.3rem;
      font-size: 0.68rem;
    }
  }
</style>

<script>
  function setupLanguageCookie() {
    document.querySelectorAll(".language-link").forEach((link) => {
      link.addEventListener("click", (e) => {
        const target = e.currentTarget as HTMLAnchorElement;
        const href = target.getAttribute("href") || "";
        const match = href.match(/^\/(es|en|ca|de)(\/|$)/);
        if (match && match[1]) {
          const selectedLocale = match[1];
          document.cookie = `locale=${selectedLocale}; path=/; max-age=31536000; SameSite=Lax`;
          try {
            localStorage.setItem("preferred_locale", selectedLocale);
          } catch {
            // Ignore localStorage quota errors
          }
        }
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupLanguageCookie);
  } else {
    setupLanguageCookie();
  }
  document.addEventListener("astro:page-load", setupLanguageCookie);
</script>
