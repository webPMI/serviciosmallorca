---
interface Props {
  translations: Record<string, string>;
}

const { translations } = Astro.props;
---

<div class="user-dashboard-container">
  <!-- Quick Actions Banner -->
  <div class="card card-glass quick-actions-banner">
    <div>
      <h2 class="banner-title">🌴 Bienvenido a tu espacio de Servicios Mallorca</h2>
      <p class="text-muted">
        Explora los mejores servicios de la isla, guarda tus favoritos o da de alta y reclama tu propio negocio.
      </p>
    </div>
    <div class="actions-group">
      <a href="./servicios/nuevo" class="btn btn-primary btn-sm">➕ Publicar Negocio</a>
      <a href="./servicios" class="btn btn-secondary btn-sm">🔍 Explorar Servicios</a>
    </div>
  </div>

  <!-- User Submissions & Claims Section -->
  <div class="user-status-grid">
    <article class="card card-glass">
      <div class="card-title-row">
        <h3>🏢 {translations["dashboard.myClaims"] || "Mis Solicitudes de Negocio"}</h3>
      </div>
      <div id="user-claims-list" class="requests-list">
        <p class="text-muted empty-state">Cargando tus solicitudes...</p>
      </div>
    </article>

    <article class="card card-glass">
      <div class="card-title-row">
        <h3>📝 {translations["dashboard.submissionsTitle"] || "Mis Propuestas de Nuevos Negocios"}</h3>
      </div>
      <div id="user-subs-list" class="requests-list">
        <p class="text-muted empty-state">Cargando tus propuestas...</p>
      </div>
    </article>
  </div>
</div>

<style>
  .user-dashboard-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .quick-actions-banner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-xl);
    border-radius: var(--border-radius-lg);
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .banner-title {
    font-size: var(--font-size-xl);
    font-weight: 800;
    margin-bottom: 0.25rem;
  }

  .actions-group {
    display: flex;
    gap: var(--space-sm);
  }

  .user-status-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
  }

  .card-title-row {
    margin-bottom: var(--space-md);
    padding-bottom: var(--space-xs);
    border-bottom: 1px solid var(--color-surface-border);
  }

  .card-title-row h3 {
    font-size: var(--font-size-base);
    font-weight: 700;
    margin: 0;
  }

  .requests-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .empty-state {
    font-style: italic;
    font-size: var(--font-size-xs);
  }

  .user-item-card {
    background: var(--color-surface);
    border: 1px solid var(--color-surface-border);
    border-radius: var(--border-radius-sm);
    padding: var(--space-sm);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  @media (max-width: 768px) {
    .user-status-grid {
      grid-template-columns: 1fr;
    }

    .quick-actions-banner {
      flex-direction: column;
      align-items: flex-start;
    }

    .actions-group {
      width: 100%;
      flex-wrap: wrap;
    }

    .actions-group .btn {
      flex: 1;
      text-align: center;
      justify-content: center;
    }
  }

  @media (max-width: 480px) {
    .banner-title {
      font-size: var(--font-size-lg);
    }

    .actions-group {
      flex-direction: column;
    }

    .actions-group .btn {
      width: 100%;
    }
  }
</style>

<script>
  import { auth, db } from "../lib/firebase";
  import { getUserClaims, getUserSubmissions } from "../lib/serviceActions";

  async function loadUserData() {
    auth.onAuthStateChanged(async (user) => {
      if (!user) return;

      // 1. Claims
      const claims = await getUserClaims(db, user.uid);
      const claimsContainer = document.getElementById("user-claims-list");
      if (claimsContainer) {
        if (claims.length === 0) {
          claimsContainer.innerHTML =
            '<p class="text-muted empty-state">No has solicitado reclamar ningún negocio aún.</p>';
        } else {
          claimsContainer.innerHTML = claims
            .map(
              (c) => `
            <div class="user-item-card">
              <div>
                <strong>${c.serviceName}</strong>
                <div class="text-muted" style="font-size: 0.75rem;">ID: ${c.serviceId}</div>
              </div>
              <span class="badge ${c.status === "approved" ? "badge-primary" : c.status === "pending" ? "badge-accent" : "badge-secondary"}">${c.status.toUpperCase()}</span>
            </div>
          `,
            )
            .join("");
        }
      }

      // 2. Submissions
      const submissions = await getUserSubmissions(db, user.uid);
      const subsContainer = document.getElementById("user-subs-list");
      if (subsContainer) {
        if (submissions.length === 0) {
          subsContainer.innerHTML = '<p class="text-muted empty-state">No has propuesto nuevos negocios aún.</p>';
        } else {
          subsContainer.innerHTML = submissions
            .map(
              (s) => `
            <div class="user-item-card">
              <div>
                <strong>${s.name}</strong>
                <div class="text-muted" style="font-size: 0.75rem;">${s.category} · 📍 ${s.zone}</div>
              </div>
              <span class="badge ${s.status === "approved" ? "badge-primary" : s.status === "pending" ? "badge-accent" : "badge-secondary"}">${s.status.toUpperCase()}</span>
            </div>
          `,
            )
            .join("");
        }
      }
    });
  }

  loadUserData();
</script>
