---
interface Props {
  translations: Record<string, string>;
}

const { translations } = Astro.props;
---

<div class="user-dashboard-container">
  <!-- Quick Actions Banner -->
  <div class="card card-glass quick-actions-banner">
    <div>
      <h2 class="banner-title">🌴 {translations["dashboard.welcome"] || "¡Bienvenido a Servicios Mallorca!"}</h2>
      <p class="text-muted">
        {translations["dashboard.subtitle"] || "Gestiona tus favoritos, solicitudes de recomendación y perfil."}
      </p>
    </div>
    <div class="actions-group">
      <a href="./servicios/nuevo" class="btn btn-primary btn-sm"
        >{translations["dashboard.publishCta"] || "➕ Publicar Negocio"}</a
      >
      <a href="./servicios" class="btn btn-secondary btn-sm"
        >{translations["dashboard.exploreCta"] || "🔍 Explorar Servicios"}</a
      >
    </div>
  </div>

  <!-- User Submissions & Claims Section -->
  <div class="user-status-grid">
    <article class="card card-glass">
      <div class="card-title-row">
        <h3>🏢 {translations["dashboard.myClaims"] || "Mis Solicitudes de Negocio"}</h3>
      </div>
      <div
        id="user-claims-list"
        class="requests-list"
        data-empty={translations["dashboard.emptyClaims"] || "No has solicitado reclamar ningún negocio aún."}
        data-approved={translations["dashboard.approved"] || "Aprobado"}
        data-pending={translations["dashboard.pending"] || "Pendiente"}
        data-rejected={translations["dashboard.rejected"] || "Rechazado"}
      >
        <p class="text-muted empty-state">{translations["dashboard.loadingClaims"] || "Cargando tus solicitudes..."}</p>
      </div>
    </article>

    <article class="card card-glass">
      <div class="card-title-row">
        <h3>📝 {translations["dashboard.submissionsTitle"] || "Mis Propuestas de Nuevos Negocios"}</h3>
      </div>
      <div
        id="user-subs-list"
        class="requests-list"
        data-empty={translations["dashboard.emptySubmissions"] || "No has propuesto nuevos negocios aún."}
        data-approved={translations["dashboard.approved"] || "Aprobado"}
        data-pending={translations["dashboard.pending"] || "Pendiente"}
        data-rejected={translations["dashboard.rejected"] || "Rechazado"}
      >
        <p class="text-muted empty-state">
          {translations["dashboard.loadingSubmissions"] || "Cargando tus propuestas..."}
        </p>
      </div>
    </article>
  </div>
</div>

<style>
  .user-dashboard-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .quick-actions-banner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-xl);
    border-radius: var(--border-radius-lg);
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .banner-title {
    font-size: var(--font-size-xl);
    font-weight: 800;
    margin-bottom: 0.25rem;
  }

  .actions-group {
    display: flex;
    gap: var(--space-sm);
  }

  .user-status-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
  }

  .card-title-row {
    margin-bottom: var(--space-md);
    padding-bottom: var(--space-xs);
    border-bottom: 1px solid var(--color-surface-border);
  }

  .card-title-row h3 {
    font-size: var(--font-size-base);
    font-weight: 700;
    margin: 0;
  }

  .requests-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .empty-state {
    font-style: italic;
    font-size: var(--font-size-xs);
  }

  .user-item-card {
    background: var(--color-surface);
    border: 1px solid var(--color-surface-border);
    border-radius: var(--border-radius-sm);
    padding: var(--space-sm);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  @media (max-width: 768px) {
    .user-status-grid {
      grid-template-columns: 1fr;
    }

    .quick-actions-banner {
      flex-direction: column;
      align-items: flex-start;
    }

    .actions-group {
      width: 100%;
      flex-wrap: wrap;
    }

    .actions-group .btn {
      flex: 1;
      text-align: center;
      justify-content: center;
    }
  }

  @media (max-width: 480px) {
    .banner-title {
      font-size: var(--font-size-lg);
    }

    .actions-group {
      flex-direction: column;
    }

    .actions-group .btn {
      width: 100%;
    }
  }
</style>

<script>
  import { auth, db } from "../lib/firebase";
  import { getUserClaims, getUserSubmissions } from "../lib/serviceActions";

  async function loadUserData() {
    auth.onAuthStateChanged(async (user) => {
      if (!user) return;

      // 1. Claims
      const claims = await getUserClaims(db, user.uid);
      const claimsContainer = document.getElementById("user-claims-list");
      if (claimsContainer) {
        const emptyMsg = claimsContainer.dataset.empty || "No claims found";
        const approvedLbl = claimsContainer.dataset.approved || "Approved";
        const pendingLbl = claimsContainer.dataset.pending || "Pending";
        const rejectedLbl = claimsContainer.dataset.rejected || "Rejected";

        if (claims.length === 0) {
          claimsContainer.innerHTML = `<p class="text-muted empty-state">${emptyMsg}</p>`;
        } else {
          claimsContainer.innerHTML = claims
            .map((c) => {
              const statusLabel =
                c.status === "approved" ? approvedLbl : c.status === "pending" ? pendingLbl : rejectedLbl;
              const badgeClass =
                c.status === "approved" ? "badge-primary" : c.status === "pending" ? "badge-accent" : "badge-secondary";
              return `
                  <div class="user-item-card">
                    <div>
                      <strong>${c.serviceName}</strong>
                      <div class="text-muted" style="font-size: 0.75rem;">ID: ${c.serviceId}</div>
                    </div>
                    <span class="badge ${badgeClass}">${statusLabel.toUpperCase()}</span>
                  </div>
                `;
            })
            .join("");
        }
      }

      // 2. Submissions
      const submissions = await getUserSubmissions(db, user.uid);
      const subsContainer = document.getElementById("user-subs-list");
      if (subsContainer) {
        const emptySubsMsg = subsContainer.dataset.empty || "No submissions found";
        const approvedLbl = subsContainer.dataset.approved || "Approved";
        const pendingLbl = subsContainer.dataset.pending || "Pending";
        const rejectedLbl = subsContainer.dataset.rejected || "Rejected";

        if (submissions.length === 0) {
          subsContainer.innerHTML = `<p class="text-muted empty-state">${emptySubsMsg}</p>`;
        } else {
          subsContainer.innerHTML = submissions
            .map((s) => {
              const statusLabel =
                s.status === "approved" ? approvedLbl : s.status === "pending" ? pendingLbl : rejectedLbl;
              const badgeClass =
                s.status === "approved" ? "badge-primary" : s.status === "pending" ? "badge-accent" : "badge-secondary";
              return `
                  <div class="user-item-card">
                    <div>
                      <strong>${s.name}</strong>
                      <div class="text-muted" style="font-size: 0.75rem;">${s.category} · 📍 ${s.zone}</div>
                    </div>
                    <span class="badge ${badgeClass}">${statusLabel.toUpperCase()}</span>
                  </div>
                `;
            })
            .join("");
        }
      }
    });
  }

  loadUserData();
</script>
