---
import { type Locale } from "../../../i18n";

export const ServiceBookingModal = ({
  service,
  translations,
  locale
}: {
  service: any;
  translations: any;
  locale: Locale;
}) => {
  return (
    <section class="card section-box booking-section">
      <h2 class="box-title">{translations["services.booking"]}</h2>
      <div class="booking-info">
        <p>{translations["services.booking_description"]}</p>
        <a href={`https://wa.me/${service.whatsapp.replace('+','').replace(' ','')}`} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          <span>📱 {translations["services.book_now"]}</span>
        </a>
      </div>
    </section>
  );
};
