---
import type { ServiceItem } from "../data/services/types";
import type { Locale } from "../i18n";

interface Props {
  service: ServiceItem;
  translations: Record<string, string>;
  locale?: Locale;
}

const { service, translations } = Astro.props;
import { formatWhatsAppLink } from "../lib/whatsappUtils";

const waUrl = formatWhatsAppLink(service.whatsapp);
const telLink = service.phone ? `tel:${service.phone.replace(/[^0-9+]/g, "")}` : null;
---

<section class="card section-box booking-section">
  <h2 class="box-title">{translations["services.booking"] || "Reserva Directa"}</h2>
  <div class="booking-info">
    <p>
      {
        translations["services.booking_description"] ||
          "Contacta directamente con el negocio para verificar disponibilidad."
      }
    </p>
    {
      waUrl ? (
        <a href={waUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          <span>📱 {translations["services.book_now"] || "Reservar por WhatsApp"}</span>
        </a>
      ) : telLink ? (
        <a href={telLink} class="btn btn-primary">
          <span>📞 {translations["services.call"] || "Llamar para Reservar"} ({service.phone})</span>
        </a>
      ) : null
    }
  </div>
</section>
