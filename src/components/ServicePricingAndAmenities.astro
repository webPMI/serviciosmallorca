---
import type { ServiceItem } from "../data/services/types";
import type { Locale } from "../i18n";

interface Props {
  service: ServiceItem;
  locale: Locale;
}

const { service, locale } = Astro.props;
---

<div class="pricing-amenities-wrap">
  <!-- Pricing & Rate Information or Digital Menu (If Available) -->
  {
    (service.pricing || service.menuUrl || (service.specialties && service.specialties[locale]?.length > 0)) && (
      <section class="card section-box pricing-section">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: var(--space-md);">
          <h2 class="box-title" style="margin: 0; padding: 0; border: none;">
            {service.category.includes("gastronomia") ? "🍽️ Menú & Carta Gastronómica" : "💶 Tarifas Orientativas & Condiciones"}
          </h2>
          {service.menuUrl && (
            <a
              href={service.menuUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-sm btn-primary"
              style="font-size: 0.85rem; padding: 0.4rem 0.8rem;"
            >
              <span>📜 Ver Carta Completa ↗</span>
            </a>
          )}
        </div>

        {(() => {
          const specList: string[] = Array.isArray(service.specialties)
            ? service.specialties
            : service.specialties?.[locale] ?? [];
          if (specList.length === 0) return null;
          return (
            <div style="margin-bottom: var(--space-md);">
              <strong style="display: block; font-size: 0.9rem; color: var(--color-text-muted); margin-bottom: 0.4rem;">
                ⭐ Especialidades de la Casa:
              </strong>
              <div class="chips-row">
                {specList.map((spec: string) => (
                  <span class="chip-item" style="border-color: var(--color-accent); font-weight: 500;">
                    🍴 {spec}
                  </span>
                ))}
              </div>
            </div>
          );
        })()}

        {service.pricing && (
          <div class="pricing-card-inner">
            {service.pricing.startingPrice && (
              <div class="pricing-pill-highlight">
                <span class="pricing-label">Precio Mínimo / Menú:</span>
                <strong class="pricing-val">{service.pricing.startingPrice}</strong>
              </div>
            )}
            {service.pricing.depositRequired && (
              <p class="pricing-note">
                📌 <strong>Reserva:</strong> {service.pricing.depositRequired}
              </p>
            )}
            {service.pricing.notes?.[locale] && <p class="pricing-note-sub">{service.pricing.notes[locale]}</p>}
          </div>
        )}
      </section>
    )
  }

  <!-- Amenities, Accessibility & Payment Methods -->
  {
    ((service.amenities && service.amenities.length > 0) ||
      (service.paymentMethods && service.paymentMethods.length > 0) ||
      (service.certifications && service.certifications.length > 0)) && (
      <section class="card section-box amenities-payments-box">
        <h2 class="box-title">✨ Comodidades, Métodos de Pago & Certificaciones</h2>

        {service.paymentMethods && service.paymentMethods.length > 0 && (
          <div class="amenity-group">
            <span class="amenity-group-title">💳 Métodos de Pago Aceptados:</span>
            <div class="chips-row">
              {service.paymentMethods.map((pm: string) => (
                <span class="chip-item">
                  {pm === "credit_card"
                    ? "💳 Tarjeta"
                    : pm === "cash"
                      ? "💶 Efectivo"
                      : pm === "bizum"
                        ? "📱 Bizum"
                        : pm === "apple_pay"
                          ? "🍎 Apple Pay"
                          : pm === "crypto"
                            ? "₿ Cripto"
                            : pm}
                </span>
              ))}
            </div>
          </div>
        )}

        {service.amenities && service.amenities.length > 0 && (
          <div class="amenity-group">
            <span class="amenity-group-title">🛋️ Comodidades e Instalaciones:</span>
            <div class="chips-row">
              {service.amenities.map((am: string) => (
                <span class="chip-item">
                  {am === "wifi"
                    ? "📶 Wi-Fi Gratis"
                    : am === "air_conditioning"
                      ? "❄️ Climatizado"
                      : am === "wheelchair_accessible"
                        ? "♿ Accesible PMR"
                        : am === "parking_nearby"
                          ? "🅿️ Parking Cercano"
                          : am === "pet_friendly"
                            ? "🐾 Pet Friendly"
                            : am}
                </span>
              ))}
            </div>
          </div>
        )}

        {service.certifications && service.certifications.length > 0 && (
          <div class="amenity-group">
            <span class="amenity-group-title">🛡️ Certificaciones Oficiales:</span>
            <div class="chips-row">
              {service.certifications.map((cert: string) => (
                <span class="chip-item cert-item">✓ {cert}</span>
              ))}
            </div>
          </div>
        )}
      </section>
    )
  }

  <!-- FAQs Accordions (If Available) -->
  {
    service.faqs && service.faqs.length > 0 && (
      <section class="card section-box faqs-section">
        <h2 class="box-title">❓ Preguntas Frecuentes sobre {service.name}</h2>
        <div class="faqs-list">
          {service.faqs.map((faq: any) => (
            <details class="faq-item">
              <summary class="faq-question">
                <strong>{faq.question[locale]}</strong>
              </summary>
              <p class="faq-answer">{faq.answer[locale]}</p>
            </details>
          ))}
        </div>
      </section>
    )
  }
</div>
