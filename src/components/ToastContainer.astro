---
// Global Toast Container — renders client-side toasts with animations and accessibility
---

<div id="toast-container" class="toast-container" role="region" aria-live="polite" aria-label="Notificaciones"></div>

<script>
  import type { ToastDetail } from "../lib/toast";

  const container = document.getElementById("toast-container");

  function createToastElement(detail: ToastDetail): HTMLElement {
    const toast = document.createElement("div");
    toast.className = `toast toast--${detail.type} card-glass`;
    toast.id = detail.id;
    toast.setAttribute("role", detail.type === "error" ? "alert" : "status");

    // Inner content
    toast.innerHTML = `
      <div class="toast-icon-wrapper">
        <span class="toast-icon">${detail.icon}</span>
      </div>
      <div class="toast-body">
        ${detail.title ? `<strong class="toast-title">${escapeHtml(detail.title)}</strong>` : ""}
        <p class="toast-message">${escapeHtml(detail.message)}</p>
      </div>
      <button type="button" class="toast-close-btn" aria-label="Cerrar notificación">
        ✕
      </button>
      ${detail.duration > 0 ? `<div class="toast-progress-track"><div class="toast-progress-bar" style="animation-duration: ${detail.duration}ms;"></div></div>` : ""}
    `;

    // Close button logic
    const closeBtn = toast.querySelector(".toast-close-btn");
    if (closeBtn) {
      closeBtn.addEventListener("click", () => dismissToast(toast));
    }

    // Auto dismiss logic
    if (detail.duration > 0) {
      let timeoutId: number | null = window.setTimeout(() => {
        dismissToast(toast);
      }, detail.duration);

      const progressBar = toast.querySelector(".toast-progress-bar") as HTMLElement | null;

      // Pause on hover
      toast.addEventListener("mouseenter", () => {
        if (timeoutId) {
          clearTimeout(timeoutId);
          timeoutId = null;
        }
        if (progressBar) progressBar.style.animationPlayState = "paused";
      });

      toast.addEventListener("mouseleave", () => {
        if (!timeoutId) {
          timeoutId = window.setTimeout(() => {
            dismissToast(toast);
          }, 1500); // 1.5s grace period on mouse leave
        }
        if (progressBar) progressBar.style.animationPlayState = "running";
      });
    }

    return toast;
  }

  function dismissToast(toast: HTMLElement) {
    if (toast.classList.contains("is-dismissing")) return;
    toast.classList.add("is-dismissing");
    toast.addEventListener(
      "animationend",
      () => {
        toast.remove();
      },
      { once: true },
    );
    // Fallback if animationend doesn't trigger
    setTimeout(() => {
      if (toast.parentElement) toast.remove();
    }, 350);
  }

  function escapeHtml(str: string): string {
    const p = document.createElement("p");
    p.textContent = str;
    return p.innerHTML;
  }

  // Listen to global app:toast events
  window.addEventListener("app:toast", ((e: CustomEvent<ToastDetail>) => {
    if (!container || !e.detail) return;
    const toastEl = createToastElement(e.detail);
    container.appendChild(toastEl);
  }) as EventListener);
</script>

<style is:global>
  /* Global Toast Container Styling */
  .toast-container {
    position: fixed;
    top: 1.5rem;
    right: 1.5rem;
    z-index: 10000;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 400px;
    width: calc(100vw - 2rem);
    pointer-events: none;
  }

  .toast {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 1rem 1.15rem;
    border-radius: var(--border-radius);
    background: var(--color-surface);
    color: var(--color-text);
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--color-surface-border);
    pointer-events: auto;
    overflow: hidden;
    animation: toastSlideIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    backdrop-filter: var(--glass-backdrop);
    -webkit-backdrop-filter: var(--glass-backdrop);
  }

  .toast.is-dismissing {
    animation: toastSlideOut 0.3s cubic-bezier(0.4, 0, 1, 1) forwards;
  }

  /* Type variants */
  .toast--success {
    border-left: 4px solid var(--color-success);
  }

  .toast--error {
    border-left: 4px solid var(--color-danger);
  }

  .toast--warning {
    border-left: 4px solid var(--color-warning);
  }

  .toast--info {
    border-left: 4px solid var(--color-primary);
  }

  .toast-icon-wrapper {
    flex-shrink: 0;
    font-size: 1.25rem;
    line-height: 1;
    margin-top: 0.1rem;
  }

  .toast-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .toast-title {
    font-size: var(--font-size-sm);
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.3;
  }

  .toast-message {
    font-size: var(--font-size-sm);
    color: var(--color-text-light);
    line-height: 1.4;
    margin: 0;
  }

  .toast-close-btn {
    flex-shrink: 0;
    background: none;
    border: none;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    cursor: pointer;
    padding: 0.2rem;
    line-height: 1;
    border-radius: var(--border-radius-sm);
    transition: all var(--transition-fast);
    margin-top: -0.2rem;
    margin-right: -0.3rem;
  }

  .toast-close-btn:hover {
    color: var(--color-text);
    background-color: var(--color-surface-hover);
  }

  /* Progress Bar */
  .toast-progress-track {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--color-surface-border);
  }

  .toast-progress-bar {
    height: 100%;
    width: 100%;
    transform-origin: left center;
    animation: toastProgress linear forwards;
  }

  .toast--success .toast-progress-bar {
    background: var(--color-success);
  }

  .toast--error .toast-progress-bar {
    background: var(--color-danger);
  }

  .toast--warning .toast-progress-bar {
    background: var(--color-warning);
  }

  .toast--info .toast-progress-bar {
    background: var(--color-primary);
  }

  /* Keyframe animations */
  @keyframes toastSlideIn {
    from {
      opacity: 0;
      transform: translateX(100%) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translateX(0) scale(1);
    }
  }

  @keyframes toastSlideOut {
    from {
      opacity: 1;
      transform: translateX(0) scale(1);
    }
    to {
      opacity: 0;
      transform: translateX(110%) scale(0.95);
    }
  }

  @keyframes toastProgress {
    from {
      transform: scaleX(1);
    }
    to {
      transform: scaleX(0);
    }
  }

  /* Mobile responsiveness */
  @media (max-width: 640px) {
    .toast-container {
      top: auto;
      bottom: 1.25rem;
      right: 50%;
      transform: translateX(50%);
      max-width: calc(100vw - 2rem);
    }

    @keyframes toastSlideIn {
      from {
        opacity: 0;
        transform: translateY(100%) scale(0.95);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    @keyframes toastSlideOut {
      from {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
      to {
        opacity: 0;
        transform: translateY(110%) scale(0.95);
      }
    }
  }
</style>
