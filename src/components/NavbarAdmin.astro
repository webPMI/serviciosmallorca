---
interface Props {
  currentLocale: "es" | "en" | "ca" | string;
  translations: Record<string, string>;
  getLangPrefix: (locale: "es" | "en" | "ca") => string;
  currentPath: string;
}

const { currentLocale, translations, getLangPrefix, currentPath } = Astro.props;
const prefix = getLangPrefix(currentLocale as "es" | "en" | "ca");
const homeUrl = prefix || "/";
---

<header class="navbar-header nav-admin">
  <div class="container navbar-container">
    <!-- Brand Logo / Title -->
    <a href={`${homeUrl}dashboard`} class="navbar-brand" aria-label={translations["nav.aria.adminBrand"] || "WebApp Starter Admin Console"}>
      <span class="brand-badge badge badge-admin">⚡ Admin Console</span>
      <span class="brand-title">WebApp Starter</span>
    </a>

    <!-- Mobile Hamburger Toggle Button -->
    <button
      id="admin-menu-toggle"
      class="mobile-toggle-btn mobile-menu-button"
      aria-label={translations["nav.aria.openAdminMenu"] || "Abrir menú de administración"}
      aria-expanded="false"
    >
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>

    <!-- Admin Navigation Menu -->
    <div id="admin-navbar-menu" class="navbar-menu">
      <nav class="navbar-links" aria-label={translations["nav.aria.adminNav"] || "Navegación de administración"}>
        <a href={`${homeUrl}dashboard`} class="nav-link">
          📊 {translations["nav.dashboard"] || "Panel"}
        </a>
        <a href={`${homeUrl}#users`} class="nav-link">
          👥 {translations["nav.users"] || "Gestión Usuarios"}
        </a>
        <a href={`${homeUrl}#analytics`} class="nav-link">
          📈 {translations["nav.analytics"] || "Analíticas"}
        </a>
        <a href={`${homeUrl}profile`} class="nav-link">
          👤 {translations["nav.profile"] || "Mi Perfil"}
        </a>
      </nav>

      <div class="navbar-actions">
        <div class="user-profile-menu">
          <a href={`${homeUrl}profile`} class="user-avatar-badge admin-badge" aria-label={translations["nav.profile"] || "Mi Perfil"}>
            <span id="admin-nav-avatar">👑</span>
            <span id="admin-nav-name" class="user-name"></span>
          </a>

          <button type="button" id="admin-logout-btn" class="btn btn-secondary btn-sm">
            {translations["nav.logout"] || "Cerrar Sesión"}
          </button>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  import { initMobileMenuToggle } from "../lib/toggleMobileMenu";
  import { initAuthNavbar } from "../lib/initAuthNavbar";

  initMobileMenuToggle("admin-menu-toggle", "admin-navbar-menu");
  initAuthNavbar("admin");
</script>

<style>
  .navbar-header {
    background: var(--glass-bg);
    border-bottom: 2px solid var(--color-role-admin);
  }
</style>
