---
interface Props {
  currentLocale: "es" | "en" | "ca" | "de" | string;
  translations: Record<string, string>;
  getLangPrefix: (locale: "es" | "en" | "ca" | "de") => string;
  currentPath: string;
}

const { currentLocale, translations, getLangPrefix, currentPath } = Astro.props;
const prefix = getLangPrefix((currentLocale as "es" | "en" | "ca" | "de") || "es");
const homeUrl = prefix || "/";

const isDashboardActive = currentPath.includes("/dashboard");
const isServicesActive = currentPath.includes("/servicios");
const isSportsActive = currentPath.includes("/deporte");
const isToursActive = currentPath.includes("/tours");
const isHistoryActive = currentPath.includes("/memoria-historica");
const isCommunityActive = currentPath.includes("/comunidad");
const isHonorActive = currentPath.includes("/cuadro-de-honor");
const isBlogActive = currentPath.includes("/blog");
const isProfileActive = currentPath.includes("/profile");
---

<header class="navbar-header nav-admin">
  <div class="container navbar-container">
    <!-- Brand Logo / Title -->
    <a
      href={`${homeUrl}dashboard`}
      class="navbar-brand"
      aria-label={translations["nav.aria.adminBrand"] || "Servicios Mallorca Admin Console"}
    >
      <span class="brand-badge badge badge-admin">⚡ Admin</span>
      <span class="brand-title">Servicios Mallorca</span>
    </a>

    <!-- Mobile Hamburger Toggle Button -->
    <button
      id="admin-menu-toggle"
      class="mobile-toggle-btn mobile-menu-button"
      aria-label={translations["nav.aria.openAdminMenu"] || "Abrir menú de administración"}
      aria-expanded="false"
    >
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>

    <!-- Admin Navigation Menu -->
    <div id="admin-navbar-menu" class="navbar-menu">
      <nav class="navbar-links" aria-label={translations["nav.aria.adminNav"] || "Navegación de administración"}>
        <!-- ── SECCIÓN 1: ADMINISTRACIÓN & AUDITORÍA ── -->
        <span class="nav-section-title">⚡ {translations["nav.section.admin"] || "Administración Central"}</span>

        <a href={`${homeUrl}dashboard`} class:list={["nav-link", "nav-desktop-link", { active: isDashboardActive }]}>
          📊 {translations["nav.dashboard"] || "Panel"}
        </a>
        <a href={`${homeUrl}servicios`} class:list={["nav-link", "nav-desktop-link", { active: isServicesActive }]}>
          🌴 {translations["nav.services"] || "Servicios"}
        </a>
        <a href={`${homeUrl}deporte`} class:list={["nav-link", "nav-desktop-link", { active: isSportsActive }]}>
          🏃 {translations["nav.sports"] || "Deporte"}
        </a>
        <a href={`${homeUrl}tours`} class:list={["nav-link", "nav-drawer-only", { active: isToursActive }]}>
          🗺️ {translations["nav.tours"] || "Rutas & Experiencias"}
        </a>
        <a
          href={`${homeUrl}memoria-historica`}
          class:list={["nav-link", "nav-drawer-only", { active: isHistoryActive }]}
        >
          🏛️ {translations["nav.history"] || "Memoria Histórica"}
        </a>

        <!-- ── SECCIÓN 2: COMUNIDAD & ÉLITE ── -->
        <span class="nav-section-title">🌟 {translations["nav.section.community"] || "Comunidad & Reconocimiento"}</span
        >

        <a href={`${homeUrl}cuadro-de-honor`} class:list={["nav-link", "nav-desktop-link", { active: isHonorActive }]}>
          👑 {translations["nav.honor"] || "Cuadro de Honor"}
        </a>
        <a href={`${homeUrl}comunidad`} class:list={["nav-link", "nav-desktop-link", { active: isCommunityActive }]}>
          💬 {translations["nav.community"] || "Comunidad"}
        </a>
        <a href={`${homeUrl}blog`} class:list={["nav-link", "nav-drawer-only", { active: isBlogActive }]}>
          📰 {translations["nav.blog"] || "Blog & Noticias"}
        </a>
      </nav>

      <!-- ── SECCIÓN 3: PERFIL DE ADMINISTRADOR & SESIÓN ── -->
      <div class="navbar-actions">
        <span class="nav-section-title drawer-prefs-title"
          >👑 {translations["nav.section.adminAccount"] || "Consola de Super-Admin"}</span
        >

        <div class="user-profile-menu">
          <a
            href={`${homeUrl}profile`}
            class:list={["user-avatar-badge", "admin-badge", { active: isProfileActive }]}
            aria-label={translations["nav.profile"] || "Mi Perfil"}
          >
            <span id="admin-nav-avatar">👑</span>
            <span id="admin-nav-name" class="user-name"></span>
          </a>

          <button type="button" id="admin-logout-btn" class="btn btn-secondary btn-sm">
            {translations["nav.logout"] || "Cerrar Sesión"}
          </button>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  import { initMobileMenuToggle } from "../lib/toggleMobileMenu";
  import { initAuthNavbar } from "../lib/initAuthNavbar";

  initMobileMenuToggle("admin-menu-toggle", "admin-navbar-menu");
  initAuthNavbar("admin");
</script>

<style>
  .navbar-header {
    background: var(--glass-bg);
    border-bottom: 2px solid var(--color-role-admin);
  }
</style>
