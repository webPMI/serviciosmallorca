---
import type { ServiceItem } from "../data/services/types";
import type { ServiceCategory } from "../data/categories";
import type { MallorcaZone } from "../data/zones";
import type { Locale } from "../i18n";
import LiveScheduleBadge from "./LiveScheduleBadge.astro";
import FavoriteButton from "./FavoriteButton.astro";
import { getSmartActionCta } from "../lib/smartCtaEngine";

interface Props {
  service: ServiceItem;
  category?: ServiceCategory;
  zone?: MallorcaZone;
  translations: Record<string, string>;
  locale: Locale;
}

const { service, category, zone, translations, locale } = Astro.props;
const categoryName = category?.name[locale] || service.category;
const zoneName = zone?.name[locale] || service.zone;

const cleanPhone = service.phone ? service.phone.replace(/[^0-9+]/g, "") : "";
const smartCta = getSmartActionCta(
  service.category,
  service.name,
  locale,
  service.phone,
  service.whatsapp,
  service.website,
  service.menuUrl,
);
---

<header class="service-detail-header">
  <div class="header-main">
    <div class="header-badges">
      <span class="badge badge-primary">{category?.icon} {categoryName}</span>
      <span class="badge badge-accent">📍 {zoneName}</span>
      <span class="badge badge-price">{service.priceRange}</span>
      {service.schedule && <LiveScheduleBadge scheduleText={service.schedule} locale={locale} />}
    </div>

    <h1 class="detail-title">{service.name}</h1>
    <p class="detail-lead">{service.shortDescription[locale] || service.shortDescription.en}</p>

    <div class="header-action-row">
      <div class="rating-bar">
        <span class="rating-stars" aria-hidden="true">★★★★★</span>
        <strong class="rating-val">{service.rating ? service.rating.toFixed(1) : "N/A"}</strong>
        <span class="rating-reviews"
          >({service.reviewCount ?? "N/A"} {translations["services.reviews"] || "reseñas"})</span
        >
      </div>

      <!-- Quick Action Buttons Above the Fold -->
      <div class="hero-quick-actions">
        {
          smartCta.url !== "#" && (
            <a
              href={smartCta.url}
              target={smartCta.isExternal ? "_blank" : "_self"}
              rel={smartCta.isExternal ? "noopener noreferrer" : undefined}
              class="btn btn-sm btn-primary hero-btn-smart-action"
              data-track-event={smartCta.trackingEvent}
              data-service-id={service.id}
            >
              <span>{smartCta.icon}</span>
              <span>{smartCta.label}</span>
            </a>
          )
        }
        {
          cleanPhone && (
            <a
              href={`tel:${cleanPhone}`}
              class="btn btn-sm btn-secondary hero-btn-phone"
              data-track-event="phone_click"
              data-service-id={service.id}
            >
              <span>📞</span>
              <span>{locale === "ca" ? "Telefonar" : locale === "en" ? "Call" : "Llamar"}</span>
            </a>
          )
        }
        <a
          href="#ubicacion"
          class="btn btn-sm btn-outline hero-btn-map"
          data-track-event="directions_click"
          data-service-id={service.id}
        >
          <span>📍</span>
          <span>{locale === "ca" ? "Com arribar" : locale === "en" ? "Directions" : "Cómo llegar"}</span>
        </a>
        <button
          type="button"
          class="btn btn-sm btn-outline hero-btn-share"
          data-open-modal="social-share-modal"
          title={translations["services.share"] || "Compartir Negocio"}
          aria-label={translations["services.share"] || "Compartir Negocio"}
        >
          <span>📤</span>
          <span
            >{
              translations["services.share"] ||
                (locale === "de" ? "Teilen" : locale === "en" ? "Share" : locale === "ca" ? "Compartir" : "Compartir")
            }</span
          >
        </button>
        <FavoriteButton
          businessId={service.id}
          businessName={service.name}
          businessSlug={service.slug}
          category={service.category}
          image={service.image}
          size="md"
        />
      </div>
    </div>
  </div>
</header>
