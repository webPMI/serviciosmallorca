<script>
  import { db } from "../lib/firebase";
  import {
    getAllClaims,
    getAllSubmissions,
    getAllDeletionRequests,
    updateClaimStatus,
    updateSubmissionStatus,
    updateDeletionRequestStatus,
    getAllReports,
    updateReportStatus,
  } from "../lib/serviceActions";
  import { getAllUsers, updateUserRole } from "../lib/userProfile";
  import type { UserRole } from "../lib/authStore";

  // Tab switching logic
  const tabBtns = document.querySelectorAll(".admin-tab-btn");
  const tabPanels = document.querySelectorAll(".admin-tab-panel");

  function switchTab(targetTab: string) {
    tabBtns.forEach((btn) => {
      if (btn.getAttribute("data-tab") === targetTab) {
        btn.classList.add("active");
      } else {
        btn.classList.remove("active");
      }
    });

    tabPanels.forEach((panel) => {
      const htmlPanel = panel as HTMLElement;
      if (panel.id === `admin-tab-${targetTab}`) {
        htmlPanel.style.display = "flex";
      } else {
        htmlPanel.style.display = "none";
      }
    });
  }

  tabBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const tab = btn.getAttribute("data-tab");
      if (tab) {
        switchTab(tab);
        const url = new URL(window.location.href);
        url.searchParams.set("tab", tab);
        window.history.replaceState({}, "", url.toString());
      }
    });
  });

  // URL query param tab activation
  const currentTabParam = new URLSearchParams(window.location.search).get("tab");
  if (
    currentTabParam &&
    ["moderation", "quality-control", "users", "analytics", "services"].includes(currentTabParam)
  ) {
    switchTab(currentTabParam);
  }

  // ---------------------------------------------------------------------------
  // Quality Control Center Interactive Filters & JSON Copy
  // ---------------------------------------------------------------------------
  const qcFilterBtns = document.querySelectorAll(".qc-filter-btn");
  const qcCards = document.querySelectorAll(".qc-service-card");

  qcFilterBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      qcFilterBtns.forEach((b) => {
        b.classList.remove("btn-primary", "active");
        b.classList.add("btn-secondary");
      });
      btn.classList.add("btn-primary", "active");
      btn.classList.remove("btn-secondary");

      const filter = btn.getAttribute("data-filter");
      qcCards.forEach((card) => {
        const cardStatus = card.getAttribute("data-qc-status");
        if (filter === "all" || filter === cardStatus) {
          (card as HTMLElement).style.display = "block";
        } else {
          (card as HTMLElement).style.display = "none";
        }
      });
    });
  });

  // Copiado 1-Clic de Raw JSON
  document.querySelectorAll(".copy-raw-json-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const rawJson = btn.getAttribute("data-service-json");
      if (rawJson) {
        try {
          const pretty = JSON.stringify(JSON.parse(rawJson), null, 2);
          await navigator.clipboard.writeText(pretty);
          const originalText = btn.textContent;
          btn.textContent = "✓ ¡Copiado!";
          btn.classList.add("btn-success");
          btn.classList.remove("btn-secondary");
          setTimeout(() => {
            btn.textContent = originalText;
            btn.classList.remove("btn-success");
            btn.classList.add("btn-secondary");
          }, 2000);
        } catch {
          // Fallback
        }
      }
    });
  });

  // ---------------------------------------------------------------------------
  // Load Moderation & Queues Data
  // ---------------------------------------------------------------------------
  async function loadAdminData() {
    // 1. Claims
    const claims = await getAllClaims(db);
    const claimsContainer = document.getElementById("admin-claims-list");
    const statClaims = document.getElementById("stat-claims-val");
    const pendingClaims = claims.filter((c) => c.status === "pending").length;
    if (statClaims) statClaims.textContent = pendingClaims.toString();

    if (claimsContainer) {
      if (claims.length === 0) {
        claimsContainer.innerHTML =
          '<p class="text-muted empty-state">No hay solicitudes de reclamación registradas.</p>';
      } else {
        claimsContainer.innerHTML = claims
          .map(
            (c) => `
          <div class="moderation-item-card" data-claim-id="${c.id}">
            <div class="item-header">
              <span class="item-title">🏢 ${c.serviceName} (ID: ${c.serviceId})</span>
              <span class="badge ${c.status === "pending" ? "badge-accent" : c.status === "approved" ? "badge-primary" : "badge-secondary"}">${c.status.toUpperCase()}</span>
            </div>
            <div class="item-meta">
              <span>👤 Solicitante: <strong>${c.applicantName}</strong></span>
              <span>📧 ${c.applicantEmail}</span>
              <span>📞 ${c.applicantPhone}</span>
            </div>
            <div class="item-proof">
              <strong>Acreditación/CIF:</strong> ${c.verificationProof}
            </div>
            ${
              c.status === "pending"
                ? `
              <div class="actions-flex">
                <button type="button" class="btn btn-primary btn-sm approve-claim-btn" data-id="${c.id}" data-uid="${c.applicantUid}">✓ Aprobar y asignar rol Manager</button>
                <button type="button" class="btn btn-secondary btn-sm reject-claim-btn" data-id="${c.id}">✕ Rechazar</button>
              </div>
            `
                : ""
            }
          </div>
        `,
          )
          .join("");

        claimsContainer.querySelectorAll(".approve-claim-btn").forEach((btn) => {
          btn.addEventListener("click", async () => {
            const id = btn.getAttribute("data-id")!;
            const uid = btn.getAttribute("data-uid")!;
            await updateClaimStatus(db, id, "approved", uid);
            loadAdminData();
          });
        });

        claimsContainer.querySelectorAll(".reject-claim-btn").forEach((btn) => {
          btn.addEventListener("click", async () => {
            const id = btn.getAttribute("data-id")!;
            await updateClaimStatus(db, id, "rejected");
            loadAdminData();
          });
        });
      }
    }

    // 2. Submissions
    const submissions = await getAllSubmissions(db);
    const subsContainer = document.getElementById("admin-subs-list");
    const statSubs = document.getElementById("stat-subs-val");
    const pendingSubs = submissions.filter((s) => s.status === "pending").length;
    if (statSubs) statSubs.textContent = pendingSubs.toString();

    if (subsContainer) {
      if (submissions.length === 0) {
        subsContainer.innerHTML =
          '<p class="text-muted empty-state">No hay propuestas de nuevos negocios pendientes.</p>';
      } else {
        subsContainer.innerHTML = submissions
          .map(
            (s) => `
          <div class="moderation-item-card" data-sub-id="${s.id}">
            <div class="item-header">
              <span class="item-title">📝 ${s.name} [${s.category} · 📍 ${s.zone}]</span>
              <span class="badge ${s.status === "pending" ? "badge-accent" : s.status === "approved" ? "badge-primary" : "badge-secondary"}">${s.status.toUpperCase()}</span>
            </div>
            <div class="item-meta">
              <span>👤 Proponente: ${s.applicantName} (${s.applicantEmail})</span>
              <span>📞 ${s.phone}</span>
              ${s.website ? `<span>🌐 <a href="${s.website}" target="_blank">${s.website}</a></span>` : ""}
              <span>📍 ${s.address}</span>
            </div>
            <div class="item-proof">
              <strong>Descripción:</strong> ${s.description}
            </div>
            ${
              s.status === "pending"
                ? `
              <div class="actions-flex">
                <button type="button" class="btn btn-primary btn-sm approve-sub-btn" data-id="${s.id}">✓ Aprobar Propuesta</button>
                <button type="button" class="btn btn-secondary btn-sm reject-sub-btn" data-id="${s.id}">✕ Rechazar</button>
              </div>
            `
                : ""
            }
          </div>
        `,
          )
          .join("");

        subsContainer.querySelectorAll(".approve-sub-btn").forEach((btn) => {
          btn.addEventListener("click", async () => {
            const id = btn.getAttribute("data-id")!;
            await updateSubmissionStatus(db, id, "approved");
            loadAdminData();
          });
        });

        subsContainer.querySelectorAll(".reject-sub-btn").forEach((btn) => {
          btn.addEventListener("click", async () => {
            const id = btn.getAttribute("data-id")!;
            await updateSubmissionStatus(db, id, "rejected");
            loadAdminData();
          });
        });
      }
    }

    // 3. Deletions
    const deletions = await getAllDeletionRequests(db);
    const delsContainer = document.getElementById("admin-dels-list");
    const statDels = document.getElementById("stat-dels-val");
    const pendingDels = deletions.filter((d) => d.status === "pending").length;
    if (statDels) statDels.textContent = pendingDels.toString();

    if (delsContainer) {
      if (deletions.length === 0) {
        delsContainer.innerHTML = '<p class="text-muted empty-state">No hay solicitudes de baja pendientes.</p>';
      } else {
        delsContainer.innerHTML = deletions
          .map(
            (d) => `
          <div class="moderation-item-card" data-del-id="${d.id}">
            <div class="item-header">
              <span class="item-title">🗑️ Solicitud de Supresión: ${d.serviceName}</span>
              <span class="badge ${d.status === "pending" ? "badge-danger" : "badge-secondary"}">${d.status.toUpperCase()}</span>
            </div>
            <div class="item-meta">
              <span>📧 Contacto: ${d.applicantEmail}</span>
            </div>
            <div class="item-proof">
              <strong>Motivo:</strong> ${d.reason}
            </div>
            ${
              d.status === "pending"
                ? `
              <div class="actions-flex">
                <button type="button" class="btn btn-danger btn-sm process-del-btn" data-id="${d.id}">Tramitar Baja / Marcar Procesado</button>
              </div>
            `
                : ""
            }
          </div>
        `,
          )
          .join("");

        delsContainer.querySelectorAll(".process-del-btn").forEach((btn) => {
          btn.addEventListener("click", async () => {
            const id = btn.getAttribute("data-id")!;
            await updateDeletionRequestStatus(db, id, "processed");
            loadAdminData();
          });
        });
      }
    }

    // 4. Reports
    const reports = await getAllReports(db);
    const reportsContainer = document.getElementById("admin-reports-list");
    const statReports = document.getElementById("stat-reports-val");
    const pendingReports = reports.filter((r) => r.status === "pending").length;
    if (statReports) statReports.textContent = pendingReports.toString();

    const totalPending = pendingClaims + pendingSubs + pendingDels + pendingReports;
    const badgeTotal = document.getElementById("tab-badge-pending-total");
    if (badgeTotal) badgeTotal.textContent = totalPending.toString();

    if (reportsContainer) {
      if (reports.length === 0) {
        reportsContainer.innerHTML =
          '<p class="text-muted empty-state">No hay reportes de la comunidad pendientes. 🎉</p>';
      } else {
        const categoryLabels: Record<string, string> = {
          horario_incorrecto: "🕒 Horario incorrecto",
          ubicacion_erronea: "📍 Ubicación errónea",
          contacto_invalido: "📞 Contacto inválido",
          negocio_cerrado: "🔒 Negocio cerrado",
          sugerencia_cambio: "💡 Sugerencia de mejora",
          otro: "📝 Otro",
        };

        reportsContainer.innerHTML = reports
          .map(
            (r) => `
          <div class="moderation-item-card" data-report-id="${r.id}">
            <div class="item-header">
              <span class="item-title">${categoryLabels[r.category] || "🚩 Reporte"} — ${r.serviceName}</span>
              <span class="badge ${r.status === "pending" ? "badge-accent" : "badge-secondary"}">${r.status.toUpperCase()}</span>
            </div>
            <div class="item-meta">
              <span>👤 Reportero: ${r.reporterEmail || "Anónimo / Comunidad"}</span>
            </div>
            <div class="item-proof">
              <strong>Detalle:</strong> ${r.description}
            </div>
            ${
              r.status === "pending"
                ? `
              <div class="actions-flex">
                <button type="button" class="btn btn-primary btn-sm resolve-report-btn" data-id="${r.id}">✓ Marcar como Resuelto</button>
              </div>
            `
                : ""
            }
          </div>
        `,
          )
          .join("");

        reportsContainer.querySelectorAll(".resolve-report-btn").forEach((btn) => {
          btn.addEventListener("click", async () => {
            const id = btn.getAttribute("data-id")!;
            await updateReportStatus(db, id, "processed");
            loadAdminData();
          });
        });
      }
    }
  }

  // ---------------------------------------------------------------------------
  // Load Users List (Tab 2)
  // ---------------------------------------------------------------------------
  async function loadUsersList() {
    const usersContainer = document.getElementById("admin-users-list");
    if (!usersContainer) return;

    try {
      const users = await getAllUsers(db);
      if (users.length === 0) {
        usersContainer.innerHTML =
          '<p class="text-muted empty-state">No hay usuarios registrados en la base de datos.</p>';
        return;
      }

      function renderUsers(filteredUsers: typeof users) {
        if (!usersContainer) return;
        usersContainer.innerHTML = filteredUsers
          .map(
            (u) => `
          <div class="user-row-card" data-user-uid="${u.uid}">
            <div class="user-info-group">
              <div class="user-avatar-circle">
                ${u.photoURL ? `<img src="${u.photoURL}" alt="${u.displayName}" style="width:100%;height:100%;border-radius:50%;object-fit:cover;" />` : "👤"}
              </div>
              <div class="user-details">
                <span class="user-name">${u.displayName || "Usuario sin nombre"}</span>
                <span class="user-email">${u.email}</span>
              </div>
            </div>
            <div class="user-actions-group">
              <span class="badge ${u.role === "admin" ? "badge-admin" : u.role === "manager" ? "badge-primary" : "badge-secondary"}">
                ${u.role ? u.role.toUpperCase() : "USER"}
              </span>
              <button type="button" class="btn btn-outline-primary btn-xs change-role-btn" data-uid="${u.uid}" data-target-role="manager">
                Hacer Manager
              </button>
              <button type="button" class="btn btn-secondary btn-xs change-role-btn" data-uid="${u.uid}" data-target-role="user">
                Usuario Normal
              </button>
              <button type="button" class="btn btn-danger btn-xs change-role-btn" data-uid="${u.uid}" data-target-role="admin">
                Hacer Admin
              </button>
            </div>
          </div>
        `,
          )
          .join("");

        // Attach role change listeners
        usersContainer.querySelectorAll(".change-role-btn").forEach((btn) => {
          btn.addEventListener("click", async () => {
            const uid = btn.getAttribute("data-uid")!;
            const targetRole = btn.getAttribute("data-target-role") as UserRole;
            btn.setAttribute("disabled", "true");
            await updateUserRole(db, uid, targetRole);
            loadUsersList();
          });
        });
      }

      renderUsers(users);

      // Search filter
      const searchInput = document.getElementById("user-search-input") as HTMLInputElement;
      searchInput?.addEventListener("input", () => {
        const query = searchInput.value.toLowerCase().trim();
        const filtered = users.filter(
          (u) =>
            u.displayName?.toLowerCase().includes(query) ||
            u.email?.toLowerCase().includes(query) ||
            u.role?.toLowerCase().includes(query),
        );
        renderUsers(filtered);
      });
    } catch {
      usersContainer.innerHTML = '<p class="text-muted empty-state">Error cargando usuarios.</p>';
    }
  }

  document.getElementById("refresh-users-btn")?.addEventListener("click", loadUsersList);

  // Initial load
  loadAdminData();
  loadUsersList();
</script>
