---
import { SERVICES } from "../data/services";
import { CATEGORIES } from "../data/categories";
import { MALLORCA_ZONES } from "../data/zones";
import { auditBusinessData } from "../lib/verificationEngine";

interface Props {
  translations: Record<string, string>;
}

const { translations } = Astro.props;

// Compute live catalog metrics
const totalServices = SERVICES.length;
const totalReviews = SERVICES.reduce((acc, s) => acc + (s.reviewCount ?? 0), 0);
const servicesWithRating = SERVICES.filter((s) => s.rating !== null);
const avgRating =
  servicesWithRating.length > 0
    ? (servicesWithRating.reduce((acc, s) => acc + s.rating!, 0) / servicesWithRating.length).toFixed(1)
    : "N/A";
const verifiedCount = SERVICES.filter((s) => s.verified).length;

// Métricas de Inteligencia y Control de Calidad (Quality Control Center)
const needsReviewServices = SERVICES.filter(
  (s) =>
    (s.confidenceScore !== undefined && s.confidenceScore < 85) ||
    s.verificationStatus === "needs_manual_review" ||
    s.verificationStatus === "needs_review" ||
    !s.verified,
);
const needsReviewCount = needsReviewServices.length;
const verifiedScoreCount = SERVICES.filter((s) => (s.confidenceScore ?? 90) >= 85).length;
const avgConfidenceScore = Math.round(
  SERVICES.reduce((acc, s) => acc + (s.confidenceScore ?? (s.verified ? 92 : 65)), 0) / (totalServices || 1),
);
const withStoreCount = SERVICES.filter(
  (s) => s.onlineStore?.hasOnlineStore || (s.products && s.products.length > 0),
).length;
const withMenuCount = SERVICES.filter((s) => !!s.menuUrl).length;
const withNewsCount = SERVICES.filter(
  (s) => (s.newsMentions && s.newsMentions.length > 0) || (s.pressMentions && s.pressMentions.length > 0),
).length;
---

<div class="admin-dashboard-container">
  <!-- Admin Navigation Tabs -->
  <nav class="admin-tabs-nav card card-glass" aria-label="Pestañas de Administración">
    <button type="button" class="admin-tab-btn active" data-tab="moderation">
      <span>🛡️</span>
      <span>Moderación y Solicitudes</span>
      <span class="tab-badge" id="tab-badge-pending-total">0</span>
    </button>
    <button type="button" class="admin-tab-btn" data-tab="quality-control">
      <span>⚡</span>
      <span>Control de Calidad & Triaje</span>
      {needsReviewCount > 0 && <span class="tab-badge warning">{needsReviewCount}</span>}
    </button>
    <button type="button" class="admin-tab-btn" data-tab="users">
      <span>👥</span>
      <span>Gestión de Usuarios</span>
    </button>
    <button type="button" class="admin-tab-btn" data-tab="analytics">
      <span>📈</span>
      <span>Analíticas y Métricas</span>
    </button>
    <button type="button" class="admin-tab-btn" data-tab="services">
      <span>🏢</span>
      <span>Catálogo ({totalServices})</span>
    </button>
  </nav>

  <!-- ======================================================================= -->
  <!-- TAB 1: MODERACIÓN Y COLAS -->
  <!-- ======================================================================= -->
  <div id="admin-tab-moderation" class="admin-tab-panel active">
    <!-- Quick Stats -->
    <section class="stats-grid">
      <article class="stat-card card hover-lift">
        <div class="stat-header">
          <span class="stat-icon">🏢</span>
          <span class="stat-trend neutral" id="stat-claims-count">0</span>
        </div>
        <div class="stat-value" id="stat-claims-val">0</div>
        <div class="stat-label">Reclamaciones Pendientes</div>
      </article>

      <article class="stat-card card hover-lift">
        <div class="stat-header">
          <span class="stat-icon">📝</span>
          <span class="stat-trend neutral" id="stat-subs-count">0</span>
        </div>
        <div class="stat-value" id="stat-subs-val">0</div>
        <div class="stat-label">Nuevas Altas Pendientes</div>
      </article>

      <article class="stat-card card hover-lift">
        <div class="stat-header">
          <span class="stat-icon">🗑️</span>
          <span class="stat-trend neutral" id="stat-dels-count">0</span>
        </div>
        <div class="stat-value" id="stat-dels-val">0</div>
        <div class="stat-label">Solicitudes de Baja</div>
      </article>

      <article class="stat-card card hover-lift">
        <div class="stat-header">
          <span class="stat-icon">🚩</span>
          <span class="stat-trend neutral" id="stat-reports-count">0</span>
        </div>
        <div class="stat-value" id="stat-reports-val">0</div>
        <div class="stat-label">Reportes de la Comunidad</div>
      </article>
    </section>

    <!-- Moderation Queues -->
    <div class="moderation-sections-grid">
      <!-- 1. CLAIMS -->
      <article class="card card-glass moderation-card">
        <div class="card-title-row">
          <h3>
            🏢 Solicitudes de Reclamación de Negocio ({translations["dashboard.claimsTitle"] || "Acreditaciones"})
          </h3>
        </div>
        <div id="admin-claims-list" class="queue-list">
          <p class="text-muted empty-state">Cargando reclamaciones...</p>
        </div>
      </article>

      <!-- 2. SUBMISSIONS -->
      <article class="card card-glass moderation-card">
        <div class="card-title-row">
          <h3>📝 Propuestas de Nuevos Negocios ({translations["dashboard.submissionsTitle"] || "Altas"})</h3>
        </div>
        <div id="admin-subs-list" class="queue-list">
          <p class="text-muted empty-state">Cargando propuestas...</p>
        </div>
      </article>

      <!-- 3. DELETIONS -->
      <article class="card card-glass moderation-card">
        <div class="card-title-row">
          <h3>🗑️ Solicitudes de Supresión / Baja RGPD</h3>
        </div>
        <div id="admin-dels-list" class="queue-list">
          <p class="text-muted empty-state">Cargando solicitudes de baja...</p>
        </div>
      </article>

      <!-- 4. COMMUNITY REPORTS -->
      <article class="card card-glass moderation-card">
        <div class="card-title-row">
          <h3>🚩 Sugerencias y Reportes de Datos de la Comunidad</h3>
        </div>
        <div id="admin-reports-list" class="queue-list">
          <p class="text-muted empty-state">Cargando reportes...</p>
        </div>
      </article>
    </div>
  </div>

  <!-- ======================================================================= -->
  <!-- TAB: CONTROL DE CALIDAD Y TRIAJE (QUALITY CONTROL CENTER) -->
  <!-- ======================================================================= -->
  <div id="admin-tab-quality-control" class="admin-tab-panel" style="display: none;">
    <!-- KPI Quality Cards -->
    <section class="stats-grid">
      <article class="stat-card card hover-lift">
        <div class="stat-header">
          <span class="stat-icon">🛡️</span>
          <span class={`stat-trend ${avgConfidenceScore >= 85 ? "positive" : "warning"}`}>
            {avgConfidenceScore >= 85 ? "Óptimo" : "Atención"}
          </span>
        </div>
        <div class="stat-value">{avgConfidenceScore}%</div>
        <div class="stat-label">Puntaje Medio de Confianza</div>
      </article>

      <article class="stat-card card hover-lift">
        <div class="stat-header">
          <span class="stat-icon">✅</span>
          <span class="stat-trend positive">Verificados</span>
        </div>
        <div class="stat-value">{verifiedScoreCount}</div>
        <div class="stat-label">Negocios con Alta Confianza (≥85%)</div>
      </article>

      <article class="stat-card card hover-lift">
        <div class="stat-header">
          <span class="stat-icon">⚠️</span>
          <span class={`stat-trend ${needsReviewCount > 0 ? "warning" : "positive"}`}>
            {needsReviewCount > 0 ? "Triaje Activo" : "Al Día"}
          </span>
        </div>
        <div class="stat-value">{needsReviewCount}</div>
        <div class="stat-label">Fichas en Cola de Revisión (&lt;85%)</div>
      </article>

      <article class="stat-card card hover-lift">
        <div class="stat-header">
          <span class="stat-icon">🛍️</span>
          <span class="stat-trend positive">Minería BI</span>
        </div>
        <div class="stat-value">{withStoreCount + withMenuCount}</div>
        <div class="stat-label">Con Tienda Online / Menú Digital</div>
      </article>
    </section>

    <!-- Triage List and Discrepancies -->
    <article class="card card-glass moderation-card" style="margin-top: var(--space-lg);">
      <div class="card-title-row flex-between" style="flex-wrap: wrap; gap: 1rem;">
        <div>
          <h3>⚡ Centro de Triaje & Verificación de Negocios</h3>
          <p class="text-muted" style="font-size: var(--font-size-xs); margin: 0.2rem 0 0 0;">
            Supervisa las discrepancias detectadas por el motor de inteligencia (teléfono, mapas, webs y cobertura
            multicanal).
          </p>
        </div>
        <div class="qc-filters-bar" style="display: flex; gap: 0.5rem;">
          <button type="button" class="btn btn-xs btn-primary qc-filter-btn active" data-filter="all"
            >Todos ({SERVICES.length})</button
          >
          <button type="button" class="btn btn-xs btn-secondary qc-filter-btn" data-filter="review"
            >⚠️ Solo Triaje ({needsReviewCount})</button
          >
          <button type="button" class="btn btn-xs btn-secondary qc-filter-btn" data-filter="verified"
            >✅ Verificados ({verifiedScoreCount})</button
          >
        </div>
      </div>

      <div
        class="qc-services-list"
        style="display: flex; flex-direction: column; gap: var(--space-md); margin-top: var(--space-md);"
      >
        {
          SERVICES.map((s) => {
            const audit = auditBusinessData({
              name: s.name,
              category: s.category,
              zone: s.zone,
              address: s.address,
              coordinates: s.coordinates,
              website: s.website,
              phone: s.phone,
              extractedWebPhone: s.phone,
              whatsapp: s.whatsapp,
              socialLinks: s.socialLinks,
              reviewCount: s.reviewCount,
            });

            const score = s.confidenceScore ?? audit.confidenceScore;
            const isNeedReview =
              score < 85 || audit.status === "needs_manual_review" || s.verificationStatus === "needs_manual_review";
            const statusLabel = score >= 85 ? "VERIFICADO" : "REQUIERE REVISIÓN";

            return (
              <div
                class="qc-service-card card"
                data-qc-status={isNeedReview ? "review" : "verified"}
                style="padding: var(--space-md); border-left: 4px solid var(--color-primary); background: var(--color-surface);"
              >
                <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 0.75rem;">
                  <div>
                    <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                      <h4 style="margin: 0; font-size: 1.1rem;">{s.name}</h4>
                      <span class={`badge ${score >= 85 ? "badge-success" : "badge-accent"}`}>
                        {score}% {score >= 85 ? "✅" : "⚠️"} {statusLabel}
                      </span>
                      <span class="badge badge-primary">{s.category}</span>
                      <span class="badge badge-secondary">📍 {s.zone}</span>
                    </div>
                    <span class="text-muted" style="font-size: 0.85rem; display: block; margin-top: 0.2rem;">
                      Última verificación oficial: {s.lastVerifiedAt || "2026-08-25"}
                    </span>
                  </div>

                  <div style="display: flex; gap: 0.4rem; flex-wrap: wrap;">
                    <button
                      type="button"
                      class="btn btn-xs btn-success one-click-verify-btn"
                      data-service-slug={s.slug}
                    >
                      ⚡ Validar (95%)
                    </button>
                    <button
                      type="button"
                      class="btn btn-xs btn-secondary copy-raw-json-btn"
                      data-service-slug={s.slug}
                      data-service-json={JSON.stringify(s)}
                    >
                      📋 Copiar Raw JSON
                    </button>
                    <a href={`/es/servicios/${s.slug}`} target="_blank" class="btn btn-xs btn-outline-primary">
                      👁️ Ver Ficha ↗
                    </a>
                  </div>
                </div>

                {/* Triple Verification Cross-Reference Grid */}
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0.6rem; padding: 0.75rem; background: var(--color-bg); border-radius: var(--radius-sm); font-size: 0.85rem;">
                  <div>
                    <span style="color: var(--color-text-muted); display: block;">📞 Teléfono Web vs Maps:</span>
                    <strong>
                      {s.sourceCrossReference?.webPhoneMatch ? "✓ Coincidente" : "🚩 Verificado / En revisión"}
                    </strong>
                    <span style="font-size: 0.75rem; color: var(--color-text-muted); display: block;">{s.phone}</span>
                  </div>
                  <div>
                    <span style="color: var(--color-text-muted); display: block;">📍 Ubicación Geográfica:</span>
                    <strong>
                      {(s.sourceCrossReference?.addressConsistency ?? true)
                        ? "✓ Isla de Mallorca"
                        : "🚩 Fuera de límites"}
                    </strong>
                    <span style="font-size: 0.75rem; color: var(--color-text-muted); display: block;">{s.address}</span>
                  </div>
                  <div>
                    <span style="color: var(--color-text-muted); display: block;">🌐 Web Oficial:</span>
                    <strong>{s.website ? "✓ Activa (200 OK)" : "— Sin web oficial"}</strong>
                    {s.website && (
                      <a
                        href={s.website}
                        target="_blank"
                        style="font-size: 0.75rem; color: var(--color-primary); display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"
                      >
                        {s.website}
                      </a>
                    )}
                  </div>
                  <div>
                    <span style="color: var(--color-text-muted); display: block;">🛍️ Tienda & Carta:</span>
                    <strong>
                      {s.onlineStore?.hasOnlineStore
                        ? `✓ Tienda (${s.products?.length || 0} prods)`
                        : s.menuUrl
                          ? "✓ Carta Digital"
                          : "— No detectada"}
                    </strong>
                    {s.menuUrl && (
                      <a
                        href={s.menuUrl}
                        target="_blank"
                        style="font-size: 0.75rem; color: var(--color-primary); display: block;"
                      >
                        Ver Carta Digital ↗
                      </a>
                    )}
                  </div>
                </div>

                {audit.warnings.length > 0 && (
                  <div style="margin-top: 0.6rem; padding: 0.5rem 0.75rem; background: rgba(239, 68, 68, 0.08); border-left: 3px solid var(--color-danger); border-radius: var(--radius-xs); font-size: 0.8rem;">
                    <strong style="color: var(--color-danger); display: block; margin-bottom: 0.2rem;">
                      🚩 Discrepancias / Alertas Detectadas:
                    </strong>
                    {audit.warnings.map((w) => (
                      <div style="color: var(--color-text); margin-top: 0.1rem;">• {w}</div>
                    ))}
                  </div>
                )}
              </div>
            );
          })
        }
      </div>
    </article>
  </div>

  <!-- ======================================================================= -->
  <!-- TAB 2: GESTIÓN DE USUARIOS (USER MANAGEMENT) -->
  <!-- ======================================================================= -->
  <div id="admin-tab-users" class="admin-tab-panel" style="display: none;">
    <article class="card card-glass moderation-card">
      <div class="card-title-row flex-between">
        <div>
          <h3>👥 Gestión de Usuarios y Permisos</h3>
          <p class="text-muted" style="font-size: var(--font-size-xs); margin: 0.2rem 0 0 0;">
            Administra los roles del sistema (Usuario, Manager, Admin) y credenciales en Firestore.
          </p>
        </div>
        <button type="button" id="refresh-users-btn" class="btn btn-secondary btn-sm"> 🔄 Actualizar Usuarios </button>
      </div>

      <div class="users-filter-bar">
        <input
          type="text"
          id="user-search-input"
          class="input-field"
          placeholder="Buscar usuario por nombre o correo electrónico..."
        />
      </div>

      <div id="admin-users-list" class="users-table-wrap">
        <p class="text-muted empty-state">Cargando directorio de usuarios...</p>
      </div>
    </article>
  </div>

  <!-- ======================================================================= -->
  <!-- TAB 3: ANALÍTICAS Y MÉTRICAS -->
  <!-- ======================================================================= -->
  <div id="admin-tab-analytics" class="admin-tab-panel" style="display: none;">
    <section class="stats-grid">
      <article class="stat-card card hover-lift">
        <div class="stat-header">
          <span class="stat-icon">🏢</span>
        </div>
        <div class="stat-value">{totalServices}</div>
        <div class="stat-label">Negocios Verificados</div>
      </article>

      <article class="stat-card card hover-lift">
        <div class="stat-header">
          <span class="stat-icon">⭐</span>
        </div>
        <div class="stat-value">{avgRating} / 5.0</div>
        <div class="stat-label">Puntuación Media</div>
      </article>

      <article class="stat-card card hover-lift">
        <div class="stat-header">
          <span class="stat-icon">💬</span>
        </div>
        <div class="stat-value">{totalReviews.toLocaleString()}</div>
        <div class="stat-label">Reseñas Públicas Indexadas</div>
      </article>

      <article class="stat-card card hover-lift">
        <div class="stat-header">
          <span class="stat-icon">🛡️</span>
        </div>
        <div class="stat-value">{verifiedCount} ({((verifiedCount / totalServices) * 100).toFixed(0)}%)</div>
        <div class="stat-label">Tasa de Verificación Oficial</div>
      </article>
    </section>

    <!-- Analytics Breakdown Grid -->
    <div class="analytics-breakdown-grid">
      <!-- Zone distribution -->
      <article class="card card-glass moderation-card">
        <div class="card-title-row">
          <h3>📍 Distribución por Zonas de Mallorca</h3>
        </div>
        <div class="bar-chart-list">
          {
            MALLORCA_ZONES.map((zone) => {
              const count = SERVICES.filter((s) => s.zone === zone.id).length;
              const pct = totalServices > 0 ? (count / totalServices) * 100 : 0;
              return (
                <div class="chart-row">
                  <div class="chart-label-wrap">
                    <span class="chart-label">{zone.name.es}</span>
                    <span class="chart-count">
                      {count} negocios ({pct.toFixed(0)}%)
                    </span>
                  </div>
                  <div class="chart-bar-track">
                    <div class="chart-bar-fill" style={`width: ${pct}%;`} />
                  </div>
                </div>
              );
            })
          }
        </div>
      </article>

      <!-- Category distribution -->
      <article class="card card-glass moderation-card">
        <div class="card-title-row">
          <h3>🏷️ Cobertura por Categorías</h3>
        </div>
        <div class="bar-chart-list">
          {
            CATEGORIES.map((cat) => {
              const count = SERVICES.filter((s) => s.category === cat.id).length;
              const pct = totalServices > 0 ? (count / totalServices) * 100 : 0;
              return (
                <div class="chart-row">
                  <div class="chart-label-wrap">
                    <span class="chart-label">
                      {cat.icon} {cat.name.es}
                    </span>
                    <span class="chart-count">{count} servicios</span>
                  </div>
                  <div class="chart-bar-track">
                    <div class="chart-bar-fill accent" style={`width: ${pct}%;`} />
                  </div>
                </div>
              );
            })
          }
        </div>
      </article>

      <!-- Business Intelligence & Data Density -->
      <article class="card card-glass moderation-card">
        <div class="card-title-row">
          <h3>🧠 Densidad de Datos & Minería Multicanal</h3>
        </div>
        <div class="bar-chart-list">
          <div class="chart-row">
            <div class="chart-label-wrap">
              <span class="chart-label">🛍️ Tienda Online / E-Commerce</span>
              <span class="chart-count"
                >{withStoreCount} de {totalServices} ({((withStoreCount / totalServices) * 100).toFixed(0)}%)</span
              >
            </div>
            <div class="chart-bar-track">
              <div
                class="chart-bar-fill"
                style={`width: ${(withStoreCount / totalServices) * 100}%; background: var(--color-primary);`}
              >
              </div>
            </div>
          </div>

          <div class="chart-row">
            <div class="chart-label-wrap">
              <span class="chart-label">🍽️ Carta Digital / Menú Detectado</span>
              <span class="chart-count"
                >{withMenuCount} de {totalServices} ({((withMenuCount / totalServices) * 100).toFixed(0)}%)</span
              >
            </div>
            <div class="chart-bar-track">
              <div
                class="chart-bar-fill"
                style={`width: ${(withMenuCount / totalServices) * 100}%; background: var(--color-accent);`}
              >
              </div>
            </div>
          </div>

          <div class="chart-row">
            <div class="chart-label-wrap">
              <span class="chart-label">📰 Cobertura de Prensa Balear</span>
              <span class="chart-count"
                >{withNewsCount} de {totalServices} ({((withNewsCount / totalServices) * 100).toFixed(0)}%)</span
              >
            </div>
            <div class="chart-bar-track">
              <div
                class="chart-bar-fill"
                style={`width: ${(withNewsCount / totalServices) * 100}%; background: var(--color-success);`}
              >
              </div>
            </div>
          </div>

          <div class="chart-row">
            <div class="chart-label-wrap">
              <span class="chart-label">🛡️ Puntuación Media de Confianza</span>
              <span class="chart-count">{avgConfidenceScore}% Global</span>
            </div>
            <div class="chart-bar-track">
              <div
                class="chart-bar-fill"
                style={`width: ${avgConfidenceScore}%; background: ${avgConfidenceScore >= 85 ? "var(--color-success)" : "var(--color-warning)"};`}
              >
              </div>
            </div>
          </div>
        </div>
      </article>
    </div>
  </div>

  <!-- ======================================================================= -->
  <!-- TAB 4: CATÁLOGO Y DIRECTORIO DE NEGOCIOS -->
  <!-- ======================================================================= -->
  <div id="admin-tab-services" class="admin-tab-panel" style="display: none;">
    <article class="card card-glass moderation-card">
      <div class="card-title-row flex-between">
        <div>
          <h3>🏢 Negocios Registrados en el Catálogo ({totalServices})</h3>
          <p class="text-muted" style="font-size: var(--font-size-xs); margin: 0.2rem 0 0 0;">
            Supervisa el estado, enlaces oficiales a Google Maps y datos de contacto de todas las fichas activas.
          </p>
        </div>
        <a href="/es/servicios" target="_blank" class="btn btn-primary btn-sm"> 👁️ Ver Directorio Público </a>
      </div>

      <div class="catalog-services-table">
        {
          SERVICES.map((s, idx) => (
            <div class="catalog-item-card">
              <div class="catalog-header">
                <div class="catalog-info-left">
                  <span class="catalog-idx">#{idx + 1}</span>
                  <div>
                    <h4 class="catalog-name">{s.name}</h4>
                    <div class="catalog-tags">
                      <span class="badge badge-primary">{s.category}</span>
                      <span class="badge badge-accent">📍 {s.zone}</span>
                      <span class="badge badge-success">
                        ⭐ {s.rating ? s.rating.toFixed(1) : "N/A"} ({s.reviewCount ?? "N/A"})
                      </span>
                    </div>
                  </div>
                </div>
                <div class="catalog-actions-right">
                  <a href={`/es/servicios/${s.slug}`} target="_blank" class="btn btn-secondary btn-xs">
                    Ver Ficha ↗
                  </a>
                  <a
                    href={s.googleMapsUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn btn-outline-primary btn-xs"
                  >
                    📍 Google Maps
                  </a>
                </div>
              </div>
              <div class="catalog-body-meta">
                <span>
                  <strong>Dirección:</strong> {s.address}
                </span>
                <span>
                  <strong>Tel:</strong> {s.phone}
                </span>
                <span>
                  <strong>Horario:</strong> {s.schedule}
                </span>
              </div>
            </div>
          ))
        }
      </div>
    </article>
  </div>
</div>

