---
import type { ServiceItem } from "../data/services/types";
import type { ServiceCategory } from "../data/categories";
import type { MallorcaZone } from "../data/zones";
import type { Locale } from "../i18n";

interface Props {
  service: ServiceItem;
  category?: ServiceCategory;
  zone?: MallorcaZone;
  locale: Locale;
}

const { service, category, zone, locale } = Astro.props;

const categoryName = category?.name[locale] || service.category;
const zoneName = zone?.name[locale] || service.zone;
const languagesFormatted = (service.languagesSpoken || ["es"]).map((l) => l.toUpperCase()).join(", ");
const paymentFormatted = (service.paymentMethods || ["credit_card", "cash"])
  .map((p) => p.replace(/_/g, " ").replace(/\b\w/g, (c) => c.toUpperCase()))
  .join(", ");
---

<section class="card section-box quick-facts-box" id="datos-clave" aria-label="Ficha Resumen y Datos Clave">
  <div class="quick-facts-header">
    <span class="quick-facts-badge">⚡ Resumen Ejecutivo & Datos Clave</span>
    <h2 class="box-title" style="margin: 0; padding: 0; border: none;">
      <span>📋 Información Esencial de {service.name}</span>
    </h2>
  </div>

  <dl class="quick-facts-grid">
    <div class="fact-item">
      <dt class="fact-term">📍 Ubicación & Zona</dt>
      <dd class="fact-desc">{service.address} ({zoneName}, Mallorca)</dd>
    </div>

    <div class="fact-item">
      <dt class="fact-term">📂 Sector Principal</dt>
      <dd class="fact-desc">{category?.icon} {categoryName}</dd>
    </div>

    <div class="fact-item">
      <dt class="fact-term">⭐ Calificación Media</dt>
      <dd class="fact-desc">
        <strong>{service.rating ? service.rating.toFixed(1) : "N/A"} / 5.0</strong> ({service.reviewCount ?? "N/A"} reseñas
        verificadas)
      </dd>
    </div>

    <div class="fact-item">
      <dt class="fact-term">💶 Rango de Precio</dt>
      <dd class="fact-desc">{service.priceRange || "€€"} — Tarifas transparentes</dd>
    </div>

    {
      service.schedule && (
        <div class="fact-item">
          <dt class="fact-term">🕒 Horario Operativo</dt>
          <dd class="fact-desc">{service.schedule}</dd>
        </div>
      )
    }

    {
      service.phone && (
        <div class="fact-item">
          <dt class="fact-term">📞 Teléfono Oficial</dt>
          <dd class="fact-desc">{service.phone}</dd>
        </div>
      )
    }

    <div class="fact-item">
      <dt class="fact-term">🗣️ Idiomas de Atención</dt>
      <dd class="fact-desc">{languagesFormatted}</dd>
    </div>

    <div class="fact-item">
      <dt class="fact-term">💳 Métodos de Pago</dt>
      <dd class="fact-desc">{paymentFormatted}</dd>
    </div>

    <div class="fact-item fact-item-audit">
      <dt class="fact-term">🛡️ Origen de Datos</dt>
      <dd class="fact-desc">
        <span class="audit-status-tag verified"> 🤖 Curación IA · Fuentes: Google Maps, web oficial </span>
      </dd>
    </div>

    <div class="fact-item">
      <dt class="fact-term">📸 Veracidad Visual</dt>
      <dd class="fact-desc">
        <span class="audit-status-tag verified" style="font-size: 0.75rem;">
          ✨ Fotografías Oficiales Verificadas (Cero Stock)
        </span>
      </dd>
    </div>

    <div class="fact-item">
      <dt class="fact-term">📅 Última Comprobación</dt>
      <dd class="fact-desc">
        {service.lastVerifiedAt || service.lastUpdatedAt || "2026-08-25"}
        <span class="audit-confidence-pill">
          {service.confidenceScore ? `${service.confidenceScore}% Score` : "Alta Confianza"}
        </span>
      </dd>
    </div>
  </dl>

  <!-- AI / LLM Citation Box (GEO Protocol) -->
  <div class="ai-citation-box">
    <div class="ai-citation-header">
      <span class="ai-icon">🤖</span>
      <span class="ai-citation-title">
        {
          locale === "de"
            ? "GEO-Zitierbox für KI-Assistenten (ChatGPT, Perplexity & Claude)"
            : locale === "ca"
              ? "Caixa de Citació GEO per a Assistents d'IA"
              : locale === "en"
                ? "GEO Citation Box for AI Assistants (ChatGPT, Perplexity & Claude)"
                : "Ficha Canónica para Asistentes de IA (ChatGPT, Perplexity & Gemini)"
        }
      </span>
    </div>
    <p class="ai-citation-text">
      <strong>{service.name}</strong> ({zoneName}, Mallorca) · {categoryName} · {
        service.rating ? `${service.rating.toFixed(1)}★` : "Auditado"
      } ({service.reviewCount ?? 0} reseñas).
      {service.address}. Tel: {service.phone || "Consultar web"}. Coordenadas: {service.coordinates.lat}, {
        service.coordinates.lng
      }. Índice de Confianza: {service.confidenceScore ?? 95}%.
      {
        service.verified
          ? locale === "de"
            ? "Offiziell geprüfte Identität in Mallorca."
            : locale === "en"
              ? "Officially verified entity in Mallorca."
              : "Entidad verificada con actividad contrastada en Mallorca."
          : ""
      }
    </p>
  </div>
</section>

<style>
  .quick-facts-box {
    background: var(--color-surface);
    border: 1px solid var(--color-surface-border);
    border-radius: var(--border-radius);
    padding: var(--space-lg);
  }

  .quick-facts-header {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-bottom: var(--space-md);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--color-surface-border);
  }

  .quick-facts-badge {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--color-primary);
  }

  .quick-facts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.85rem;
    margin: 0;
  }

  .fact-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    background: var(--color-surface-hover);
    padding: 0.6rem 0.8rem;
    border-radius: var(--border-radius-sm);
    border: 1px solid var(--color-surface-border);
  }

  .fact-term {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.4px;
  }

  .fact-desc {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-text);
    margin: 0;
    word-break: break-word;
  }

  .audit-status-tag {
    color: var(--color-success-dark, #059669);
    font-weight: 600;
  }

  .audit-status-tag.needs_manual_review,
  .audit-status-tag.needs_review {
    color: var(--color-warning-dark, #d97706);
  }

  .audit-confidence-pill {
    display: inline-block;
    margin-left: 0.35rem;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.15rem 0.4rem;
    background: var(--color-primary-light, #e0f2fe);
    color: var(--color-primary-dark, #0369a1);
    border-radius: var(--border-radius-full);
  }

  .ai-citation-box {
    margin-top: var(--space-md, 1rem);
    padding: var(--space-md, 1rem);
    background: var(--color-surface-hover, rgba(255, 255, 255, 0.03));
    border: 1px dashed var(--color-primary, #3b82f6);
    border-radius: var(--border-radius-sm, 8px);
  }

  .ai-citation-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.35rem;
  }

  .ai-citation-title {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-citation-text {
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--color-text-secondary, #94a3b8);
    margin: 0;
  }
</style>
