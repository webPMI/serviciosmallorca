---
import type { Translations } from "../i18n";

interface Props {
  translations: Translations;
  loginUrl: string;
}

const { translations, loginUrl } = Astro.props;
---

<div class="auth-container">
  <div class="auth-card card-glass fade-in">
    <div class="auth-header">
      <div class="auth-brand-badge">🌴 Servicios Mallorca</div>
      <h1 class="auth-title">{translations["auth.register.title"]}</h1>
      <p class="auth-subtitle">{translations["auth.register.subtitle"]}</p>
    </div>

    <div id="general-error" class="alert-error" style="display: none;"></div>

    <form
      class="auth-form"
      id="register-form"
      data-error-name={translations["auth.nameRequired"]}
      data-error-email={translations["auth.emailRequired"]}
      data-error-password={translations["auth.passwordRequired"]}
      data-error-mismatch={translations["auth.passwordMismatch"]}
      data-error-in-use={translations["auth.errors.emailAlreadyInUse"]}
      data-error-weak={translations["auth.errors.weakPassword"]}
      data-error-register={translations["auth.errors.registerError"]}
      data-strength-weak={translations["auth.passwordStrength.weak"]}
      data-strength-medium={translations["auth.passwordStrength.medium"]}
      data-strength-strong={translations["auth.passwordStrength.strong"]}
    >
      <div class="form-group">
        <label for="name" class="form-label">{translations["auth.register.name"]}</label>
        <div class="input-wrapper">
          <span class="input-icon">👤</span>
          <input
            type="text"
            id="name"
            name="name"
            class="form-input"
            required
            placeholder="Juan Pérez"
            autocomplete="name"
          />
        </div>
        <span class="form-error" id="name-error"></span>
      </div>

      <div class="form-group">
        <label for="email" class="form-label">{translations["auth.register.email"]}</label>
        <div class="input-wrapper">
          <span class="input-icon">📧</span>
          <input
            type="email"
            id="email"
            name="email"
            class="form-input"
            required
            placeholder="tu@email.com"
            autocomplete="email"
          />
        </div>
        <span class="form-error" id="email-error"></span>
      </div>

      <div class="form-group">
        <label for="password" class="form-label">{translations["auth.register.password"]}</label>
        <div class="input-wrapper">
          <span class="input-icon">🔒</span>
          <input
            type="password"
            id="password"
            name="password"
            class="form-input"
            required
            placeholder="••••••••"
            autocomplete="new-password"
          />
          <button
            type="button"
            id="toggle-password"
            class="toggle-password-btn"
            aria-label={translations["auth.togglePassword.ariaLabel"]}
          >
            👁️
          </button>
        </div>
        <div class="password-strength" id="passwordStrength">
          <div class="strength-bar">
            <div class="strength-fill" id="strengthFill"></div>
          </div>
          <span class="strength-text" id="strengthText"></span>
        </div>
        <span class="form-error" id="password-error"></span>
      </div>

      <div class="form-group">
        <label for="confirmPassword" class="form-label">{translations["auth.register.confirmPassword"]}</label>
        <div class="input-wrapper">
          <span class="input-icon">🔒</span>
          <input
            type="password"
            id="confirmPassword"
            name="confirmPassword"
            class="form-input"
            required
            placeholder="••••••••"
            autocomplete="new-password"
          />
          <button
            type="button"
            id="toggle-confirm-password"
            class="toggle-password-btn"
            aria-label={translations["auth.togglePassword.ariaLabel"]}
          >
            👁️
          </button>
        </div>
        <span class="form-error" id="confirmPassword-error"></span>
      </div>

      <div class="form-actions">
        <button type="submit" id="submit-btn" class="btn btn-primary btn-block">
          {translations["auth.register.submit"]}
        </button>
      </div>

      <div class="auth-divider">
        <span>{translations["auth.divider.orRegisterWith"]}</span>
      </div>

      <button type="button" id="google-register-btn" class="btn btn-google btn-block">
        <svg width="20" height="20" viewBox="0 0 24 24">
          <path
            fill="#4285F4"
            d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
          ></path>
          <path
            fill="#34A853"
            d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
          ></path>
          <path
            fill="#FBBC05"
            d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
          ></path>
          <path
            fill="#EA4335"
            d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
          ></path>
        </svg>
        <span>{translations["auth.google"] || "Continuar con Google"}</span>
      </button>

      <div class="auth-footer">
        <a href={loginUrl} class="auth-link">
          {translations["auth.register.hasAccount"]}
          <strong>{translations["auth.register.loginLink"]}</strong>
        </a>
      </div>
    </form>
  </div>
</div>

<script>
  import { createUserWithEmailAndPassword, updateProfile, signInWithPopup } from "firebase/auth";
  import { auth, googleProvider, db } from "../lib/firebase";
  import { createUserProfile } from "../lib/userProfile";

  const form = document.getElementById("register-form") as HTMLFormElement | null;
  const nameInput = document.getElementById("name") as HTMLInputElement | null;
  const emailInput = document.getElementById("email") as HTMLInputElement | null;
  const passwordInput = document.getElementById("password") as HTMLInputElement | null;
  const confirmPasswordInput = document.getElementById("confirmPassword") as HTMLInputElement | null;
  const nameError = document.getElementById("name-error");
  const emailError = document.getElementById("email-error");
  const passwordError = document.getElementById("password-error");
  const confirmPasswordError = document.getElementById("confirmPassword-error");
  const generalError = document.getElementById("general-error");
  const googleBtn = document.getElementById("google-register-btn");
  const togglePasswordBtn = document.getElementById("toggle-password");
  const toggleConfirmPasswordBtn = document.getElementById("toggle-confirm-password");
  const strengthFill = document.getElementById("strengthFill");
  const strengthText = document.getElementById("strengthText");
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement | null;

  // Password Toggles
  if (togglePasswordBtn && passwordInput) {
    togglePasswordBtn.addEventListener("click", () => {
      const isPassword = passwordInput.type === "password";
      passwordInput.type = isPassword ? "text" : "password";
      togglePasswordBtn.textContent = isPassword ? "🙈" : "👁️";
    });
  }

  if (toggleConfirmPasswordBtn && confirmPasswordInput) {
    toggleConfirmPasswordBtn.addEventListener("click", () => {
      const isPassword = confirmPasswordInput.type === "password";
      confirmPasswordInput.type = isPassword ? "text" : "password";
      toggleConfirmPasswordBtn.textContent = isPassword ? "🙈" : "👁️";
    });
  }

  // Password Strength Meter
  if (passwordInput && strengthFill && strengthText && form) {
    passwordInput.addEventListener("input", () => {
      const val = passwordInput.value;
      let score = 0;

      if (val.length >= 8) score++;
      if (/\d/.test(val)) score++;
      if (/[a-z]/.test(val) && /[A-Z]/.test(val)) score++;
      if (/[^A-Za-z0-9]/.test(val)) score++;

      if (val.length === 0) {
        strengthFill.className = "strength-fill";
        strengthText.textContent = "";
      } else if (score <= 1) {
        strengthFill.className = "strength-fill weak";
        strengthText.textContent = form.dataset.strengthWeak || "Débil";
      } else if (score <= 3) {
        strengthFill.className = "strength-fill medium";
        strengthText.textContent = form.dataset.strengthMedium || "Media";
      } else {
        strengthFill.className = "strength-fill strong";
        strengthText.textContent = form.dataset.strengthStrong || "Fuerte";
      }
    });
  }

  // Register with Firebase
  if (
    form &&
    nameInput &&
    emailInput &&
    passwordInput &&
    confirmPasswordInput &&
    nameError &&
    emailError &&
    passwordError &&
    confirmPasswordError
  ) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      nameError.textContent = "";
      emailError.textContent = "";
      passwordError.textContent = "";
      confirmPasswordError.textContent = "";
      if (generalError) generalError.style.display = "none";

      let hasError = false;

      if (!nameInput.value.trim()) {
        nameError.textContent = form.dataset.errorName || "El nombre es requerido";
        hasError = true;
      }

      if (!emailInput.value.trim()) {
        emailError.textContent = form.dataset.errorEmail || "El correo electrónico es requerido";
        hasError = true;
      }

      if (!passwordInput.value) {
        passwordError.textContent = form.dataset.errorPassword || "La contraseña es requerida";
        hasError = true;
      }

      if (confirmPasswordInput.value !== passwordInput.value) {
        confirmPasswordError.textContent = form.dataset.errorMismatch || "Las contraseñas no coinciden";
        hasError = true;
      }

      if (hasError) return;

      if (submitBtn) submitBtn.disabled = true;

      // Helper para redirección fluida tras registro
      function getRedirectTarget(): string {
        const urlParams = new URLSearchParams(window.location.search);
        const returnTo =
          urlParams.get("returnTo") || urlParams.get("redirect") || sessionStorage.getItem("auth_return_to");
        sessionStorage.removeItem("auth_return_to");

        if (returnTo && returnTo.startsWith("/") && !returnTo.startsWith("//")) {
          return returnTo;
        }
        return "./dashboard";
      }

      try {
        const userCredential = await createUserWithEmailAndPassword(auth, emailInput.value.trim(), passwordInput.value);
        await updateProfile(userCredential.user, {
          displayName: nameInput.value.trim(),
        });
        // Create Firestore user profile (ficha)
        await createUserProfile(db, {
          uid: userCredential.user.uid,
          email: emailInput.value.trim(),
          displayName: nameInput.value.trim(),
        });
        sessionStorage.setItem("fromAuth", emailInput.value.trim());
        window.location.href = getRedirectTarget();
      } catch (error: any) {
        console.error("Error al registrarse:", error);
        let message = form.dataset.errorRegister || "Error al crear la cuenta.";
        if (error.code === "auth/email-already-in-use") {
          message = form.dataset.errorInUse || "Ya existe una cuenta con este correo electrónico.";
        } else if (error.code === "auth/weak-password") {
          message = form.dataset.errorWeak || "La contraseña debe tener al menos 6 caracteres.";
        }
        if (generalError) {
          generalError.textContent = message;
          generalError.style.display = "block";
        }
      } finally {
        if (submitBtn) submitBtn.disabled = false;
      }
    });
  }

  // Google Sign Up (creates Firestore profile)
  if (googleBtn) {
    googleBtn.addEventListener("click", async () => {
      try {
        const result = await signInWithPopup(auth, googleProvider);
        const user = result.user;

        // Ensure Firestore profile exists for first-time Google sign-up
        await createUserProfile(db, {
          uid: user.uid,
          email: user.email || "",
          displayName: user.displayName || "Usuario",
        });

        sessionStorage.setItem("fromAuth", user.email || user.displayName || "Google");

        const urlParams = new URLSearchParams(window.location.search);
        const returnTo =
          urlParams.get("returnTo") || urlParams.get("redirect") || sessionStorage.getItem("auth_return_to");
        sessionStorage.removeItem("auth_return_to");
        const target = returnTo && returnTo.startsWith("/") && !returnTo.startsWith("//") ? returnTo : "./dashboard";

        window.location.href = target;
      } catch (error: any) {
        console.error("Error en registro con Google:", error);
        if (generalError) {
          if (error.code === "auth/unauthorized-domain") {
            generalError.textContent =
              "Dominio no autorizado en Firebase para Google Sign-In. Por favor agrega 'serviciosmallorca.com' en Firebase Console -> Authentication -> Settings -> Dominios autorizados.";
          } else {
            generalError.textContent = `Error con Google Auth: ${error.message || error}`;
          }
          generalError.style.display = "block";
        }
      }
    });
  }
</script>

<style>
  .auth-container {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-xl) var(--space-md);
  }

  .auth-card {
    width: 100%;
    max-width: 460px;
    padding: var(--space-2xl);
    border-radius: calc(var(--border-radius) * 1.5);
  }

  .auth-header {
    text-align: center;
    margin-bottom: var(--space-xl);
  }

  .auth-brand-badge {
    display: inline-block;
    font-size: var(--font-size-sm);
    font-weight: 600;
    padding: 0.25rem 0.75rem;
    background: var(--color-primary-bg);
    color: var(--color-primary);
    border-radius: 20px;
    margin-bottom: var(--space-sm);
  }

  .auth-title {
    font-size: var(--font-size-3xl);
    margin-bottom: var(--space-xs);
    color: var(--color-text);
    font-weight: 700;
  }

  .auth-subtitle {
    color: var(--color-text-light);
    font-size: var(--font-size-base);
  }

  .alert-error {
    background-color: var(--color-danger-bg);
    border: 1px solid var(--color-danger-border);
    color: var(--color-danger-light);
    padding: 0.75rem 1rem;
    border-radius: var(--border-radius);
    font-size: var(--font-size-sm);
    margin-bottom: var(--space-md);
    text-align: center;
  }

  .auth-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .form-label {
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-text);
  }

  .input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .input-icon {
    position: absolute;
    left: 0.85rem;
    font-size: 1.1rem;
    pointer-events: none;
    z-index: 1;
  }

  .form-input {
    width: 100%;
    padding: 0.8rem 1rem 0.8rem 2.8rem;
    border: 2px solid var(--color-surface-border);
    border-radius: var(--border-radius);
    background-color: var(--color-white);
    color: var(--color-text);
    font-family: var(--font-family);
    font-size: var(--font-size-base);
    transition: all 0.2s ease-in-out;
  }

  .form-input:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px var(--color-primary-ring);
  }

  .toggle-password-btn {
    position: absolute;
    right: 0.75rem;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1.1rem;
    padding: 0.25rem;
  }

  .password-strength {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-top: 0.25rem;
  }

  .strength-bar {
    height: 4px;
    background-color: var(--color-surface-border);
    border-radius: 2px;
    overflow: hidden;
  }

  .strength-fill {
    height: 100%;
    width: 0%;
    transition: all 0.3s ease;
  }

  .strength-fill.weak {
    width: 33%;
    background-color: var(--color-danger-light);
  }

  .strength-fill.medium {
    width: 66%;
    background-color: var(--color-warning-light);
  }

  .strength-fill.strong {
    width: 100%;
    background-color: var(--color-success-dark);
  }

  .strength-text {
    font-size: var(--font-size-xs);
    color: var(--color-text-light);
  }

  .form-error {
    color: var(--color-danger-light);
    font-size: var(--font-size-xs);
    font-weight: 500;
    min-height: 1rem;
  }

  .btn-block {
    width: 100%;
    padding: 0.85rem;
    font-size: var(--font-size-base);
    font-weight: 600;
  }

  .auth-divider {
    display: flex;
    align-items: center;
    margin: var(--space-md) 0;
  }

  .auth-divider::before,
  .auth-divider::after {
    content: "";
    flex: 1;
    height: 1px;
    background-color: var(--color-surface-border);
  }

  .auth-divider span {
    padding: 0 var(--space-md);
    color: var(--color-text-light);
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .btn-google {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    background-color: var(--color-white);
    color: var(--color-text);
    border: 2px solid var(--color-surface-border);
    border-radius: var(--border-radius);
    cursor: pointer;
    font-family: var(--font-family);
    font-size: var(--font-size-base);
    font-weight: 500;
    transition: all 0.2s ease-in-out;
    box-shadow: var(--shadow);
  }

  .btn-google:hover {
    background-color: var(--color-bg);
    border-color: var(--color-primary);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px var(--shadow-overlay-sm);
  }

  .btn-google:active {
    transform: translateY(0);
  }

  .auth-footer {
    text-align: center;
    margin-top: var(--space-md);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-surface-border);
  }

  .auth-link {
    color: var(--color-text-light);
    font-size: var(--font-size-sm);
    text-decoration: none;
  }

  .auth-link strong {
    color: var(--color-primary);
    margin-left: 0.25rem;
  }

  .auth-link:hover strong {
    text-decoration: underline;
  }

  @media (max-width: 480px) {
    .auth-card {
      padding: var(--space-lg);
      border-radius: var(--border-radius);
    }

    .auth-title {
      font-size: var(--font-size-2xl);
    }

    .auth-subtitle {
      font-size: var(--font-size-sm);
    }

    .form-input {
      padding: 0.7rem 0.9rem 0.7rem 2.5rem;
      font-size: var(--font-size-sm);
    }

    .input-icon {
      left: 0.65rem;
      font-size: 1rem;
    }

    .btn-block {
      padding: 0.75rem;
      font-size: var(--font-size-sm);
    }
  }
</style>
