---
import { type Locale } from "../../../i18n";

export const ServiceRelatedList = ({
  service,
  translations,
  locale
}: {
  service: any;
  translations: any;
  locale: Locale;
}) => {
  // Simulación de búsqueda de servicios relacionados (en producción esto vendría de una lógica de categorías/zonas)
  // Por ahora, usaremos el ID del servicio actual para mostrar ejemplos
  return (
    <section class="card section-box related-services">
      <h2 class="box-title">{translations["services.related"]}</h2>
      <div class="related-grid">
        {/* Ejemplo de placeholders - En el futuro se poblará con lógica de base de datos/filtros */}
        <div class="related-item-placeholder">
          <p>Negocios relacionados en {service.zone}</p>
        </div>
      </div>
    </section>
  );
};
