---
import type { ServiceItem } from "../data/services/types";
import type { Locale } from "../i18n";

interface Props {
  service: ServiceItem;
  locale: Locale;
}

const { service, locale } = Astro.props;
---

<section class="card section-box">
  <h2 class="box-title">Acerca de este Servicio</h2>
  <p class="desc-text">{service.fullDescription[locale]}</p>
</section>
