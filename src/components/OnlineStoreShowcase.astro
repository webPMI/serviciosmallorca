---
import type { OnlineStoreInfo, StoreProduct } from "../data/services/types";
import type { Locale } from "../i18n";

export interface Props {
  onlineStore?: OnlineStoreInfo;
  products?: StoreProduct[];
  currentLocale: Locale;
  businessName: string;
}

const { onlineStore, products = [], currentLocale = "es", businessName } = Astro.props;

if (!onlineStore?.hasOnlineStore && products.length === 0) {
  return null;
}

const titles = {
  es: {
    title: "Tienda Oficial & Productos Destacados",
    subtitle: `Adquiere productos oficiales, creaciones exclusivas o bonos regalo de ${businessName}.`,
    visitStore: "Visitar Tienda Online Oficial",
    shipping: "Envíos a Mallorca y Baleares",
    pickup: "Recogida en local disponible",
    buyProduct: "Ver en tienda",
    inStock: "Disponible",
    outOfStock: "Agotado",
  },
  en: {
    title: "Official Store & Featured Products",
    subtitle: `Shop official merchandise, exclusive prints, and gift vouchers from ${businessName}.`,
    visitStore: "Visit Official Online Store",
    shipping: "Delivery across Mallorca & Balearics",
    pickup: "In-store pickup available",
    buyProduct: "Shop now",
    inStock: "In Stock",
    outOfStock: "Sold Out",
  },
  ca: {
    title: "Botiga Oficial i Productes Destacats",
    subtitle: `Compra productes oficials, creacions exclusives o xecs regal de ${businessName}.`,
    visitStore: "Visitar Botiga Online Oficial",
    shipping: "Enviaments a Mallorca i Balears",
    pickup: "Recollida al local disponible",
    buyProduct: "Veure a la botiga",
    inStock: "Disponible",
    outOfStock: "Esgotat",
  },
};

const t = titles[currentLocale] || titles.es;
---

<section class="card section-box store-showcase-box">
  <div class="store-header">
    <div class="store-header-info">
      <div class="store-badge-top">
        <span class="store-icon">🛍️</span>
        <span class="store-pill">E-Commerce Verificado</span>
      </div>
      <h2 class="box-title">{t.title}</h2>
      <p class="store-subtitle">{t.subtitle}</p>

      <div class="store-perks">
        {
          (onlineStore?.shippingToBalearics ?? true) && (
            <span class="perk-item">
              <span class="perk-icon">🚚</span> {t.shipping}
            </span>
          )
        }
        {
          (onlineStore?.pickupInStore ?? true) && (
            <span class="perk-item">
              <span class="perk-icon">🏬</span> {t.pickup}
            </span>
          )
        }
      </div>
    </div>

    {
      onlineStore?.url && (
        <div class="store-cta-wrapper">
          <a
            href={onlineStore.url}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary store-btn hover-lift"
          >
            <span>🛒</span> {t.visitStore} ↗
          </a>
        </div>
      )
    }
  </div>

  {
    products.length > 0 && (
      <div class="products-grid">
        {products.map((product) => {
          const name = product.name[currentLocale] || product.name.es;
          const desc = product.description?.[currentLocale] || product.description?.es;
          const targetUrl = product.url || onlineStore?.url || "#";

          return (
            <article class="product-card hover-lift">
              {product.imageUrl && (
                <div class="product-media">
                  <img
                    src={product.imageUrl}
                    alt={name}
                    loading="lazy"
                    decoding="async"
                    class="product-img"
                  />
                  {product.badge && (
                    <span class="product-badge">{product.badge}</span>
                  )}
                </div>
              )}

              <div class="product-content">
                {product.category && (
                  <span class="product-category">{product.category}</span>
                )}
                <h3 class="product-name">{name}</h3>
                {desc && <p class="product-desc">{desc}</p>}

                <div class="product-footer">
                  <div class="product-pricing">
                    <span class="product-price">{product.price}</span>
                    {product.inStock !== false && (
                      <span class="stock-badge">✓ {t.inStock}</span>
                    )}
                  </div>

                  {targetUrl !== "#" && (
                    <a
                      href={targetUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="product-buy-btn"
                    >
                      {t.buyProduct} ↗
                    </a>
                  )}
                </div>
              </div>
            </article>
          );
        })}
      </div>
    )
  }
</section>

<style>
  .store-showcase-box {
    margin-bottom: var(--space-xl);
    border: 1px solid var(--color-surface-border);
    background: linear-gradient(
      145deg,
      var(--color-surface),
      rgba(238, 108, 77, 0.04)
    );
    border-radius: var(--border-radius-lg);
    padding: var(--space-xl);
  }

  .store-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: var(--space-lg);
    margin-bottom: var(--space-xl);
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--color-surface-border);
  }

  .store-header-info {
    flex: 1;
    min-width: 280px;
  }

  .store-badge-top {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: var(--space-xs);
  }

  .store-pill {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-primary);
    background: rgba(238, 108, 77, 0.12);
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
  }

  .store-subtitle {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    margin-top: 0.25rem;
    margin-bottom: var(--space-md);
  }

  .store-perks {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .perk-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--font-size-xs);
    font-weight: 600;
    color: var(--color-text);
    background: var(--color-bg);
    padding: 0.3rem 0.75rem;
    border-radius: var(--border-radius-sm);
    border: 1px solid var(--color-surface-border);
  }

  .store-cta-wrapper {
    align-self: center;
  }

  .store-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    padding: 0.75rem 1.4rem;
    font-size: var(--font-size-sm);
    box-shadow: 0 4px 14px rgba(238, 108, 77, 0.25);
  }

  /* Products Grid */
  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: var(--space-lg);
  }

  .product-card {
    background: var(--color-bg);
    border: 1px solid var(--color-surface-border);
    border-radius: var(--border-radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .product-card:hover {
    border-color: var(--color-primary);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }

  .product-media {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--color-surface);
  }

  .product-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  .product-card:hover .product-img {
    transform: scale(1.06);
  }

  .product-badge {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-sm);
    background: var(--color-primary);
    color: white;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.2rem 0.55rem;
    border-radius: 9999px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
  }

  .product-content {
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .product-category {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-text-muted);
    letter-spacing: 0.04em;
    margin-bottom: 0.25rem;
  }

  .product-name {
    font-size: var(--font-size-base);
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 0.35rem 0;
    line-height: 1.3;
  }

  .product-desc {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    line-height: 1.5;
    margin-bottom: var(--space-md);
    flex: 1;
  }

  .product-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-top: auto;
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-surface-border);
  }

  .product-pricing {
    display: flex;
    flex-direction: column;
  }

  .product-price {
    font-size: var(--font-size-md);
    font-weight: 800;
    color: var(--color-primary);
  }

  .stock-badge {
    font-size: 0.68rem;
    font-weight: 600;
    color: #10b981;
  }

  .product-buy-btn {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-primary);
    background: rgba(238, 108, 77, 0.1);
    padding: 0.4rem 0.85rem;
    border-radius: var(--border-radius-sm);
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .product-buy-btn:hover {
    background: var(--color-primary);
    color: white;
  }

  @media (max-width: 640px) {
    .store-header {
      flex-direction: column;
    }
    .store-cta-wrapper {
      width: 100%;
    }
    .store-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
