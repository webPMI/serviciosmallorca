---
import type { ServiceItem } from "../data/services";
import { CATEGORIES } from "../data/categories";
import { MALLORCA_ZONES } from "../data/zones";
import ServiceImage from "./ServiceImage.astro";
import LiveScheduleBadge from "./LiveScheduleBadge.astro";
import FavoriteButton from "./FavoriteButton.astro";
import { getSmartActionCta } from "../lib/smartCtaEngine";

interface Props {
  service: ServiceItem;
  currentLocale: "es" | "en" | "ca" | "de";
  getLangPrefix: (locale: "es" | "en" | "ca" | "de") => string;
  translations: Record<string, string>;
}

const { service, currentLocale, getLangPrefix, translations } = Astro.props;
const prefix = getLangPrefix(currentLocale);
const category = CATEGORIES.find((c) => c.id === service.category);
const zone = MALLORCA_ZONES.find((z) => z.id === service.zone);

const categoryName = category?.name[currentLocale] || service.category;
const zoneName = zone?.name[currentLocale] || service.zone;
const shortDesc = service.shortDescription[currentLocale] || service.shortDescription.en;
const detailUrl = `${prefix}servicios/${service.slug}`;

const smartCta = getSmartActionCta(
  service.category,
  service.name,
  currentLocale,
  service.phone,
  service.whatsapp,
  service.website,
  service.menuUrl,
);
---

<article class="service-card card hover-lift">
  <div class="card-media">
    <FavoriteButton
      businessId={service.id}
      businessName={service.name}
      businessSlug={service.slug}
      category={service.category}
      image={service.image}
      size="sm"
      className="card-fav-floating-btn"
    />
    <ServiceImage
      src={service.image}
      alt={service.name}
      categoryIcon={category?.icon}
      categoryName={categoryName}
      aspectRatio="16/9"
      className="card-media-img"
    />
    <div class="media-badges">
      {
        service.isIconicHeritage && (
          <span class="badge badge-heritage">
            {currentLocale === "de" ? "🏛️ Traditionsbetrieb" : "🌴 Clásico Mallorquín"}
          </span>
        )
      }
      {
        (service.culturalIdentity === "german_oriented" ||
          (currentLocale === "de" && service.languagesSpoken?.includes("de"))) && (
          <span class="badge badge-community">🇩🇪 Deutschsprachig</span>
        )
      }
      {service.culturalIdentity === "british_oriented" && <span class="badge badge-community">🇬🇧 English</span>}
      {
        service.verified && (
          <span class="badge badge-success">
            {currentLocale === "de"
              ? `🛡️ Geprüft (${service.confidenceScore ?? 95}%)`
              : `✓ ${translations["services.verifiedBadge"] || "Verificado"}`}
          </span>
        )
      }
      <span class="badge badge-price">{service.priceRange}</span>
    </div>
  </div>

  <div class="card-body">
    <div class="service-meta">
      <span class="service-cat">
        {category?.icon}
        {categoryName}
      </span>
      <span class="service-zone">📍 {zoneName}</span>
    </div>

    <LiveScheduleBadge
      scheduleText={service.schedule}
      serviceStatus={service.status}
      showDisclaimer={false}
      locale={currentLocale}
    />

    <h3 class="service-title">
      <a href={detailUrl}>{service.name}</a>
    </h3>

    <p class="service-desc">{shortDesc}</p>

    {
      (service.capabilities?.petFriendly ||
        service.capabilities?.wheelchairAccessible ||
        service.capabilities?.kidsArea ||
        service.capabilities?.terrace ||
        service.capabilities?.seaViews ||
        service.amenities?.includes("pet_friendly") ||
        service.amenities?.includes("wheelchair_accessible") ||
        service.amenities?.includes("terrace")) && (
        <div class="service-capabilities-row">
          {(service.capabilities?.petFriendly || service.amenities?.includes("pet_friendly")) && (
            <span class="cap-pill" title="Admite mascotas">
              🐾 Pet Friendly
            </span>
          )}
          {(service.capabilities?.wheelchairAccessible || service.amenities?.includes("wheelchair_accessible")) && (
            <span class="cap-pill" title="Accesible PMR">
              ♿ Accesible
            </span>
          )}
          {(service.capabilities?.terrace || service.amenities?.includes("terrace")) && (
            <span class="cap-pill" title="Terraza exterior">
              ☀️ Terraza
            </span>
          )}
          {(service.capabilities?.seaViews || service.amenities?.includes("sea_views")) && (
            <span class="cap-pill" title="Vistas al mar">
              🌊 Vistas Mar
            </span>
          )}
          {(service.capabilities?.kidsArea || service.amenities?.includes("kids_area")) && (
            <span class="cap-pill" title="Zona infantil">
              👶 Familiar
            </span>
          )}
        </div>
      )
    }

    <div class="service-footer">
      <div class="service-rating">
        <span class="star">★</span>
        <strong class="rating-num">{service.rating ? service.rating.toFixed(1) : "N/A"}</strong>
        <span class="rating-count"
          >({service.reviewCount ?? "N/A"} {translations["services.reviews"] || "reseñas"})</span
        >
      </div>

      <div class="service-actions-cluster">
        {
          smartCta.url !== "#" && (
            <a
              href={smartCta.url}
              target={smartCta.isExternal ? "_blank" : "_self"}
              rel={smartCta.isExternal ? "noopener noreferrer" : undefined}
              class="btn btn-secondary btn-xs smart-action-btn"
              data-track-event={smartCta.trackingEvent}
            >
              <span>
                {smartCta.icon} {smartCta.label}
              </span>
            </a>
          )
        }
        <a href={detailUrl} class="btn btn-primary btn-sm card-view-btn">
          {translations["services.viewDetails"] || "Ver ficha"}
        </a>
      </div>
    </div>
  </div>
</article>

<style>
  .service-card {
    padding: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--color-surface-border);
    border-radius: var(--border-radius);
    background: var(--color-surface);
    transition:
      transform var(--transition-smooth),
      box-shadow var(--transition-smooth);
  }

  .card-media {
    position: relative;
    width: 100%;
    height: 200px;
    overflow: hidden;
    background: var(--color-bg);
  }

  .card-fav-floating-btn {
    position: absolute;
    top: var(--space-sm);
    left: var(--space-sm);
    z-index: 5;
  }

  .service-actions-cluster {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .smart-action-btn {
    font-size: 0.725rem;
    font-weight: 700;
    white-space: nowrap;
    padding: 0.25rem 0.5rem;
  }

  .service-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .service-card:hover .service-img {
    transform: scale(1.05);
  }

  .media-badges {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-sm);
    display: flex;
    gap: var(--space-xs);
  }

  .badge-price {
    background: var(--glass-bg);
    color: var(--color-text);
    backdrop-filter: var(--glass-backdrop);
    font-weight: 700;
  }

  .badge-heritage {
    background: linear-gradient(135deg, #f59e0b, #d97706);
    color: #ffffff;
    font-weight: 800;
    font-size: 0.68rem;
    box-shadow: 0 2px 6px rgba(217, 119, 6, 0.35);
  }

  .badge-community {
    background: var(--color-surface);
    color: var(--color-text);
    border: 1px solid var(--color-surface-border);
    font-weight: 700;
    font-size: 0.68rem;
  }

  .card-body {
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: var(--space-xs);
  }

  .service-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    font-weight: 600;
  }

  .service-cat {
    color: var(--color-primary);
  }

  .service-title {
    font-size: var(--font-size-lg);
    font-weight: 700;
    line-height: 1.3;
    margin-top: var(--space-xs);
  }

  .service-title a {
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .service-title a:hover {
    color: var(--color-primary);
  }

  .service-desc {
    font-size: var(--font-size-sm);
    color: var(--color-text-light);
    line-height: 1.5;
    flex-grow: 1;
    margin: var(--space-xs) 0;
  }

  .service-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-surface-border);
    margin-top: auto;
  }

  .service-rating {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-size: var(--font-size-sm);
  }

  .star {
    color: var(--color-accent);
    font-size: 1.1rem;
  }

  .rating-num {
    color: var(--color-text);
  }

  .service-capabilities-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0.35rem 0 0.5rem 0;
  }

  .cap-pill {
    display: inline-flex;
    align-items: center;
    font-size: 0.68rem;
    font-weight: 500;
    padding: 0.15rem 0.45rem;
    border-radius: var(--border-radius-full, 9999px);
    background: var(--color-surface, #f8fafc);
    border: 1px solid var(--color-surface-border, #e2e8f0);
    color: var(--color-text, #334155);
  }

  .rating-count {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }
</style>
