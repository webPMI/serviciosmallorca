---
/**
 * CitizenChecklist.astro
 *
 * Checklist interactivo de documentación requerida para trámites oficiales.
 * Guarda el progreso en localStorage para no perder el estado.
 * Cumple con GR-01 (CSS tokens), GR-02 (responsive), GR-04 (i18n),
 * GR-07 (accesibilidad ARIA) y GR-09 (sin dependencias externas).
 */
import type { GuideDocument } from "../data/citizenGuides";
import type { Locale } from "../i18n";

export interface Props {
  guideId: string;
  documents: GuideDocument[];
  lang: Locale;
}

const { guideId, documents, lang } = Astro.props;

const labels: Record<
  Locale,
  {
    title: string;
    subtitle: string;
    mandatory: string;
    optional: string;
    progressText: string;
    resetText: string;
    completedAlert: string;
  }
> = {
  es: {
    title: "Documentación Requerida & Checklist Interactivo",
    subtitle: "Marca los documentos que ya tienes en tu carpeta para acudir con seguridad a tu cita.",
    mandatory: "Obligatorio",
    optional: "Opcional / Según caso",
    progressText: "requisitos preparados",
    resetText: "Restablecer",
    completedAlert: "¡Todo listo! Tienes toda la documentación requerida preparada.",
  },
  ca: {
    title: "Documentació Requerida i Checklist Interactiu",
    subtitle: "Marca els documents que ja tens a la teva carpeta per anar amb seguretat a la teva cita.",
    mandatory: "Obligatori",
    optional: "Opcional / Segons cas",
    progressText: "requisits preparats",
    resetText: "Restablir",
    completedAlert: "Tot a punt! Tens tota la documentació requerida preparada.",
  },
  en: {
    title: "Required Documents & Interactive Checklist",
    subtitle: "Check off the documents you have prepared to attend your appointment with complete peace of mind.",
    mandatory: "Mandatory",
    optional: "Optional / If applicable",
    progressText: "requirements ready",
    resetText: "Reset",
    completedAlert: "All set! You have all required documentation ready.",
  },
  de: {
    title: "Erforderliche Nachweise & Interaktive Checkliste",
    subtitle: "Haken Sie die vorbereiteten Dokumente ab, um Ihren Behördentermin sicher wahrzunehmen.",
    mandatory: "Erforderlich",
    optional: "Optional / Je nach Fall",
    progressText: "Unterlagen bereit",
    resetText: "Zurücksetzen",
    completedAlert: "Alles bereit! Sie haben alle erforderlichen Unterlagen beisammen.",
  },
};

const l = labels[lang] || labels.es;
---

<section class="citizen-checklist-container" data-guide-id={guideId} aria-label={l.title}>
  <header class="checklist-header">
    <div class="checklist-header-top">
      <div class="checklist-title-group">
        <span class="checklist-icon" aria-hidden="true">📋</span>
        <h3 class="checklist-title">{l.title}</h3>
      </div>
      <button type="button" class="checklist-reset-btn" id="checklist-reset-btn" title={l.resetText}>
        <svg viewBox="0 0 20 20" fill="currentColor" width="14" height="14" aria-hidden="true">
          <path
            fill-rule="evenodd"
            d="M15.312 11.424a5.5 5.5 0 01-9.201 2.466l-.312-.311h2.45a.75.75 0 000-1.5H4.5a.75.75 0 00-.75.75v3.75a.75.75 0 001.5 0v-2.146l.462.462a7 7 0 101.402-8.58.75.75 0 101.077 1.042 5.5 5.5 0 018.621 4.067z"
            clip-rule="evenodd"></path>
        </svg>
        <span>{l.resetText}</span>
      </button>
    </div>
    <p class="checklist-subtitle">{l.subtitle}</p>

    <!-- Barra de Progreso Dinámica -->
    <div class="progress-bar-wrapper">
      <div class="progress-meta">
        <span id="checklist-counter" class="checklist-counter">0 / {documents.length} {l.progressText}</span>
        <span id="checklist-percentage" class="checklist-percentage">0%</span>
      </div>
      <div
        class="progress-track"
        role="progressbar"
        aria-valuenow="0"
        aria-valuemin="0"
        aria-valuemax={documents.length}
      >
        <div id="progress-fill" class="progress-fill" style="width: 0%;"></div>
      </div>
    </div>
  </header>

  <!-- Lista de Documentos -->
  <ul class="checklist-items" role="list">
    {
      documents.map((doc) => {
        const docName = doc.name[lang] || doc.name.es;
        const tip = doc.helpTip?.[lang] || doc.helpTip?.es;
        return (
          <li class="checklist-item" data-doc-id={doc.id}>
            <label class="checklist-label" for={`doc-${guideId}-${doc.id}`}>
              <div class="checkbox-box">
                <input
                  type="checkbox"
                  id={`doc-${guideId}-${doc.id}`}
                  class="checklist-checkbox"
                  data-doc-id={doc.id}
                />
                <span class="custom-checkmark" aria-hidden="true">
                  <svg viewBox="0 0 20 20" fill="currentColor" width="14" height="14">
                    <path
                      fill-rule="evenodd"
                      d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z"
                      clip-rule="evenodd"
                    />
                  </svg>
                </span>
              </div>
              <div class="checklist-content">
                <div class="checklist-item-title-row">
                  <span class="doc-title">{docName}</span>
                  <span class={`doc-priority-badge ${doc.isMandatory ? "mandatory" : "optional"}`}>
                    {doc.isMandatory ? l.mandatory : l.optional}
                  </span>
                </div>
                {tip && <p class="doc-tip">💡 {tip}</p>}
              </div>
            </label>
          </li>
        );
      })
    }
  </ul>

  <div id="checklist-complete-message" class="checklist-complete-message" hidden>
    <svg viewBox="0 0 20 20" fill="currentColor" width="18" height="18" aria-hidden="true">
      <path
        fill-rule="evenodd"
        d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z"
        clip-rule="evenodd"></path>
    </svg>
    <span>{l.completedAlert}</span>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const container = document.querySelector<HTMLElement>(".citizen-checklist-container");
    if (!container) return;

    const guideId = container.dataset.guideId;
    if (!guideId) return;

    const storageKey = `serviciosmallorca_checklist_${guideId}`;
    const checkboxes = container.querySelectorAll<HTMLInputElement>(".checklist-checkbox");
    const counterEl = document.getElementById("checklist-counter");
    const percentEl = document.getElementById("checklist-percentage");
    const fillEl = document.getElementById("progress-fill");
    const progressTrack = container.querySelector(".progress-track");
    const completeMsg = document.getElementById("checklist-complete-message");
    const resetBtn = document.getElementById("checklist-reset-btn");

    const total = checkboxes.length;

    const getStored = (): string[] => {
      try {
        const raw = localStorage.getItem(storageKey);
        return raw ? JSON.parse(raw) : [];
      } catch {
        return [];
      }
    };

    const saveStored = (ids: string[]) => {
      try {
        localStorage.setItem(storageKey, JSON.stringify(ids));
      } catch {
        // quota exceeded fallback
      }
    };

    const updateUI = () => {
      const stored = getStored();
      let count = 0;

      checkboxes.forEach((cb) => {
        const id = cb.dataset.docId;
        const itemLi = cb.closest(".checklist-item");
        if (id && stored.includes(id)) {
          cb.checked = true;
          itemLi?.classList.add("checked");
          count++;
        } else {
          cb.checked = false;
          itemLi?.classList.remove("checked");
        }
      });

      const pct = total > 0 ? Math.round((count / total) * 100) : 0;

      if (counterEl) {
        const parts = counterEl.innerText.split(" ");
        const textTail = parts.slice(2).join(" ");
        counterEl.innerText = `${count} / ${total} ${textTail}`;
      }
      if (percentEl) {
        percentEl.innerText = `${pct}%`;
      }
      if (fillEl) {
        fillEl.style.width = `${pct}%`;
      }
      if (progressTrack) {
        progressTrack.setAttribute("aria-valuenow", String(count));
      }
      if (completeMsg) {
        completeMsg.hidden = count < total || total === 0;
      }
    };

    // Listeners en checkboxes
    checkboxes.forEach((cb) => {
      cb.addEventListener("change", () => {
        const docId = cb.dataset.docId;
        if (!docId) return;

        const stored = getStored();
        let updated: string[];
        if (cb.checked) {
          updated = Array.from(new Set([...stored, docId]));
        } else {
          updated = stored.filter((id) => id !== docId);
        }
        saveStored(updated);
        updateUI();
      });
    });

    // Reset button
    resetBtn?.addEventListener("click", () => {
      saveStored([]);
      updateUI();
    });

    // Inicializar estado guardado
    updateUI();
  });
</script>

<style>
  .citizen-checklist-container {
    background: var(--color-bg-card, #ffffff);
    border: 1px solid var(--color-border, #e2e8f0);
    border-radius: var(--radius-xl, 16px);
    padding: 1.75rem;
    margin: 2rem 0;
    box-shadow: var(--shadow-sm, 0 1px 3px rgba(0, 0, 0, 0.05));
  }

  .checklist-header {
    margin-bottom: 1.5rem;
  }

  .checklist-header-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  .checklist-title-group {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .checklist-icon {
    font-size: 1.5rem;
  }

  .checklist-title {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-main, #1a202c);
  }

  .checklist-reset-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: transparent;
    border: 1px solid var(--color-border, #e2e8f0);
    color: var(--color-text-muted, #718096);
    font-size: 0.78rem;
    font-weight: 600;
    padding: 0.3rem 0.65rem;
    border-radius: var(--radius-sm, 6px);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .checklist-reset-btn:hover {
    color: var(--color-error, #e53e3e);
    border-color: var(--color-error, #e53e3e);
    background: rgba(229, 62, 62, 0.05);
  }

  .checklist-subtitle {
    margin: 0 0 1.25rem 0;
    font-size: 0.92rem;
    color: var(--color-text-muted, #718096);
    line-height: 1.5;
  }

  .progress-bar-wrapper {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .progress-meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-text-main, #2d3748);
  }

  .checklist-percentage {
    color: var(--color-gold, #c89d5c);
  }

  .progress-track {
    width: 100%;
    height: 8px;
    background: var(--color-bg-alt, #edf2f7);
    border-radius: var(--radius-full, 9999px);
    overflow: hidden;
  }

  .progress-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--color-gold, #c89d5c), #10b981);
    border-radius: var(--radius-full, 9999px);
    transition: width 0.3s ease;
  }

  .checklist-items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .checklist-item {
    border: 1px solid var(--color-border, #e2e8f0);
    border-radius: var(--radius-md, 10px);
    background: var(--color-bg-main, #ffffff);
    transition: all 0.2s ease;
  }

  .checklist-item.checked {
    background: rgba(16, 185, 129, 0.04);
    border-color: rgba(16, 185, 129, 0.35);
  }

  .checklist-label {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 1rem 1.15rem;
    cursor: pointer;
    user-select: none;
  }

  .checkbox-box {
    position: relative;
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  .checklist-checkbox {
    position: absolute;
    opacity: 0;
    width: 100%;
    height: 100%;
    cursor: pointer;
    margin: 0;
  }

  .custom-checkmark {
    position: absolute;
    top: 0;
    left: 0;
    width: 22px;
    height: 22px;
    border: 2px solid var(--color-border, #cbd5e0);
    border-radius: 6px;
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    color: transparent;
    transition: all 0.2s ease;
  }

  .checklist-checkbox:checked + .custom-checkmark {
    background: #10b981;
    border-color: #10b981;
    color: #ffffff;
  }

  .checklist-checkbox:focus-visible + .custom-checkmark {
    outline: 2px solid var(--color-gold, #c89d5c);
    outline-offset: 2px;
  }

  .checklist-content {
    flex-grow: 1;
  }

  .checklist-item-title-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .doc-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text-main, #1a202c);
    line-height: 1.4;
  }

  .checklist-item.checked .doc-title {
    color: #2d3748;
    text-decoration: line-through;
    opacity: 0.8;
  }

  .doc-priority-badge {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm, 4px);
    white-space: nowrap;
  }

  .doc-priority-badge.mandatory {
    background: rgba(239, 68, 68, 0.1);
    color: #dc2626;
    border: 1px solid rgba(239, 68, 68, 0.2);
  }

  .doc-priority-badge.optional {
    background: var(--color-bg-alt, #edf2f7);
    color: var(--color-text-muted, #718096);
    border: 1px solid var(--color-border, #cbd5e0);
  }

  .doc-tip {
    margin: 0.4rem 0 0 0;
    font-size: 0.82rem;
    line-height: 1.45;
    color: var(--color-text-muted, #4a5568);
    background: var(--color-bg-alt, #f7fafc);
    padding: 0.4rem 0.65rem;
    border-radius: var(--radius-sm, 6px);
  }

  .checklist-complete-message {
    margin-top: 1.25rem;
    padding: 0.85rem 1.15rem;
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.3);
    border-radius: var(--radius-md, 8px);
    color: #065f46;
    font-size: 0.9rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  @media (max-width: 640px) {
    .citizen-checklist-container {
      padding: 1.25rem;
    }

    .checklist-header-top {
      flex-direction: column;
      align-items: flex-start;
    }

    .checklist-reset-btn {
      align-self: flex-end;
    }
  }
</style>
