---
import type { Translations } from "../i18n";

interface Props {
  translations: Translations;
  loginUrl: string;
}

const { translations, loginUrl } = Astro.props;
---

<div class="auth-container">
  <div class="auth-card card-glass fade-in">
    <div class="auth-header">
      <div class="auth-brand-badge">🌴 Servicios Mallorca</div>
      <h1 class="auth-title">{translations["auth.forgotPassword.title"]}</h1>
      <p class="auth-subtitle">{translations["auth.forgotPassword.subtitle"]}</p>
    </div>

    <div id="success-alert" class="alert-success" style="display: none;"></div>
    <div id="general-error" class="alert-error" style="display: none;"></div>

    <form
      class="auth-form"
      id="forgot-password-form"
      data-error-email={translations["auth.emailRequired"]}
      data-error-not-found={translations["auth.errors.userNotFound"]}
      data-error-invalid-email={translations["auth.errors.invalidEmail"]}
      data-error-general={translations["auth.errors.generalError"]}
      data-success-message={translations["auth.forgotPassword.success"]}
    >
      <div class="form-group">
        <label for="email" class="form-label">{translations["auth.login.email"]}</label>
        <div class="input-wrapper">
          <span class="input-icon">📧</span>
          <input
            type="email"
            id="email"
            name="email"
            class="form-input"
            required
            placeholder="tu@email.com"
            autocomplete="email"
          />
        </div>
        <span class="form-error" id="email-error"></span>
      </div>

      <div class="form-actions">
        <button type="submit" id="submit-btn" class="btn btn-primary btn-block">
          {translations["auth.forgotPassword.submit"]}
        </button>
      </div>

      <div class="auth-footer">
        <a href={loginUrl} class="auth-link">
          ← <strong>{translations["auth.forgotPassword.backToLogin"]}</strong>
        </a>
      </div>
    </form>
  </div>
</div>

<script>
  import { sendPasswordResetEmail } from "firebase/auth";
  import { auth } from "../lib/firebase";

  const form = document.getElementById("forgot-password-form") as HTMLFormElement | null;
  const emailInput = document.getElementById("email") as HTMLInputElement | null;
  const emailError = document.getElementById("email-error");
  const generalError = document.getElementById("general-error");
  const successAlert = document.getElementById("success-alert");
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement | null;

  if (form && emailInput && emailError) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      emailError.textContent = "";
      if (generalError) generalError.style.display = "none";
      if (successAlert) successAlert.style.display = "none";

      const email = emailInput.value.trim();
      if (!email) {
        emailError.textContent = form.dataset.errorEmail || "El correo electrónico es requerido";
        return;
      }

      if (submitBtn) submitBtn.disabled = true;

      try {
        // Configurar idioma dinámico para la plantilla del correo de Firebase
        const currentLang = document.documentElement.lang || "es";
        auth.languageCode = currentLang;

        await sendPasswordResetEmail(auth, email);
        if (successAlert) {
          successAlert.textContent =
            form.dataset.successMessage ||
            "Te hemos enviado un correo electrónico con instrucciones para restablecer tu contraseña.";
          successAlert.style.display = "block";
        }
        form.reset();
      } catch (error: any) {
        console.error("Error al enviar email de recuperación:", error);
        let message = form.dataset.errorGeneral || "Ocurrió un error al procesar tu solicitud.";
        if (error.code === "auth/user-not-found") {
          message = form.dataset.errorNotFound || "No existe ninguna cuenta asociada a este correo electrónico.";
        } else if (error.code === "auth/invalid-email") {
          message = form.dataset.errorInvalidEmail || "El formato del correo electrónico es inválido.";
        }
        if (generalError) {
          generalError.textContent = message;
          generalError.style.display = "block";
        }
      } finally {
        if (submitBtn) submitBtn.disabled = false;
      }
    });
  }
</script>

<style>
  .auth-container {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-xl) var(--space-md);
  }

  .auth-card {
    width: 100%;
    max-width: 440px;
    padding: var(--space-2xl);
    border-radius: calc(var(--border-radius) * 1.5);
  }

  .auth-header {
    text-align: center;
    margin-bottom: var(--space-xl);
  }

  .auth-brand-badge {
    display: inline-block;
    font-size: var(--font-size-sm);
    font-weight: 600;
    padding: 0.25rem 0.75rem;
    background: var(--color-primary-bg);
    color: var(--color-primary);
    border-radius: 20px;
    margin-bottom: var(--space-sm);
  }

  .auth-title {
    font-size: var(--font-size-3xl);
    margin-bottom: var(--space-xs);
    color: var(--color-text);
    font-weight: 700;
  }

  .auth-subtitle {
    color: var(--color-text-light);
    font-size: var(--font-size-base);
  }

  .alert-success {
    background-color: var(--color-success-bg);
    border: 1px solid var(--color-success-border);
    color: var(--color-success-light);
    padding: 0.75rem 1rem;
    border-radius: var(--border-radius);
    font-size: var(--font-size-sm);
    margin-bottom: var(--space-md);
    text-align: center;
  }

  .alert-error {
    background-color: var(--color-danger-bg);
    border: 1px solid var(--color-danger-border);
    color: var(--color-danger-light);
    padding: 0.75rem 1rem;
    border-radius: var(--border-radius);
    font-size: var(--font-size-sm);
    margin-bottom: var(--space-md);
    text-align: center;
  }

  .auth-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .form-label {
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-text);
  }

  .input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .input-icon {
    position: absolute;
    left: 0.85rem;
    font-size: 1.1rem;
    pointer-events: none;
    z-index: 1;
  }

  .form-input {
    width: 100%;
    padding: 0.8rem 1rem 0.8rem 2.8rem;
    border: 2px solid var(--color-surface-border);
    border-radius: var(--border-radius);
    background-color: var(--color-white);
    color: var(--color-text);
    font-family: var(--font-family);
    font-size: var(--font-size-base);
    transition: all 0.2s ease-in-out;
  }

  .form-input:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px var(--color-primary-ring);
  }

  .form-error {
    color: var(--color-danger-light);
    font-size: var(--font-size-xs);
    font-weight: 500;
    min-height: 1rem;
  }

  .btn-block {
    width: 100%;
    padding: 0.85rem;
    font-size: var(--font-size-base);
    font-weight: 600;
  }

  .auth-footer {
    text-align: center;
    margin-top: var(--space-md);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-surface-border);
  }

  .auth-link {
    color: var(--color-text-light);
    font-size: var(--font-size-sm);
    text-decoration: none;
  }

  .auth-link strong {
    color: var(--color-primary);
  }

  .auth-link:hover strong {
    text-decoration: underline;
  }

  @media (max-width: 480px) {
    .auth-card {
      padding: var(--space-lg);
      border-radius: var(--border-radius);
    }

    .auth-title {
      font-size: var(--font-size-2xl);
    }

    .auth-subtitle {
      font-size: var(--font-size-sm);
    }

    .form-input {
      padding: 0.7rem 0.9rem 0.7rem 2.5rem;
      font-size: var(--font-size-sm);
    }

    .input-icon {
      left: 0.65rem;
      font-size: 1rem;
    }

    .btn-block {
      padding: 0.75rem;
      font-size: var(--font-size-sm);
    }
  }
</style>
