---
import type { ServiceItem } from "../data/services/types";
import type { Locale } from "../i18n";

interface Props {
  service: ServiceItem;
  locale?: Locale;
}

const { service, locale = "es" } = Astro.props;

const waTemplates: Record<Locale, string> = {
  es: `Hola, he visto ${service.name} en Servicios Mallorca y me gustaría solicitar información.`,
  en: `Hello, I saw ${service.name} on Servicios Mallorca and would like to request information.`,
  ca: `Hola, he vist ${service.name} a Servicios Mallorca i voldria demanar informació.`,
  de: `Hallo, ich habe ${service.name} auf Servicios Mallorca gesehen und möchte gerne Informationen anfragen.`,
};

const waText = encodeURIComponent(waTemplates[locale] || waTemplates.es);
---

{
  (cleanWhatsApp || cleanPhone || service.website) && (
    <aside class="mobile-sticky-bar" aria-label="Acciones Rápidas Móvil">
      <div class="mobile-sticky-container">
        {cleanWhatsApp ? (
          <a
            href={`https://wa.me/${cleanWhatsApp}?text=${waText}`}
            target="_blank"
            rel="noopener noreferrer"
            class="mobile-sticky-btn mobile-btn-whatsapp"
            aria-label="WhatsApp Directo"
            data-track-event="whatsapp_click"
            data-service-id={service.id}
          >
            <span class="btn-icon">💬</span>
            <span class="btn-label">WhatsApp</span>
          </a>
        ) : null}

        {cleanPhone ? (
          <a
            href={`tel:${cleanPhone}`}
            class="mobile-sticky-btn mobile-btn-call"
            aria-label="Llamar por Teléfono"
            data-track-event="phone_click"
            data-service-id={service.id}
          >
            <span class="btn-icon">📞</span>
            <span class="btn-label">{locale === "ca" ? "Telefonar" : locale === "en" ? "Call" : "Llamar"}</span>
          </a>
        ) : service.website ? (
          <a
            href={service.website}
            target="_blank"
            rel="noopener noreferrer"
            class="mobile-sticky-btn mobile-btn-web"
            aria-label="Web Oficial"
            data-track-event="website_click"
            data-service-id={service.id}
          >
            <span class="btn-icon">🌐</span>
            <span class="btn-label">
              {locale === "ca" ? "Web Oficial" : locale === "en" ? "Website" : "Web Oficial"}
            </span>
          </a>
        ) : null}

        <a
          href="#ubicacion"
          class="mobile-sticky-btn mobile-btn-location"
          aria-label="Ver Ubicación en Mapa"
          data-track-event="directions_click"
          data-service-id={service.id}
        >
          <span class="btn-icon">📍</span>
          <span class="btn-label">{locale === "ca" ? "Mapa" : locale === "en" ? "Map" : "Mapa"}</span>
        </a>
      </div>
    </aside>
  )
}
