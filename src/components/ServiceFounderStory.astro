---
import type { ServiceItem } from "../data/services/types";
import type { Locale } from "../i18n";

interface Props {
  service: ServiceItem;
  locale: Locale;
}

const { service, locale } = Astro.props;
---

{
  service.founderStory?.[locale] && (
    <section class="card section-box founder-story-box">
      <div class="story-header-flex">
        <span class="story-icon">📜</span>
        <div>
          <h2 class="box-title" style="margin: 0; border: none; padding: 0;">
            Historia de Autor {service.foundedYear && `· Desde ${service.foundedYear}`}
          </h2>
          {service.founderName && <p class="founder-subtitle">Fundado y dirigido por {service.founderName}</p>}
        </div>
      </div>
      <p class="story-text">{service.founderStory[locale]}</p>
    </section>
  )
}
