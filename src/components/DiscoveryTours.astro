---
import { DISCOVERY_TOURS, type DiscoveryTour } from "../data/discoveryTours";
import type { Locale } from "../i18n";

interface Props {
  currentLocale: Locale;
  getLangPrefix: (locale: Locale) => string;
  limit?: number;
}

const { currentLocale, getLangPrefix, limit = 3 } = Astro.props;
const prefix = getLangPrefix(currentLocale);
const tours = DISCOVERY_TOURS.slice(0, limit);
---

<section class="discovery-tours-section section" id="discovery-tours">
  <div class="section-header text-center">
    <div class="badge badge-primary fade-in">
      {
        currentLocale === "de"
          ? "🗺️ Inspiration & Routen"
          : currentLocale === "en"
            ? "🗺️ Inspiration & Day Tours"
            : currentLocale === "ca"
              ? "🗺️ Inspiració & Rutes"
              : "🗺️ Inspiración & Rutas Temáticas"
      }
    </div>
    <h2 class="section-title fade-in">
      {
        currentLocale === "de"
          ? "Entdecken Sie Mallorca nach Themen"
          : currentLocale === "en"
            ? "Explore Mallorca by Thematic Days"
            : currentLocale === "ca"
              ? "Descobreix Mallorca per Rutes Temàtiques"
              : "Descubre Mallorca por Rutas Temáticas"
      }
    </h2>
    <p class="section-subtitle fade-in">
      {
        currentLocale === "de"
          ? "Vom Experten kuratierte Tagesrouten, die die besten Gastronomen, Weingüter, Spas und Sportstätten verbinden."
          : currentLocale === "en"
            ? "Handcrafted daily itineraries connecting top verified restaurants, wineries, luxury spas, and outdoor sports."
            : currentLocale === "ca"
              ? "Itineraris d'un dia seleccionats que connecten els millors restaurants, cellers, spas i esports."
              : "Itinerarios de un día completos que combinan los mejores restaurantes, bodegas, spas y enclaves deportivos."
      }
    </p>
  </div>

  <div class="tours-grid">
    {
      tours.map((tour) => (
        <article class="tour-card card hover-lift">
          <div class="tour-media-wrap">
            <img
              src={tour.heroImage}
              alt={tour.title[currentLocale] || tour.title.es}
              class="tour-hero-img"
              loading="lazy"
              decoding="async"
            />
            <div class="tour-overlay-badge">
              <span class="tour-theme-pill">{tour.badge[currentLocale] || tour.badge.es}</span>
              <span class="tour-time-pill">⏱️ {tour.estimatedTime}</span>
            </div>
          </div>

          <div class="tour-body">
            <span class="tour-zone-tag">📍 {tour.zone.toUpperCase()} (MALLORCA)</span>
            <h3 class="tour-title">{tour.title[currentLocale] || tour.title.es}</h3>
            <p class="tour-desc">{tour.subtitle[currentLocale] || tour.subtitle.es}</p>

            <div class="tour-timeline">
              <h4 class="timeline-heading">
                {currentLocale === "de"
                  ? "Etappen des Tages:"
                  : currentLocale === "en"
                    ? "Itinerary Stops:"
                    : currentLocale === "ca"
                      ? "Parades de la ruta:"
                      : "Paradas del Itinerario:"}
              </h4>
              <div class="timeline-list">
                {tour.stops.map((stop) => (
                  <div class="timeline-item">
                    <div class="timeline-icon-wrap">
                      <span class="stop-num">{stop.stopNumber}</span>
                      <span class="stop-icon">{stop.categoryIcon}</span>
                    </div>
                    <div class="timeline-content">
                      <div class="stop-header">
                        {stop.businessSlug ? (
                          <a href={`${prefix}servicios/${stop.businessSlug}`} class="stop-name-link">
                            {stop.name} ↗
                          </a>
                        ) : (
                          <span class="stop-name">{stop.name}</span>
                        )}
                        <span class="stop-time">⏱️ {stop.durationEstimate}</span>
                      </div>
                      <p class="stop-desc">{stop.description[currentLocale] || stop.description.es}</p>
                      <span class="stop-highlight-badge">⭐ {stop.highlight[currentLocale] || stop.highlight.es}</span>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .discovery-tours-section {
    margin-bottom: var(--space-3xl);
  }

  .tours-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 360px), 1fr));
    gap: var(--space-xl);
    margin-top: var(--space-xl);
  }

  .tour-card {
    padding: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .tour-media-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--color-surface-hover);
    overflow: hidden;
  }

  .tour-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .tour-card:hover .tour-hero-img {
    transform: scale(1.04);
  }

  .tour-overlay-badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    right: 0.75rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }

  .tour-theme-pill,
  .tour-time-pill {
    padding: 0.3rem 0.65rem;
    border-radius: var(--border-radius-full);
    font-size: 0.75rem;
    font-weight: 700;
    background: rgba(0, 0, 0, 0.7);
    color: #ffffff;
    backdrop-filter: blur(8px);
  }

  .tour-body {
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .tour-zone-tag {
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--color-primary);
    letter-spacing: 0.5px;
    margin-bottom: var(--space-xs);
  }

  .tour-title {
    font-size: 1.25rem;
    margin: 0 0 var(--space-xs);
    color: var(--color-text);
  }

  .tour-desc {
    font-size: 0.9rem;
    color: var(--color-text-light);
    line-height: 1.45;
    margin: 0 0 var(--space-md);
  }

  /* Timeline */
  .tour-timeline {
    margin-top: auto;
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-surface-border);
  }

  .timeline-heading {
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-sm);
  }

  .timeline-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    position: relative;
  }

  .timeline-item {
    display: flex;
    gap: var(--space-sm);
    align-items: flex-start;
  }

  .timeline-icon-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    flex-shrink: 0;
  }

  .stop-num {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--color-primary);
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .stop-icon {
    font-size: 0.9rem;
  }

  .timeline-content {
    flex: 1;
    min-width: 0;
  }

  .stop-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .stop-name-link {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .stop-name-link:hover {
    color: var(--color-primary);
  }

  .stop-name {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .stop-time {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-weight: 600;
  }

  .stop-desc {
    font-size: 0.8rem;
    color: var(--color-text-light);
    line-height: 1.35;
    margin: 0.15rem 0 0.3rem;
  }

  .stop-highlight-badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-primary);
    background: rgba(64, 145, 108, 0.1);
    padding: 0.1rem 0.4rem;
    border-radius: var(--border-radius-xs);
  }
</style>
