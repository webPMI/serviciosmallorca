// =============================================================================
// Firestore Security Rules — Servicios Mallorca
// =============================================================================
// Roles: guest, user, manager, admin
// Document path: users/{uid}
// Last reviewed: 2026-08-25
// =============================================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper functions
    // -------------------------------------------------------------------------

    /** Returns true if the requester is authenticated. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** Returns the role of the authenticated user from their own document. */
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    /** Returns true if the requester is the owner of the target document. */
    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    /** Returns true if the field value is a valid https URL or null. */
    function isValidUrl(val) {
      return val == null || val.matches('https://.*');
    }

    /** Returns true if a string field is within a byte range. */
    function withinLength(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    /** Returns true if the requester is an administrator. */
    function isAdmin() {
      return isSignedIn() && getUserRole() == 'admin';
    }

    /** Returns true if the requester is a business manager. */
    function isManager() {
      return isSignedIn() && getUserRole() == 'manager';
    }

    /**
     * Fields of `service_overrides/{slug}` that ONLY an administrator may write.
     * Blocks a manager from self-issuing the official seal or stealing ownership
     * (INV-01/INV-02 · GR-11/GR-13). Must stay in sync with VERIFICATION_FIELDS
     * in `src/lib/serviceOverrides.ts`.
     */
    function verificationFields() {
      return [
        'verified', 'verificationStatus', 'trustLevel', 'confidenceScore', 'lastVerifiedAt',
        'verificationMethod', 'documentUrl', 'verifiedByUid', 'verifiedByRole',
        'isClaimed', 'claimedByUid', 'claimedAt'
      ];
    }

    // -------------------------------------------------------------------------
    // Users collection
    // -------------------------------------------------------------------------
    match /users/{uid} {

      // Anyone can read their own profile; Managers and Admins can read any profile
      allow read: if isSignedIn() && (
        isOwner(uid) ||
        getUserRole() == 'manager' ||
        getUserRole() == 'admin'
      );

      // A user can only create their own profile document on registration
      allow create: if isSignedIn()
        && isOwner(uid)
        && request.resource.data.role == 'user'
        && request.resource.data.keys().hasAll(['role', 'displayName', 'email', 'createdAt', 'updatedAt'])
        && withinLength(request.resource.data.displayName, 120)
        && withinLength(request.resource.data.email, 254);

      // A user can update their own profile (cannot escalate their own role)
      // photoURL must be https:// or null
      allow update: if isSignedIn() && (
        (
          isOwner(uid)
          && request.resource.data.role == resource.data.role
          && request.resource.data.email == resource.data.email
          && (!('photoURL' in request.resource.data) || isValidUrl(request.resource.data.photoURL))
          && (!('displayName' in request.resource.data) || withinLength(request.resource.data.displayName, 120))
        ) ||
        getUserRole() == 'admin'
      );

      // Only admins can delete users
      allow delete: if isSignedIn() && getUserRole() == 'admin';
    }

    // -------------------------------------------------------------------------
    // Services Directory collection (Public read, admin/manager write)
    // -------------------------------------------------------------------------
    match /services/{serviceId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        getUserRole() == 'admin' ||
        getUserRole() == 'manager'
      );
      allow update: if isSignedIn() && (
        getUserRole() == 'admin' ||
        (getUserRole() == 'manager' && resource.data.ownerUid == request.auth.uid)
      );
      allow delete: if isSignedIn() && getUserRole() == 'admin';
    }

    // -------------------------------------------------------------------------
    // Service Overrides (Dynamic Manager Overlays)
    // -------------------------------------------------------------------------
    match /service_overrides/{slug} {
      allow read: if true;

      // Create: an admin may write anything (verification, ownership transfer).
      // A manager may only create an override owned by themselves and WITHOUT any
      // verification/titularity field (no self-issued seal).
      allow create: if isAdmin() || (
        isManager()
        && request.resource.data.ownerUid == request.auth.uid
        && !request.resource.data.keys().hasAny(verificationFields())
      );

      // Update: a manager can only edit business fields of their own ficha.
      // Ownership can never move and no verification field may be touched
      // (the admin keeps the monopoly of the official seal).
      allow update: if isAdmin() || (
        isManager()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(verificationFields())
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerUid'])
      );

      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // Service Claims collection (Solicitudes de reclamación)
    // -------------------------------------------------------------------------
    match /service_claims/{claimId} {
      // One claim per (business, user): the client uses a deterministic id
      // (`claim-{serviceId}-{uid}`) and rules reject any overwrite, so a double
      // click or a retry can never create a duplicate (INV-04).
      allow create: if isSignedIn()
        && request.resource.data.applicantUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && withinLength(request.resource.data.applicantEmail, 254)
        && withinLength(request.resource.data.verificationProof, 2000)
        && !exists(/databases/$(database)/documents/service_claims/$(claimId));
      allow read: if isSignedIn() && (
        resource.data.applicantUid == request.auth.uid ||
        isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // Service Submissions collection (Altas de nuevos negocios)
    // -------------------------------------------------------------------------
    match /service_submissions/{submissionId} {
      // Authenticated users can submit a new service proposal
      allow create: if isSignedIn()
        && request.resource.data.applicantUid == request.auth.uid
        && withinLength(request.resource.data.name, 200)
        && withinLength(request.resource.data.description, 5000);
      allow read: if isSignedIn() && (
        resource.data.applicantUid == request.auth.uid ||
        getUserRole() == 'admin'
      );
      allow update, delete: if isSignedIn() && getUserRole() == 'admin';
    }

    // -------------------------------------------------------------------------
    // Service Deletion Requests (Derecho de supresión / baja)
    // -------------------------------------------------------------------------
    match /service_deletion_requests/{requestId} {
      allow create: if isSignedIn()
        && request.resource.data.applicantUid == request.auth.uid
        && withinLength(request.resource.data.reason, 2000);
      allow read: if isSignedIn() && (
        resource.data.applicantUid == request.auth.uid ||
        getUserRole() == 'admin'
      );
      allow update, delete: if isSignedIn() && getUserRole() == 'admin';
    }

    // -------------------------------------------------------------------------
    // Service Reports & Suggestions (Sugerir cambios o reportar errores)
    // ⚠️ Require auth to prevent bot spam; anonymous users still use the form
    //    but must be at least signed in. Open reports capped at 2000 chars.
    // -------------------------------------------------------------------------
    match /service_reports/{reportId} {
      // Require sign-in to prevent automated bot spam
      allow create: if isSignedIn()
        && withinLength(request.resource.data.description, 2000)
        && withinLength(request.resource.data.category, 50)
        && request.resource.data.keys().hasAll(['serviceId', 'serviceName', 'category', 'description']);
      allow read: if isSignedIn() && (
        getUserRole() == 'admin' ||
        (resource.data.reporterUid != null && resource.data.reporterUid == request.auth.uid)
      );
      allow update, delete: if isSignedIn() && getUserRole() == 'admin';
    }

    // -------------------------------------------------------------------------
    // Reviews collection (Public read, authenticated create & helpful toggle)
    // -------------------------------------------------------------------------
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && withinLength(request.resource.data.comment, 2000)
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update: if isSignedIn() && (
        resource.data.authorUid == request.auth.uid ||
        getUserRole() == 'admin' ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['helpfulCount', 'helpfulUsers'])
      );
      allow delete: if isSignedIn() && (
        resource.data.authorUid == request.auth.uid ||
        getUserRole() == 'admin'
      );
    }

    // -------------------------------------------------------------------------
    // Contact Leads & Inquiries
    // -------------------------------------------------------------------------
    match /leads/{leadId} {
      // Require basic fields to prevent blank spam submissions
      allow create: if withinLength(request.resource.data.email, 254)
        && withinLength(request.resource.data.message, 2000)
        && request.resource.data.keys().hasAll(['email', 'message']);
      allow read, update: if isSignedIn() && (
        getUserRole() == 'admin' ||
        resource.data.recipientUid == request.auth.uid
      );
      allow delete: if isSignedIn() && getUserRole() == 'admin';
    }

    // -------------------------------------------------------------------------
    // Forum Topics collection (Public read, authenticated create & like)
    // -------------------------------------------------------------------------
    match /forum_topics/{topicId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && withinLength(request.resource.data.title, 300)
        && (
          ('content' in request.resource.data && withinLength(request.resource.data.content, 10000)) ||
          ('body' in request.resource.data && withinLength(request.resource.data.body, 10000))
        );
      allow update: if isSignedIn() && (
        resource.data.authorUid == request.auth.uid ||
        getUserRole() == 'admin' ||
        // Permit like toggles only on these specific counters
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'likedUsers', 'repliesCount'])
      );
      allow delete: if isSignedIn() && (
        resource.data.authorUid == request.auth.uid ||
        getUserRole() == 'admin'
      );
    }

    // -------------------------------------------------------------------------
    // Forum Replies collection (Public read, authenticated create & like)
    // -------------------------------------------------------------------------
    match /forum_replies/{replyId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && (
          ('content' in request.resource.data && withinLength(request.resource.data.content, 5000)) ||
          ('body' in request.resource.data && withinLength(request.resource.data.body, 5000))
        );
      allow update: if isSignedIn() && (
        resource.data.authorUid == request.auth.uid ||
        getUserRole() == 'admin' ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'likedUsers'])
      );
      allow delete: if isSignedIn() && (
        resource.data.authorUid == request.auth.uid ||
        getUserRole() == 'admin'
      );
    }

    // -------------------------------------------------------------------------
    // Cuadro de Honor: la fuente de verdad es Cloudflare D1 (`honor_spots` +
    // `honor_bids` en `src/lib/honorBoardStore.ts`), aplicada por el webhook de
    // Stripe tras confirmar el pago. NO existe ninguna escritura a Firestore,
    // por lo que no se declara aquí una colección `honor_nominations`: dejar
    // reglas huérfanas abriría una vía alternativa sin auditoría (+1€ real).
    // Cualquier acceso no previsto cae en el `match /{document=**}` final: DENY.
    // -------------------------------------------------------------------------

    // -------------------------------------------------------------------------
    // Fallback: deny everything else by default
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}