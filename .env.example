# ==========================================================================
# Firebase Configuration
# Obtén estos valores en: https://console.firebase.google.com/
# Project: mallorca-campfit
# ==========================================================================

PUBLIC_FIREBASE_API_KEY=your_api_key_here
PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=your_project_id
PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
PUBLIC_FIREBASE_APP_ID=1:your_app_id
PUBLIC_FIREBASE_MEASUREMENT_ID=G-your_id

# ==========================================================================
# AdSense (opcional)
# PUBLIC_ENABLE_ADSENSE="true" activa la carga de anuncios; el client
# (ca-pub-1988580228487420) está configurado en src/components/AdSenseSlot.astro.
# Sin esta variable (o con valor distinto de "true") no se carga ningún script de ads.
# ==========================================================================
PUBLIC_ENABLE_ADSENSE=false

# ==========================================================================
# Nota: Copia este archivo como .env y rellena los valores reales.
# Nunca subas .env al repositorio (está en .gitignore).
# En Cloudflare configura estas variables en el dashboard del Worker/Pages.
# ==========================================================================

# ==========================================================================
# Gemini Bridge (puente local IA ⇄ Gemini — scripts/gemini-bridge.ts)
# Clave gratuita de Google AI Studio: https://aistudio.google.com/apikey
# Modelo por defecto: gemini-3-pro-preview (el que usa Google Antigravity)
# Arranque: npm run gemini:bridge → http://127.0.0.1:8785
# ==========================================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-pro-preview
GEMINI_BRIDGE_PORT=8785
GEMINI_BRIDGE_PERSIST=0