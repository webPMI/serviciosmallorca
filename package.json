{
  "name": "servicios-mallorca",
  "type": "module",
  "version": "1.0.12",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "deploy": "npm run ship",
    "ship": "node --experimental-strip-types scripts/ship.ts",
    "bump": "node --experimental-strip-types scripts/bump-version.ts",
    "autosave": "node --experimental-strip-types scripts/autosave.ts",
    "autosave:deploy": "node --experimental-strip-types scripts/autosave.ts && npm run deploy",
    "prepush": "npm run typecheck && npm run validate:taxonomy && npm test && npm run audit:full",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "audit:full": "node --experimental-strip-types scripts/run-full-audit.ts",
    "audit:services": "node --experimental-strip-types scripts/audit-services.ts",
    "audit:refresh": "node --experimental-strip-types scripts/refresh-catalog.ts",
    "add:service": "node --experimental-strip-types scripts/add-service.ts",
    "discover": "node --experimental-strip-types scripts/discover-businesses.ts",
    "discover:mine": "node --experimental-strip-types scripts/discover-businesses.ts --mine --file=scripts/discovery-targets.json",
    "discover:sports": "node --experimental-strip-types scripts/discover-businesses.ts --mine --file=scripts/discovery-targets-sports.json",
    "rank:businesses": "node --experimental-strip-types scripts/rank-and-organize-businesses.ts",
    "validate:taxonomy": "node --experimental-strip-types scripts/validate-taxonomy.ts",
    "ingest:batch": "node --experimental-strip-types scripts/batch-ingest.ts",
    "audit:anomaly": "node --experimental-strip-types scripts/anomaly-audit.ts",
    "audit:images": "node --experimental-strip-types scripts/audit-and-harvest-images.ts",
    "audit:images:live": "node --experimental-strip-types scripts/verify-all-image-urls.ts",
    "audit:quality": "node --experimental-strip-types scripts/deep-data-scrubbing.ts",
    "report:verify": "node --experimental-strip-types scripts/generate-verification-report.ts",
    "curate": "node --experimental-strip-types scripts/curate-business.ts",
    "gate:check": "node --experimental-strip-types -e \"import('./src/lib/verificationPipeline.ts').then(m=>console.log('✅ Verification gate:', m.VERIFICATION_GATE))\"",
    "check": "npm run lint && npm run typecheck && npm test && npm run validate:taxonomy",
    "gemini:bridge": "node --experimental-strip-types scripts/gemini-bridge.ts",
    "audit:security": "node --experimental-strip-types scripts/security-audit.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/node": "^11.1.6",
    "astro": "^7.3.5",
    "firebase": "^12.19.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/compiler-binding-wasm32-wasi": "^0.5.1",
    "@types/node": "^26.6.3",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7"
  },
  "lint-staged": {
    "*.{ts,astro,json,md,css,js,mjs}": [
      "prettier --write"
    ]
  }
}
